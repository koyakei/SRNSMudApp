{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/SRNSMudApp/SRNSMudApp.csproj",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "kill-existing-server",
      "type": "shell",
      "command": "lsof -t -i :5000 | xargs kill -9 || true",
      "problemMatcher": [],
      "dependsOn": ["build"]
    },
    {
      "label": "Build .NET Metrics",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/SRNSMudApp/SRNSMudApp.csproj",
        "-target:Metrics",
        "/consoleloggerparameters:NoSummary"
      ],
      "problemMatcher": "$msCompile"
    }
  ]
}