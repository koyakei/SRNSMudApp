{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug SRNSMudApp (Server)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "kill-existing-server",
            "program": "${workspaceFolder}/SRNSMudApp/bin/Debug/net11.0/SRNSMudApp.dll",
            "args": [],
            "cwd": "${workspaceFolder}/SRNSMudApp",
            "stopAtEntry": false,
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "ASPNETCORE_URLS": "http://localhost:5009"
            },
            "launchBrowser": {
                "enabled": false
            }
        }
    ]
}