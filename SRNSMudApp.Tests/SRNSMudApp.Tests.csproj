<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <EnablePreviewFeatures>true</EnablePreviewFeatures>
    <NoWarn>$(NoWarn);CA2252</NoWarn>
  </PropertyGroup>


  <ItemGroup>
    <PackageReference Include="AngleSharp" Version="1.7.1"/>
    <PackageReference Include="bunit" Version="1.31.3"/>
    <PackageReference Include="coverlet.collector" Version="6.0.4"/>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.10"/>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1"/>
    <PackageReference Include="Moq" Version="4.20.70"/>
    <PackageReference Include="NuGet.Packaging" Version="7.6.0"/>
    <PackageReference Include="NuGet.Protocol" Version="7.6.0"/>
    <PackageReference Include="xunit" Version="2.9.3"/>
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4"/>
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.10"/>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SRNSMudApp\SRNSMudApp.csproj"/>
  </ItemGroup>

</Project>