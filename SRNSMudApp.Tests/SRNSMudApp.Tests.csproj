<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <EnablePreviewFeatures>true</EnablePreviewFeatures>
    <NoWarn>$(NoWarn);CA2252</NoWarn>
  </PropertyGroup>


  <ItemGroup>
    <PackageReference Include="AngleSharp" Version="1.8.1" />
    <PackageReference Include="bunit" Version="2.11.3" />
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Authentication" Version="11.0.0-*" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="11.0.0-*" />
    <PackageReference Include="Testcontainers.MsSql" Version="3.8.0" />
    <!-- Testcontainers の依存 SSH.NET に高危険度脆弱性 (GHSA-q939-rpr3-3284) のため修正版を直接参照 -->
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Moq" Version="4.20.70" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="11.0.0-*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer.HierarchyId" Version="11.0.0-*" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="SRNSMudApp.Tests.TestSupport" />
    <Using Include="SRNSMudApp.Client.Models" />
    <Using Include="SRNSMudApp.Models" />
  </ItemGroup>


  <ItemGroup>
    <ProjectReference Include="../SRNSMudApp/SRNSMudApp.csproj" />
    <ProjectReference Include="../SRNSMudApp.Client/SRNSMudApp.Client.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="xunit.runner.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>