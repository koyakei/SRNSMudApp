@page "/tag-diagram"
@rendermode @(new InteractiveServerRenderMode(prerender: false))

@using System.Security.Claims
@using Blazor.Diagrams
@using Blazor.Diagrams.Core.Models
@using Blazor.Diagrams.Options
@using SRNSMudApp.Components.Diagram
@using SRNSMudApp.Components.Tag
@using SRNSMudApp.Data
@using SRNSMudApp.Models.Unions
@using SRNSMudApp.Services
@using SRNSMudApp.Services.Dialogs
@using TagEntity = SRNSMudApp.Data.Tag

<PageTitle>Tag Edge Diagram - SRNS</PageTitle>

<div class="d-flex flex-wrap justify-space-between align-center gap-3 mb-3">
    <div class="d-flex align-center gap-2">
        <MudText Typo="Typo.h5" Class="font-weight-bold d-flex align-center">
            <MudIcon Icon="@Icons.Material.Filled.Hub" Class="mr-2" Color="Color.Primary" />
            Tag Edge Diagram
        </MudText>
    </div>

    @* 共通化されたタグ検索コンポーネントによるフォーカス UI *@
    <div style="min-width: 280px; max-width: 380px; flex-grow: 1;">
        <TagAutocomplete Value="_focusedTag" ValueChanged="OnTagFocusedFromSearch"
                         Label="@(_focusedTag == null ? "タグを検索してフォーカス" : "始点タグを変更")"
                         Placeholder="タグ名または内容で検索..." Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" />
    </div>

    <div class="d-flex flex-wrap align-center gap-2">
        @* 表示過多を防ぐフィルタリング設定 *@
        <MudSwitch T="bool" Value="_onlyConnectedTags" ValueChanged="OnOnlyConnectedTagsChanged" Color="Color.Primary"
                   Label="エッジのあるタグのみ" Dense="true" />

        @if (_focusedTag != null || _secondFocusedTag != null)
        {
            <MudToggleIconButton Toggled="_neighborhoodOnly" ToggledChanged="OnNeighborhoodOnlyChanged"
                                 Icon="@Icons.Material.Outlined.FilterCenterFocus" ToggledIcon="@Icons.Material.Filled.FilterCenterFocus"
                                 Color="Color.Default" ToggledColor="Color.Warning" Title="周辺のみ表示切替" />
        }

        <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Small">
            表示タグ: @_displayedTagsCount / @_tags.Count
        </MudChip>
        <MudChip T="string" Color="Color.Secondary" Variant="Variant.Outlined" Size="Size.Small">
            Edges: @_edges.Count
        </MudChip>

        <MudButton Variant="@(_isEdgeCreationMode ? Variant.Filled : Variant.Outlined)"
                   Color="@(_isEdgeCreationMode ? Color.Warning : Color.Primary)"
                   StartIcon="@Icons.Material.Filled.AltRoute"
                   OnClick="ToggleEdgeCreationModeAsync"
                   Disabled="@(string.IsNullOrEmpty(_currentUserId) || _tags.Count < 2)">
            @(_isEdgeCreationMode ? "エッジ作成中" : "エッジ作成モード")
        </MudButton>

        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AddLink"
                   OnClick="() => OpenCreateEdgeDialog(_focusedTag, _secondFocusedTag)"
                   Disabled="@(string.IsNullOrEmpty(_currentUserId) || _tags.Count < 2)">
            Edge を作成
        </MudButton>

        <MudIconButton Icon="@Icons.Material.Filled.Refresh" Color="Color.Default" Title="再読み込み"
                       OnClick="() => ReloadDiagramAsync()" />
        <MudIconButton Icon="@Icons.Material.Filled.CenterFocusStrong" Color="Color.Default" Title="ズームリセット"
                       OnClick="ResetZoom" />
    </div>
</div>

@* フォーカス中タグのサマリーバー（複数タグ・始点/終点フォーカス対応） *@
<TagDiagramFocusBar FocusedTag="_focusedTag"
                    SecondFocusedTag="_secondFocusedTag"
                    AllTags="_tags"
                    Edges="_edges"
                    IsEdgeCreationMode="_isEdgeCreationMode"
                    CurrentUserId="@_currentUserId"
                    OnClearFirstTag="ClearFirstTag"
                    OnClearSecondTag="ClearSecondTag"
                    OnClearFocus="ClearFocus"
                    OnSwapFocusedTags="SwapFocusedTags"
                    OnShowChildNodes="HandleShowChildNodes"
                    OnFocusTagFromTree="FocusTagFromHeaderTree"
                    OnAddChildTag="HandleAddChildTag"
                    OnToggleEdgeCreationMode="ToggleEdgeCreationModeAsync"
                    OnOpenCreateEdgeDialog="args => OpenCreateEdgeDialog(args.Source, args.Target)"
                    OnSelectEdge="HandleEdgeSelected"
                    OnSecondTagFocusedFromSearch="OnSecondTagFocusedFromSearch" />

@* エッジ作成モードパネル（現在フォーカスを維持したまま子タグ同士・タグ間のエッジを形成・タグ付け） *@
<TagEdgeCreationPanel IsEdgeCreationMode="_isEdgeCreationMode"
                      FocusedTag="_focusedTag"
                      AllTags="_tags"
                      SourceTag="_edgeCreationSourceTag"
                      TargetTag="_edgeCreationTargetTag"
                      AttachTag="_edgeCreationAttachTag"
                      AttachAsset="_edgeCreationAttachAsset"
                      AvailableAssets="_edgeCreationAvailableAssets"
                      Weight="_edgeCreationWeight"
                      IsLoadingAttachAssets="_isLoadingAttachAssets"
                      CanCreateEdge="CanCreateEdgeInMode"
                      OnCreateEdge="CreateEdgeInModeAsync"
                      OnExitMode="ExitEdgeCreationMode"
                      OnSourceTagChanged="OnEdgeCreationSourceChanged"
                      OnTargetTagChanged="OnEdgeCreationTargetChanged"
                      OnAttachTagChanged="OnEdgeCreationAttachTagChanged"
                      OnWeightChanged="w => _edgeCreationWeight = w"
                      OnSwapTags="SwapEdgeCreationTags"
                      OnSelectChildAsSource="SelectChildAsSource"
                      OnSelectChildAsTarget="SelectChildAsTarget" />

@if (_isLoading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
}
else
{
    <MudPaper Outlined="true" Class="d-flex diagram-workspace"
              Style="height: calc(100vh - 240px); min-height: 550px; position: relative; overflow: hidden;">
        <div class="flex-grow-1" style="height: 100%; position: relative;">
            <TagDiagramCanvas Diagram="_diagram" OnEdgeSelected="HandleEdgeSelected" OnNodeSelected="HandleNodeSelected" />
        </div>

        @if (_selectedEdge != null)
        {
            <div style="height: 100%; z-index: 10;">
                <TagEdgeInspector Edge="_selectedEdge" AllTags="_tags" CurrentUserId="@_currentUserId" OnClose="CloseInspector"
                                  OnDeleteEdge="HandleDeleteEdge" OnAttachTag="HandleOpenAttachDialog" OnDetachTag="HandleDetachTag"
                                  OnAddChildTag="HandleAddChildTag" />
            </div>
        }
    </MudPaper>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    [Inject] private ITagDiagramDataProvider DataProvider { get; set; } = null!;
    [Inject] private IDialogLauncher DialogLauncher { get; set; } = null!;
    [Inject] private ISnackbar Snackbar { get; set; } = null!;

    private BlazorDiagram _diagram = null!;
    private List<TagEntity> _tags = [];
    private List<TagEdge> _edges = [];
    private TagEdge? _selectedEdge;
    private TagEntity? _focusedTag;
    private TagEntity? _secondFocusedTag;
    private string _currentUserId = "";
    private bool _isLoading = true;
    private bool _onlyConnectedTags = true;
    private bool _neighborhoodOnly = false;
    private bool _isProgrammaticSelection;
    private int _displayedTagsCount = 0;
    private readonly HashSet<int> _extraVisibleTagIds = [];

    // エッジ作成モード関連の内部状態
    private bool _isEdgeCreationMode;
    private TagEntity? _edgeCreationSourceTag;
    private TagEntity? _edgeCreationTargetTag;
    private TagEntity? _edgeCreationAttachTag;
    private RightAsset? _edgeCreationAttachAsset;
    private List<RightAsset> _edgeCreationAvailableAssets = [];
    private int _edgeCreationWeight = 1;
    private bool _isLoadingAttachAssets;
    private bool _isSelectingTargetInEdgeMode;

    protected override async Task OnInitializedAsync()
    {
        InitializeDiagram();

        if (AuthState != null)
        {
            var auth = await AuthState;
            _currentUserId = auth.User.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? "";
        }

        await ReloadDiagramAsync();
    }

    private void InitializeDiagram()
    {
        var options = new BlazorDiagramOptions
        {
            AllowMultiSelection = false,
            Zoom =
            {
                Enabled = true,
                Minimum = 0.3,
                Maximum = 2.0
            }
        };

        _diagram = new BlazorDiagram(options);
        _diagram.RegisterComponent<TagNode, TagNodeWidget>();
        _diagram.RegisterComponent<TagEdgeLink, TagEdgeLinkWidget>();
    }

    private async Task ReloadDiagramAsync(bool preserveExtraVisibleTags = false)
    {
        var preservedExtraIds = preserveExtraVisibleTags ? _extraVisibleTagIds.ToHashSet() : null;
        _isLoading = true;
        _selectedEdge = null;
        _extraVisibleTagIds.Clear();

        try
        {
            _tags = await DataProvider.LoadAllTagsAsync();
            var edgeList = await DataProvider.LoadAllEdgesAsync();
            _edges = edgeList.ToList();

            if (preservedExtraIds != null)
            {
                foreach (var id in preservedExtraIds)
                {
                    _extraVisibleTagIds.Add(id);
                }
            }

            BuildDiagramElements();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"ダイアグラム読み込みに失敗しました: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void OnOnlyConnectedTagsChanged(bool value)
    {
        _onlyConnectedTags = value;
        BuildDiagramElements();
        FocusNodesInDiagram();
    }

    private void OnNeighborhoodOnlyChanged(bool value)
    {
        _neighborhoodOnly = value;
        BuildDiagramElements();
        FocusNodesInDiagram();
    }

    private void BuildDiagramElements()
    {
        // 既存ノードの位置を退避して可能な限りレイアウトを維持
        var existingPositions = _diagram.Nodes.OfType<TagNode>()
            .ToDictionary(n => n.Tag.Id, n => n.Position);

        _diagram.Nodes.Clear();
        _diagram.Links.Clear();

        // 表示対象タグを決定
        var connectedTagIds = _edges
            .SelectMany(e => new[] { e.SourceTagId, e.TargetTagId })
            .ToHashSet();

        IEnumerable<TagEntity> tagsToDisplay;

        if (_neighborhoodOnly && (_focusedTag != null || _secondFocusedTag != null))
        {
            var focusIds = new HashSet<int>();
            if (_focusedTag != null)
            {
                _ = focusIds.Add(_focusedTag.Id);
            }

            if (_secondFocusedTag != null)
            {
                _ = focusIds.Add(_secondFocusedTag.Id);
            }

            var neighborIds = _edges
                .Where(e => focusIds.Contains(e.SourceTagId) || focusIds.Contains(e.TargetTagId))
                .SelectMany(e => new[] { e.SourceTagId, e.TargetTagId })
                .Concat(focusIds)
                .Concat(_extraVisibleTagIds)
                .ToHashSet();

            tagsToDisplay = _tags.Where(t => neighborIds.Contains(t.Id));
        }
        else if (_onlyConnectedTags)
        {
            // エッジに関与しているタグ、フォーカス中、または子タグ展開で明示的に追加されたタグ
            tagsToDisplay = _tags.Where(t => connectedTagIds.Contains(t.Id)
                || (_focusedTag != null && t.Id == _focusedTag.Id)
                || (_secondFocusedTag != null && t.Id == _secondFocusedTag.Id)
                || _extraVisibleTagIds.Contains(t.Id));
        }
        else
        {
            tagsToDisplay = _tags;
        }

        var displayList = tagsToDisplay.ToList();
        _displayedTagsCount = displayList.Count;

        var nodeMap = new Dictionary<int, TagNode>();
        int columns = Math.Max(3, (int)Math.Ceiling(Math.Sqrt(displayList.Count * 1.5)));

        // 新規配置する子ノード用のオフセット管理
        var childOffsets = new Dictionary<int, int>();

        for (int i = 0; i < displayList.Count; i++)
        {
            var tag = displayList[i];
            Blazor.Diagrams.Core.Geometry.Point position;

            if (existingPositions.TryGetValue(tag.Id, out var prevPos))
            {
                position = new Blazor.Diagrams.Core.Geometry.Point(prevPos.X, prevPos.Y);
            }
            else if (tag.ParentTagId != null && existingPositions.TryGetValue(tag.ParentTagId.Value, out var parentPos))
            {
                int order = childOffsets.TryGetValue(tag.ParentTagId.Value, out int cur) ? cur : 0;
                childOffsets[tag.ParentTagId.Value] = order + 1;
                double offsetX = (order - 1) * 200.0;
                double offsetY = 120.0;
                position = new Blazor.Diagrams.Core.Geometry.Point(Math.Max(20, parentPos.X + offsetX), Math.Max(20, parentPos.Y + offsetY));
            }
            else
            {
                int col = i % columns;
                int row = i / columns;
                double x = 80 + (col * 240);
                double y = 80 + (row * 160);
                position = new Blazor.Diagrams.Core.Geometry.Point(x, y);
            }

            TagFocusRole role = TagFocusRole.None;
            if (_focusedTag != null && tag.Id == _focusedTag.Id)
            {
                role = TagFocusRole.Source;
            }
            else if (_secondFocusedTag != null && tag.Id == _secondFocusedTag.Id)
            {
                role = TagFocusRole.Target;
            }

            var node = new TagNode(tag, position)
            {
                FocusRole = role,
                AllTags = _tags,
                RequestFocusTag = FocusTagById,
                RequestAddChildTag = HandleAddChildTag,
                RequestShowChildNodes = HandleShowChildNodes
            };
            nodeMap[tag.Id] = node;
            _diagram.Nodes.Add(node);
        }

        foreach (var edge in _edges)
        {
            if (nodeMap.TryGetValue(edge.SourceTagId, out var sourceNode) &&
                nodeMap.TryGetValue(edge.TargetTagId, out var targetNode))
            {
                // 始点ノードと終点ノードの相対位置から最も自然なポート対（上下左右）を選択し、矢印が自然に終点へ向かうようにする
                double dx = targetNode.Position.X - sourceNode.Position.X;
                double dy = targetNode.Position.Y - sourceNode.Position.Y;
                PortAlignment sourceAlignment;
                PortAlignment targetAlignment;

                if (Math.Abs(dx) >= Math.Abs(dy))
                {
                    sourceAlignment = dx >= 0 ? PortAlignment.Right : PortAlignment.Left;
                    targetAlignment = dx >= 0 ? PortAlignment.Left : PortAlignment.Right;
                }
                else
                {
                    sourceAlignment = dy >= 0 ? PortAlignment.Bottom : PortAlignment.Top;
                    targetAlignment = dy >= 0 ? PortAlignment.Top : PortAlignment.Bottom;
                }

                var sourcePort = sourceNode.GetPort(sourceAlignment) ?? sourceNode.Ports.First();
                var targetPort = targetNode.GetPort(targetAlignment) ?? targetNode.Ports.First();

                var link = new TagEdgeLink(edge, sourcePort, targetPort);
                _diagram.Links.Add(link);
            }
        }
    }

    private void FocusTagFromHeaderTree(int tagId) =>
        FocusTagById(tagId);

    private void FocusTagById(int tagId)
    {
        var tag = _tags.FirstOrDefault(t => t.Id == tagId);
        switch (tag)
        {
            case not null:
                HandleTagSelection(tag);
                break;
        }
    }

    private void HandleTagSelection(TagEntity tag)
    {
        if (_focusedTag == null)
        {
            _focusedTag = tag;
        }
        else if (_focusedTag.Id == tag.Id)
        {
            // 始点と同じタグの場合は何もしない
            return;
        }
        else if (_secondFocusedTag?.Id == tag.Id)
        {
            // 終点と同じタグの場合も何もしない
            return;
        }
        else
        {
            // 異なるタグの場合は終点（2つ目）に指定
            _secondFocusedTag = tag;
        }

        OnFocusedTagsChanged();
    }

    private void OnTagFocusedFromSearch(TagEntity? tag)
    {
        switch (tag)
        {
            case null:
                ClearFirstTag();
                return;
        }

        if (_focusedTag == null)
        {
            _focusedTag = tag;
        }
        else if (_focusedTag.Id == tag.Id)
        {
            // 変更なし
        }
        else if (_secondFocusedTag == null)
        {
            _secondFocusedTag = tag;
        }
        else
        {
            _focusedTag = tag;
        }

        OnFocusedTagsChanged();
    }

    private void OnSecondTagFocusedFromSearch(TagEntity? tag)
    {
        _secondFocusedTag = tag;
        OnFocusedTagsChanged();
    }

    private void OnFocusedTagsChanged()
    {
        _selectedEdge = null;
        BuildDiagramElements();
        FocusNodesInDiagram();
        _ = InvokeAsync(StateHasChanged);
    }

    private void FocusNodesInDiagram()
    {
        _isProgrammaticSelection = true;
        try
        {
            var node1 = _focusedTag != null
                ? _diagram.Nodes.OfType<TagNode>().FirstOrDefault(n => n.Tag.Id == _focusedTag.Id)
                : null;
            var node2 = _secondFocusedTag != null
                ? _diagram.Nodes.OfType<TagNode>().FirstOrDefault(n => n.Tag.Id == _secondFocusedTag.Id)
                : null;

            foreach (var n in _diagram.Nodes.OfType<TagNode>())
            {
                if (node1 != null && n.Tag.Id == node1.Tag.Id)
                {
                    n.FocusRole = TagFocusRole.Source;
                }
                else if (node2 != null && n.Tag.Id == node2.Tag.Id)
                {
                    n.FocusRole = TagFocusRole.Target;
                }
                else
                {
                    n.FocusRole = TagFocusRole.None;
                }
                n.Refresh();
            }

            double zoom = _diagram.Zoom;
            double containerWidth = _diagram.Container is { Width: > 0 } ? _diagram.Container.Width : 800;
            double containerHeight = _diagram.Container is { Height: > 0 } ? _diagram.Container.Height : 550;

            if (node1 != null && node2 != null)
            {
                _diagram.SelectModel(node1, unselectOthers: true);
                _diagram.SelectModel(node2, unselectOthers: false);

                double nodeWidth = node1.Size is { Width: > 0 } ? node1.Size.Width : 160;
                double nodeHeight = node1.Size is { Height: > 0 } ? node1.Size.Height : 50;

                double midX = (node1.Position.X + node2.Position.X + nodeWidth) / 2.0;
                double midY = (node1.Position.Y + node2.Position.Y + nodeHeight) / 2.0;

                double panX = (containerWidth / 2.0) - (midX * zoom);
                double panY = (containerHeight / 2.0) - (midY * zoom);
                _diagram.SetPan(panX, panY);
            }
            else if (node1 != null)
            {
                _diagram.SelectModel(node1, unselectOthers: true);

                double nodeWidth = node1.Size is { Width: > 0 } ? node1.Size.Width : 160;
                double nodeHeight = node1.Size is { Height: > 0 } ? node1.Size.Height : 50;

                double panX = (containerWidth / 2.0) - ((node1.Position.X + (nodeWidth / 2.0)) * zoom);
                double panY = (containerHeight / 2.0) - ((node1.Position.Y + (nodeHeight / 2.0)) * zoom);
                _diagram.SetPan(panX, panY);
            }
        }
        finally
        {
            _isProgrammaticSelection = false;
        }
    }

    private void SwapFocusedTags()
    {
        (_focusedTag, _secondFocusedTag) = (_secondFocusedTag, _focusedTag);
        OnFocusedTagsChanged();
    }

    private void ClearFirstTag()
    {
        _focusedTag = _secondFocusedTag;
        _secondFocusedTag = null;
        if (_focusedTag == null)
        {
            ClearFocus();
        }
        else
        {
            OnFocusedTagsChanged();
        }
    }

    private void ClearSecondTag()
    {
        _secondFocusedTag = null;
        OnFocusedTagsChanged();
    }

    private void ClearFocus()
    {
        _focusedTag = null;
        _secondFocusedTag = null;
        _neighborhoodOnly = false;
        _extraVisibleTagIds.Clear();
        ExitEdgeCreationMode();
        foreach (var n in _diagram.Nodes.OfType<TagNode>())
        {
            n.FocusRole = TagFocusRole.None;
            n.Refresh();
        }
        _diagram.UnselectAll();

        // 絞り込み表示を通常状態に再構築
        BuildDiagramElements();
    }

    private int GetChildTagsCount(int tagId) =>
        _tags.Count(t => t.ParentTagId == tagId);

    private void HandleShowChildNodes(TagEntity parentTag)
    {
        var children = _tags.Where(t => t.ParentTagId == parentTag.Id).ToList();
        if (children.Count == 0)
        {
            Snackbar.Add($"'{parentTag.Name}' に子タグはありません。", Severity.Info);
            return;
        }

        int newlyAdded = 0;
        foreach (var child in children)
        {
            if (_extraVisibleTagIds.Add(child.Id))
            {
                newlyAdded++;
            }
        }

        if (_focusedTag == null)
        {
            _focusedTag = parentTag;
        }
        else if (_focusedTag.Id != parentTag.Id && _secondFocusedTag == null)
        {
            _secondFocusedTag = parentTag;
        }

        BuildDiagramElements();
        FocusNodesInDiagram();
        _ = InvokeAsync(StateHasChanged);

        if (newlyAdded > 0)
        {
            Snackbar.Add($"'{parentTag.Name}' の子タグ ({newlyAdded}件) を画面上に表示しました。", Severity.Success);
        }
        else
        {
            Snackbar.Add($"'{parentTag.Name}' の子タグはすでに画面上に表示されています。", Severity.Info);
        }
    }

    private TagEdge? GetExistingEdgeBetween(int id1, int id2) =>
        _edges.FirstOrDefault(e =>
            (e.SourceTagId == id1 && e.TargetTagId == id2) ||
            (e.SourceTagId == id2 && e.TargetTagId == id1));

    private int GetOutgoingEdgesCount(int tagId) =>
        _edges.Count(e => e.SourceTagId == tagId);

    private int GetIncomingEdgesCount(int tagId) =>
        _edges.Count(e => e.TargetTagId == tagId);

    private void ResetZoom()
    {
        _diagram.SetZoom(1.0);
        _diagram.SetPan(0, 0);
    }

    private void HandleEdgeSelected(TagEdge? edge)
    {
        _selectedEdge = edge;
    }

    private void HandleNodeSelected(TagEntity? tag)
    {
        if (_isProgrammaticSelection)
        {
            return;
        }

        _selectedEdge = null;
        if (tag == null)
        {
            return;
        }

        if (_isEdgeCreationMode)
        {
            // エッジ作成モード時は、現在のフォーカスを維持したまま From / To に割り当て
            if (!_isSelectingTargetInEdgeMode || _edgeCreationSourceTag == null)
            {
                _edgeCreationSourceTag = tag;
                _isSelectingTargetInEdgeMode = true;
            }
            else
            {
                _edgeCreationTargetTag = tag;
            }

            return;
        }

        HandleTagSelection(tag);
    }

    private void CloseInspector()
    {
        _selectedEdge = null;
        _diagram.UnselectAll();
    }

    private async Task OpenCreateEdgeDialog(TagEntity? initialSource = null, TagEntity? initialTarget = null)
    {
        var parameters = new DialogParameters<CreateEdgeDialog>
        {
            { x => x.AvailableTags, _tags },
            { x => x.InitialSourceTag, initialSource },
            { x => x.InitialTargetTag, initialTarget }
        };
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };

        var dialog = await DialogLauncher.ShowAsync<CreateEdgeDialog>("Edge の作成", parameters, options);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled && result.Data is ValueTuple<int, int> edgeData)
        {
            var createResult = await DataProvider.CreateEdgeAsync(edgeData.Item1, edgeData.Item2, _currentUserId);
            switch (createResult)
            {
                case Success<TagEdge> s:
                    Snackbar.Add("Edge を作成しました。", Severity.Success);
                    await ReloadDiagramAsync();
                    _selectedEdge = _edges.FirstOrDefault(e => e.Id == s.Value.Id);
                    break;
                case Failure f:
                    Snackbar.Add($"Edge 作成に失敗しました: {f.ErrorMessage}", Severity.Error);
                    break;
            }
        }
    }

    private async Task HandleDeleteEdge(TagEdge edge)
    {
        var result = await DataProvider.DeleteEdgeAsync(edge.Id, _currentUserId);
        switch (result)
        {
            case Success<bool>:
                Snackbar.Add("Edge を削除しました。", Severity.Success);
                _selectedEdge = null;
                await ReloadDiagramAsync();
                break;
            case Failure f:
                Snackbar.Add($"Edge 削除に失敗しました: {f.ErrorMessage}", Severity.Error);
                break;
        }
    }

    private async Task HandleOpenAttachDialog(TagEdge edge)
    {
        var parameters = new DialogParameters<AttachTagToEdgeDialog>
        {
            { x => x.Edge, edge },
            { x => x.CurrentUserId, _currentUserId },
            { x => x.AvailableTags, _tags }
        };
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };

        var dialog = await DialogLauncher.ShowAsync<AttachTagToEdgeDialog>("Edge へのタグ紐付け", parameters, options);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled && result.Data is ValueTuple<int, int, int> attachData)
        {
            var attachResult = await DataProvider.AttachTagToEdgeAsync(
                edge.Id, attachData.Item1, attachData.Item2, _currentUserId, attachData.Item3);

            switch (attachResult)
            {
                case Success<TagEdgeTagAttachment>:
                    Snackbar.Add(ContractMessages.TagEdgeTagAttached, Severity.Success);
                    await ReloadDiagramAsync();
                    _selectedEdge = _edges.FirstOrDefault(e => e.Id == edge.Id);
                    break;
                case Failure f:
                    Snackbar.Add($"タグ紐付けに失敗しました: {f.ErrorMessage}", Severity.Error);
                    break;
            }
        }
    }

    private async Task HandleDetachTag(TagEdgeTagAttachment attachment)
    {
        var result = await DataProvider.DetachTagFromEdgeAsync(attachment.Id, _currentUserId);
        switch (result)
        {
            case Success<bool>:
                Snackbar.Add(ContractMessages.TagEdgeTagDetachedOrDecreased, Severity.Success);
                int edgeId = _selectedEdge?.Id ?? attachment.TagEdgeId;
                await ReloadDiagramAsync();
                _selectedEdge = _edges.FirstOrDefault(e => e.Id == edgeId);
                break;
            case Failure f:
                Snackbar.Add($"紐付け解除に失敗しました: {f.ErrorMessage}", Severity.Error);
                break;
        }
    }

    private async Task HandleAddChildTag(TagEntity? parentTag)
    {
        if (parentTag == null)
        {
            return;
        }

        var parameters = new DialogParameters { [nameof(TagAddDialog.DefaultParentTag)] = parentTag };
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Large, FullWidth = true };

        var dialog = await DialogLauncher.ShowAsync<TagAddDialog>("子タグの追加", parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false, Data: TagEntity createdTag })
        {
            Snackbar.Add($"'{createdTag.Name}' を追加しました。", Severity.Success);
            await ReloadDiagramAsync();
        }
    }

    /// <summary>
    ///     指定された親タグの子タグ一覧を取得する。
    /// </summary>
    private List<TagEntity> GetChildTags(int parentId) =>
        _tags.Where(t => t.ParentTagId == parentId).ToList();

    /// <summary>
    ///     エッジ作成モードの切り替え。
    /// </summary>
    private async Task ToggleEdgeCreationModeAsync()
    {
        if (_isEdgeCreationMode)
        {
            ExitEdgeCreationMode();
        }
        else
        {
            await EnterEdgeCreationModeAsync();
        }
    }

    /// <summary>
    ///     エッジ作成モードを開始する。
    ///     現在フォーカス中のタグのフォーカスは維持したまま、子タグが存在する場合は画面上に展開し、
    ///     フォーカス中タグをエッジに紐付ける意味付けタグの初期値として設定する。
    /// </summary>
    private async Task EnterEdgeCreationModeAsync()
    {
        _isEdgeCreationMode = true;
        _isSelectingTargetInEdgeMode = false;
        _edgeCreationSourceTag = null;
        _edgeCreationTargetTag = null;

        if (_focusedTag != null)
        {
            // 子タグがまだ展開されていなければ画面上に展開
            var children = _tags.Where(t => t.ParentTagId == _focusedTag.Id).ToList();
            if (children.Count > 0)
            {
                bool addedAny = false;
                foreach (var child in children)
                {
                    if (_extraVisibleTagIds.Add(child.Id))
                    {
                        addedAny = true;
                    }
                }

                if (addedAny)
                {
                    BuildDiagramElements();
                    FocusNodesInDiagram();
                }
            }

            await SetEdgeCreationAttachTagAsync(_focusedTag);
        }
        else
        {
            _edgeCreationAttachTag = null;
            _edgeCreationAttachAsset = null;
            _edgeCreationAvailableAssets.Clear();
        }
    }

    /// <summary>
    ///     エッジ作成モードを終了し、作業状態をリセットする。
    /// </summary>
    private void ExitEdgeCreationMode()
    {
        _isEdgeCreationMode = false;
        _edgeCreationSourceTag = null;
        _edgeCreationTargetTag = null;
        _edgeCreationAttachTag = null;
        _edgeCreationAttachAsset = null;
        _edgeCreationAvailableAssets.Clear();
        _isSelectingTargetInEdgeMode = false;
    }

    private void SelectChildAsSource(TagEntity child)
    {
        _edgeCreationSourceTag = child;
        _isSelectingTargetInEdgeMode = true;
    }

    private void SelectChildAsTarget(TagEntity child)
    {
        _edgeCreationTargetTag = child;
    }

    private void SwapEdgeCreationTags()
    {
        (_edgeCreationSourceTag, _edgeCreationTargetTag) = (_edgeCreationTargetTag, _edgeCreationSourceTag);
    }

    private void OnEdgeCreationSourceChanged(TagEntity? tag)
    {
        _edgeCreationSourceTag = tag;
        if (tag != null)
        {
            _isSelectingTargetInEdgeMode = true;
        }
    }

    private void OnEdgeCreationTargetChanged(TagEntity? tag)
    {
        _edgeCreationTargetTag = tag;
    }

    private async Task OnEdgeCreationAttachTagChanged(TagEntity? tag)
    {
        await SetEdgeCreationAttachTagAsync(tag);
    }

    /// <summary>
    ///     エッジに紐付ける意味付けタグの変更時に利用可能 RightAsset を取得する。
    /// </summary>
    private async Task SetEdgeCreationAttachTagAsync(TagEntity? tag)
    {
        _edgeCreationAttachTag = tag;
        _edgeCreationAttachAsset = null;
        _edgeCreationAvailableAssets.Clear();

        if (tag == null || string.IsNullOrWhiteSpace(_currentUserId))
        {
            return;
        }

        _isLoadingAttachAssets = true;
        try
        {
            _edgeCreationAvailableAssets = await DataProvider.GetAvailableRightAssetsAsync(_currentUserId, tag.Id);
            _edgeCreationAttachAsset = _edgeCreationAvailableAssets.FirstOrDefault();
            _edgeCreationWeight = 1;
        }
        finally
        {
            _isLoadingAttachAssets = false;
        }
    }

    /// <summary>
    ///     エッジ作成モードで決定ボタンが押下可能か判定する。
    /// </summary>
    private bool CanCreateEdgeInMode =>
        !string.IsNullOrEmpty(_currentUserId) &&
        _edgeCreationSourceTag != null &&
        _edgeCreationTargetTag != null &&
        _edgeCreationSourceTag.Id != _edgeCreationTargetTag.Id &&
        !_isLoadingAttachAssets;

    /// <summary>
    ///     エッジ作成モードにおいて、From と To を結ぶ Edge を作成し、
    ///     意味付けタグが指定されていればタグ紐付け（RightAsset 消費）を実行する。
    ///     処理完了後も現在のフォーカス状態を維持する。
    /// </summary>
    private async Task CreateEdgeInModeAsync()
    {
        if (!CanCreateEdgeInMode)
        {
            return;
        }

        var sourceTag = _edgeCreationSourceTag!;
        var targetTag = _edgeCreationTargetTag!;

        var createResult = await DataProvider.CreateEdgeAsync(sourceTag.Id, targetTag.Id, _currentUserId);
        switch (createResult)
        {
            case Success<TagEdge> s:
                var createdEdge = s.Value;
                Snackbar.Add($"Edge（{sourceTag.Name} → {targetTag.Name}）を作成しました。", Severity.Success);

                // エッジへの意味付けタグ付与が指定されていて利用可能アセットがある場合
                if (_edgeCreationAttachTag != null && _edgeCreationAttachAsset != null)
                {
                    var attachResult = await DataProvider.AttachTagToEdgeAsync(
                        createdEdge.Id, _edgeCreationAttachTag.Id, _edgeCreationAttachAsset.Id, _currentUserId, _edgeCreationWeight);

                    switch (attachResult)
                    {
                        case Success<TagEdgeTagAttachment>:
                            Snackbar.Add($"エッジにタグ「{_edgeCreationAttachTag.Name}」を紐付けました。", Severity.Success);
                            break;
                        case Failure f:
                            Snackbar.Add($"エッジ作成は成功しましたが、タグ紐付けに失敗しました: {f.ErrorMessage}", Severity.Warning);
                            break;
                    }
                }

                // 現在のフォーカスと展開中タグを維持したままダイアグラムを再読み込み
                var savedFocus = _focusedTag;
                var savedSecondFocus = _secondFocusedTag;

                await ReloadDiagramAsync(preserveExtraVisibleTags: true);

                _focusedTag = savedFocus;
                _secondFocusedTag = savedSecondFocus;
                _selectedEdge = _edges.FirstOrDefault(e => e.Id == createdEdge.Id);

                // 続けて別の子タグ同士のエッジを作成できるように From / To をリセット
                _edgeCreationSourceTag = null;
                _edgeCreationTargetTag = null;
                _isSelectingTargetInEdgeMode = false;

                if (_edgeCreationAttachTag != null)
                {
                    await SetEdgeCreationAttachTagAsync(_edgeCreationAttachTag);
                }

                FocusNodesInDiagram();
                break;

            case Failure f:
                Snackbar.Add($"Edge 作成に失敗しました: {f.ErrorMessage}", Severity.Error);
                break;
        }
    }
}
