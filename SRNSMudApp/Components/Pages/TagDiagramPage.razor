@page "/tag-diagram"
@rendermode @(new InteractiveServerRenderMode(prerender: false))

@using Blazor.Diagrams
@using SRNSMudApp.Components.Diagram
@using SRNSMudApp.Components.Tag
@using SRNSMudApp.Data
@using TagEntity = SRNSMudApp.Data.Tag

<PageTitle>Tag Edge Diagram - SRNS</PageTitle>

<div class="d-flex flex-wrap justify-space-between align-center gap-3 mb-3">
    <div class="d-flex align-center gap-2">
        <MudText Typo="Typo.h5" Class="font-weight-bold d-flex align-center">
            <MudIcon Icon="@Icons.Material.Filled.Hub" Class="mr-2" Color="Color.Primary" />
            Tag Edge Diagram
        </MudText>
        @if (QueryItemId.HasValue)
        {
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.ArrowBack"
                       OnClick="@(() => NavigationManager.NavigateTo($"/ItemDetail/{QueryItemId.Value}"))">
                Item #@QueryItemId.Value に戻る
            </MudButton>
        }

    </div>

    @* 共通化されたタグ検索コンポーネントによるフォーカス UI *@
    <div style="min-width: 280px; max-width: 380px; flex-grow: 1;">
        <TagAutocomplete Value="ViewModel.FocusedTag" ValueChanged="OnTagFocusedFromSearch"
                         Label="@(ViewModel.FocusedTag == null ? "タグを検索してフォーカス" : "始点タグを変更")" Placeholder="タグ名または内容で検索..."
                         Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" />
    </div>

    <div class="d-flex flex-wrap align-center gap-2">
        @* 表示過多を防ぐフィルタリング設定 *@
        <MudSwitch T="bool" Value="ViewModel.OnlyConnectedTags" ValueChanged="OnOnlyConnectedTagsChanged" Color="Color.Primary"
                   Label="エッジのあるタグのみ" Dense="true" />

        @if (QueryItemId.HasValue)
        {
            <MudSwitch T="bool" Value="ViewModel.ContextOnly" ValueChanged="OnContextOnlyChanged" Color="Color.Secondary"
                       Label="アイテム関連タグのみ" Dense="true" />
        }

        @if (ViewModel.FocusedTag != null || ViewModel.SecondFocusedTag != null)
        {
            <MudToggleIconButton Toggled="ViewModel.NeighborhoodOnly" ToggledChanged="OnNeighborhoodOnlyChanged"
                                 Icon="@Icons.Material.Outlined.FilterCenterFocus" ToggledIcon="@Icons.Material.Filled.FilterCenterFocus"
                                 Color="Color.Default" ToggledColor="Color.Warning" Title="周辺のみ表示切替" />
        }

        <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Small">
            表示タグ: @ViewModel.DisplayedTagsCount / @ViewModel.Tags.Count
        </MudChip>
        <MudChip T="string" Color="Color.Secondary" Variant="Variant.Outlined" Size="Size.Small">
            表示 Edge: @ViewModel.DisplayedEdgesCount / @ViewModel.Edges.Count
        </MudChip>

        @if (ViewModel.HiddenTagIds.Count > 0 || ViewModel.HiddenItemIds.Count > 0)
        {
            <MudButton Variant="Variant.Outlined" Color="Color.Warning" Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.Visibility" OnClick="RestoreHiddenNodes"
                       Class="tag-restore-hidden-button" Title="非表示ノードをすべて再表示">
                非表示 (@(ViewModel.HiddenTagIds.Count + ViewModel.HiddenItemIds.Count)) を再表示
            </MudButton>
        }

        <MudButton Variant="@(ViewModel.IsEdgeCreationMode ? Variant.Filled : Variant.Outlined)"
                   Color="@(ViewModel.IsEdgeCreationMode ? Color.Warning : Color.Primary)" StartIcon="@Icons.Material.Filled.AltRoute"
                   OnClick="ToggleEdgeCreationModeAsync" Disabled="@(string.IsNullOrEmpty(ViewModel.CurrentUserId) || ViewModel.Tags.Count < 2)">
            @(ViewModel.IsEdgeCreationMode ? "エッジ作成中" : "エッジ作成モード")
        </MudButton>

        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AddLink"
                   OnClick="() => OpenCreateEdgeDialog(ViewModel.FocusedTag, ViewModel.SecondFocusedTag)"
                   Disabled="@(string.IsNullOrEmpty(ViewModel.CurrentUserId) || ViewModel.Tags.Count < 2)">
            Edge を作成
        </MudButton>

        <MudIconButton Icon="@Icons.Material.Filled.Refresh" Color="Color.Default" Title="再読み込み"
                       OnClick="() => ReloadDiagramAsync()" />
        <MudIconButton Icon="@Icons.Material.Filled.CenterFocusStrong" Color="Color.Default" Title="ズームリセット"
                       OnClick="ResetZoom" />
    </div>
</div>

@* フォーカス中タグのサマリーバー（複数タグ・始点/終点フォーカス対応） *@
<TagDiagramFocusBar FocusedTag="ViewModel.FocusedTag" SecondFocusedTag="ViewModel.SecondFocusedTag" AllTags="ViewModel.Tags" Edges="ViewModel.Edges"
                    IsEdgeCreationMode="ViewModel.IsEdgeCreationMode" CurrentUserId="@ViewModel.CurrentUserId" OnClearFirstTag="ClearFirstTag"
                    OnClearSecondTag="ClearSecondTag" OnClearFocus="ClearFocus" OnSwapFocusedTags="SwapFocusedTags"
                    OnShowChildNodes="HandleShowChildNodes" OnFocusTagFromTree="FocusTagFromHeaderTree"
                    OnAddChildTag="HandleAddChildTag" OnToggleEdgeCreationMode="ToggleEdgeCreationModeAsync"
                    OnOpenCreateEdgeDialog="args => OpenCreateEdgeDialog(args.Source, args.Target)" OnSelectEdge="HandleEdgeSelected"
                    OnSecondTagFocusedFromSearch="OnSecondTagFocusedFromSearch" OnHideFocusedTag="HandleHideTagNode" />

@* エッジ作成モードパネル（現在フォーカスを維持したまま子タグ同士・タグ間のエッジを形成・タグ付け） *@
<TagEdgeCreationPanel IsEdgeCreationMode="ViewModel.IsEdgeCreationMode" FocusedTag="ViewModel.FocusedTag" AllTags="ViewModel.Tags"
                      SourceTag="ViewModel.EdgeCreationSourceTag" TargetTag="ViewModel.EdgeCreationTargetTag" AttachTag="ViewModel.EdgeCreationAttachTag"
                      AttachAsset="ViewModel.EdgeCreationAttachAsset" AvailableAssets="ViewModel.EdgeCreationAvailableAssets" Weight="ViewModel.EdgeCreationWeight"
                      IsLoadingAttachAssets="ViewModel.IsLoadingAttachAssets" CanCreateEdge="ViewModel.CanCreateEdgeInMode"
                      OnCreateEdge="CreateEdgeInModeAsync" OnExitMode="ExitEdgeCreationMode"
                      OnSourceTagChanged="OnEdgeCreationSourceChanged" OnTargetTagChanged="OnEdgeCreationTargetChanged"
                      OnAttachTagChanged="OnEdgeCreationAttachTagChanged" OnWeightChanged="w => ViewModel.EdgeCreationWeight = w"
                      OnSwapTags="SwapEdgeCreationTags" OnSelectChildAsSource="SelectChildAsSource"
                      OnSelectChildAsTarget="SelectChildAsTarget" />

@if (ViewModel.IsLoading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
}
else
{
    <MudPaper Outlined="true" Class="d-flex diagram-workspace"
              Style="height: calc(100vh - 240px); min-height: 550px; position: relative; overflow: hidden;">
        <div class="flex-grow-1" style="height: 100%; position: relative;">
            <TagDiagramCanvas Diagram="_diagram" OnEdgeSelected="HandleEdgeSelected" OnNodeSelected="HandleNodeSelected" />
        </div>

        @if (ViewModel.SelectedEdge != null)
        {
            <div style="height: 100%; z-index: 10;">
                <TagEdgeInspector Edge="ViewModel.SelectedEdge" AllTags="ViewModel.Tags" CurrentUserId="@ViewModel.CurrentUserId" OnClose="CloseInspector"
                                  OnDeleteEdge="HandleDeleteEdge" OnAttachTag="HandleOpenAttachDialog" OnDetachTag="HandleDetachTag"
                                  OnAddChildTag="HandleAddChildTag" />
            </div>
        }
    </MudPaper>
}
