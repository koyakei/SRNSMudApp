@page "/auth/callback"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.WebUtilities
@inject NavigationManager NavigationManager
@inject IJSRuntime JS
<PageTitle>Authenticating...</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-8 text-center">
    <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large"/>
    <MudText Typo="Typo.h6" Class="mt-4">Completing authentication...</MudText>
</MudContainer>

@code {

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
            var query = QueryHelpers.ParseQuery(uri.Query);

            if (query.TryGetValue("code", out var code) && query.TryGetValue("provider", out var provider))
            {
                await JS.InvokeVoidAsync("console.log", $"[AuthCallback] Found code={code}, provider={provider}");

                // Call the JS function to post the code to our backend
                try
                {
                    await JS.InvokeVoidAsync("customAuth.loginWithToken", provider.ToString(), code.ToString());
                    await JS.InvokeVoidAsync("console.log", "[AuthCallback] InvokeVoidAsync completed");
                }
                catch (Exception ex)
                {
                    await JS.InvokeVoidAsync("console.error", $"[AuthCallback] JS interop error: {ex.Message}");
                    NavigationManager.NavigateTo("/Account/Login");
                }
            }
            else
            {
                await JS.InvokeVoidAsync("console.error", $"[AuthCallback] Missing code or provider in query. Query: {uri.Query}");
                NavigationManager.NavigateTo("/Account/Login");
            }
        }
    }

}
