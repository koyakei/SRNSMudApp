@page "/notifications"
@rendermode InteractiveServer
@using System.Security.Claims
@using SRNSMudApp.Models
@using SRNSMudApp.Services
@using MudBlazor
@using SRNSMudApp.Data
@using Microsoft.EntityFrameworkCore
@inject INotificationService NotificationService
@inject NavigationManager NavigationManager
@inject IHomeDataProvider HomeData
@inject INotificationsDataProvider NotificationsData
@inject TaggingContractService TaggingContractService
@inject ITaggingService TaggingService
@inject ISnackbar Snackbar
@inject IDialogLauncher DialogLauncher

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-4">
    <MudPaper Elevation="1" Class="pa-4">
        <MudText Typo="Typo.h5" Class="mb-4">通知</MudText>
        
        @if (_isLoading)
        {
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Class="mx-auto my-4 d-block" />
        }
        else if (_notifications.Count == 0)
        {
            <MudText Typo="Typo.body1" Align="Align.Center" Color="Color.Secondary" Class="pa-4">
                通知はありません
            </MudText>
        }
        else
        {
            <MudList T="NotificationDto" Clickable="false" Class="pa-0">
                @foreach (var notification in _notifications)
                {
                    <MudListItem T="NotificationDto" Class="px-0 py-3"
                                 Style="@(notification.IsRead ? "" : "background-color: var(--mud-palette-action-default); border-radius: 8px;")">
                        <div class="d-flex flex-column w-100 px-4">
                            <div class="d-flex flex-row align-center mb-2 cursor-pointer" @onclick="@(() => HandleNotificationClick(notification))">
                                <div class="mr-4">
                                    @if (Enum.TryParse<Color>(notification.Kind.IconColor, out var color))
                                    {
                                        <MudAvatar Color="color" Variant="Variant.Filled" Size="Size.Small">
                                            <MudIcon Icon="@notification.Kind.Icon" Size="Size.Small"/>
                                        </MudAvatar>
                                    }
                                    else
                                    {
                                        <MudAvatar Color="Color.Default" Variant="Variant.Filled" Size="Size.Small">
                                            <MudIcon Icon="@notification.Kind.Icon" Size="Size.Small" />
                                        </MudAvatar>
                                    }
                                </div>
                                <div class="d-flex flex-column flex-grow-1">
                                    <div class="d-flex justify-space-between w-100">
                                        <MudText Typo="Typo.subtitle2" Style="@(!notification.IsRead ? "font-weight: bold;" : "")">
                                            @notification.ActorName
                                        </MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                                            @GetRelativeTime(notification.CreatedAt)
                                        </MudText>
                                    </div>
                                    <MudText Typo="Typo.body2" Style="@(!notification.IsRead ? "font-weight: bold;" : "")">
                                        @notification.Message
                                    </MudText>
                                </div>
                            </div>
                            
                            @if (notification.AssociatedItem != null)
                            {
                                <div class="pl-11 mt-1">
                                    @if (notification.Kind is TagRequestNotification reqNote)
                                    {
                                        var isPending = reqNote.Status == TradeStatus.Proposed;
                                        // RequestInfoを動的に生成して渡す
                                        var reqInfo = new SRNSMudApp.Components.UI.RequestInfo
                                        {
                                            IsTaggingRequest = true,
                                            RequestType = reqNote.RequestType,
                                            ProposedWeight = reqNote.ProposedWeight,
                                            TargetItemId = reqNote.TargetItemId,
                                            TargetItemContent = notification.AssociatedItem?.Content,
                                            TargetTagId = reqNote.TargetTagId,
                                            TargetTagName = reqNote.TargetTagName,
                                            Status = reqNote.Status
                                        };
                                        <SRNSMudApp.Components.UI.RequestInfoAlert 
                                            RequestInfo="reqInfo"
                                            CanApprove="isPending"
                                            CanReject="isPending"
                                            OnApprove="@(() => ApproveRequestAsync(notification))"
                                            OnReject="@(() => RejectRequestAsync(notification))" />
                                    }
                                    @{
                                        var highlightEvents = new List<TimelineEvent>();
                                        if (notification.HighlightTagId.HasValue)
                                        {
                                            highlightEvents.Add(new TimelineEvent { EventType = "Update", FollowedTagId = notification.HighlightTagId.Value, OwnerId = _userId ?? "" });
                                        }
                                    }
                                    <SRNSMudApp.Components.UI.ItemCard Item="@notification.AssociatedItem"
                                                                           AllTags="@_allTags"
                                                                           AllTagRelationsToTags="@_allTagRelationsToTags"
                                                                           CurrentUserId="@_userId"
                                                                           CurrentUserGoodTagId="@_currentUserGoodTagId"
                                                                           CurrentUserBadTagId="@_currentUserBadTagId"
                                                                           OnEnsureSystemTags="EnsureSystemTagsExistAsync"
                                                                           HighlightEvents="highlightEvents" />
                                </div>
                            }
                        </div>
                    </MudListItem>
                    <MudDivider />
                }
            </MudList>
        }
    </MudPaper>
</MudContainer>

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthenticationStateTask { get; set; } = default!;

    private string? _userId;
    private List<NotificationDto> _notifications = new();
    private bool _isLoading = true;

    private List<Tag> _allTags = [];
    private List<TagRelationToTag> _allTagRelationsToTags = [];
    private int? _currentUserGoodTagId;
    private int? _currentUserBadTagId;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateTask;
        var user = authState.User;
        if (user.Identity?.IsAuthenticated == true)
        {
            _userId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;
            if (_userId != null)
            {
                _notifications = await NotificationService.GetUserNotificationsAsync(_userId);
                
                await FetchTagsAsync();
                await FetchAssociatedItemsAsync();
            }
        }
        _isLoading = false;
    }

    private async Task FetchTagsAsync()
    {
        (List<Tag> tags, List<TagRelationToTag> relations) = await HomeData.GetTagsAndRelationsAsync();
        _allTags = tags;
        _allTagRelationsToTags = relations;

        if (!string.IsNullOrEmpty(_userId))
        {
            var goodTag = _allTags.FirstOrDefault(t => t.OwnerId == _userId && t.Name == "good" && t.IsSystem);
            var badTag = _allTags.FirstOrDefault(t => t.OwnerId == _userId && t.Name == "bad" && t.IsSystem);
            _currentUserGoodTagId = goodTag?.Id;
            _currentUserBadTagId = badTag?.Id;
        }
    }

    private async Task FetchAssociatedItemsAsync()
    {
        var itemIds = _notifications
            .Where(n => n.AssociatedItemId != 0)
            .Select(n => n.AssociatedItemId)
            .Distinct()
            .ToList();

        if (!itemIds.Any()) return;

        List<Item> items = await NotificationsData.GetAssociatedItemsAsync(itemIds);

        var itemDict = items.ToDictionary(i => i.Id);
        foreach (var notification in _notifications)
        {
            if (notification.AssociatedItemId != 0 && itemDict.TryGetValue(notification.AssociatedItemId, out var item))
            {
                notification.AssociatedItem = item;
            }
        }
    }

    public async Task EnsureSystemTagsExistAsync()
    {
        if (string.IsNullOrEmpty(_userId)) return;
        if (_currentUserGoodTagId.HasValue && _currentUserBadTagId.HasValue) return;

        SystemTagsResult result = await HomeData.EnsureSystemTagsAsync(_userId);

        if (result.Created)
        {
            await FetchTagsAsync();
        }
        else
        {
            _currentUserGoodTagId = result.GoodTagId;
            _currentUserBadTagId = result.BadTagId;
        }
    }

    private async Task HandleNotificationClick(NotificationDto notification)
    {
        if (!notification.IsRead && _userId != null)
        {
            await NotificationService.MarkAsReadAsync(_userId, notification.SourceId, notification.Kind.SourceType);
        }
        NavigationManager.NavigateTo(notification.TargetUrl.ToHref());
    }

    private static string GetRelativeTime(DateTimeOffset dateTime)
    {
        var timeSpan = DateTimeOffset.UtcNow - dateTime;
        if (timeSpan <= TimeSpan.FromSeconds(60)) return $"{timeSpan.Seconds}秒前";
        if (timeSpan <= TimeSpan.FromMinutes(60)) return $"{timeSpan.Minutes}分前";
        if (timeSpan <= TimeSpan.FromHours(24)) return $"{timeSpan.Hours}時間前";
        return $"{timeSpan.Days}日前";
    }

    private async Task ApproveRequestAsync(NotificationDto notification)
    {
        if (_userId == null) return;
        try
        {
            await TaggingContractService.AcceptContractAsync(notification.SourceId, _userId);
            Snackbar.Add("リクエストを承認しました。", Severity.Success);
            
            // UIを更新
            if (notification.Kind is TagRequestNotification reqNote)
            {
                var index = _notifications.IndexOf(notification);
                if (index != -1)
                {
                    _notifications[index] = notification with 
                    { 
                        Kind = reqNote with { Status = TradeStatus.Executed },
                        IsRead = true 
                    };
                }
            }
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"エラー: {ex.Message}", Severity.Error);
        }
    }

    private async Task RejectRequestAsync(NotificationDto notification)
    {
        if (_userId == null) return;
        
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogLauncher.ShowAsync<SRNSMudApp.Components.UI.RejectRequestDialog>("リクエストを却下", options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            try
            {
                var comment = result.Data as string;
                await TaggingContractService.CancelContractAsync(notification.SourceId, _userId);
                Snackbar.Add("リクエストを却下しました。", Severity.Success);
                
                // UIを更新
                if (notification.Kind is TagRequestNotification reqNote)
                {
                    var index = _notifications.IndexOf(notification);
                    if (index != -1)
                    {
                        _notifications[index] = notification with 
                        { 
                            Kind = reqNote with { Status = TradeStatus.Rejected },
                            IsRead = true 
                        };
                    }
                }StateHasChanged();
            }
            catch (Exception ex)
            {
                Snackbar.Add($"エラー: {ex.Message}", Severity.Error);
            }
        }
    }
}
