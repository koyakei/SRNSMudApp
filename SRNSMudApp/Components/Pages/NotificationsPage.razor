@page "/notifications"
@attribute [Authorize]
@rendermode InteractiveServer
@using System.Security.Claims
@using SRNSMudApp.Components.UI
@using SRNSMudApp.Models
@using SRNSMudApp.Services
@using MudBlazor
@using SRNSMudApp.Data
@using Microsoft.EntityFrameworkCore

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-4">
    <MudPaper Elevation="1" Class="pa-4">
        <MudText Typo="Typo.h5" Class="mb-4">通知</MudText>
        
        @if (_isLoading)
        {
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Class="mx-auto my-4 d-block" />
        }
        else if (_notifications.Count == 0)
        {
            <MudText Typo="Typo.body1" Align="Align.Center" Color="Color.Secondary" Class="pa-4">
                通知はありません
            </MudText>
        }
        else
        {
            <MudList T="NotificationDto" Clickable="false" Class="pa-0">
                @foreach (var notification in _notifications)
                {
                    <MudListItem T="NotificationDto" Class="px-0 py-3"
                                 Style="@(notification.IsRead ? "" : "background-color: var(--mud-palette-action-default); border-radius: 8px;")">
                        <div class="d-flex flex-column w-100 px-4">
                            <div class="d-flex flex-row align-center mb-2 cursor-pointer" @onclick="@(() => HandleNotificationClick(notification))">
                                <div class="mr-4">
                                    @if (Enum.TryParse<Color>(notification.Kind.IconColor, out var color))
                                    {
                                        <MudAvatar Color="color" Variant="Variant.Filled" Size="Size.Small">
                                            <MudIcon Icon="@notification.Kind.Icon" Size="Size.Small"/>
                                        </MudAvatar>
                                    }
                                    else
                                    {
                                        <MudAvatar Color="Color.Default" Variant="Variant.Filled" Size="Size.Small">
                                            <MudIcon Icon="@notification.Kind.Icon" Size="Size.Small" />
                                        </MudAvatar>
                                    }
                                </div>
                                <div class="d-flex flex-column flex-grow-1">
                                    <div class="d-flex justify-space-between w-100">
                                        <MudText Typo="Typo.subtitle2" Style="@(!notification.IsRead ? "font-weight: bold;" : "")">
                                            @notification.ActorName
                                        </MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                                            @GetRelativeTime(notification.CreatedAt)
                                        </MudText>
                                    </div>
                                    <MudText Typo="Typo.body2" Style="@(!notification.IsRead ? "font-weight: bold;" : "")">
                                        @notification.Message
                                    </MudText>
                                </div>
                            </div>
                            
                            @if (notification.AssociatedItem != null)
                            {
                                <div class="pl-11 mt-1">
                                    @if (notification.Kind is TagRequestNotification reqNote)
                                    {
                                        var isPending = reqNote.Status == TradeStatus.Proposed;
                                        // RequestInfoを動的に生成して渡す
                                        var reqInfo = new SRNSMudApp.Components.UI.RequestInfo
                                        {
                                            IsTaggingRequest = true,
                                            RequestType = reqNote.RequestType,
                                            ProposedWeight = reqNote.ProposedWeight,
                                            TargetItemId = reqNote.TargetItemId,
                                            TargetItemContent = notification.AssociatedItem?.Content,
                                            TargetTagId = reqNote.TargetTagId,
                                            TargetTagName = reqNote.TargetTagName,
                                            Status = reqNote.Status
                                        };
                                        <SRNSMudApp.Components.UI.RequestInfoAlert 
                                            RequestInfo="reqInfo"
                                            CanApprove="isPending"
                                            CanReject="isPending"
                                            OnApprove="@(() => ApproveRequestAsync(notification))"
                                            OnReject="@(() => RejectRequestAsync(notification))" />
                                    }
                                    @{
                                        var highlightEvents = NotificationsViewModel.CreateHighlightEvents(notification, _userId);
                                    }
                                    <SRNSMudApp.Components.UI.ItemCard Item="@notification.AssociatedItem"
                                                                           AllTags="@_allTags"
                                                                           AllTagRelationsToTags="@_allTagRelationsToTags"
                                                                           CurrentUserId="@_userId"
                                                                           CurrentUserGoodTagId="@_currentUserGoodTagId"
                                                                           CurrentUserBadTagId="@_currentUserBadTagId"
                                                                           CurrentUserShinjiTagId="@_currentUserShinjiTagId"
                                                                           CurrentUserZenTagId="@_currentUserZenTagId"
                                                                           CurrentUserBiTagId="@_currentUserBiTagId"
                                                                           OnEnsureSystemTags="EnsureSystemTagsExistAsync"
                                                                           HighlightEvents="highlightEvents" />
                                </div>
                            }
                        </div>
                    </MudListItem>
                    <MudDivider />
                }
            </MudList>
        }
    </MudPaper>
</MudContainer>

