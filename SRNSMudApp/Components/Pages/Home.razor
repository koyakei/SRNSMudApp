@page "/"
@using System.Security.Claims

@rendermode InteractiveServer
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Home</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-4">
    @switch (_isLoggedIn)
    {
        case true:
            <MudText Typo="Typo.h5" GutterBottom="true" Class="mb-4">タイムライン</MudText>

            @switch (_followedTagIds)
            {
                case { Count: 0 }:
                    <MudAlert Severity="Severity.Info" Class="mb-4">
                        まだタグをフォローしていません。タグをフォローすると、ここにタイムラインが表示されます。
                    </MudAlert>
                    break;
                case not null:
                    <div style="height: 80vh; overflow-y: auto;">
                        <Virtualize ItemsProvider="LoadTimeline" Context="group" ItemComparer="new TimelineFeedGroupComparer()">
                            <ItemContent>
                                <div class="mb-4">
                                    @switch (System.Text.Json.JsonSerializer.Deserialize<SRNSMudApp.Models.Unions.TimelineTarget>(group.TimelineTargetJson))
                                    {
                                        case SRNSMudApp.Models.Unions.ItemTarget when group.Item != null:
                                            <SRNSMudApp.Components.UI.ItemCard Item="@group.Item"
                                                                                   AllTags="@_allTags"
                                                                                   AllTagRelationsToTags="@_allTagRelationsToTags"
                                                                                   CurrentUserId="@_currentUserId"
                                                                                   CurrentUserGoodTagId="@_currentUserGoodTagId"
                                                                                   CurrentUserBadTagId="@_currentUserBadTagId"
                                                                                   OnEnsureSystemTags="EnsureSystemTagsExistAsync"
                                                                                   HighlightEvents="@group.Events"
                                                                                   IsFocused="false"/>
                                            break;
                                        case SRNSMudApp.Models.Unions.TagTarget when group.Tag != null:
                                            <SRNSMudApp.Components.UI.TagCard Tag="@group.Tag"
                                                                                  AllTags="@_allTags"
                                                                                  CurrentUserId="@_currentUserId"
                                                                                  CurrentUserGoodTagId="@_currentUserGoodTagId"
                                                                                  CurrentUserBadTagId="@_currentUserBadTagId"
                                                                                  OnEnsureSystemTags="EnsureSystemTagsExistAsync"
                                                                                  HighlightEvents="@group.Events"
                                                                                  IsFocused="false"/>
                                            break;
                                    }
                                </div>
                            </ItemContent>
                            <Placeholder>
                                <MudCard Class="mb-4" Elevation="0" Outlined="true">
                                    <MudCardContent>
                                        <div class="d-flex justify-center align-center py-4">
                                            <MudProgressCircular Color="Color.Primary" Indeterminate="true"/>
                                        </div>
                                    </MudCardContent>
                                </MudCard>
                            </Placeholder>
                        </Virtualize>
                    </div>
                    break;
                case null:
                    break;
            }
            break;

        case false:
            <MudText Typo="Typo.h3" GutterBottom="true" Align="Align.Center" Class="mt-10">Welcome to SRNSMudApp</MudText>
            <MudText Align="Align.Center" Class="mb-8">
                ログインして、フォローしたタグのタイムラインを表示しましょう。
            </MudText>
            <div class="d-flex justify-center">
                <MudButton Color="Color.Primary" Variant="Variant.Filled" Href="/Account/Login" Size="Size.Large">
                    ログイン
                </MudButton>
            </div>
            break;
    }
</MudContainer>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private bool _isLoggedIn;
    private string _currentUserId = "";
    private List<int>? _followedTagIds;

    private List<Tag> _allTags = [];
    private List<TagRelationToTag> _allTagRelationsToTags = [];
    private int? _currentUserGoodTagId;
    private int? _currentUserBadTagId;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthState!;
        var user = authState.User;
        _isLoggedIn = user.Identity?.IsAuthenticated ?? false;

        await (_isLoggedIn switch
        {
            true => HandleLoggedInUserAsync(user),
            false => Task.CompletedTask
        });
    }

    private async Task HandleLoggedInUserAsync(ClaimsPrincipal user)
    {
        _currentUserId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? "";

        await (string.IsNullOrEmpty(_currentUserId) switch
        {
            false => LoadUserDataAsync(),
            true => Task.CompletedTask
        });
    }

    private async Task LoadUserDataAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _followedTagIds = await db.UserTagFollows!
            .Where(f => f.OwnerId == _currentUserId)
            .Select(f => f.TagId)
            .ToListAsync();

        await FetchTagsAsync();
    }

    private async Task FetchTagsAsync()
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        _allTags = await context.Tags
            .AsNoTracking()
            .ToListAsync();

        _allTagRelationsToTags = await context.TagRelationToTags
            .Include(tr => tr.Tag)
            .Include(tr => tr.TargetTag)
            .AsNoTracking()
            .ToListAsync();

        _ = string.IsNullOrEmpty(_currentUserId) switch
        {
            false => AssignSystemTags(),
            true => false
        };
    }

    private bool AssignSystemTags()
    {
        var goodTag = _allTags.FirstOrDefault(t => t.OwnerId == _currentUserId && t.Name == "good" && t.IsSystem);
        var badTag = _allTags.FirstOrDefault(t => t.OwnerId == _currentUserId && t.Name == "bad" && t.IsSystem);
        _currentUserGoodTagId = goodTag?.Id;
        _currentUserBadTagId = badTag?.Id;
        return true;
    }

    public async Task EnsureSystemTagsExistAsync()
    {
        await ((string.IsNullOrEmpty(_currentUserId), _currentUserGoodTagId.HasValue && _currentUserBadTagId.HasValue) switch
        {
            (false, false) => ExecuteEnsureSystemTagsAsync(),
            _ => Task.CompletedTask
        });
    }

    private async Task ExecuteEnsureSystemTagsAsync()
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        var goodTag = await context.Tags.FirstOrDefaultAsync(t => t.OwnerId == _currentUserId && t.Name == "good" && t.IsSystem);
        var badTag = await context.Tags.FirstOrDefaultAsync(t => t.OwnerId == _currentUserId && t.Name == "bad" && t.IsSystem);

        var created = false;
        _ = goodTag switch
        {
            null => (goodTag = new Tag { Name = "good", IsSystem = true, OwnerId = _currentUserId, CreatedDate = DateTime.UtcNow, UpdatedDate = DateTime.UtcNow }, context.Tags.Add(goodTag), created = true),
            _ => (null, null, false)
        };

        _ = badTag switch
        {
            null => (badTag = new Tag { Name = "bad", IsSystem = true, OwnerId = _currentUserId, CreatedDate = DateTime.UtcNow, UpdatedDate = DateTime.UtcNow }, context.Tags.Add(badTag), created = true),
            _ => (null, null, false)
        };

        await (created switch
        {
            true => SaveAndReloadTagsAsync(context),
            false => AssignExistingSystemTags(goodTag!, badTag!)
        });
    }

    private async Task SaveAndReloadTagsAsync(ApplicationDbContext context)
    {
        await context.SaveChangesAsync();
        await FetchTagsAsync(); // Reload all tags list
    }

    private Task AssignExistingSystemTags(Tag goodTag, Tag badTag)
    {
        _currentUserGoodTagId = goodTag.Id;
        _currentUserBadTagId = badTag.Id;
        return Task.CompletedTask;
    }

    public class TimelineFeedGroup
    {
        public string TimelineTargetJson { get; set; } = "";
        public DateTime LatestEventDate { get; set; }

        public Item? Item { get; set; }
        public Tag? Tag { get; set; }

        public List<TimelineEvent> Events { get; set; } = [];
    }

    private async ValueTask<ItemsProviderResult<TimelineFeedGroup>> LoadTimeline(ItemsProviderRequest request)
    {
        return await (_followedTagIds switch
        {
            null or { Count: 0 } => ValueTask.FromResult(new ItemsProviderResult<TimelineFeedGroup>(new List<TimelineFeedGroup>(), 0)),
            _ => LoadTimelineDataAsync(request)
        });
    }

    private async ValueTask<ItemsProviderResult<TimelineFeedGroup>> LoadTimelineDataAsync(ItemsProviderRequest request)
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        var query = db.TimelineEvents!
            .Where(e => _followedTagIds!.Contains(e.FollowedTagId));

        var groupedQuery = query
            .GroupBy(e => e.TimelineTargetJson)
            .Select(g => new
            {
                TimelineTargetJson = g.Key,
                LatestEventDate = g.Max(e => e.CreatedDate)
            })
            .OrderByDescending(g => g.LatestEventDate);

        var totalGroups = await groupedQuery.CountAsync();

        var pagedGroups = await groupedQuery
            .Skip(request.StartIndex)
            .Take(request.Count)
            .ToListAsync();

        var feedGroups = new List<TimelineFeedGroup>();
        foreach (var pg in pagedGroups)
        {
            var feedGroup = new TimelineFeedGroup
            {
                TimelineTargetJson = pg.TimelineTargetJson,
                LatestEventDate = pg.LatestEventDate,
                Events = await db.TimelineEvents!
                    .Where(e => _followedTagIds!.Contains(e.FollowedTagId) && e.TimelineTargetJson == pg.TimelineTargetJson)
                    .Include(e => e.FollowedTag)
                    .AsNoTracking()
                    .ToListAsync()
            };

            var target = feedGroup.Events.FirstOrDefault()?.Target;
            await (target switch
            {
                SRNSMudApp.Models.Unions.ItemTarget it => LoadItemForFeedGroupAsync(db, feedGroup, it.TargetItemId),
                SRNSMudApp.Models.Unions.TagTarget tt => LoadTagForFeedGroupAsync(db, feedGroup, tt.TargetTagId),
                _ => Task.CompletedTask
            });

            switch (feedGroup.Item != null || feedGroup.Tag != null)
            {
                case true:
                    feedGroups.Add(feedGroup);
                    break;
                case false:
                    break;
            }
        }

        return new ItemsProviderResult<TimelineFeedGroup>(feedGroups, totalGroups);
    }

    private async Task LoadItemForFeedGroupAsync(ApplicationDbContext db, TimelineFeedGroup feedGroup, int targetId)
    {
        feedGroup.Item = await db.Items!
            .Include(i => i.Owner)
            .Include(i => i.TagRelations)
            .ThenInclude(tr => tr.Tag)
            .ThenInclude(t => t.Owner)
            .AsNoTracking()
            .FirstOrDefaultAsync(i => i.Id == targetId);
    }

    private async Task LoadTagForFeedGroupAsync(ApplicationDbContext db, TimelineFeedGroup feedGroup, int targetId)
    {
        feedGroup.Tag = await db.Tags!
            .Include(t => t.Owner)
            .Include(t => t.TargetTagRelations!)
            .ThenInclude(tr => tr.Tag)
            .ThenInclude(t => t.Owner)
            .AsNoTracking()
            .FirstOrDefaultAsync(t => t.Id == targetId);
    }

    private class TimelineFeedGroupComparer : IEqualityComparer<TimelineFeedGroup>
    {
        public bool Equals(TimelineFeedGroup? x, TimelineFeedGroup? y)
        {
            return x?.TimelineTargetJson == y?.TimelineTargetJson;
        }

        public int GetHashCode(TimelineFeedGroup obj)
        {
            return HashCode.Combine(obj.TimelineTargetJson);
        }
    }

}