@page "/"
@using System.Security.Claims
@using SRNSMudApp.Services

@rendermode InteractiveServer
@inject IHomeDataProvider HomeData
@inject NavigationManager NavigationManager

<PageTitle>Home</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-4">
    @switch (_isLoggedIn)
    {
        case true:
            <MudText Typo="Typo.h5" GutterBottom="true" Class="mb-4">タイムライン</MudText>

            @switch (_followedTagIds)
            {
                case { Count: 0 }:
                    <MudAlert Severity="Severity.Info" Class="mb-4">
                        まだタグをフォローしていません。タグをフォローすると、ここにタイムラインが表示されます。
                    </MudAlert>
                    break;
                case not null:
                    <div style="height: 80vh; overflow-y: auto;">
                        <Virtualize ItemsProvider="LoadTimeline" Context="group" ItemComparer="new TimelineFeedGroupComparer()">
                            <ItemContent>
                                <div class="mb-4">
                                    @switch (System.Text.Json.JsonSerializer.Deserialize<SRNSMudApp.Models.Unions.TimelineTarget>(group.TimelineTargetJson))
                                    {
                                        case SRNSMudApp.Models.Unions.ItemTarget when group.Item != null:
                                            <SRNSMudApp.Components.UI.ItemCard Item="@group.Item"
                                                                                   AllTags="@_allTags"
                                                                                   AllTagRelationsToTags="@_allTagRelationsToTags"
                                                                                   CurrentUserId="@_currentUserId"
                                                                                   CurrentUserGoodTagId="@_currentUserGoodTagId"
                                                                                   CurrentUserBadTagId="@_currentUserBadTagId"
                                                                                   OnEnsureSystemTags="EnsureSystemTagsExistAsync"
                                                                                   HighlightEvents="@group.Events"
                                                                                   IsFocused="false"/>
                                            break;
                                        case SRNSMudApp.Models.Unions.TagTarget when group.Tag != null:
                                            <SRNSMudApp.Components.UI.TagCard Tag="@group.Tag"
                                                                                  AllTags="@_allTags"
                                                                                  CurrentUserId="@_currentUserId"
                                                                                  CurrentUserGoodTagId="@_currentUserGoodTagId"
                                                                                  CurrentUserBadTagId="@_currentUserBadTagId"
                                                                                  OnEnsureSystemTags="EnsureSystemTagsExistAsync"
                                                                                  HighlightEvents="@group.Events"
                                                                                  IsFocused="false"/>
                                            break;
                                    }
                                </div>
                            </ItemContent>
                            <Placeholder>
                                <MudCard Class="mb-4" Elevation="0" Outlined="true">
                                    <MudCardContent>
                                        <div class="d-flex justify-center align-center py-4">
                                            <MudProgressCircular Color="Color.Primary" Indeterminate="true"/>
                                        </div>
                                    </MudCardContent>
                                </MudCard>
                            </Placeholder>
                        </Virtualize>
                    </div>
                    break;
                case null:
                    break;
            }
            break;

        case false:
            <MudText Typo="Typo.h3" GutterBottom="true" Align="Align.Center" Class="mt-10">Welcome to SRNSMudApp</MudText>
            <MudText Align="Align.Center" Class="mb-8">
                ログインして、フォローしたタグのタイムラインを表示しましょう。
            </MudText>
            <div class="d-flex justify-center">
                <MudButton Color="Color.Primary" Variant="Variant.Filled" Href="/Account/Login" Size="Size.Large">
                    ログイン
                </MudButton>
            </div>
            break;
    }
</MudContainer>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private bool _isLoggedIn;
    private string _currentUserId = "";
    private List<int>? _followedTagIds;

    private List<Tag> _allTags = [];
    private List<TagRelationToTag> _allTagRelationsToTags = [];
    private int? _currentUserGoodTagId;
    private int? _currentUserBadTagId;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthState!;
        var user = authState.User;
        _isLoggedIn = user.Identity?.IsAuthenticated ?? false;

        await (_isLoggedIn switch
        {
            true => HandleLoggedInUserAsync(user),
            false => Task.CompletedTask
        });
    }

    private async Task HandleLoggedInUserAsync(ClaimsPrincipal user)
    {
        _currentUserId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? "";

        await (string.IsNullOrEmpty(_currentUserId) switch
        {
            false => LoadUserDataAsync(),
            true => Task.CompletedTask
        });
    }

    private async Task LoadUserDataAsync()
    {
        _followedTagIds = await HomeData.GetFollowedTagIdsAsync(_currentUserId);

        await FetchTagsAsync();
    }

    private async Task FetchTagsAsync()
    {
        (List<Tag> tags, List<TagRelationToTag> relations) = await HomeData.GetTagsAndRelationsAsync();
        _allTags = tags;
        _allTagRelationsToTags = relations;

        _ = string.IsNullOrEmpty(_currentUserId) switch
        {
            false => AssignSystemTags(),
            true => false
        };
    }

    private bool AssignSystemTags()
    {
        var goodTag = _allTags.FirstOrDefault(t => t.OwnerId == _currentUserId && t.Name == "good" && t.IsSystem);
        var badTag = _allTags.FirstOrDefault(t => t.OwnerId == _currentUserId && t.Name == "bad" && t.IsSystem);
        _currentUserGoodTagId = goodTag?.Id;
        _currentUserBadTagId = badTag?.Id;
        return true;
    }

    public async Task EnsureSystemTagsExistAsync()
    {
        await ((string.IsNullOrEmpty(_currentUserId), _currentUserGoodTagId.HasValue && _currentUserBadTagId.HasValue) switch
        {
            (false, false) => ExecuteEnsureSystemTagsAsync(),
            _ => Task.CompletedTask
        });
    }

    private async Task ExecuteEnsureSystemTagsAsync()
    {
        SystemTagsResult result = await HomeData.EnsureSystemTagsAsync(_currentUserId);

        switch (result.Created)
        {
            case true:
                await FetchTagsAsync(); // Reload all tags list
                break;
            case false:
                _currentUserGoodTagId = result.GoodTagId;
                _currentUserBadTagId = result.BadTagId;
                break;
        }
    }

    private async ValueTask<ItemsProviderResult<TimelineFeedGroup>> LoadTimeline(ItemsProviderRequest request)
    {
        return await (_followedTagIds switch
        {
            null or { Count: 0 } => ValueTask.FromResult(new ItemsProviderResult<TimelineFeedGroup>(new List<TimelineFeedGroup>(), 0)),
            _ => LoadTimelineDataAsync(request)
        });
    }

    private async ValueTask<ItemsProviderResult<TimelineFeedGroup>> LoadTimelineDataAsync(ItemsProviderRequest request)
    {
        HomeTimelinePage page =
            await HomeData.LoadTimelineAsync(_followedTagIds!, request.StartIndex, request.Count);
        return new ItemsProviderResult<TimelineFeedGroup>(page.Groups, page.TotalCount);
    }

    private class TimelineFeedGroupComparer : IEqualityComparer<TimelineFeedGroup>
    {
        public bool Equals(TimelineFeedGroup? x, TimelineFeedGroup? y)
        {
            return x?.TimelineTargetJson == y?.TimelineTargetJson;
        }

        public int GetHashCode(TimelineFeedGroup obj)
        {
            return HashCode.Combine(obj.TimelineTargetJson);
        }
    }

}