@namespace SRNSMudApp.Components.Diagram
@using Blazor.Diagrams.Core.Models
@using Blazor.Diagrams.Components.Renderers
@using SRNSMudApp.Components.UI
@using SRNSMudApp.Models

<div class="item-node @(Node.Selected ? "selected" : "") @(Node.IsExpanded ? "expanded" : "")" @onclick="OnClick">
    @if (Node.IsExpanded)
    {
        <div class="expanded-card-container" @onclick:stopPropagation="true">
            <div class="d-flex justify-end align-center p-1"
                 style="background: var(--mud-palette-surface); border-bottom: 1px solid var(--mud-palette-lines-default);">
                <MudIconButton Icon="@Icons.Material.Filled.Compress" Size="Size.Small" OnClick="ToggleExpand"
                               Class="item-compress-button" />
                <span @onclick:stopPropagation="true" @onpointerdown:stopPropagation="true" @onmousedown:stopPropagation="true">
                    <MudTooltip Text="アイテム詳細へ遷移">
                        <MudIconButton Icon="@Icons.Material.Filled.OpenInNew" Size="Size.Small" Color="Color.Default"
                                       Class="ml-1 item-detail-button" Title="アイテム詳細へ遷移" Href="@($"/ItemDetail/{Node.Item.Id}")" />
                    </MudTooltip>
                </span>
                <span @onclick:stopPropagation="true" @onpointerdown:stopPropagation="true" @onmousedown:stopPropagation="true" @onpointerup:stopPropagation="true" @onmouseup:stopPropagation="true">
                    <MudTooltip Text="画面表示から消す">
                        <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" Color="Color.Default"
                                       Class="ml-1 item-hide-node-button" Title="画面表示から消す" OnClick="HandleHideNode" />
                    </MudTooltip>
                </span>
            </div>
            <ItemCard Item="Node.Item" EnableNavigation="true" />
        </div>
    }
    else
    {
        <MudPaper Elevation="Node.Selected ? 4 : 1" Class="pa-2 item-paper">
            <div class="d-flex align-center">
                <MudIcon Icon="@Icons.Material.Filled.Description" Size="Size.Small" Class="mr-2 flex-shrink-0" />
                <div class="item-content flex-grow-1">
                    @foreach (var segment in ItemNodeViewModel.GetTruncatedSegments(Node.Item.Content))
                    {
                        @if (segment.IsUrl)
                        {
                            <span @onclick:stopPropagation="true">
                                <UrlPreviewCard Url="@segment.Text" LoadPreview="@GetPreviewAsync" />
                            </span>
                        }
                        else
                        {
                            <MudText Typo="Typo.body2" Class="d-inline font-inherit">@segment.Text</MudText>
                        }
                    }
                </div>
                <MudIconButton Icon="@Icons.Material.Filled.ExpandMore" Size="Size.Small" OnClick="ToggleExpand"
                               Class="ml-auto flex-shrink-0 item-expand-button" />
                <span @onclick:stopPropagation="true" @onpointerdown:stopPropagation="true" @onmousedown:stopPropagation="true">
                    <MudTooltip Text="アイテム詳細へ遷移">
                        <MudIconButton Icon="@Icons.Material.Filled.OpenInNew" Size="Size.Small" Color="Color.Default"
                                       Class="ml-1 flex-shrink-0 item-detail-button" Title="アイテム詳細へ遷移"
                                       Href="@($"/ItemDetail/{Node.Item.Id}")" />
                    </MudTooltip>
                </span>
                <span @onclick:stopPropagation="true" @onpointerdown:stopPropagation="true" @onmousedown:stopPropagation="true" @onpointerup:stopPropagation="true" @onmouseup:stopPropagation="true">
                    <MudTooltip Text="画面表示から消す">
                        <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" Color="Color.Default"
                                       Class="ml-1 flex-shrink-0 item-hide-node-button" Title="画面表示から消す"
                                       OnClick="HandleHideNode" />
                    </MudTooltip>
                </span>
            </div>
        </MudPaper>
    }

    @foreach (var port in Node.Ports)
    {
        <PortRenderer Port="port" />
    }
</div>
