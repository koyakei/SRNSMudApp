@namespace SRNSMudApp.Components.Diagram
@using Blazor.Diagrams.Components.Renderers
@using SRNSMudApp.Components.Tag

<div
    class="tag-node @(Node.Selected ? "selected" : "") @(Node.IsFocused ? "focused" : "") @(Node.FocusRole == TagFocusRole.Source ? "focused-source" : "") @(Node.FocusRole == TagFocusRole.Target ? "focused-target" : "")">
    <div class="tag-node-header d-flex align-center">
        @if (Node.FocusRole == TagFocusRole.Source)
        {
            <MudTooltip Text="始点 (Source)">
                <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Filled"
                         Class="mr-1 pa-1 font-weight-bold tag-role-chip" Style="height: 20px; min-width: 20px;">
                    ①
                </MudChip>
            </MudTooltip>
        }
        else if (Node.FocusRole == TagFocusRole.Target)
        {
            <MudTooltip Text="終点 (Target)">
                <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Filled"
                         Class="mr-1 pa-1 font-weight-bold tag-role-chip" Style="height: 20px; min-width: 20px;">
                    ②
                </MudChip>
            </MudTooltip>
        }
        else if (Node.IsFocused)
        {
            <MudIcon Icon="@Icons.Material.Filled.CenterFocusStrong" Size="Size.Small" Color="Color.Warning" Class="mr-1"
                     Title="Focused" />
        }
        else
        {
            <MudIcon Icon="@Icons.Material.Filled.LocalOffer" Size="Size.Small" Color="Color.Primary" Class="mr-1" />
        }
        <span class="tag-node-name font-weight-bold">@Node.Tag.Name</span>
        <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Variant="Variant.Filled"
                 Class="ml-1 px-1 tag-weight-chip">
            @Node.Tag.CachedWeight
        </MudChip>
        <span @onclick:stopPropagation="true" @onpointerdown:stopPropagation="true" @onmousedown:stopPropagation="true">
            <MudTooltip Text="@(Node.ChildCount > 0 ? $"子タグ ({Node.ChildCount}件) を画面上に表示" : "子タグはありません")">
                <MudIconButton Icon="@Icons.Material.Filled.SubdirectoryArrowRight" Size="Size.Small"
                               Color="@(Node.IsFocused ? Color.Warning : Color.Primary)" Class="pa-0 ml-1 tag-show-children-button"
                               Title="@(Node.ChildCount > 0 ? $"子タグ ({Node.ChildCount}件) を画面上に表示" : "子タグはありません")"
                               Disabled="@(Node.ChildCount == 0)" OnClick="HandleShowChildNodes" />
            </MudTooltip>
        </span>
        <span @onclick:stopPropagation="true" @onpointerdown:stopPropagation="true" @onmousedown:stopPropagation="true">
            <MudIconButton Icon="@Icons.Material.Filled.AccountTree" Size="Size.Small" Color="Color.Default"
                           Class="pa-0 ml-1 tag-tree-button" Title="タグツリーを表示" OnClick="ToggleTree" />
        </span>
        <span @onclick:stopPropagation="true" @onpointerdown:stopPropagation="true" @onmousedown:stopPropagation="true">
            <MudTooltip Text="タグ詳細へ遷移">
                <MudIconButton Icon="@Icons.Material.Filled.OpenInNew" Size="Size.Small" Color="Color.Default"
                               Class="pa-0 ml-1 tag-detail-button" Title="タグ詳細へ遷移" OnClick="NavigateToTagDetail" />
            </MudTooltip>
        </span>
        <span @onclick:stopPropagation="true" @onpointerdown:stopPropagation="true" @onmousedown:stopPropagation="true" @onpointerup:stopPropagation="true" @onmouseup:stopPropagation="true">
            <MudTooltip Text="画面表示から消す">
                <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" Color="Color.Default"
                               Class="pa-0 ml-1 tag-hide-node-button" Title="画面表示から消す" OnClick="HandleHideNode" />
            </MudTooltip>
        </span>
    </div>
    @foreach (var port in Node.Ports)
    {
        <PortRenderer @key="port" Port="port" Class="@GetPortClass(port.Alignment)" />
    }

    <MudOverlay Visible="@_isTreeOpen" OnClick="@(() => _isTreeOpen = false)" AutoClose="true" DarkBackground="false" />
    <MudPopover Open="@_isTreeOpen" AnchorOrigin="Origin.BottomCenter" TransformOrigin="Origin.TopCenter"
                OverflowBehavior="OverflowBehavior.FlipAlways" Class="tree-popover" Paper="false">
        <TagTreePopoverContent TargetTag="@Node.Tag" AllTags="@Node.AllTags" EnableSwap="false" EnableExpand="true"
                               EnableNavigation="true" OnTagClick="HandleTagClick" EnableAddChild="true"
                               OnAddChildTag="HandleAddChildTag" />
    </MudPopover>
</div>

