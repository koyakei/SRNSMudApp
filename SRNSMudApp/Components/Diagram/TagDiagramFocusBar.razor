@using SRNSMudApp.Components.Tag
@using SRNSMudApp.Data
@using TagEntity = SRNSMudApp.Data.Tag

@if (FocusedTag != null)
{
    <MudPaper Elevation="1"
              Class="px-3 py-2 mb-2 d-flex flex-wrap align-center justify-space-between gap-2 border-l-4 border-warning">
        <div class="d-flex flex-wrap align-center gap-2">
            @* 始点タグ (Tag 1) *@
            <div class="d-flex align-center gap-1">
                <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Filled" Class="font-weight-bold">
                    ① 始点
                </MudChip>
                <MudText Typo="Typo.subtitle2" Class="font-weight-bold">
                    @FocusedTag.Name
                </MudText>
                <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Variant="Variant.Filled">
                    W: @FocusedTag.CachedWeight
                </MudChip>
                <MudTooltip Text="@(GetChildTagsCount(FocusedTag.Id) > 0 ? $"子タグ ({GetChildTagsCount(FocusedTag.Id)}件) を画面上に表示" : "子タグはありません")">
                    <MudIconButton Icon="@Icons.Material.Filled.SubdirectoryArrowRight" Size="Size.Small" Color="Color.Warning"
                                   Class="pa-0 ml-1" Title="子タグを画面上に表示"
                                   Disabled="@(GetChildTagsCount(FocusedTag.Id) == 0)"
                                   OnClick="() => OnShowChildNodes.InvokeAsync(FocusedTag)" />
                </MudTooltip>
                <MudIconButton Icon="@Icons.Material.Filled.AccountTree" Size="Size.Small" Color="Color.Default"
                               Class="pa-0 ml-1" Title="始点タグのツリーを表示" OnClick="() => _isFocusTreeOpen = !_isFocusTreeOpen" />
                <MudOverlay Visible="@_isFocusTreeOpen" OnClick="@(() => _isFocusTreeOpen = false)" AutoClose="true"
                            DarkBackground="false" />
                <MudPopover Open="@_isFocusTreeOpen" AnchorOrigin="Origin.BottomCenter" TransformOrigin="Origin.TopCenter"
                            OverflowBehavior="OverflowBehavior.FlipAlways" Class="tree-popover" Paper="false">
                    <TagTreePopoverContent TargetTag="@FocusedTag" AllTags="@AllTags" EnableSwap="false" EnableExpand="true"
                                           EnableNavigation="true" OnTagClick="HandleFocusFromTree"
                                           EnableAddChild="true" OnAddChildTag="tag => OnAddChildTag.InvokeAsync(tag)" />
                </MudPopover>
                <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" Color="Color.Default"
                               Class="pa-0" Title="始点タグを解除" OnClick="() => OnClearFirstTag.InvokeAsync()" />
            </div>

            @* 向き / 反転 (Swap) ボタン *@
            @if (SecondFocusedTag != null)
            {
                <MudTooltip Text="始点と終点を入れ替える">
                    <MudIconButton Icon="@Icons.Material.Filled.SwapHoriz" Size="Size.Small" Color="Color.Primary"
                                   OnClick="() => OnSwapFocusedTags.InvokeAsync()" Title="入れ替え" />
                </MudTooltip>
            }
            else
            {
                <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" Color="Color.Secondary" Class="mx-1" />
            }

            @* 終点タグ (Tag 2) *@
            @if (SecondFocusedTag != null)
            {
                <div class="d-flex align-center gap-1">
                    <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Filled" Class="font-weight-bold">
                        ② 終点
                    </MudChip>
                    <MudText Typo="Typo.subtitle2" Class="font-weight-bold">
                        @SecondFocusedTag.Name
                    </MudText>
                    <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Variant="Variant.Filled">
                        W: @SecondFocusedTag.CachedWeight
                    </MudChip>
                    <MudTooltip Text="@(GetChildTagsCount(SecondFocusedTag.Id) > 0 ? $"子タグ ({GetChildTagsCount(SecondFocusedTag.Id)}件) を画面上に表示" : "子タグはありません")">
                        <MudIconButton Icon="@Icons.Material.Filled.SubdirectoryArrowRight" Size="Size.Small" Color="Color.Info"
                                       Class="pa-0 ml-1" Title="子タグを画面上に表示"
                                       Disabled="@(GetChildTagsCount(SecondFocusedTag.Id) == 0)"
                                       OnClick="() => OnShowChildNodes.InvokeAsync(SecondFocusedTag)" />
                    </MudTooltip>
                    <MudIconButton Icon="@Icons.Material.Filled.AccountTree" Size="Size.Small" Color="Color.Default"
                                   Class="pa-0 ml-1" Title="終点タグのツリーを表示" OnClick="() => _isSecondFocusTreeOpen = !_isSecondFocusTreeOpen" />
                    <MudOverlay Visible="@_isSecondFocusTreeOpen" OnClick="@(() => _isSecondFocusTreeOpen = false)" AutoClose="true"
                                DarkBackground="false" />
                    <MudPopover Open="@_isSecondFocusTreeOpen" AnchorOrigin="Origin.BottomCenter" TransformOrigin="Origin.TopCenter"
                                OverflowBehavior="OverflowBehavior.FlipAlways" Class="tree-popover" Paper="false">
                        <TagTreePopoverContent TargetTag="@SecondFocusedTag" AllTags="@AllTags" EnableSwap="false" EnableExpand="true"
                                               EnableNavigation="true" OnTagClick="HandleFocusFromTree"
                                               EnableAddChild="true" OnAddChildTag="tag => OnAddChildTag.InvokeAsync(tag)" />
                    </MudPopover>
                    <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" Color="Color.Default"
                                   Class="pa-0" Title="終点タグを解除" OnClick="() => OnClearSecondTag.InvokeAsync()" />
                </div>
            }
            else
            {
                <div class="d-flex align-center gap-1">
                    <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined">
                        ② 終点: 未選択
                    </MudChip>
                    <div style="min-width: 220px; max-width: 280px;">
                        <TagAutocomplete Value="SecondFocusedTag" ValueChanged="tag => OnSecondTagFocusedFromSearch.InvokeAsync(tag)"
                                         Label="2つ目のタグを検索 (終点)" Placeholder="タグ名で検索..."
                                         Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" />
                    </div>
                </div>
            }
        </div>

        <div class="d-flex align-center gap-2">
            @if (SecondFocusedTag != null)
            {
                var existingEdge = GetExistingEdgeBetween(FocusedTag.Id, SecondFocusedTag.Id);
                @if (existingEdge != null)
                {
                    <MudChip T="string" Size="Size.Small" Color="@(existingEdge.SourceTagId == FocusedTag.Id ? Color.Info : Color.Warning)" Variant="Variant.Outlined">
                        @(existingEdge.SourceTagId == FocusedTag.Id ? "既存 Edge あり (①→②)" : "逆方向 Edge あり (②→①)")
                    </MudChip>
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Timeline" OnClick="() => OnSelectEdge.InvokeAsync(existingEdge)">
                        Edge を選択
                    </MudButton>
                }
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.AddLink"
                           OnClick="() => OnOpenCreateEdgeDialog.InvokeAsync((FocusedTag, SecondFocusedTag))"
                           Disabled="@string.IsNullOrEmpty(CurrentUserId)">
                    この2つのタグ間に Edge を作成
                </MudButton>
            }
            else
            {
                <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.AddLink" OnClick="() => OnOpenCreateEdgeDialog.InvokeAsync((FocusedTag, null))"
                           Disabled="@string.IsNullOrEmpty(CurrentUserId)">
                    このタグから Edge 作成
                </MudButton>
            }

            <MudButton Variant="@(IsEdgeCreationMode ? Variant.Filled : Variant.Outlined)"
                       Color="@(IsEdgeCreationMode ? Color.Warning : Color.Primary)" Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.AltRoute" OnClick="() => OnToggleEdgeCreationMode.InvokeAsync()"
                       Disabled="@string.IsNullOrEmpty(CurrentUserId)">
                @(IsEdgeCreationMode ? "エッジ作成中" : "エッジ作成モード")
            </MudButton>

            <MudButton Variant="Variant.Text" Color="Color.Default" Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.Close" OnClick="() => OnClearFocus.InvokeAsync()">
                フォーカス解除
            </MudButton>
        </div>
    </MudPaper>
}

@code {
    [Parameter] public TagEntity? FocusedTag { get; set; }
    [Parameter] public TagEntity? SecondFocusedTag { get; set; }
    [Parameter] public IReadOnlyList<TagEntity> AllTags { get; set; } = [];
    [Parameter] public IReadOnlyList<TagEdge> Edges { get; set; } = [];
    [Parameter] public bool IsEdgeCreationMode { get; set; }
    [Parameter] public string CurrentUserId { get; set; } = "";

    [Parameter] public EventCallback OnClearFirstTag { get; set; }
    [Parameter] public EventCallback OnClearSecondTag { get; set; }
    [Parameter] public EventCallback OnClearFocus { get; set; }
    [Parameter] public EventCallback OnSwapFocusedTags { get; set; }
    [Parameter] public EventCallback<TagEntity> OnShowChildNodes { get; set; }
    [Parameter] public EventCallback<int> OnFocusTagFromTree { get; set; }
    [Parameter] public EventCallback<TagEntity?> OnAddChildTag { get; set; }
    [Parameter] public EventCallback OnToggleEdgeCreationMode { get; set; }
    [Parameter] public EventCallback<(TagEntity? Source, TagEntity? Target)> OnOpenCreateEdgeDialog { get; set; }
    [Parameter] public EventCallback<TagEdge> OnSelectEdge { get; set; }
    [Parameter] public EventCallback<TagEntity?> OnSecondTagFocusedFromSearch { get; set; }

    private bool _isFocusTreeOpen;
    private bool _isSecondFocusTreeOpen;

    private async Task HandleFocusFromTree(int tagId)
    {
        _isFocusTreeOpen = false;
        _isSecondFocusTreeOpen = false;
        await OnFocusTagFromTree.InvokeAsync(tagId);
    }

    private int GetChildTagsCount(int tagId) =>
        AllTags.Count(t => t.ParentTagId == tagId);

    private TagEdge? GetExistingEdgeBetween(int tagId1, int tagId2) =>
        Edges.FirstOrDefault(e =>
            (e.SourceTagId == tagId1 && e.TargetTagId == tagId2) ||
            (e.SourceTagId == tagId2 && e.TargetTagId == tagId1));
}
