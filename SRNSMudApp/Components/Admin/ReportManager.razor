@page "/Admin/Reports"
@using System.Security.Claims
@using SRNSMudApp.Data
@using SRNSMudApp.Services
@using SRNSMudApp.Services.Dialogs
@attribute [Authorize(Roles = "Admin")]
@inject IContentReportService ContentReportService
@inject IDialogLauncher DialogLauncher
@inject ISnackbar Snackbar

<PageTitle>通報管理 (Reports)</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">
    <MudIcon Icon="@Icons.Material.Filled.Report" Class="mr-2 align-middle" />
    不適切な投稿の通報管理
</MudText>
<MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
    ユーザーから送信された不適切なアイテム・タグの通報一覧です。内容を確認し、処置や却下を行ってください。
</MudText>

<MudPaper Class="pa-4 mb-4" Elevation="1">
    <MudGrid>
        <MudItem xs="12" md="4">
            <MudSelect T="ReportStatus?"
                       Label="ステータス絞り込み"
                       Value="_selectedStatus"
                       ValueChanged="OnStatusFilterChangedAsync"
                       Variant="Variant.Outlined"
                       Dense="true">
                <MudSelectItem Value="@((ReportStatus?)null)">すべてのステータス</MudSelectItem>
                <MudSelectItem Value="@((ReportStatus?)ReportStatus.Pending)">未対応 (Pending)</MudSelectItem>
                <MudSelectItem Value="@((ReportStatus?)ReportStatus.ActionTaken)">処置済み (ActionTaken)</MudSelectItem>
                <MudSelectItem Value="@((ReportStatus?)ReportStatus.Reviewed)">確認済み (Reviewed)</MudSelectItem>
                <MudSelectItem Value="@((ReportStatus?)ReportStatus.Dismissed)">却下 (Dismissed)</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="12" md="4">
            <MudSelect T="ReportTargetType?"
                       Label="対象種別絞り込み"
                       Value="_selectedTargetType"
                       ValueChanged="OnTargetTypeFilterChangedAsync"
                       Variant="Variant.Outlined"
                       Dense="true">
                <MudSelectItem Value="@((ReportTargetType?)null)">すべての対象種別</MudSelectItem>
                <MudSelectItem Value="@((ReportTargetType?)ReportTargetType.Item)">アイテムのみ</MudSelectItem>
                <MudSelectItem Value="@((ReportTargetType?)ReportTargetType.Tag)">タグのみ</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="12" md="4" Class="d-flex align-center justify-end">
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Refresh"
                       OnClick="LoadReportsAsync"
                       Disabled="_isLoading">
                再読み込み
            </MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

<MudTable Items="@_reports" Hover="true" Dense="true" Elevation="1" Loading="@_isLoading" LoadingProgressColor="Color.Primary">
    <HeaderContent>
        <MudTh>ID</MudTh>
        <MudTh>通報日時</MudTh>
        <MudTh>種別</MudTh>
        <MudTh>通報対象 (内容スナップショット)</MudTh>
        <MudTh>通報理由</MudTh>
        <MudTh>通報者</MudTh>
        <MudTh>ステータス</MudTh>
        <MudTh>対応</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="ID">@context.Id</MudTd>
        <MudTd DataLabel="通報日時">@context.CreatedDate.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</MudTd>
        <MudTd DataLabel="種別">
            @if (context.TargetType == ReportTargetType.Item)
            {
                <MudChip T="string" Color="Color.Primary" Size="Size.Small" Variant="Variant.Outlined">アイテム</MudChip>
            }
            else
            {
                <MudChip T="string" Color="Color.Secondary" Size="Size.Small" Variant="Variant.Outlined">タグ</MudChip>
            }
        </MudTd>
        <MudTd DataLabel="通報対象" Style="max-width: 250px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
            <MudTooltip Text="@context.TargetContentSnapshot">
                <span>@context.TargetContentSnapshot</span>
            </MudTooltip>
        </MudTd>
        <MudTd DataLabel="通報理由">
            <MudChip T="string" Color="Color.Error" Size="Size.Small" Variant="Variant.Text">
                @context.Reason
            </MudChip>
        </MudTd>
        <MudTd DataLabel="通報者">@(context.Owner?.UserName ?? "不明")</MudTd>
        <MudTd DataLabel="ステータス">
            @switch (context.Status)
            {
                case ReportStatus.Pending:
                    <MudChip T="string" Color="Color.Warning" Size="Size.Small" Variant="Variant.Filled">未対応</MudChip>
                    break;
                case ReportStatus.Reviewed:
                    <MudChip T="string" Color="Color.Info" Size="Size.Small" Variant="Variant.Filled">確認済み</MudChip>
                    break;
                case ReportStatus.ActionTaken:
                    <MudChip T="string" Color="Color.Success" Size="Size.Small" Variant="Variant.Filled">処置済み</MudChip>
                    break;
                case ReportStatus.Dismissed:
                    <MudChip T="string" Color="Color.Default" Size="Size.Small" Variant="Variant.Filled">却下</MudChip>
                    break;
            }
        </MudTd>
        <MudTd DataLabel="対応">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.Visibility"
                       OnClick="@(() => OpenDetailDialogAsync(context))">
                詳細・対応
            </MudButton>
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <MudText Class="pa-4 text-center" Color="Color.Secondary">該当する通報はありません。</MudText>
    </NoRecordsContent>
</MudTable>

@code {
    private List<ContentReport> _reports = [];
    private ReportStatus? _selectedStatus = ReportStatus.Pending;
    private ReportTargetType? _selectedTargetType;
    private bool _isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadReportsAsync();
    }

    private async Task LoadReportsAsync()
    {
        _isLoading = true;
        try
        {
            _reports = await ContentReportService.GetReportsAsync(_selectedStatus, _selectedTargetType);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"通報一覧の取得中にエラーが発生しました: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task OnStatusFilterChangedAsync(ReportStatus? status)
    {
        _selectedStatus = status;
        await LoadReportsAsync();
    }

    private async Task OnTargetTypeFilterChangedAsync(ReportTargetType? targetType)
    {
        _selectedTargetType = targetType;
        await LoadReportsAsync();
    }

    private async Task OpenDetailDialogAsync(ContentReport report)
    {
        // 最新の詳細情報を再取得してダイアログを開く
        var latestReport = await ContentReportService.GetReportByIdAsync(report.Id);
        if (latestReport is null)
        {
            Snackbar.Add("通報が見つかりません。", Severity.Error);
            await LoadReportsAsync();
            return;
        }

        var parameters = new DialogParameters
        {
            [nameof(ReportDetailDialog.Report)] = latestReport
        };
        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            MaxWidth = MaxWidth.Medium,
            FullWidth = true
        };

        var dialog = await DialogLauncher.ShowAsync<ReportDetailDialog>("通報の詳細・対応", parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            await LoadReportsAsync();
        }
    }
}

