@using System.Security.Claims
@using SRNSMudApp.Data
@using SRNSMudApp.Models.Unions
@using SRNSMudApp.Services
@inject ITagContentProposalService TagContentProposalService
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.subtitle2" Color="Color.Secondary" Class="mb-1">対象タグ</MudText>
        <MudText Typo="Typo.h6" Class="mb-4 d-flex align-center">
            <MudIcon Icon="@Icons.Material.Filled.LocalOffer" Size="Size.Small" Class="mr-2" />
            @Tag.Name
        </MudText>

        @if (!string.IsNullOrEmpty(Tag.Content))
        {
            <MudTextField T="string" Value="@Tag.Content" Label="現在の内容" Variant="Variant.Outlined"
                          Lines="3" ReadOnly="true" Class="mb-4" />
        }

        <MudTextField T="string" @bind-Value="_proposedContent" Label="提案する内容" Variant="Variant.Outlined"
                      Lines="4" AutoFocus="true" Required="true" RequiredError="提案内容は必須です" Class="mb-4" />

        <MudTextField T="string" @bind-Value="_reason" Label="提案理由・コメント（任意）" Variant="Variant.Outlined"
                      Lines="2" Class="mb-2" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@Cancel">キャンセル</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="@SubmitAsync">提案を送信</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    [Parameter] public Tag Tag { get; set; } = null!;

    private string _proposedContent = string.Empty;
    private string? _reason;

    protected override void OnInitialized()
    {
        _proposedContent = Tag.Content;
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }

    private async Task SubmitAsync()
    {
        if (AuthState is null)
        {
            Snackbar.Add("ログインが必要です。", Severity.Warning);
            return;
        }

        var auth = await AuthState;
        var userId = auth.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;

        if (string.IsNullOrEmpty(userId))
        {
            Snackbar.Add("ログインユーザー情報が取得できませんでした。", Severity.Warning);
            return;
        }

        Result<TagContentProposal> result = await TagContentProposalService.ProposeContentAsync(
            Tag.Id,
            _proposedContent,
            _reason,
            userId);

        switch (result)
        {
            case Success<TagContentProposal>:
                Snackbar.Add("編集提案を送信しました。", Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
                break;
            case Failure fail:
                Snackbar.Add(fail.ErrorMessage, Severity.Error);
                break;
        }
    }
}

