@page "/TagDetail/{TagId:int}"
@using System.Security.Claims
@rendermode InteractiveServer
@using SRNSMudApp.Services
@using SRNSMudApp.Data
@using SRNSMudApp.Components.UI
@inject ITagDetailDataProvider TagDetailData
@inject ITagDialogDataProvider TagDialogData
@inject IDialogLauncher DialogLauncher
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-5">
    @if (_tag is null)
    {
        <MudText>読み込み中...</MudText>
    }
    else
    {
        <div class="d-flex align-center mb-4">
            <MudIconButton Icon="@Icons.Material.Filled.ArrowBack"
                           OnClick="@(() => NavigationManager.NavigateTo("Item/ItemList"))" Class="mr-2" />
            <MudText Typo="Typo.h5">タグ詳細</MudText>
            <MudSpacer />
            @if (_currentUserId is not null)
            {
                <MudButton Variant="@(_isFollowing ? Variant.Outlined : Variant.Filled)"
                           Color="@(_isFollowing ? Color.Default : Color.Primary)"
                           StartIcon="@(_isFollowing ? Icons.Material.Filled.FavoriteBorder : Icons.Material.Filled.Favorite)"
                           OnClick="@ToggleFollowAsync" Class="mr-2">
                    @(_isFollowing ? "フォロー解除" : "フォロー")
                </MudButton>
            }
            <MudSwitch T="bool" Value="@(_tag.AutoAcceptIncomingTaggingRequests)" ValueChanged="OnAutoAcceptChangedAsync"
                       Label="自動承認" Color="Color.Primary" Class="mr-2" />
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Edit"
                       OnClick="@OpenEditDialog" Class="mr-2">
                編集
            </MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Outlined.Report"
                       OnClick="@OpenReportDialogAsync">
                通報
            </MudButton>
        </div>

        <MudCard Outlined="true" Class="mb-4 rounded-xl">
            <MudCardContent>
                <MudText Typo="Typo.h4" Class="d-flex align-center">
                    <MudIcon Icon="@Icons.Material.Filled.LocalOffer" Class="mr-2" />
                    @_tag.Name
                </MudText>
                @if (!string.IsNullOrEmpty(_tag.Content))
                {
                    <MudText Typo="Typo.body1" Class="mt-4">@_tag.Content</MudText>
                }
                @if (_tag.AutoApproveUserGroups.Count > 0 || _tag.AutoApproveUserGroup is not null)
                {
                    <div class="d-flex align-center mt-3 gap-2 flex-wrap">
                        <MudIcon Icon="@Icons.Material.Filled.Group" Size="Size.Small" Color="Color.Info" />
                        <MudText Typo="Typo.body2">自動承認許可グループ:</MudText>
                        @if (_tag.AutoApproveUserGroups.Count > 0)
                        {
                            @foreach (var g in _tag.AutoApproveUserGroups)
                            {
                                <MudChip T="string" Color="Color.Info" Size="Size.Small" Variant="Variant.Outlined">
                                    @(g.UserGroup?.Name ?? "不明なグループ")
                                </MudChip>
                            }
                        }
                        else if (_tag.AutoApproveUserGroup is not null)
                        {
                            <MudChip T="string" Color="Color.Info" Size="Size.Small" Variant="Variant.Outlined">
                                @_tag.AutoApproveUserGroup.Name
                            </MudChip>
                        }
                    </div>
                }
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mt-4">
                    作成者: @(_tag.Owner?.UserName ?? "不明")
                </MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block">
                    作成日時: @(_tag.CreatedDate.ToLocalTime().ToString("g"))
                </MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block">
                    更新日時: @(_tag.UpdatedDate.ToLocalTime().ToString("g"))
                </MudText>
            </MudCardContent>
        </MudCard>

        @* 関連するアイテムとタグのリストを表示 *@
        <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-4 mt-4">
            <MudTabPanel Text="関連アイテム / タグ">
                <SRNSMudApp.Components.UI.ResourceList Tags="_relatedTags" Items="_relatedItems"
                                                       OnDataChanged="LoadDataAsync" />
            </MudTabPanel>
            <MudTabPanel Text="リクエスト" BadgeData="@_pendingRequests.Count()" BadgeColor="Color.Error">
                <TaggingRequestList Requests="_pendingRequests" OnRequestChanged="LoadDataAsync" />
            </MudTabPanel>
            <MudTabPanel Text="Weight 履歴 / 取引履歴">
                <SRNSMudApp.Components.UI.TagWeightLedgerList Ledgers="_weightLedgers" />
            </MudTabPanel>
            <MudTabPanel Text="関連オファー">
                <SRNSMudApp.Components.UI.PublicTradeOfferList Offers="_publicOffers" OnOfferTriggered="LoadDataAsync" />
            </MudTabPanel>
        </MudTabs>
    }
</MudContainer>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    [Parameter] public int TagId { get; set; }

    private Tag? _tag;
    private IEnumerable<Item> _relatedItems = [];
    private IEnumerable<Tag> _relatedTags = [];
    private IEnumerable<TagWeightLedger> _weightLedgers = [];
    private IEnumerable<PublicTradeOffer> _publicOffers = [];
    private IEnumerable<TaggingRequestEntity> _pendingRequests = [];
    private bool _isFollowing;
    private string? _currentUserId;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthState!;
        _currentUserId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        await LoadDataAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_tag is { Id: var id } && id != TagId)
        {
            await LoadDataAsync();
        }
    }

    private async Task LoadDataAsync()
    {
        TagDetailPageData data = await TagDetailData.GetTagDetailAsync(TagId, _currentUserId);
        _tag = data.Tag;
        _isFollowing = data.IsFollowing;
        _relatedItems = data.RelatedItems;
        _relatedTags = data.RelatedTags;
        _weightLedgers = data.WeightLedgers;
        _publicOffers = data.PublicOffers;
        _pendingRequests = data.PendingRequests;
    }

    private async Task OpenEditDialog()
    {
        if (_tag is null)
        {
            return;
        }

        var parameters = new DialogParameters
        {
            { "Tag", _tag }
        };

        var dialog = await DialogLauncher.ShowAsync<TagEditDialog>("タグを編集", parameters);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            await LoadDataAsync();
        }
    }

    private async Task ToggleFollowAsync()
    {
        if (_currentUserId is null || _tag is null)
        {
            return;
        }

        _isFollowing = await TagDetailData.ToggleFollowAsync(TagId, _currentUserId);
    }

    private async Task OnAutoAcceptChangedAsync(bool enabled)
    {
        if (_tag is null)
        {
            return;
        }

        var groupIds = _tag.AutoApproveUserGroups.Select(g => g.UserGroupId).ToList();
        if (groupIds.Count == 0 && _tag.AutoApproveUserGroupId.HasValue)
        {
            groupIds.Add(_tag.AutoApproveUserGroupId.Value);
        }

        bool updated = await TagDialogData.UpdateTagAsync(_tag.Id, _tag.Name, _tag.Content, enabled, groupIds);
        if (!updated)
        {
            return;
        }

        _tag.AutoAcceptIncomingTaggingRequests = enabled;
    }

    private async Task OpenReportDialogAsync()
    {
        if (_currentUserId is null || _tag is null)
        {
            Snackbar.Add("通報するにはログインが必要です。", Severity.Warning);
            return;
        }

        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var parameters = new DialogParameters
        {
            [nameof(ReportContentDialog.TargetType)] = ReportTargetType.Tag,
            [nameof(ReportContentDialog.TagId)] = _tag.Id,
            [nameof(ReportContentDialog.TargetContent)] = $"タグ名: {_tag.Name}\n{_tag.Content}",
            [nameof(ReportContentDialog.TargetOwnerName)] = _tag.Owner?.UserName
        };

        _ = await DialogLauncher.ShowAsync<ReportContentDialog>("不適切な投稿を通報", parameters, options);
    }
}