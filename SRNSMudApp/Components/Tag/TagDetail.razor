@page "/TagDetail/{TagId:int}"
@using System.Security.Claims
@rendermode InteractiveServer
@using SRNSMudApp.Services
@using SRNSMudApp.Data
@using SRNSMudApp.Models
@using SRNSMudApp.Models.Unions
@using SRNSMudApp.Components.UI
@using SRNSMudApp.Components.Contract
@inject ITagDetailDataProvider TagDetailData
@inject ITagCommandService TagCommandService
@inject ITagContentProposalService TagContentProposalService
@inject ITagNameProposalService TagNameProposalService
@inject IDialogLauncher DialogLauncher
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject ITagLockService TagLockService

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-5">
    @if (_tag is null)
    {
        <MudText>読み込み中...</MudText>
    }
    else
    {
        <div class="d-flex align-center mb-4">
            <MudIconButton Icon="@Icons.Material.Filled.ArrowBack"
                           OnClick="@(() => NavigationManager.NavigateTo("Item/ItemList"))" Class="mr-2" />
            <MudText Typo="Typo.h5">タグ詳細</MudText>
            <MudSpacer />
            @if (_isAdmin && _tag.Name != Tag.RootTagName)
            {
                <MudSwitch T="bool" Value="@_tag.IsLocked" ValueChanged="OnToggleThisTagLockAsync"
                           Label="@(_tag.IsLocked ? "このTagをロック中" : "このTagをロック")" Color="Color.Error" Disabled="@_isTogglingTagLock"
                           Class="mr-2" />
                <MudSwitch T="bool" Value="@_areAncestorsLocked" ValueChanged="OnToggleAncestorsLockAsync"
                           Label="@(_areAncestorsLocked ? "このTagの祖先をロック中" : "このTagの祖先をロック")" Color="Color.Warning"
                           Disabled="@_isTogglingAncestorsLock" Class="mr-2" />
            }
            @if (_currentUserId is not null)
            {
                <MudButton Variant="@(_isFollowing ? Variant.Outlined : Variant.Filled)"
                           Color="@(_isFollowing ? Color.Default : Color.Primary)"
                           StartIcon="@(_isFollowing ? Icons.Material.Filled.FavoriteBorder : Icons.Material.Filled.Favorite)"
                           OnClick="@ToggleFollowAsync" Class="mr-2">
                    @(_isFollowing ? "フォロー解除" : "フォロー")
                </MudButton>
            }
            @if (_currentUserId == _tag.OwnerId || _isAdmin)
            {
                <MudSwitch T="bool" Value="@(_tag.AutoAcceptIncomingTaggingRequests)" ValueChanged="OnAutoAcceptChangedAsync"
                           Label="自動承認" Color="Color.Primary" Class="mr-2" />
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Edit"
                           OnClick="@OpenEditDialog" Disabled="@(!_isAdmin && _isTagOrSiblingLocked)" Class="mr-2">
                    編集
                </MudButton>
                @if (!_tag.IsSystem && _tag.Name != Tag.RootTagName)
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete"
                               OnClick="@DeleteTagAsync" Disabled="@(!_isAdmin && _isTagOrSiblingLocked)" Class="mr-2"
                               data-testid="delete-tag-button">
                        削除
                    </MudButton>
                }
            }
            else if (_currentUserId is not null)
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Send"
                           OnClick="@OpenRequestPermissionDialogAsync" Class="mr-2">
                    操作権限をリクエスト
                </MudButton>
                @if (!_isTagOrSiblingLocked)
                {
                    <MudMenu Label="編集を提案" Variant="Variant.Outlined" Color="Color.Primary"
                             StartIcon="@Icons.Material.Filled.EditNote" EndIcon="@Icons.Material.Filled.ArrowDropDown" Class="mr-2">
                        @if (!_tag.IsSystem && _tag.OwnerId != "system" && _tag.Name != "全て∀")
                        {
                            <MudMenuItem Icon="@Icons.Material.Filled.DriveFileRenameOutline" OnClick="@OpenNameProposalDialog">タグ名変更を提案
                            </MudMenuItem>
                        }
                        <MudMenuItem Icon="@Icons.Material.Filled.EditNote" OnClick="@OpenContentProposalDialog">内容変更を提案
                        </MudMenuItem>
                    </MudMenu>
                }
            }
            <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Outlined.Report"
                       OnClick="@OpenReportDialogAsync">
                通報
            </MudButton>
        </div>

        @if (_isTagOrSiblingLocked)
        {
            @if (_isAdmin)
            {
                <MudAlert Severity="Severity.Info" Class="mb-4" Dense="true" Elevation="1">
                    このタグまたはその兄弟タグはロックされています。管理者権限により操作が可能です。
                </MudAlert>
            }
            else
            {
                <MudAlert Severity="Severity.Warning" Class="mb-4" Dense="true" Elevation="1">
                    このタグまたはその兄弟タグはロックされています。新規作成・編集・削除はできません（管理者のみ操作可能）。
                </MudAlert>
            }
        }

        <MudCard Outlined="true" Class="mb-4 rounded-xl">
            <MudCardContent>
                <MudText Typo="Typo.h4" Class="d-flex align-center">
                    <MudIcon Icon="@Icons.Material.Filled.LocalOffer" Class="mr-2" />
                    @_tag.Name
                </MudText>
                @if (!string.IsNullOrEmpty(_tag.Content))
                {
                    <MudText Typo="Typo.body1" Class="mt-4">@_tag.Content</MudText>
                }
                @if (_tag.AutoApproveUserGroups.Count > 0)
                {
                    <div class="d-flex align-center mt-3 gap-2 flex-wrap">
                        <MudIcon Icon="@Icons.Material.Filled.Group" Size="Size.Small" Color="Color.Info" />
                        <MudText Typo="Typo.body2">自動承認許可グループ:</MudText>
                        @if (_tag.AutoApproveUserGroups.Count > 0)
                        {
                            @foreach (var g in _tag.AutoApproveUserGroups)
                            {
                                <MudChip T="string" Color="Color.Info" Size="Size.Small" Variant="Variant.Outlined">
                                    @(g.UserGroup?.Name ?? "不明なグループ")
                                </MudChip>
                            }
                        }
                    </div>
                }
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mt-4">
                    作成者: @(_tag.Owner?.UserName ?? "不明")
                </MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block">
                    作成日時: @(_tag.CreatedDate.ToLocalTime().ToString("g"))
                </MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block">
                    更新日時: @(_tag.UpdatedDate.ToLocalTime().ToString("g"))
                </MudText>
            </MudCardContent>
        </MudCard>

        @* 関連するアイテムとタグのリストを表示 *@
        <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-4 mt-4">
            <MudTabPanel Text="関連アイテム / タグ">
                <SRNSMudApp.Components.UI.ResourceList Tags="_relatedTags" Items="_relatedItems"
                                                       OnDataChanged="LoadDataAsync" />
            </MudTabPanel>
            <MudTabPanel Text="リクエスト" BadgeData="@_pendingRequests.Count()" BadgeColor="Color.Error">
                @if (_currentUserId is not null && _currentUserId != _tag.OwnerId)
                {
                    <div class="d-flex justify-end mb-3">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Send" OnClick="@OpenRequestPermissionDialogAsync">
                            操作権限をリクエスト
                        </MudButton>
                    </div>
                }
                <TaggingRequestList Requests="_pendingRequests" OnRequestChanged="LoadDataAsync" />
            </MudTabPanel>
            <MudTabPanel Text="編集提案" BadgeData="@(_pendingProposals.Count + _pendingNameProposals.Count)"
                         BadgeColor="Color.Info">
                @if (_pendingProposals.Count == 0 && _pendingNameProposals.Count == 0)
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="pa-4 text-center">
                        現在、保留中の編集提案はありません。
                    </MudText>
                }
                else
                {
                    <MudStack Spacing="3">
                        @foreach (var nameProposal in _pendingNameProposals)
                        {
                            <MudCard Outlined="true" Class="rounded-lg">
                                <MudCardContent>
                                    <div class="d-flex justify-space-between align-center mb-2">
                                        <div class="d-flex align-center">
                                            <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined"
                                                     Class="mr-2">
                                                タグ名変更
                                            </MudChip>
                                            <MudAvatar Color="Color.Primary" Size="Size.Small" Class="mr-2">
                                                <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" />
                                            </MudAvatar>
                                            <MudText Typo="Typo.subtitle2">
                                                <MudLink Href="@($"/User/UserDetail/{nameProposal.RequesterUserId}")">
                                                    @(nameProposal.RequesterUser?.UserName ?? "不明なユーザー")
                                                </MudLink>
                                            </MudText>
                                        </div>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                                            @nameProposal.CreatedDate.ToLocalTime().ToString("g")
                                        </MudText>
                                    </div>
                                    <MudText Typo="Typo.body2" Class="mb-1">
                                        <strong>提案された新しいタグ名:</strong> <span
                                        class="font-weight-bold ml-1">@nameProposal.ProposedName</span>
                                    </MudText>
                                    @if (!string.IsNullOrWhiteSpace(nameProposal.Reason))
                                    {
                                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mb-2">
                                            <strong>提案理由:</strong> @nameProposal.Reason
                                        </MudText>
                                    }
                                    <div class="d-flex justify-end gap-2 mt-2">
                                        @if (_currentUserId == _tag.OwnerId)
                                        {
                                            <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Success"
                                                       StartIcon="@Icons.Material.Filled.Check"
                                                       OnClick="@(() => ApproveNameProposalAsync(nameProposal.Id))">
                                                承認
                                            </MudButton>
                                            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error"
                                                       StartIcon="@Icons.Material.Filled.Close"
                                                       OnClick="@(() => RejectNameProposalAsync(nameProposal.Id))">
                                                却下
                                            </MudButton>
                                        }
                                        else if (_currentUserId == nameProposal.RequesterUserId)
                                        {
                                            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning"
                                                       OnClick="@(() => CancelNameProposalAsync(nameProposal.Id))">
                                                取り下げ
                                            </MudButton>
                                        }
                                    </div>
                                </MudCardContent>
                            </MudCard>
                        }

                        @foreach (var proposal in _pendingProposals)
                        {
                            <MudCard Outlined="true" Class="rounded-lg">
                                <MudCardContent>
                                    <div class="d-flex justify-space-between align-center mb-2">
                                        <div class="d-flex align-center">
                                            <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Variant="Variant.Outlined"
                                                     Class="mr-2">
                                                内容変更
                                            </MudChip>
                                            <MudAvatar Color="Color.Primary" Size="Size.Small" Class="mr-2">
                                                <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" />
                                            </MudAvatar>
                                            <MudText Typo="Typo.subtitle2">
                                                <MudLink Href="@($"/User/UserDetail/{proposal.RequesterUserId}")">
                                                    @(proposal.RequesterUser?.UserName ?? "不明なユーザー")
                                                </MudLink>
                                            </MudText>
                                        </div>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                                            @proposal.CreatedDate.ToLocalTime().ToString("g")
                                        </MudText>
                                    </div>
                                    <MudText Typo="Typo.body2" Class="mb-2">
                                        <strong>提案内容:</strong> @proposal.ProposedContent
                                    </MudText>
                                    @if (!string.IsNullOrWhiteSpace(proposal.Reason))
                                    {
                                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mb-2">
                                            <strong>提案理由:</strong> @proposal.Reason
                                        </MudText>
                                    }
                                    <div class="d-flex justify-end gap-2 mt-2">
                                        @if (_currentUserId == _tag.OwnerId)
                                        {
                                            <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Success"
                                                       StartIcon="@Icons.Material.Filled.Check"
                                                       OnClick="@(() => ApproveProposalAsync(proposal.Id))">
                                                承認
                                            </MudButton>
                                            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error"
                                                       StartIcon="@Icons.Material.Filled.Close"
                                                       OnClick="@(() => RejectProposalAsync(proposal.Id))">
                                                却下
                                            </MudButton>
                                        }
                                        else if (_currentUserId == proposal.RequesterUserId)
                                        {
                                            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning"
                                                       OnClick="@(() => CancelProposalAsync(proposal.Id))">
                                                取り下げ
                                            </MudButton>
                                        }
                                    </div>
                                </MudCardContent>
                            </MudCard>
                        }
                    </MudStack>
                }
            </MudTabPanel>
            <MudTabPanel Text="Weight 履歴 / 取引履歴">
                <SRNSMudApp.Components.UI.TagWeightLedgerList Ledgers="_weightLedgers" />
            </MudTabPanel>
            <MudTabPanel Text="関連オファー">
                <SRNSMudApp.Components.UI.PublicTradeOfferList Offers="_publicOffers" OnOfferTriggered="LoadDataAsync" />
            </MudTabPanel>
            <MudTabPanel Text="操作権限" Icon="@Icons.Material.Filled.Key" BadgeData="@(_rightAssetOverview?.TotalHoldersCount)"
                         BadgeColor="Color.Primary">
                <div class="d-flex justify-space-between align-center mb-4 flex-wrap gap-2">
                    <div class="d-flex align-center gap-3">
                        <MudText Typo="Typo.subtitle1" Class="font-weight-bold">RightAsset 保有状況</MudText>
                        @if (_rightAssetOverview is not null)
                        {
                            <MudChip T="string" Color="Color.Primary" Size="Size.Small" Variant="Variant.Outlined">
                                総保有量: @_rightAssetOverview.TotalActiveAmount
                            </MudChip>
                            <MudChip T="string" Color="Color.Success" Size="Size.Small" Variant="Variant.Outlined">
                                保有者: @_rightAssetOverview.TotalHoldersCount 人
                            </MudChip>
                        }
                    </div>
                    <div class="d-flex gap-2">
                        @if (_currentUserId is not null && _currentUserId != _tag.OwnerId)
                        {
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.Send" OnClick="@OpenRequestPermissionDialogAsync">
                                操作権限をリクエスト
                            </MudButton>
                        }
                        @if (_currentUserId is not null)
                        {
                            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.ShoppingCart" OnClick="@OpenPurchaseDialogAsync"
                                       data-testid="purchase-right-asset-button">
                                JPYCで購入
                            </MudButton>
                        }
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.OpenInNew" Href="@($"/RightAsset/Overview?tagId={TagId}")">
                            RightAsset 詳細画面を開く
                        </MudButton>
                    </div>
                </div>

                @if (_rightAssetOverview is null || _rightAssetOverview.Holders.Count == 0)
                {
                    <MudAlert Severity="Severity.Normal" Class="my-3">
                        このタグに対する有効な RightAsset はまだ発行されていません。
                    </MudAlert>
                }
                else
                {
                    <!-- 保有者一覧テーブル -->
                    <MudText Typo="Typo.body2" Class="font-weight-bold mb-2">保有者一覧（誰がどれだけ持っているか）</MudText>
                    <MudTable Items="@_rightAssetOverview.Holders" Dense="true" Hover="true" Striped="true" Class="mb-6"
                              data-testid="tag-detail-right-asset-holders-table">
                        <HeaderContent>
                            <MudTh>保有ユーザー</MudTh>
                            <MudTh Style="text-align: right;">有効保有量</MudTh>
                            <MudTh Style="width: 25%;">保有シェア</MudTh>
                            <MudTh Style="text-align: right;">有効アセット件数</MudTh>
                            <MudTh Style="text-align: right;">燃焼済 (消費量)</MudTh>
                            <MudTh>最終更新日時</MudTh>
                            <MudTh Style="text-align: center;">アクション</MudTh>
                        </HeaderContent>
                        <RowTemplate Context="holder">
                            <MudTd DataLabel="保有ユーザー">
                                <div class="d-flex align-center gap-2">
                                    <MudAvatar Size="Size.Small" Color="Color.Secondary">
                                        @((holder.UserName ?? holder.UserId)[..1].ToUpperInvariant())
                                    </MudAvatar>
                                    <MudLink Href="@($"/User/UserDetail/{holder.UserId}")" Underline="Underline.Hover">
                                        <strong>@(holder.UserName ?? holder.UserId)</strong>
                                    </MudLink>
                                </div>
                            </MudTd>
                            <MudTd DataLabel="有効保有量" Style="text-align: right;">
                                <MudChip T="string" Color="Color.Primary" Size="Size.Small" Variant="Variant.Filled">
                                    @holder.TotalAmount
                                </MudChip>
                            </MudTd>
                            <MudTd DataLabel="保有シェア">
                                @{
                                    var share = _rightAssetOverview.TotalActiveAmount > 0
                                        ? (double)holder.TotalAmount / _rightAssetOverview.TotalActiveAmount * 100
                                        : 0;
                                }
                                <div class="d-flex align-center gap-2">
                                    <MudProgressLinear Color="Color.Primary" Value="@share" Rounded="true"
                                                       Class="flex-grow-1" />
                                    <MudText Typo="Typo.caption" Style="min-width: 45px; text-align: right;">
                                        @share.ToString("F1")%
                                    </MudText>
                                </div>
                            </MudTd>
                            <MudTd DataLabel="有効アセット件数" Style="text-align: right;">
                                @holder.ActiveAssetCount 件
                            </MudTd>
                            <MudTd DataLabel="燃焼済 (消費量)" Style="text-align: right;">
                                @(holder.BurnedAmount > 0 ? $"{holder.BurnedAmount} ({holder.BurnedAssetCount} 件)" : "-")
                            </MudTd>
                            <MudTd DataLabel="最終更新日時">
                                @(holder.LastUpdated?.ToLocalTime().ToString("yyyy/MM/dd HH:mm") ?? "-")
                            </MudTd>
                            <MudTd DataLabel="アクション" Style="text-align: center;">
                                @if (_currentUserId is not null && holder.UserId != _currentUserId && holder.TotalAmount > 0)
                                {
                                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                                               StartIcon="@Icons.Material.Filled.SwapHoriz"
                                               OnClick="@(() => OpenRequestPermissionDialogAsync(holder.UserId))"
                                               data-testid="@($"request-permission-holder-{holder.UserId}")">
                                        リクエスト
                                    </MudButton>
                                }
                            </MudTd>
                        </RowTemplate>
                    </MudTable>

                    <!-- 個別アセット明細テーブル -->
                    <MudExpansionPanels Class="mt-3">
                        <MudExpansionPanel Text="@($"個別 RightAsset 明細 ({_rightAssetOverview.Assets.Count} 件)")"
                                           Icon="@Icons.Material.Filled.ListAlt">
                            <MudTable Items="@_rightAssetOverview.Assets" Dense="true" Hover="true" Striped="true">
                                <HeaderContent>
                                    <MudTh>ID</MudTh>
                                    <MudTh>所有者</MudTh>
                                    <MudTh Style="text-align: right;">数量</MudTh>
                                    <MudTh>状態</MudTh>
                                    <MudTh>作成日時</MudTh>
                                </HeaderContent>
                                <RowTemplate Context="asset">
                                    <MudTd DataLabel="ID">#@asset.Id</MudTd>
                                    <MudTd DataLabel="所有者">
                                        <MudLink Href="@($"/User/UserDetail/{asset.OwnerId}")" Underline="Underline.Hover">
                                            @(asset.OwnerName ?? asset.OwnerId)
                                        </MudLink>
                                    </MudTd>
                                    <MudTd DataLabel="数量" Style="text-align: right;">
                                        <strong>@asset.Amount</strong>
                                    </MudTd>
                                    <MudTd DataLabel="状態">
                                        @if (asset.IsBurned)
                                        {
                                            <MudChip T="string" Color="Color.Default" Size="Size.Small" Variant="Variant.Outlined">
                                                @asset.StatusSummary
                                            </MudChip>
                                        }
                                        else if (asset.Amount > 0)
                                        {
                                            <MudChip T="string" Color="Color.Success" Size="Size.Small" Variant="Variant.Filled">
                                                有効
                                            </MudChip>
                                        }
                                        else
                                        {
                                            <MudChip T="string" Color="Color.Warning" Size="Size.Small" Variant="Variant.Outlined">
                                                残高0
                                            </MudChip>
                                        }
                                    </MudTd>
                                    <MudTd DataLabel="作成日時">
                                        @asset.CreatedDate.ToLocalTime().ToString("yyyy/MM/dd HH:mm")
                                    </MudTd>
                                </RowTemplate>
                            </MudTable>
                        </MudExpansionPanel>
                    </MudExpansionPanels>
                }
            </MudTabPanel>
        </MudTabs>
    }
</MudContainer>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    [Parameter] public int TagId { get; set; }

    private Tag? _tag;
    private IEnumerable<Item> _relatedItems = [];
    private IEnumerable<Tag> _relatedTags = [];
    private IEnumerable<TagWeightLedger> _weightLedgers = [];
    private IEnumerable<PublicTradeOffer> _publicOffers = [];
    private IEnumerable<TaggingRequestEntity> _pendingRequests = [];
    private IReadOnlyList<TagContentProposal> _pendingProposals = [];
    private IReadOnlyList<TagNameProposal> _pendingNameProposals = [];
    private RightAssetOverviewData? _rightAssetOverview;
    private bool _isFollowing;
    private string? _currentUserId;
    private bool _isAdmin;
    private bool _areAncestorsLocked;
    private bool _isTagOrSiblingLocked;
    private bool _isTogglingAncestorsLock;
    private bool _isTogglingTagLock;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthState!;
        _currentUserId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        _isAdmin = authState.User.IsInRole("Admin");
        await LoadDataAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_tag is { Id: var id } && id != TagId)
        {
            await LoadDataAsync();
        }
    }

    private async Task LoadDataAsync()
    {
        TagDetailPageData data = await TagDetailData.GetTagDetailAsync(TagId, _currentUserId);
        _tag = data.Tag;
        _isFollowing = data.IsFollowing;
        _relatedItems = data.RelatedItems;
        _relatedTags = data.RelatedTags;
        _weightLedgers = data.WeightLedgers;
        _publicOffers = data.PublicOffers;
        _pendingRequests = data.PendingRequests;
        _rightAssetOverview = data.RightAssetOverview;
        _pendingProposals = await TagContentProposalService.GetPendingProposalsForTagAsync(TagId);
        _pendingNameProposals = await TagNameProposalService.GetPendingProposalsForTagAsync(TagId);
        _areAncestorsLocked = await TagLockService.AreAncestorsLockedAsync(TagId);
        _isTagOrSiblingLocked = await TagLockService.IsTagOrSiblingLockedAsync(TagId);
    }

    private async Task OnToggleThisTagLockAsync(bool shouldLock)
    {
        if (!_isAdmin || _isTogglingTagLock || _tag is null)
        {
            return;
        }

        _isTogglingTagLock = true;
        try
        {
            bool isLocked = await TagLockService.ToggleTagLockAsync(TagId);
            Snackbar.Add(isLocked ? "このタグを個別ロックしました。" : "このタグの個別ロックを解除しました。", Severity.Success);
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"タグのロック操作に失敗しました: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isTogglingTagLock = false;
        }
    }

    private async Task OnToggleAncestorsLockAsync(bool shouldLock)
    {
        if (!_isAdmin || _isTogglingAncestorsLock)
        {
            return;
        }

        _isTogglingAncestorsLock = true;
        try
        {
            if (shouldLock)
            {
                await LockAncestorsAsync();
            }
            else
            {
                await UnlockAncestorsAsync();
            }
        }
        finally
        {
            _isTogglingAncestorsLock = false;
        }
    }

