@using System.Security.Claims
@using SRNSMudApp.Components.UI
@using SRNSMudApp.Services
@inject IDialogLauncher DialogLauncher
@inject ITaggingRequestActions RequestActions
<MudTable T="TaggingRequestEntity" Items="[.. Requests.Where(r => r.Status != TradeStatus.Rejected)]" Hover="true"
          Breakpoint="Breakpoint.Sm" Elevation="0"
          @bind-SelectedItem="SelectedRequest" OnRowClick="OnRowClicked" RowClassFunc="SelectedRowClassFunc">
    <HeaderContent>
        <MudTh>タイプ</MudTh>
        <MudTh>対象アイテム</MudTh>
        <MudTh>リクエスタ</MudTh>
        <MudTh>作成日時</MudTh>
        <MudTh>操作</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="タイプ">
            @switch (context.RequestType)
            {
                case TaggingRequestType.Add:
                    <MudChip T="string" Color="Color.Success" Size="Size.Small">追加 (+@(context.ProposedWeight))</MudChip>
                    break;
                case TaggingRequestType.Remove:
                    <MudChip T="string" Color="Color.Error" Size="Size.Small">削除</MudChip>
                    break;
                case TaggingRequestType.DecreaseWeight:
                    <MudChip T="string" Color="Color.Warning" Size="Size.Small">追加 (-@(context.ProposedWeight))</MudChip>
                    break;
            }
        </MudTd>
        <MudTd DataLabel="対象アイテム">
            <MudLink Href="@($"/ItemDetail/{context.TargetItemId}")">
                @(context.TargetItem?.Content ?? $"Item #{context.TargetItemId}")
            </MudLink>
        </MudTd>
        <MudTd DataLabel="リクエスタ">@context.Owner?.UserName</MudTd>
        <MudTd DataLabel="作成日時">@context.CreatedDate.ToLocalTime().ToString("g")</MudTd>
        <MudTd DataLabel="操作">
            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                       OnClick="@(() => OpenThreadDialog(context))" Class="mr-2">
                詳細・スレッド
            </MudButton>
            @switch (CanApprove(context))
            {
                case true:
                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Success"
                               data-testid="tagging-request-approve"
                               OnClick="@(() => ApproveRequestAsync(context))" Class="mr-2">
                        承認
                    </MudButton>
                    break;
            }
            @switch (RejectButtonTemplate)
            {
                case not null:
                    @RejectButtonTemplate(context)
                    break;
                case null when CanApprove(context):
                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Error"
                               data-testid="tagging-request-reject"
                               StartIcon="@Icons.Material.Filled.ThumbDown" OnClick="@(() => RejectRequestAsync(context))">
                        却下
                    </MudButton>
                    break;
            }
        </MudTd>
    </RowTemplate>
</MudTable>

@code {
    [Parameter] public IEnumerable<TaggingRequestEntity> Requests { get; set; } = [];
    [Parameter] public EventCallback OnRequestChanged { get; set; }
    [Parameter] public RenderFragment<TaggingRequestEntity>? RejectButtonTemplate { get; set; }
    [Parameter] public TaggingRequestEntity? SelectedRequest { get; set; }
    [Parameter] public EventCallback<TaggingRequestEntity?> SelectedRequestChanged { get; set; }

    private string SelectedRowClassFunc(TaggingRequestEntity element, int rowNumber)
    {
        switch (SelectedRequest)
        {
            case not null when SelectedRequest.Id == element.Id:
                return "mud-table-row-selected";
            default:
                return string.Empty;
        }
    }

    private async Task OnRowClicked(TableRowClickEventArgs<TaggingRequestEntity> args)
    {
        SelectedRequest = args.Item;
        await SelectedRequestChanged.InvokeAsync(args.Item);
    }

    private string? _currentUserId;

    [CascadingParameter] private Task<AuthenticationState> AuthenticationStateTask { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateTask;
        _currentUserId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
    }

    private bool CanApprove(TaggingRequestEntity request)
    {
        return RequestActions.CanApprove(request, _currentUserId);
    }

    private async Task ApproveRequestAsync(TaggingRequestEntity request)
    {
        switch (_currentUserId)
        {
            case null: return;
        }

        if (await RequestActions.ApproveAsync(request.Id, _currentUserId))
        {
            await OnRequestChanged.InvokeAsync();
        }
    }

    private async Task RejectRequestAsync(TaggingRequestEntity request)
    {
        switch (_currentUserId)
        {
            case null: return;
        }

        if (await RequestActions.RejectViaDialogAsync(request.Id, _currentUserId))
        {
            await OnRequestChanged.InvokeAsync();
        }
    }

    public async Task OpenThreadDialog(TaggingRequestEntity request)
    {
        var parameters = new DialogParameters<TaggingRequestThreadDialog>
        {
            { x => x.TaggingRequest, request }
        };
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogLauncher.ShowAsync<TaggingRequestThreadDialog>("リクエストスレッド", parameters, options);
        var result = await dialog.Result;

        switch (result)
        {
            case { Canceled: false }:
                await OnRequestChanged.InvokeAsync();
                break;
        }
    }

}