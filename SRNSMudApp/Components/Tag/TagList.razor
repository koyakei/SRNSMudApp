@page "/Tag/TagList"
@rendermode InteractiveServer
@using SRNSMudApp.Services
@inject ITagSearchQueryService TagSearchQueryService

<MudText Typo="Typo.h4" GutterBottom="true">Tag List</MudText>

<SRNSMudApp.Components.Tag.TagTable Tags="@tags" OnDataChanged="LoadDataAsync" />

@code {
    private List<Tag>? tags;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        tags = await TagSearchQueryService.GetTagsWithDetailsAsync();

        // StateHasChanged();
    }

}