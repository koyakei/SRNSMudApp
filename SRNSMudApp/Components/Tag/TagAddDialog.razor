@using System.Security.Claims
@using SRNSMudApp.Services
@inject ITagDialogDataProvider TagDialogData
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudTabs ActivePanelIndex="_activeTabIndex" ActivePanelIndexChanged="@OnActiveTabIndexChanged"
                 Elevation="0" Rounded="true" ApplyEffectsToContainer="true" panelClass="pt-4">
            <MudTabPanel Text="既存タグから選択">
                <!-- 検索入力エリア -->
                <div class="d-flex align-center gap-4 mb-4">
                    <MudTextField @bind-Value="_searchText"
                                  Label="タグを検索"
                                  Placeholder="タグ名 または 内容を入力..."
                                  Immediate="true"
                                  OnKeyDown="@HandleKeyDown"
                                  Clearable="true"
                                  AutoFocus="true"/>
                    <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="@SearchAsync">検索</MudButton>
                </div>

                <!-- 検索結果表示エリア -->
                @switch (_isSearching)
                {
                    case true:
                        <div class="d-flex justify-center pa-4">
                            <MudProgressCircular Color="Color.Primary" Indeterminate="true"/>
                        </div>
                        break;
                    case false when _searchResults != null:
                        switch (_searchResults.Any())
                        {
                            case true:
                                <MudText Typo="Typo.subtitle2" Class="mb-2">検索候補から1つ選択してください：</MudText>

                                <!-- スクロール可能な一覧エリア -->
                                <div class="tag-search-results">
                                    <MudRadioGroup T="Tag" @bind-Value="SelectedTag">
                                        @foreach (var tag in _searchResults)
                                        {
                                            var isActive = _activeTreeTagId == tag.Id;
                                            <div class="d-flex align-center search-result-item">
                                                <MudRadio Value="@tag" Color="Color.Primary" Class="flex-grow-1 py-2">
                                                    <div class="d-flex flex-column">
                                                        <MudText Typo="Typo.body1">@tag.Name</MudText>
                                                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                            ウェイト: @tag.CachedWeight | 内容: @tag.Content
                                                        </MudText>
                                                    </div>
                                                </MudRadio>
                                                <MudIconButton Icon="@Icons.Material.Filled.AccountTree"
                                                               Size="Size.Small"
                                                               OnClick="@(() => ToggleTree(tag.Id))"
                                                               title="タグツリーを表示"
                                                               Class="ml-2"/>
                                                <MudIconButton Icon="@Icons.Material.Filled.AddCircleOutline"
                                                               Size="Size.Small"
                                                               Color="Color.Info"
                                                               OnClick="@(() => SelectParentAndOpenCreateTab(tag))"
                                                               title="このタグの子タグを作成"
                                                               Class="ml-1"/>

                                                @* タグツリーポップオーバー *@
                                                <MudOverlay Visible="@isActive"
                                                            OnClick="@(() => _activeTreeTagId = null)"
                                                            AutoClose="true"
                                                            DarkBackground="false"
                                                            ZIndex="1450" />
                                                <MudPopover Open="@isActive"
                                                            AnchorOrigin="Origin.TopRight"
                                                            TransformOrigin="Origin.TopLeft"
                                                            OverflowBehavior="OverflowBehavior.FlipAlways"
                                                            Class="tree-popover" Paper="false"
                                                            Style="z-index: 1500;">
                                                    <TagTreePopoverContent TargetTag="@tag"
                                                                           AllTags="@_allTags"
                                                                           EnableSwap="false"
                                                                           EnableExpand="false"
                                                                           EnableNavigation="false"/>
                                                </MudPopover>
                                            </div>
                                        }
                                    </MudRadioGroup>
                                </div>
                                break;
                            case false:
                                <MudText Align="Align.Center" Class="px-4 py-2" Color="Color.Error">
                                    一致するタグが見つかりません
                                </MudText>
                                break;
                        }
                        break;
                }
            </MudTabPanel>

            <MudTabPanel Text="子タグを新規作成">
                <MudStack Spacing="3">
                    <MudAutocomplete T="Tag"
                                     Label="親タグ"
                                     @bind-Value="_parentTag"
                                     SearchFunc="@SearchParentTagsAsync"
                                     ToStringFunc="@(t => t?.Name ?? string.Empty)"
                                     Placeholder="親タグを検索・選択..."
                                     Clearable="true"
                                     Required="true"
                                     RequiredError="親タグを選択してください"
                                     Immediate="true"
                                     HelperText="@(_parentTag != null ? $"選択中親タグ: {_parentTag.Name}" : "親となるタグを検索して選択してください")"/>

                    <MudTextField @bind-Value="_newTagName"
                                  Label="子タグ名"
                                  Required="true"
                                  RequiredError="タグ名は必須です"
                                  Immediate="true"/>

                    <MudTextField @bind-Value="_newTagContent"
                                  Label="内容"
                                  Lines="3"
                                  Immediate="true"/>
                </MudStack>
            </MudTabPanel>
        </MudTabs>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="@Cancel">キャンセル</MudButton>
        @switch (_activeTabIndex)
        {
            case 0:
                <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="@SubmitSearch"
                           Disabled="@(SelectedTag == null)">
                    選択して追加
                </MudButton>
                break;
            default:
                <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="@SubmitCreateChildAsync"
                           Disabled="@(_parentTag == null || string.IsNullOrWhiteSpace(_newTagName))">
                    子タグを作成して追加
                </MudButton>
                break;
        }
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;

    private Tag? SelectedTag { get; set; }
    private string _searchText = string.Empty;

    // 状態管理用
    private bool _isSearching;
    private List<Tag>? _searchResults;

    // ===== タグツリーポップオーバー用 =====
    private List<Tag> _allTags = [];
    private int? _activeTreeTagId;

    // ===== 子タグ作成用 =====
    private int _activeTabIndex;
    private Tag? _parentTag;
    private string _newTagName = string.Empty;
    private string _newTagContent = string.Empty;

    private void OnActiveTabIndexChanged(int newIndex)
    {
        _activeTabIndex = newIndex;
        if (_activeTabIndex == 1 && _parentTag == null && SelectedTag != null)
        {
            _parentTag = SelectedTag;
        }
    }

    private void SelectParentAndOpenCreateTab(Tag tag)
    {
        _parentTag = tag;
        _activeTabIndex = 1;
    }

    private Task<IEnumerable<Tag>> SearchParentTagsAsync(string value, CancellationToken token)
    {
        switch (string.IsNullOrWhiteSpace(value))
        {
            case true:
                return Task.FromResult<IEnumerable<Tag>>(_allTags.Take(15));
            case false:
                var filtered = _allTags
                    .Where(t => t.Name.Contains(value, StringComparison.OrdinalIgnoreCase) ||
                                t.Content.Contains(value, StringComparison.OrdinalIgnoreCase))
                    .Take(15);
                return Task.FromResult(filtered);
        }
    }

    private void ToggleTree(int tagId)
    {
        switch (_activeTreeTagId == tagId)
        {
            case true:
                _activeTreeTagId = null;
                break;
            case false:
                _activeTreeTagId = tagId;
                break;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _allTags = await TagDialogData.GetAllTagsAsync();
    }

    private async Task SearchAsync()
    {
        switch (string.IsNullOrWhiteSpace(_searchText))
        {
            case true:
                _searchResults = null;
                SelectedTag = null;
                return;
        }

        _isSearching = true;
        SelectedTag = null;

        try
        {
            _searchResults = await TagDialogData.SearchTagsAsync(_searchText);

            switch (_searchResults.Count)
            {
                case 1:
                    SelectedTag = _searchResults.First();
                    break;
            }
        }
        finally
        {
            _isSearching = false;
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        switch (e.Key)
        {
            case "Enter":
                await SearchAsync();
                break;
        }
    }

    private void SubmitSearch()
    {
        MudDialog.Close(DialogResult.Ok(SelectedTag));
    }

    private async Task SubmitCreateChildAsync()
    {
        switch (string.IsNullOrWhiteSpace(_newTagName))
        {
            case true: return;
        }

        switch (_parentTag)
        {
            case null:
                Snackbar.Add("親タグを選択してください。", Severity.Warning);
                return;
        }

        string? userId = null;
        if (AuthState != null)
        {
            var authState = await AuthState;
            userId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        }

        switch (string.IsNullOrEmpty(userId))
        {
            case true:
                Snackbar.Add("ユーザーが見つかりません。", Severity.Error);
                return;
        }

        Tag? existingTag = await TagDialogData.FindTagByNameAsync(_newTagName);
        switch (existingTag)
        {
            case not null:
                Snackbar.Add("同じ名前のタグが既に存在します。", Severity.Error);
                return;
        }

        var newTag = new Tag
        {
            Name = _newTagName,
            Content = _newTagContent ?? string.Empty,
            OwnerId = userId!,
            ParentTagId = _parentTag.Id,
            CachedWeight = 0
        };

        await TagDialogData.CreateTagAsync(newTag);

        MudDialog.Close(DialogResult.Ok(newTag));
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }
}