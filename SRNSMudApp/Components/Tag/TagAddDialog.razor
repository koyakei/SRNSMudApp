@namespace SRNSMudApp.Components.Tag

<MudDialog>
    <DialogContent>
        <MudTabs ActivePanelIndex="_activeTabIndex" ActivePanelIndexChanged="@OnActiveTabIndexChanged" Elevation="0"
                 Rounded="true" ApplyEffectsToContainer="true" panelClass="pt-4">
            <MudTabPanel Text="既存タグから選択">
                <!-- 検索入力エリア -->
                <div class="d-flex align-center gap-4 mb-4">
                    <MudTextField @bind-Value="ViewModel.SearchText" Label="タグを検索" Placeholder="タグ名 または 内容を入力..."
                                  Immediate="true" OnKeyDown="@HandleKeyDown" Clearable="true" AutoFocus="true" />
                    <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="@SearchAsync">検索</MudButton>
                </div>

                <!-- 検索結果表示エリア -->
                @if (ViewModel.IsSearching)
                {
                    <div class="d-flex justify-center pa-4">
                        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                    </div>
                }
                else if (ViewModel.SearchResults != null)
                {
                    @if (ViewModel.SearchResults.Any())
                    {
                        <MudText Typo="Typo.subtitle2" Class="mb-2">検索候補から1つ選択してください：</MudText>

                        <!-- スクロール可能な一覧エリア -->
                        <div class="tag-search-results">
                            <MudRadioGroup T="Data.Tag" @bind-Value="ViewModel.SelectedTag">
                                @foreach (var tag in ViewModel.SearchResults)
                                {
                                    var isActive = _activeTreeTagId == tag.Id;
                                    <div class="d-flex align-center search-result-item">
                                        <MudRadio Value="@tag" Color="Color.Primary" Class="flex-grow-1 py-2">
                                            <div class="d-flex flex-column">
                                                <MudText Typo="Typo.body1">@tag.Name</MudText>
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                    ウェイト: @tag.CachedWeight | 内容: @tag.Content
                                                </MudText>
                                            </div>
                                        </MudRadio>
                                        <MudIconButton Icon="@Icons.Material.Filled.AccountTree" Size="Size.Small"
                                                       OnClick="@(() => ToggleTree(tag.Id))" title="タグツリーを表示" Class="ml-2" />
                                        <MudIconButton Icon="@Icons.Material.Filled.AddCircleOutline" Size="Size.Small"
                                                       Color="Color.Info" OnClick="@(() => SelectParentAndOpenCreateTab(tag))"
                                                       title="このタグの子タグを作成" Class="ml-1" />

                                        @* タグツリーポップオーバー *@
                                        <MudOverlay Visible="@isActive" OnClick="@(() => _activeTreeTagId = null)" AutoClose="true"
                                                    DarkBackground="false" ZIndex="1450" />
                                        <MudPopover Open="@isActive" AnchorOrigin="Origin.TopRight" TransformOrigin="Origin.TopLeft"
                                                    OverflowBehavior="OverflowBehavior.FlipAlways" Class="tree-popover" Paper="false"
                                                    Style="z-index: 1500; margin-left: 10px;">
                                            <TagTreePopoverContent TargetTag="@tag" AllTags="@ViewModel.AllTags" EnableSwap="false"
                                                                   EnableExpand="false" EnableNavigation="false" />
                                        </MudPopover>
                                    </div>
                                }
                            </MudRadioGroup>
                        </div>
                    }
                    else
                    {
                        <MudText Align="Align.Center" Class="px-4 py-2" Color="Color.Error">
                            一致するタグが見つかりません
                        </MudText>
                    }
                }
            </MudTabPanel>

            <MudTabPanel Text="子タグを新規作成">
                <MudStack Spacing="3">
                    <MudAutocomplete T="Data.Tag" Label="親タグ" @bind-Value="ViewModel.ParentTag"
                                     SearchFunc="@SearchParentTagsAsync" ToStringFunc="@(t => t?.Name ?? string.Empty)"
                                     Placeholder="親タグを検索・選択..." Clearable="true" Required="true" RequiredError="親タグを選択してください"
                                     Immediate="true"
                                     HelperText="@(ViewModel.ParentTag != null ? $"選択中親タグ: {ViewModel.ParentTag.Name}" : "親となるタグを検索して選択してください")" />

                    <MudTextField @bind-Value="ViewModel.NewTagName" Label="子タグ名" Required="true"
                                  RequiredError="タグ名は必須です" Immediate="true" />

                    @if (ViewModel.SimilarTags.Count > 0)
                    {
                        <MudAlert Severity="Severity.Info" Dense="true" Class="py-1 px-2" Variant="Variant.Outlined" data-testid="similar-tags-alert">
                            <div class="d-flex flex-column gap-1">
                                <MudText Typo="Typo.caption" Class="fw-bold">
                                    類似する既存タグが見つかりました（クリックで選択）：
                                </MudText>
                                <div class="d-flex flex-wrap gap-1 align-center">
                                    @foreach (var candidate in ViewModel.SimilarTags)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Filled"
                                                 OnClick="@(() => SelectExistingCandidate(candidate.Tag))"
                                                 title="@($"既存タグ: {candidate.Tag.Name} (類似度: {candidate.Similarity:P0}) - クリックで選択")"
                                                 Class="cursor-pointer" data-testid="@($"similar-tag-chip-{candidate.Tag.Id}")">
                                            <span>@candidate.Tag.Name</span>
                                            <span class="ml-1" style="font-size: 0.75rem; opacity: 0.85;">@($"{candidate.Similarity:P0}")</span>
                                        </MudChip>
                                    }
                                </div>
                            </div>
                        </MudAlert>
                    }

                    <MudTextField @bind-Value="ViewModel.NewTagContent" Label="内容" Lines="3" Immediate="true" />
                </MudStack>
            </MudTabPanel>
        </MudTabs>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="@Cancel">キャンセル</MudButton>
        @if (_activeTabIndex == 0)
        {
            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="@SubmitSearch"
                       Disabled="@(ViewModel.SelectedTag == null)">
                選択して追加
            </MudButton>
        }
        else
        {
            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="@SubmitCreateChildAsync"
                       Disabled="@(ViewModel.ParentTag == null || string.IsNullOrWhiteSpace(ViewModel.NewTagName))">
                子タグを作成して追加
            </MudButton>
        }
    </DialogActions>
</MudDialog>