@using System.Security.Claims
@using SRNSMudApp.Services
@inject ITagDialogDataProvider TagDialogData
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudTabs @bind-ActivePanelIndex="_activeTabIndex" Elevation="0" Rounded="true" ApplyEffectsToContainer="true"
                 panelClass="pt-4">
            <MudTabPanel Text="既存タグから選択">
                <!-- 検索入力エリア -->
                <div class="d-flex align-center gap-4 mb-4">
                    <MudTextField @bind-Value="_searchText"
                                  Label="タグを検索"
                                  Placeholder="タグ名 または 内容を入力..."
                                  Immediate="true"
                                  OnKeyDown="@HandleKeyDown"
                                  Clearable="true"
                                  AutoFocus="true"/>
                    <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="@SearchAsync">検索</MudButton>
                </div>

                <!-- 検索結果表示エリア -->
                @switch (_isSearching)
                {
                    case true:
                        <div class="d-flex justify-center pa-4">
                            <MudProgressCircular Color="Color.Primary" Indeterminate="true"/>
                        </div>
                        break;
                    case false when _searchResults != null:
                        switch (_searchResults.Any())
                        {
                            case true:
                                <MudText Typo="Typo.subtitle2" Class="mb-2">検索候補から1つ選択してください：</MudText>

                                <!-- スクロール可能な一覧エリア -->
                                <div class="tag-search-results">
                                    <MudRadioGroup T="Tag" @bind-Value="SelectedTag">
                                        @foreach (var tag in _searchResults)
                                        {
                                            var isActive = _activeTreeTagId == tag.Id;
                                            <div class="d-flex align-center search-result-item">
                                                <MudRadio Value="@tag" Color="Color.Primary" Class="flex-grow-1 py-2">
                                                    <div class="d-flex flex-column">
                                                        <MudText Typo="Typo.body1">@tag.Name</MudText>
                                                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                            ウェイト: @tag.CachedWeight | 内容: @tag.Content
                                                        </MudText>
                                                    </div>
                                                </MudRadio>
                                                <MudIconButton Icon="@Icons.Material.Filled.AccountTree"
                                                               Size="Size.Small"
                                                               OnClick="@(() => ToggleTree(tag.Id))"
                                                               title="タグツリーを表示"
                                                               Class="ml-2"/>

                                                @* タグツリーポップオーバー *@
                                                <MudPopover Open="@isActive"
                                                            AnchorOrigin="Origin.TopRight"
                                                            TransformOrigin="Origin.TopLeft"
                                                            OverflowBehavior="OverflowBehavior.FlipAlways"
                                                            Class="tree-popover" Paper="false">
                                                    <TagTreePopoverContent TargetTag="@tag"
                                                                           AllTags="@_allTags"
                                                                           EnableSwap="false"
                                                                           EnableExpand="false"
                                                                           EnableNavigation="false"/>
                                                </MudPopover>
                                            </div>
                                        }
                                    </MudRadioGroup>
                                </div>
                                break;
                            case false:
                                <MudText Align="Align.Center" Class="px-4 py-2" Color="Color.Error">
                                    一致するタグが見つかりません
                                </MudText>
                                break;
                        }
                        break;
                }
            </MudTabPanel>

            <MudTabPanel Text="新規作成">
                <MudTextField @bind-Value="_newTagName" Label="タグ名" Required="true" RequiredError="タグ名は必須です"
                              Immediate="true" Class="mb-3"/>
                <MudTextField @bind-Value="_newTagContent" Label="内容" Lines="3" Immediate="true"/>
            </MudTabPanel>
        </MudTabs>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="@Cancel">キャンセル</MudButton>
        @switch (_activeTabIndex)
        {
            case 0:
                <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="@SubmitSearch"
                           Disabled="@(SelectedTag == null)">
                    選択して追加
                </MudButton>
                break;
            default:
                <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="@SubmitCreateAsync"
                           Disabled="@(string.IsNullOrWhiteSpace(_newTagName))">
                    作成して追加
                </MudButton>
                break;
        }
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;

    private Tag? SelectedTag { get; set; }
    private string _searchText = string.Empty;

    // 状態管理用
    private bool _isSearching;
    private List<Tag>? _searchResults;

    // ===== タグツリーポップオーバー用 =====
    private List<Tag> _allTags = [];
    private int? _activeTreeTagId;

    // ===== 新規作成用 =====
    private int _activeTabIndex;
    private string _newTagName = string.Empty;
    private string _newTagContent = string.Empty;

    private void ToggleTree(int tagId)
    {
        switch (_activeTreeTagId == tagId)
        {
            case true:
                _activeTreeTagId = null;
                break;
            case false:
                _activeTreeTagId = tagId;
                break;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _allTags = await TagDialogData.GetAllTagsAsync();
    }

    private async Task SearchAsync()
    {
        switch (string.IsNullOrWhiteSpace(_searchText))
        {
            case true:
                _searchResults = null;
                SelectedTag = null;
                return;
        }

        _isSearching = true;
        SelectedTag = null; // 検索のたびに選択状態をリセット
        // StateHasChanged();

        try
        {
            _searchResults = await TagDialogData.SearchTagsAsync(_searchText);

            // ▼ UX向上：ヒットした結果が1件だけなら自動的に選択状態にする
            switch (_searchResults.Count)
            {
                case 1:
                    SelectedTag = _searchResults.First();
                    break;
            }
        }
        finally
        {
            _isSearching = false;
            // StateHasChanged();
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        // Enterキーが押されたら検索を実行
        switch (e.Key)
        {
            case "Enter":
                await SearchAsync();
                break;
        }
    }

    private void SubmitSearch()
    {
        MudDialog.Close(DialogResult.Ok(SelectedTag));
    }

    private async Task SubmitCreateAsync()
    {
        switch (string.IsNullOrWhiteSpace(_newTagName))
        {
            case true: return;
        }

        var authState = await AuthState!;
        var userId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        switch (string.IsNullOrEmpty(userId))
        {
            case true:
                Snackbar.Add("ユーザーが見つかりません。", Severity.Error);
                return;
        }

        Tag? existingTag = await TagDialogData.FindTagByNameAsync(_newTagName);
        switch (existingTag)
        {
            case not null:
                Snackbar.Add("同じ名前のタグが既に存在します。", Severity.Error);
                return;
        }

        var newTag = new Tag
        {
            Name = _newTagName,
            Content = _newTagContent ?? string.Empty,
            OwnerId = userId!,
            CachedWeight = 0
        };

        await TagDialogData.CreateTagAsync(newTag);

        MudDialog.Close(DialogResult.Ok(newTag));
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }

}