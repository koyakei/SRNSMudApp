
@using SRNSMudApp.Components.UI

@{
    // 純粋な表示計算は ItemTagChipViewModel に委譲
    var vm = ItemTagChipViewModel.GetDisplay(TagRelation, Item.Id, CurrentUserId, HighlightEvent,
        ChipIndex, ChipBackgrounds, ChipTextColors, ShowNameAndOwner, AllTagRelationsToTags);
}

<BaseTagChip ChipId="@vm.ChipId"
             TagName="@vm.TagName"
             Style="@($"background: {vm.BackgroundColor}; color: {vm.TextColor}; font-weight: {vm.FontWeight}")"
             TagStyle="@(vm.IsDeleted switch { true => "text-decoration: line-through;", false => "" })"
             OwnerName="@vm.OwnerName"
             CloseIcon="@Icons.Material.Filled.RemoveCircleOutline"
             OnClose="@(_ => RemoveTagRelationAsync())"
             OnClick="@(() => NavigationManager.NavigateTo($"/TagDetail/{vm.TagId}"))">
    <PrefixContent>
        <MudIconButton Icon="@Icons.Material.Filled.LocalOffer"
                       Size="Size.Small" Color="Color.Inherit"
                       Class="chip-icon-btn mr-1"
                       OnClick="@(() => OnAddTagToTagClicked(TagRelation.Tag))"/>
    </PrefixContent>
    <WeightContent>
        <ItemTagChipWeightContent IsDeleted="@vm.IsDeleted"
                                  IsMyTag="@vm.IsMyTag"
                                  DisplayWeight="@vm.DisplayWeight"
                                  AddButtonColor="@vm.AddButtonColor"
                                  OnDecreaseWeight="@(() => UpdateTagRelationWeightAsync(-1))"
                                  OnIncreaseWeight="@(() => UpdateTagRelationWeightAsync(1))"
                                  OnEditWeight="EditTagRelationWeightAsync"
                                  OnRemoveRelation="RemoveTagRelationAsync"/>
    </WeightContent>
    <ActionContent>
        <MudIconButton Icon="@Icons.Material.Filled.AccountTree"
                       Size="Size.Small" Color="Color.Inherit"
                       Class="chip-icon-btn ml-1"
                       Title="タグツリーを表示"
                       OnClick="ToggleTagTreePopover"/>
    </ActionContent>
    <PopoverContent>
        <AddedTagsPopover IsOpen="@_isTreePopoverOpen"
                          AddedTags="@vm.AddedTags"
                          OnRemoveRelation="RemoveTagToTagRelationAsync"
                          OnNavigate="@(tagId => NavigationManager.NavigateTo($"/TagDetail/{tagId}"))"/>

        @* タグツリーポップオーバー *@
        <MudOverlay Visible="@(_isTreePopoverOpen && TagRelation.Tag != null)"
                    OnClick="@ToggleTagTreePopover"
                    AutoClose="true"
                    DarkBackground="false" />
        <MudPopover Open="@(_isTreePopoverOpen && TagRelation.Tag != null)"
                    AnchorOrigin="Origin.TopCenter"
                    TransformOrigin="Origin.BottomCenter"
                    OverflowBehavior="OverflowBehavior.FlipAlways"
                    Class="tree-popover" Paper="false">
            <TagTreePopoverContent TargetTag="@TagRelation.Tag"
                                   AllTags="@AllTags"
                                   EnableSwap="true"
                                   EnableExpand="true"
                                   EnableNavigation="true"
                                   EnableAddChild="true"
                                   OnAddChildTag="OnAddChildTagFromTree"
                                   OnSwap="ChangeItemTagAsync"/>
        </MudPopover>
    </PopoverContent>
</BaseTagChip>

