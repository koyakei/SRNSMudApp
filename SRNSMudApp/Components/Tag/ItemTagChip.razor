@using SRNSMudApp.Components.Contract
@using SRNSMudApp.Components.UI
@using SRNSMudApp.Services
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager
@inject IItemTagService ItemTagService

@{
    var tagId = TagRelation.Tag?.Id ?? -1;
    var isDeleted = HighlightEvent?.EventType == "Delete";
    var isInserted = HighlightEvent?.EventType == "Insert";
    var isUpdated = HighlightEvent?.EventType == "Update";
    var weightIncreased = HighlightEvent != null && HighlightEvent.NewWeight > (HighlightEvent.PreviousWeight ?? 0);

    var isMyTag = TagRelation.OwnerId == CurrentUserId;
    
    var bgColor = isDeleted switch
    {
        true => "#E0E0E0",
        false => (HighlightEvent != null) switch
        {
            true => "#FFEB3B",
            false => isMyTag switch
            {
                true => ChipIndex < ChipBackgrounds.Length ? ChipBackgrounds[ChipIndex] : ChipBackgrounds[0],
                false => "#FFF9C4"
            }
        }
    };

    var textColor = isDeleted switch
    {
        true => "#9E9E9E",
        false => (HighlightEvent != null) switch
        {
            true => "#F57F17",
            false => isMyTag switch
            {
                true => ChipIndex < ChipTextColors.Length ? ChipTextColors[ChipIndex] : ChipTextColors[0],
                false => "#5C4B00"
            }
        }
    };

    var fontWeight = (HighlightEvent != null) switch
    {
        true => "bold",
        false => "normal"
    };

    var tagName = ShowNameAndOwner switch
    {
        true => TagRelation.Tag?.Name ?? "不明",
        false => (string?)null
    };

    var ownerName = ShowNameAndOwner switch
    {
        true => GetShortOwnerName(TagRelation.Tag?.Owner?.UserName),
        false => (string?)null
    };

    var chipId = $"tag-chip-{Item.Id}-{tagId}";
    var displayWeight = isDeleted switch
    {
        true => $"{HighlightEvent?.PreviousWeight}",
        false => (isUpdated || isInserted) switch
        {
            true => $"{HighlightEvent?.PreviousWeight ?? 0} → {HighlightEvent?.NewWeight}",
            false => TagRelation.Weight.ToString()
        }
    };
    
    var addBtnColor = weightIncreased switch
    {
        true => Color.Success,
        false => Color.Inherit
    };

    var addedTags = AllTagRelationsToTags
        .Where(ttr => ttr.TargetTagId == tagId && ttr.Tag != null && !ttr.Tag.IsSystem)
        .ToList();
}

<BaseTagChip ChipId="@chipId"
             TagName="@tagName"
             Style="@($"background: {bgColor}; color: {textColor}; font-weight: {fontWeight}")"
             TagStyle="@(isDeleted switch { true => "text-decoration: line-through;", false => "" })"
             OwnerName="@ownerName"
             CloseIcon="@Icons.Material.Filled.RemoveCircleOutline"
             OnClose="@(_ => RemoveTagRelationAsync())"
             OnClick="@(() => NavigationManager.NavigateTo($"/TagDetail/{tagId}"))">
    <PrefixContent>
        <MudIconButton Icon="@Icons.Material.Filled.LocalOffer"
                       Size="Size.Small" Color="Color.Inherit"
                       Class="chip-icon-btn mr-1"
                       OnClick="@(() => OnAddTagToTagClicked(TagRelation.Tag))"/>
    </PrefixContent>
    <WeightContent>
        @switch (isDeleted)
        {
            case false:
                <MudIconButton Icon="@Icons.Material.Filled.Remove" Size="Size.Small"
                               Color="Color.Inherit" Class="chip-icon-btn pa-0 mx-1"
                               OnClick="@(() => UpdateTagRelationWeightAsync(-1))"
                               title="Weightを減らす"/>
                break;
            case true:
                break;
        }
        <MudLink Color="Color.Inherit" Underline="Underline.Hover"
                 Class="mx-1 cursor-pointer font-weight-bold" OnClick="@(async () =>
                                                                       {
                                                                           await (isDeleted switch
                                                                           {
                                                                               false => EditTagRelationWeightAsync(),
                                                                               true => Task.CompletedTask
                                                                           });
                                                                       })">
            @switch (isDeleted)
            {
                case true:
                    <MudIcon Icon="@Icons.Material.Outlined.Delete" Size="Size.Small"
                             Class="mr-1" Style="font-size: 1rem; vertical-align: middle;"/>
                    break;
                case false:
                    break;
            }
            <span style="vertical-align: middle;">@displayWeight</span>
        </MudLink>
        @switch (isDeleted)
        {
            case false:
                <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small"
                               Color="@addBtnColor" Class="chip-icon-btn pa-0 mx-1"
                               OnClick="@(() => UpdateTagRelationWeightAsync(1))"
                               title="Weightを増やす"/>

                <MudIconButton
                    Icon="@(isMyTag switch { true => Icons.Material.Filled.Delete, false => Icons.Material.Outlined.Delete })"
                    Size="Size.Small"
                    Color="Color.Inherit" Class="chip-icon-btn pa-0 mx-1"
                    OnClick="@RemoveTagRelationAsync"
                    title="関連付けを削除"/>
                break;
            case true:
                break;
        }
    </WeightContent>
    <ActionContent>
        <MudIconButton Icon="@Icons.Material.Filled.AccountTree"
                       Size="Size.Small" Color="Color.Inherit"
                       Class="chip-icon-btn ml-1"
                       OnClick="ToggleTagTreePopover"/>
    </ActionContent>
    <PopoverContent>
        @switch (addedTags.Any())
        {
            case true:
                <MudPopover Open="@_isTreePopoverOpen"
                            AnchorOrigin="Origin.BottomCenter"
                            TransformOrigin="Origin.TopCenter"
                            OverflowBehavior="OverflowBehavior.FlipAlways"
                            Paper="true"
                            Class="added-tags-popover pa-2 mt-1 rounded-lg">
                    <div class="d-flex flex-column gap-1">
                        @foreach (var added in addedTags)
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                                     Color="Color.Primary"
                                     Class="small-chip"
                                     CloseIcon="@Icons.Material.Filled.RemoveCircleOutline"
                                     OnClose="@(_ => RemoveTagToTagRelationAsync(added))">
                                <div class="d-flex align-center">
                                    <MudIcon
                                        Icon="@Icons.Material.Filled.SubdirectoryArrowRight"
                                        Size="Size.Small"
                                        Class="mr-1 small-icon"/>
                                    <a class="small-chip-link"
                                       @onclick="@(() => NavigationManager.NavigateTo($"/TagDetail/{added.TagId}"))"
                                       @onclick:stopPropagation="true">
                                        @added.Tag?.Name
                                    </a>
                                </div>
                            </MudChip>
                        }
                    </div>
                </MudPopover>
                break;
            case false:
                break;
        }

        @* タグツリーポップオーバー *@
        <MudPopover Open="@(_isTreePopoverOpen && TagRelation.Tag != null)"
                    AnchorOrigin="Origin.TopCenter"
                    TransformOrigin="Origin.BottomCenter"
                    OverflowBehavior="OverflowBehavior.FlipAlways"
                    Class="tree-popover" Paper="false">
            <TagTreePopoverContent TargetTag="@TagRelation.Tag"
                                   AllTags="@AllTags"
                                   EnableSwap="true"
                                   EnableExpand="true"
                                   EnableNavigation="true"
                                   EnableAddChild="true"
                                   OnAddChildTag="OnAddChildTagFromTree"
                                   OnSwap="ChangeItemTagAsync"/>
        </MudPopover>
    </PopoverContent>
</BaseTagChip>

@code {
    [Parameter] [EditorRequired] public TagRelation TagRelation { get; set; } = null!;
    [Parameter] [EditorRequired] public Item Item { get; set; } = null!;
    [Parameter] public string CurrentUserId { get; set; } = "";
    [Parameter] public List<Tag> AllTags { get; set; } = [];
    [Parameter] public List<TagRelationToTag> AllTagRelationsToTags { get; set; } = [];
    [Parameter] public TimelineEvent? HighlightEvent { get; set; }
    [Parameter] public EventCallback OnDataChanged { get; set; }
    [Parameter] public int ChipIndex { get; set; }
    [Parameter] public string[] ChipBackgrounds { get; set; } = ["#EEEDFE"];
    [Parameter] public string[] ChipTextColors { get; set; } = ["#26215C"];
    [Parameter] public bool ShowNameAndOwner { get; set; } = true;

    private bool _isTreePopoverOpen;

    private void ToggleTagTreePopover()
    {
        _isTreePopoverOpen = !_isTreePopoverOpen;
    }

    private static string GetShortOwnerName(string? name)
    {
        return ItemCardViewModel.GetShortOwnerName(name);
    }

    private async Task RemoveTagRelationAsync()
    {
        await ((TagRelation.OwnerId == CurrentUserId, TagRelation.Tag != null) switch
        {
            (false, true) => ProposeRemovalContractAsync(),
            (true, _) => ExecuteRemovalAsync(),
            _ => Task.CompletedTask
        });
    }

    private async Task ProposeRemovalContractAsync()
    {
        var parameters = new DialogParameters<ProposeContractDialog>
        {
            { x => x.TargetItem, Item },
            { x => x.RequestedTag, TagRelation.Tag },
            { x => x.WeightDelta, -TagRelation.Weight },
            { x => x.IsRemovalRequest, true }
        };
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<ProposeContractDialog>("コントラクトの提案", parameters, options);
        var result = await dialog.Result;
        
        await ((result?.Canceled == true) switch
        {
            false => OnDataChanged.HasDelegate ? OnDataChanged.InvokeAsync() : Task.CompletedTask,
            _ => Task.CompletedTask
        });
    }

    private async Task ExecuteRemovalAsync()
    {
        var error = await ItemTagService.RemoveTagRelationAsync(TagRelation.Id, CurrentUserId);
        await (error switch
        {
            null => HandleSuccessfulRemoval(),
            _ => HandleError(error)
        });
    }
    
    private Task HandleSuccessfulRemoval()
    {
        var localRelation = Item.TagRelations.FirstOrDefault(tr => tr.Id == TagRelation.Id);
        _ = localRelation switch
        {
            not null => Item.TagRelations.Remove(localRelation),
            _ => false
        };

        Snackbar.Add("タグの関連付けを解除しました。", Severity.Success);
        return OnDataChanged.HasDelegate ? OnDataChanged.InvokeAsync() : Task.CompletedTask;
    }

    private Task HandleError(string error)
    {
        Snackbar.Add(error, Severity.Error);
        return Task.CompletedTask;
    }

    private async Task UpdateTagRelationWeightAsync(int delta)
    {
        await ((TagRelation.OwnerId == CurrentUserId, TagRelation.Tag != null) switch
        {
            (false, true) => ProposeUpdateContractAsync(delta),
            (true, _) => ExecuteWeightUpdateAsync(delta),
            _ => Task.CompletedTask
        });
    }

    private async Task ProposeUpdateContractAsync(int delta)
    {
        var parameters = new DialogParameters<ProposeContractDialog>
        {
            { x => x.TargetItem, Item },
            { x => x.RequestedTag, TagRelation.Tag },
            { x => x.WeightDelta, delta },
            { x => x.IsRemovalRequest, false }
        };
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<ProposeContractDialog>("コントラクトの提案", parameters, options);
        var result = await dialog.Result;
        
        await ((result?.Canceled == true) switch
        {
            false => OnDataChanged.HasDelegate ? OnDataChanged.InvokeAsync() : Task.CompletedTask,
            _ => Task.CompletedTask
        });
    }

    private async Task ExecuteWeightUpdateAsync(int delta)
    {
        var result = await ItemTagService.UpdateTagWeightAsync(TagRelation.Id, delta, CurrentUserId);
        await (result switch
        {
            UpdateWeightResult.Success => OnDataChanged.HasDelegate ? OnDataChanged.InvokeAsync() : Task.CompletedTask,
            UpdateWeightResult.NoPermission => HandleError("関連付けた本人ではないため、Weightを変更する権限がありません。"),
            UpdateWeightResult.NotFound => HandleError("タグの関連付けが見つかりません。"),
            _ => HandleError("不明なエラーが発生しました。")
        });
    }

    private async Task EditTagRelationWeightAsync()
    {
        await ((TagRelation.OwnerId == CurrentUserId) switch
        {
            false => HandleError("関連付けた本人ではないため、Weightを変更する権限がありません。"),
            true => ShowEditWeightDialogAsync()
        });
    }

    private async Task ShowEditWeightDialogAsync()
    {
        var parameters = new DialogParameters { ["Weight"] = TagRelation.Weight };
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.ExtraSmall, FullWidth = true };
        var dialog = await DialogService.ShowAsync<WeightEditDialog>("Weightの一括変更", parameters, options);
        var result = await dialog.Result;

        await ((result?.Canceled == false, result?.Data is int) switch
        {
            (true, true) => HandleWeightEditResult((int)result.Data!),
            _ => Task.CompletedTask
        });
    }

    private async Task HandleWeightEditResult(int newWeight)
    {
        await ((newWeight == TagRelation.Weight) switch
        {
            true => Task.CompletedTask,
            false => ExecuteSetWeightAsync(newWeight)
        });
    }

    private async Task ExecuteSetWeightAsync(int newWeight)
    {
        var error = await ItemTagService.SetTagWeightAsync(TagRelation.Id, newWeight, CurrentUserId);
        await (error switch
        {
            null => OnDataChanged.HasDelegate ? OnDataChanged.InvokeAsync() : Task.CompletedTask,
            _ => HandleError(error)
        });
    }

    private async Task ChangeItemTagAsync(int newTagId)
    {
        await ((TagRelation.TagId == newTagId) switch
        {
            true => Task.CompletedTask,
            false => (TagRelation.OwnerId == CurrentUserId) switch
            {
                false => HandleError("関連付けた本人ではないため、変更する権限がありません。"),
                true => ExecuteChangeTagAsync(newTagId)
            }
        });
    }

    private async Task ExecuteChangeTagAsync(int newTagId)
    {
        var error = await ItemTagService.ChangeItemTagAsync(TagRelation.Id, newTagId, Item.Id, CurrentUserId);
        await (error switch
        {
            null => HandleSuccessfulChangeTag(),
            _ => HandleError(error)
        });
    }

    private Task HandleSuccessfulChangeTag()
    {
        Snackbar.Add("タグを変更しました。", Severity.Success);
        _isTreePopoverOpen = false;
        return OnDataChanged.HasDelegate ? OnDataChanged.InvokeAsync() : Task.CompletedTask;
    }

    private async Task OnAddTagToTagClicked(Tag? targetTag)
    {
        await (targetTag switch
        {
            null => Task.CompletedTask,
            not null => ShowAddTagToTagDialogAsync(targetTag)
        });
    }

    private async Task ShowAddTagToTagDialogAsync(Tag targetTag)
    {
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Large, FullWidth = true };
        var dialog = await DialogService.ShowAsync<TagAddDialog>("関連タグの追加", options);
        var result = await dialog.Result;

        await ((result?.Canceled == false, result?.Data is Tag) switch
        {
            (true, true) => ExecuteAddTagToTagAsync(targetTag, (Tag)result.Data!),
            _ => Task.CompletedTask
        });
    }

    private async Task ExecuteAddTagToTagAsync(Tag targetTag, Tag selectedTag)
    {
        var error = await ItemTagService.AddTagToTagAsync(targetTag.Id, selectedTag.Id, CurrentUserId);
        await (error switch
        {
            null => HandleSuccessfulAddTagToTag(),
            _ => HandleError(error)
        });
    }

    private Task HandleSuccessfulAddTagToTag()
    {
        Snackbar.Add("タグを追加しました。", Severity.Success);
        return OnDataChanged.HasDelegate ? OnDataChanged.InvokeAsync() : Task.CompletedTask;
    }

    private async Task RemoveTagToTagRelationAsync(TagRelationToTag relation)
    {
        await ((relation.OwnerId == CurrentUserId) switch
        {
            false => HandleError("関連付けた本人ではないため、解除する権限がありません。"),
            true => ExecuteRemoveTagToTagAsync(relation.Id)
        });
    }

    private async Task ExecuteRemoveTagToTagAsync(int relationId)
    {
        var error = await ItemTagService.RemoveTagToTagRelationAsync(relationId, CurrentUserId);
        await (error switch
        {
            null => HandleSuccessfulRemoveTagToTag(),
            _ => HandleError(error)
        });
    }

    private Task HandleSuccessfulRemoveTagToTag()
    {
        Snackbar.Add("タグの関連付けを解除しました。", Severity.Success);
        return OnDataChanged.HasDelegate ? OnDataChanged.InvokeAsync() : Task.CompletedTask;
    }

    private async Task OnAddChildTagFromTree(Tag? targetTag)
    {
        await (targetTag switch
        {
            null => Task.CompletedTask,
            not null => ShowAddChildTagDialogAsync(targetTag)
        });
    }

    private async Task ShowAddChildTagDialogAsync(Tag targetTag)
    {
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Large, FullWidth = true };
        var dialog = await DialogService.ShowAsync<TagAddDialog>("子タグの追加", options);
        var result = await dialog.Result;

        await ((result?.Canceled == false, result?.Data is Tag) switch
        {
            (true, true) => ExecuteSetParentTagAsync(targetTag, (Tag)result.Data!),
            _ => Task.CompletedTask
        });
    }

    private async Task ExecuteSetParentTagAsync(Tag parentTag, Tag childTag)
    {
        var error = await ItemTagService.SetParentTagAsync(parentTag.Id, childTag.Id, CurrentUserId, AllTags);
        await (error switch
        {
            null => HandleSuccessfulSetParentTag(),
            _ => HandleError(error)
        });
    }

    private Task HandleSuccessfulSetParentTag()
    {
        Snackbar.Add("子タグとして設定しました。", Severity.Success);
        return OnDataChanged.HasDelegate ? OnDataChanged.InvokeAsync() : Task.CompletedTask;
    }
}