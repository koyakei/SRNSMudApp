@if (_visible)
{
    <MudBadge Content="@_replyCount" Color="Color.Primary" Overlap="true" Visible="@(_replyCount > 0)">
        <MudChip T="string" Size="Size.Small" Color="@(_isAdd ? Color.Success : Color.Error)" Variant="Variant.Outlined"
                 Icon="@(_isAdd ? Icons.Material.Filled.Add : Icons.Material.Filled.Remove)">
            <div class="d-flex align-center">
                <a class="chip-link mr-1" style="color: inherit;"
                   href="@($"/TagDetail/{Request.RequestedTagId}")"
                   @onclick:stopPropagation="true">
                    @Request.RequestedTag?.Name
                </a>
                <MudIconButton Icon="@Icons.Material.Filled.ChatBubbleOutline" Size="Size.Small" Color="Color.Inherit"
                               Class="pa-0" OnClick="OpenThreadDialogAsync" />
            </div>
        </MudChip>
    </MudBadge>
}
