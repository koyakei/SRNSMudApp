@using SRNSMudApp.Components.Tag
@using SRNSMudApp.Data
@using SRNSMudApp.Models

<div class="d-flex justify-space-between align-center mb-4">
    <MudText Typo="Typo.h5">付けられたタグ</MudText>

    <MudAutocomplete @ref="_autocomplete"
                     T="string"
                     Value="@_searchString"
                     ValueChanged="HandleValueChangedAsync"
                     SearchFunc="@SearchSuggestionsAsync"
                     Placeholder="タグ名 または タグ名 @@ユーザー名 で検索..."
                     Adornment="Adornment.Start"
                     AdornmentIcon="@Icons.Material.Filled.Search"
                     IconSize="Size.Medium"
                     Class="mt-0 search-input"
                     DebounceInterval="300"
                     Clearable="true"
                     ResetValueOnEmptyText="true"
                     MaxItems="10"/>
</div>

<MudTable Items="@TagRelations" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm" Filter="FilterFunc"
          LoadingProgressColor="Color.Info">
    <HeaderContent>
        <MudTh>Name</MudTh>
        <MudTh>Content</MudTh>
        <MudTh>Username</MudTh>
        <MudTh>Actions</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Name">
            <a href="@($"/TagDetail/{context.TagId}")" class="mud-primary-text font-weight-bold" style="text-decoration: none;">
                @context.Tag?.Name
            </a>
        </MudTd>
        <MudTd DataLabel="Content">
            <div style="max-width: 300px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="@context.Tag?.Content">
                @context.Tag?.Content
            </div>
        </MudTd>
        <MudTd DataLabel="Username">
            @context.Tag?.Owner?.UserName
        </MudTd>
        <MudTd DataLabel="Actions">
            <ActionTagChip TagRelation="@context"
                           Item="@Item"
                           CurrentUserId="@CurrentUserId"
                           AllTags="@AllTags"
                           AllTagRelationsToTags="@AllTagRelationsToTags"
                           OnDataChanged="OnDataChanged"
                           ChipIndex="0"/>
        </MudTd>
    </RowTemplate>
    <PagerContent>
        <MudTablePager/>
    </PagerContent>
</MudTable>

<MudPaper Class="pa-4 mt-4" Elevation="1">
    <div class="d-flex align-center gap-4 flex-wrap">
        <MudText Typo="Typo.subtitle1" Class="mr-2">タグ付与依頼:</MudText>
        
        <MudAutocomplete T="ApplicationUser"
                         Value="_selectedTargetUser"
                         ValueChanged="@(user => _selectedTargetUser = user)"
                         SearchFunc="@SearchUsersAsync"
                         ToStringFunc="@(u => u?.UserName)"
                         Placeholder="依頼先のユーザーを検索..."
                         ResetValueOnEmptyText="true"
                         Clearable="true"
                         Adornment="Adornment.Start"
                         AdornmentIcon="@Icons.Material.Filled.PersonSearch"
                         Style="min-width: 250px;" />
        
        <MudButton Variant="Variant.Filled" 
                   Color="Color.Primary" 
                   OnClick="RequestSelectedTagAddAsync"
                   StartIcon="@Icons.Material.Filled.Send">
            リクエストを送信
        </MudButton>
    </div>
</MudPaper>