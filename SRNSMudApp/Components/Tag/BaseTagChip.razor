<span id="@ChipId" class="position-relative d-inline-flex align-center">
    <MudChip T="string" Size="Size.Small"
             Class="@($"custom-chip {Class}")"
             Style="@Style"
             Color="@Color"
             Variant="@Variant"
             CloseIcon="@CloseIcon"
             OnClose="@OnClose">
        <div class="d-flex align-center">
            @switch (string.IsNullOrEmpty(TagName), OwnerName != null)
            {
                case (false, _):
                case (_, true):
                    <span class="d-flex align-center mr-1">
                        @switch (string.IsNullOrEmpty(TagName))
                        {
                            case false:
                                <a class="chip-link mr-1"
                                   style="@TagStyle"
                                   @onclick="HandleTagClick"
                                   @onclick:stopPropagation="true">
                                    @TagName
                                </a>
                                break;
                        }
                        @switch (OwnerName)
                        {
                            case not null:
                                <span class="ml-1" @onclick:stopPropagation="true">(@OwnerName)</span>
                                break;
                        }
                    </span>
                    break;
            }

            @switch (PrefixContent)
            {
                case not null:
                    <div class="d-flex align-center" @onclick:stopPropagation="true">
                        @PrefixContent
                    </div>
                    break;
            }
            <span class="d-flex align-center">
                @switch (WeightContent)
                {
                    case not null:
                        <span class="mx-1 d-flex align-center font-weight-bold" @onclick:stopPropagation="true">
                            @WeightContent
                        </span>
                        break;
                    case null when Weight != 0:
                        <span class="mx-1 font-weight-bold" @onclick:stopPropagation="true">
                            @Weight
                        </span>
                        break;
                }
            </span>
            @switch (ActionContent)
            {
                case not null:
                    <div class="d-flex align-center" @onclick:stopPropagation="true">
                        @ActionContent
                    </div>
                    break;
            }
        </div>
    </MudChip>
    @switch (PopoverContent)
    {
        case not null:
            @PopoverContent
            break;
    }
</span>

@code {
    [Parameter] public string ChipId { get; set; } = "";
    [Parameter] public string TagName { get; set; } = "";
    [Parameter] public int Weight { get; set; }
    [Parameter] public string? Style { get; set; }
    [Parameter] public string? TagStyle { get; set; }
    [Parameter] public Color Color { get; set; } = Color.Primary;
    [Parameter] public Variant Variant { get; set; } = Variant.Filled;
    [Parameter] public string? OwnerName { get; set; }
    [Parameter] public string? CloseIcon { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public EventCallback<MudChip<string>> OnClose { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }
    [Parameter] public RenderFragment? PrefixContent { get; set; }
    [Parameter] public RenderFragment? WeightContent { get; set; }
    [Parameter] public RenderFragment? ActionContent { get; set; }
    [Parameter] public RenderFragment? PopoverContent { get; set; }

    private async Task HandleTagClick()
    {
        switch (OnClick.HasDelegate)
        {
            case true:
                await OnClick.InvokeAsync();
                break;
        }
    }

}