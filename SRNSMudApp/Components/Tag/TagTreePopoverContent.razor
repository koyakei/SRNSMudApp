@namespace SRNSMudApp.Components.Tag

<MudPaper Outlined="true" Class="tag-tree-popover-content rounded-lg pa-2"
          Style="@($"max-height: {MaxHeight}; overflow-y: auto; overscroll-behavior: contain; box-shadow: 0 8px 32px rgba(0, 0, 0, 0.18), 0 2px 8px rgba(0, 0, 0, 0.10); {Style}")">
    <MudList T="object" Dense="true" Class="pa-0">
        @foreach (var line in _treeLines)
        {
            <MudListItem id="@(line.IsCurrent ? "tag-tree-current-line" : null)" OnClick="@(() => OnLineClicked(line))"
                         Class="@($"pa-0 px-2 rounded {(line.IsCurrent ? "current" : "")} {(line.IsParent ? "parent" : "")} {(line.IsChild ? "child" : "")} {(line.IsSibling ? "sibling" : "")} {(EnableExpand ? "cursor-pointer" : "")}")"
                         Style="@(line.IsCurrent ? "background: rgba(103, 80, 164, 0.08);" : null)">
                <div class="d-flex align-center tag-tree-line" style="gap: 4px; padding: 2px 0;">
                    <span class="tag-tree-indent">
                        <MudText Typo="Typo.body2" Color="Color.Secondary"
                                 Style="white-space: pre; font-family: monospace;">
                            @line.Indent
                        </MudText>
                    </span>
                    <span class="tag-tree-icon" style="font-size: 10px; width: 14px; flex-shrink: 0;">@line.Icon</span>

                    @if (OnTagClick.HasDelegate)
                    {
                        <span @onclick:stopPropagation="true" class="tag-tree-name tag-link"
                              style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                            <MudLink Typo="Typo.body2" Color="Color.Primary" Style="font-weight: 500;"
                                     OnClick="@(() => OnTagClick.InvokeAsync(line.TagId))">
                                @line.Name
                            </MudLink>
                        </span>
                    }
                    else if (EnableNavigation)
                    {
                        <span @onclick:stopPropagation="true" class="tag-tree-name tag-link"
                              style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                            <MudLink Typo="Typo.body2" Color="Color.Primary" Style="font-weight: 500;"
                                     Href="@($"/TagDetail/{line.TagId}")">
                                @line.Name
                            </MudLink>
                        </span>
                    }
                    else
                    {
                        <MudText Typo="Typo.body2" Color="Color.Primary"
                                 Style="font-weight: 500; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;"
                                 Class="tag-tree-name">
                            @line.Name
                        </MudText>
                    }

                    @if (!string.IsNullOrEmpty(line.Role))
                    {
                        <span class="tag-tree-role">@line.Role</span>
                    }
                    <div style="flex: 1;"></div>
                    @if (!line.IsCurrent && EnableSwap)
                    {
                        <span class="tag-tree-swap-btn" @onclick:stopPropagation="true">
                            <MudIconButton Icon="@Icons.Material.Filled.SwapHoriz" Size="Size.Small" Color="Color.Primary"
                                           Class="pa-1" OnClick="@(() => OnSwap.InvokeAsync(line.TagId))" title="このタグに入れ替える" />
                        </span>
                    }
                    @if (EnableAddChild)
                    {
                        <span class="tag-tree-add-btn" @onclick:stopPropagation="true">
                            <MudIconButton Icon="@Icons.Material.Filled.AddCircleOutline" Size="Size.Small"
                                           Color="Color.Primary" Class="pa-1" OnClick="@(() => AddChildTagClicked(line.TagId))"
                                           title="このタグの子にタグを追加" />
                        </span>
                    }
                </div>
            </MudListItem>
        }
    </MudList>
</MudPaper>