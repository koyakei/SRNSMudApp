@inject NavigationManager NavigationManager

<MudPaper Outlined="true" Class="tag-tree-popover-content rounded-lg pa-2"
          Style="@($"max-height: {MaxHeight}; overflow-y: auto; overscroll-behavior: contain; box-shadow: 0 8px 32px rgba(0, 0, 0, 0.18), 0 2px 8px rgba(0, 0, 0, 0.10); {Style}")">
    <MudList T="object" Dense="true" Class="pa-0">
        @foreach (var line in _treeLines)
        {
            <MudListItem id="@(line.IsCurrent ? "tag-tree-current-line" : null)"
                         OnClick="@(() => OnLineClicked(line))"
                         Class="@($"pa-0 px-2 rounded {(line.IsCurrent ? "current" : "")} {(line.IsParent ? "parent" : "")} {(line.IsChild ? "child" : "")} {(line.IsSibling ? "sibling" : "")} {(EnableExpand ? "cursor-pointer" : "")}")"
                         Style="@(line.IsCurrent ? "background: rgba(103, 80, 164, 0.08);" : null)">
                <div class="d-flex align-center tag-tree-line" style="gap: 4px; padding: 2px 0;">
                    <span class="tag-tree-indent">
                        <MudText Typo="Typo.body2" Color="Color.Secondary"
                                 Style="white-space: pre; font-family: monospace;">
                            @line.Indent
                        </MudText>
                    </span>
                    <span class="tag-tree-icon" style="font-size: 10px; width: 14px; flex-shrink: 0;">@line.Icon</span>

                    @switch (OnTagClick.HasDelegate || EnableNavigation)
                    {
                        case true:
                            <span @onclick:stopPropagation="true" class="tag-tree-name tag-link"
                                  style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                <MudLink Typo="Typo.body2" Color="Color.Primary" Style="font-weight: 500;"
                                         OnClick="@(() => NavigateToTag(line.TagId))">
                                    @line.Name
                                </MudLink>
                            </span>
                            break;
                        case false:
                            <MudText Typo="Typo.body2" Color="Color.Primary"
                                     Style="font-weight: 500; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;"
                                     Class="tag-tree-name">
                                @line.Name
                            </MudText>
                            break;
                    }

                    @switch (string.IsNullOrEmpty(line.Role))
                    {
                        case false:
                            <span class="tag-tree-role">@line.Role</span>
                            break;
                    }
                    <div style="flex: 1;"></div>
                    @switch (!line.IsCurrent && EnableSwap)
                    {
                        case true:
                            <span class="tag-tree-swap-btn" @onclick:stopPropagation="true">
                                <MudIconButton Icon="@Icons.Material.Filled.SwapHoriz" Size="Size.Small" Color="Color.Primary"
                                               Class="pa-1" OnClick="@(() => OnSwap.InvokeAsync(line.TagId))" title="このタグに入れ替える" />
                            </span>
                            break;
                    }
                    @switch (EnableAddChild)
                    {
                        case true:
                            <span class="tag-tree-add-btn" @onclick:stopPropagation="true">
                                <MudIconButton Icon="@Icons.Material.Filled.AddCircleOutline" Size="Size.Small"
                                               Color="Color.Primary" Class="pa-1" OnClick="@(() => AddChildTagClicked(line.TagId))"
                                               title="このタグの子にタグを追加" />
                            </span>
                            break;
                    }
                </div>
            </MudListItem>
        }
    </MudList>
</MudPaper>

@code {
    [Parameter] public Tag TargetTag { get; set; } = null!;
    [Parameter] public IEnumerable<Tag> AllTags { get; set; } = [];
    [Parameter] public bool EnableSwap { get; set; }
    [Parameter] public bool EnableExpand { get; set; } = true;
    [Parameter] public bool EnableNavigation { get; set; } = true;
    [Parameter] public bool EnableAddChild { get; set; }
    [Parameter] public string MaxHeight { get; set; } = "min(300px, 60vh)";
    [Parameter] public string? Style { get; set; }
    [Parameter] public EventCallback<int> OnSwap { get; set; }
    [Parameter] public EventCallback<Tag> OnAddChildTag { get; set; }
    [Parameter] public EventCallback<int> OnTagClick { get; set; }

    private async Task AddChildTagClicked(int tagId)
    {
        switch (OnAddChildTag.HasDelegate)
        {
            case true:
                var targetTag = AllTags.FirstOrDefault(t => t.Id == tagId);
                switch (targetTag)
                {
                    case not null:
                        await OnAddChildTag.InvokeAsync(targetTag);
                        break;
                }
                break;
        }
    }

    private readonly List<TagTreeLine> _treeLines = [];
    private readonly HashSet<int> _expandedTreeTagIds = [];

    protected override void OnParametersSet()
    {
        switch ((TargetTag, AllTags))
        {
            case (null, _):
            case (_, null):
                return;
        }

        switch (_expandedTreeTagIds.Any())
        {
            case false:
                // Auto-expand parents of TargetTag
                foreach (var id in TagTreePopoverViewModel.GetAutoExpandIds(TargetTag, AllTags.ToList()))
                {
                    _expandedTreeTagIds.Add(id);
                }
                break;
        }

        BuildTree();
    }

    private void BuildTree()
    {
        _treeLines.Clear();
        switch (TargetTag == null || !AllTags.Any())
        {
            case true: return;
        }

        _treeLines.AddRange(TagTreePopoverViewModel.BuildTreeLines(
            TargetTag, AllTags.ToList(), _expandedTreeTagIds, EnableExpand));
    }

    private void OnLineClicked(TagTreeLine line)
    {
        switch (EnableExpand)
        {
            case false: return;
        }

        switch (_expandedTreeTagIds.Remove(line.TagId))
        {
            case false:
                _expandedTreeTagIds.Add(line.TagId);
                break;
        }

        BuildTree();
    }

    private async Task NavigateToTag(int tagId)
    {
        switch (OnTagClick.HasDelegate)
        {
            case true:
                await OnTagClick.InvokeAsync(tagId);
                break;
            case false when EnableNavigation:
                NavigationManager.NavigateTo($"/TagDetail/{tagId}");
                break;
        }
    }

}