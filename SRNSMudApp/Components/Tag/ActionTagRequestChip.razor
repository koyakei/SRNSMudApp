@using MudBlazor

<span class="position-relative d-inline-flex align-center">
    <MudChip T="string" Size="Size.Small" Class="action-tag-request-chip custom-chip" Style="@Style" Color="@Color"
             Variant="@Variant">
        <div class="d-flex align-center">
            <!-- アクション領域 (先頭) -->
            <div class="d-flex align-center mr-1" @onclick:stopPropagation="true">
                @if (CanApprove)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small"
                                   Class="pa-0 mr-2 chip-icon-btn" OnClick="OnApproveClicked" title="削除リクエストを承認" />
                }

                @if (CanCancel)
                {
                    <MudBadge Icon="@Icons.Material.Filled.Close" Color="Color.Error" Overlap="true" Bordered="true"
                              Class="mr-1">
                        <MudIconButton Icon="@Icons.Material.Outlined.Delete" Color="Color.Inherit" Size="Size.Small"
                                       Class="pa-0 chip-icon-btn" OnClick="OnCancelClicked" title="削除リクエストをキャンセル" />
                    </MudBadge>
                }
            </div>

            <!-- テキスト領域（タグ名・オーナー） -->
            <span class="d-flex align-center">
                @if (!string.IsNullOrEmpty(Href))
                {
                    <a class="chip-link mr-1" href="@Href" style="@TagStyle" @onclick:stopPropagation="true">
                        @TagName
                    </a>
                }
                else
                {
                    <a class="chip-link mr-1" style="@TagStyle" @onclick="HandleTagClick" @onclick:stopPropagation="true">
                        @TagName
                    </a>
                }
                @if (!string.IsNullOrEmpty(OwnerName))
                {
                    <span class="ml-1 text-muted" @onclick:stopPropagation="true">(@OwnerName)</span>
                }
            </span>

            <!-- Weight表示 -->
            @if (Weight != 0)
            {
                <span class="mx-1 ml-2 font-weight-bold text-muted" @onclick:stopPropagation="true">
                    @Weight
                </span>
            }
        </div>
    </MudChip>
</span>
