@page "/tag-tree"
@rendermode InteractiveServer

<MudText Typo="Typo.h4" GutterBottom="true">タグ階層管理</MudText>
<MudText Typo="Typo.body1" Class="mb-4">
    JqTreeを使用してノードをドラッグ＆ドロップし、親子関係を変更できます。変更は自動的にデータベースに保存されます。
</MudText>

<MudGrid>
    <MudItem xs="12">
        <div class="d-flex align-center">
            <MudTextField T="string" Value="@_searchText" ValueChanged="OnSearchTextChanged" Placeholder="タグを検索..."
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Class="mr-4"
                          Immediate="true" DebounceInterval="300"/>
            <MudButton Variant="Variant.Filled" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete"
                       OnClick="@DeleteSelectedTags" Disabled="@(string.IsNullOrEmpty(_currentUserId))">
                選択したタグを削除
            </MudButton>
        </div>
    </MudItem>
    <MudItem xs="12">
        <MudPaper Width="100%" Elevation="3" Class="pa-4">
            <div id="jqtree-container" class="mt-4 tree-container"></div>
        </MudPaper>
    </MudItem>
</MudGrid>
