@page "/tag-tree"
@rendermode InteractiveServer
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject AuthenticationStateProvider AuthStateProvider
@inject ISnackbar Snackbar
@inject IJSRuntime JSRuntime
@inject IDialogService DialogService
@inject NavigationManager NavigationManager
@using System.Security.Claims
@using System.Text.Json
@implements IAsyncDisposable

<MudText Typo="Typo.h4" GutterBottom="true">タグ階層管理</MudText>
<MudText Typo="Typo.body1" Class="mb-4">
    JqTreeを使用してノードをドラッグ＆ドロップし、親子関係を変更できます。変更は自動的にデータベースに保存されます。
</MudText>

<MudGrid>
    <MudItem xs="12">
        <div class="d-flex align-center">
            <MudTextField T="string" Value="@_searchText" ValueChanged="OnSearchTextChanged" Placeholder="タグを検索..."
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Class="mr-4"
                          Immediate="true" DebounceInterval="300"/>
            <MudButton Variant="Variant.Filled" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete"
                       OnClick="@DeleteSelectedTags" Disabled="@(string.IsNullOrEmpty(_currentUserId))">
                選択したタグを削除
            </MudButton>
        </div>
    </MudItem>
    <MudItem xs="12">
        <MudPaper Width="100%" Elevation="3" Class="pa-4">
            <div id="jqtree-container" class="mt-4 tree-container"></div>
        </MudPaper>
    </MudItem>
</MudGrid>


@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private List<Tag> _tags = [];
    private string? _searchText;
    private DotNetObjectReference<TagTree>? _dotNetRef;
    private bool _isTreeInitialized;
    private bool _dataLoaded;
    private string? _currentUserId;

    [SupplyParameterFromQuery(Name = "tagId")]
    public int? SelectedTagId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        switch (AuthState)
        {
            case not null:
                var authState = await AuthState;
                _currentUserId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
                break;
        }

        await LoadDataAsync();
        _dataLoaded = true;
    }

    private async Task LoadDataAsync()
    {
        try
        {
            await using var context = await DbFactory.CreateDbContextAsync();
            _tags = await context.Tags.Where(t => !t.IsSystem).ToListAsync();

            // 循環参照を検出して解除する（DB上のデータも修復する）
            HashSet<int> visited = [];
            HashSet<int> recursionStack = [];
            var hasCycles = false;

            foreach (var tag in _tags)
            {
                switch (visited.Contains(tag.Id))
                {
                    case true: continue;
                }

                var current = tag;
                List<Tag> path = [];

                while (current != null && !recursionStack.Contains(current.Id) && !visited.Contains(current.Id))
                {
                    recursionStack.Add(current.Id);
                    path.Add(current);
                    current = current.ParentTagId.HasValue ? _tags.FirstOrDefault(t => t.Id == current.ParentTagId.Value) : null;
                }

                switch (current)
                {
                    case not null when recursionStack.Contains(current.Id):
                        current.ParentTagId = null;
                        var dbTag = await context.Tags.FindAsync(current.Id);
                        switch (dbTag)
                        {
                            case not null:
                                dbTag.ParentTagId = null;
                                break;
                        }
                        hasCycles = true;
                        break;
                }

                foreach (var p in path)
                {
                    recursionStack.Remove(p.Id);
                    visited.Add(p.Id);
                }
            }

            switch (hasCycles)
            {
                case true:
                    await context.SaveChangesAsync();
                    break;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[TagTree] LoadDataAsync ERROR: {ex.GetType().Name}: {ex.Message}");
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // _dataLoaded が true になるまでツリーを初期化しない
        // （OnInitializedAsync の await 中に firstRender が先に来る場合がある）
        switch (!_isTreeInitialized && _dataLoaded)
        {
            case true:
                _dotNetRef = DotNetObjectReference.Create(this);
                var treeDataJson = GetSerializedTreeData();
                var isLoggedIn = !string.IsNullOrEmpty(_currentUserId);
                try
                {
                    await JSRuntime.InvokeVoidAsync("jqTreeInterop.init", "jqtree-container", treeDataJson, _dotNetRef, isLoggedIn, SelectedTagId);
                }
                catch (Exception)
                {
                    // ignored
                }

                _isTreeInitialized = true;
                break;
        }
    }

    private IEnumerable<Tag> GetFilteredTags()
    {
        switch (string.IsNullOrWhiteSpace(_searchText))
        {
            case true:
                return _tags
                    .OrderByDescending(t => t.OwnerId == _currentUserId)
                    .ThenBy(t => t.Name)
                    .Take(2000);
        }

        var baseTags = _tags.Where(t => t.Name.Contains(_searchText, StringComparison.OrdinalIgnoreCase)).ToList();
        HashSet<int> resultIds = [];

        foreach (var tag in baseTags)
        {
            resultIds.Add(tag.Id);

            var current = tag;
            bool stopAncestors = false;
            while (current.ParentTagId.HasValue && !stopAncestors)
            {
                var parent = _tags.FirstOrDefault(t => t.Id == current.ParentTagId.Value);
                stopAncestors = parent == null || !resultIds.Add(parent.Id);
                switch (stopAncestors)
                {
                    case false:
                        current = parent!;
                        break;
                }
            }
        }

        return _tags.Where(t => resultIds.Contains(t.Id));
    }

    private static List<object> BuildTreeDataForJqTree(int? parentId, IEnumerable<Tag> filteredTags)
    {
        var tagList = filteredTags as IReadOnlyCollection<Tag> ?? [.. filteredTags];
        List<object> result = [];
        List<Tag> children;

        switch (parentId)
        {
            case null:
                var allFilteredIds = tagList.Select(t => t.Id).ToHashSet();
                children =
                [
                    .. tagList
                        .Where(t => t.ParentTagId == null || !allFilteredIds.Contains(t.ParentTagId.Value))
                        .OrderBy(t => t.Name)
                ];
                break;
            default:
                children = [.. tagList.Where(t => t.ParentTagId == parentId).OrderBy(t => t.Name)];
                break;
        }

        foreach (var child in children)
        {
            var nodeChildren = BuildTreeDataForJqTree(child.Id, tagList);
            switch (nodeChildren.Count)
            {
                case 0:
                    result.Add(new
                    {
                        id = child.Id,
                        name = child.Name
                    });
                    continue;
            }

            result.Add(new
            {
                id = child.Id,
                name = child.Name,
                children = nodeChildren
            });
        }

        return result;
    }

    private string GetSerializedTreeData()
    {
        var filteredTags = GetFilteredTags();
        var treeData = BuildTreeDataForJqTree(null, filteredTags);
        // タグ階層が深くてもエラーにならないよう MaxDepth を十分に大きくする
        var options = new JsonSerializerOptions { MaxDepth = 1024 };
        return JsonSerializer.Serialize(treeData, options);
    }

    private async Task OnSearchTextChanged(string? text)
    {
        _searchText = text;
        switch (_isTreeInitialized)
        {
            case true:
                var treeDataJson = GetSerializedTreeData();
                try
                {
                    await JSRuntime.InvokeVoidAsync("jqTreeInterop.loadData", "jqtree-container", treeDataJson);
                }
                catch (Exception)
                {
                    // ignored
                }
                break;
        }
    }

    private async Task DeleteSelectedTags()
    {
        switch (string.IsNullOrEmpty(_currentUserId))
        {
            case true: return;
        }

        List<int> selectedIds = [];
        try
        {
            selectedIds = await JSRuntime.InvokeAsync<List<int>>("jqTreeInterop.getSelectedIds", "jqtree-container");
        }
        catch (Exception)
        {
            // ignored
        }

        switch (selectedIds)
        {
            case null:
            case { Count: 0 }:
                Snackbar.Add("削除するタグが選択されていません。", Severity.Info);
                return;
        }

        var hasDeleted = false;

        await using var context = await DbFactory.CreateDbContextAsync();
        await using var transaction = await context.Database.BeginTransactionAsync();
        try
        {
            var selectedTagsFromDb = await context.Tags.Where(t => selectedIds.Contains(t.Id)).ToListAsync();

            var unauthorizedTags = selectedTagsFromDb.Where(t => t.OwnerId != _currentUserId).ToList();
            var systemTags = selectedTagsFromDb.Where(t => t.IsSystem).ToList();
            var authorizedIds = selectedTagsFromDb.Where(t => t.OwnerId == _currentUserId && !t.IsSystem).Select(t => t.Id).ToList();

            switch (unauthorizedTags.Count > 0)
            {
                case true:
                    var skippedNames = string.Join(", ", unauthorizedTags.Select(t => t.Name));
                    Snackbar.Add($"削除権限がないためスキップしました: {skippedNames}", Severity.Warning);
                    break;
            }

            switch (systemTags.Count > 0)
            {
                case true:
                    var skippedNames = string.Join(", ", systemTags.Select(t => t.Name));
                    Snackbar.Add($"システムタグは削除できないためスキップしました: {skippedNames}", Severity.Warning);
                    break;
            }

            switch (authorizedIds.Count > 0)
            {
                case true:
                    var tagsToDelete = await context.Tags
                        .Where(t => authorizedIds.Contains(t.Id) && t.OwnerId == _currentUserId)
                        .ToListAsync();

                    switch (tagsToDelete.Count > 0)
                    {
                        case true:
                            // 関連する TagRelationToTag (DeleteBehavior.Restrict) を手動で削除
                            var relationsToDelete = await context.TagRelationToTags
                                .Where(tr => authorizedIds.Contains(tr.TagId) || authorizedIds.Contains(tr.TargetTagId))
                                .ToListAsync();

                            switch (relationsToDelete.Count > 0)
                            {
                                case true:
                                    context.TagRelationToTags.RemoveRange(relationsToDelete);
                                    break;
                            }

                            // 削除対象のタグを親に持つ子タグを取得し、ルートノード（ParentTagId = null）に変更する
                            var orphanedChildren = await context.Tags
                                .Where(t => t.ParentTagId.HasValue && authorizedIds.Contains(t.ParentTagId.Value) && !authorizedIds.Contains(t.Id))
                                .ToListAsync();

                            foreach (var child in orphanedChildren)
                            {
                                child.ParentTagId = null;
                            }

                            // SQLiteの自己参照外部キー制約エラーを避けるため、一旦親タグ参照を解除して保存
                            foreach (var tag in tagsToDelete)
                            {
                                tag.ParentTagId = null;
                            }

                            await context.SaveChangesAsync();

                            // タグ本体の削除
                            context.Tags.RemoveRange(tagsToDelete);
                            await context.SaveChangesAsync();

                            hasDeleted = true;
                            Snackbar.Add($"{tagsToDelete.Count}個のタグを削除しました。", Severity.Success);
                            break;
                    }

                    await transaction.CommitAsync();
                    break;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"削除中にエラーが発生しました: {ex.Message}", Severity.Error);
        }

        switch (hasDeleted)
        {
            case true:
                await LoadDataAsync();
                StateHasChanged();
                switch (_isTreeInitialized)
                {
                    case true:
                        var treeDataJson = GetSerializedTreeData();
                        try
                        {
                            await JSRuntime.InvokeVoidAsync("jqTreeInterop.loadData", "jqtree-container", treeDataJson);
                        }
                        catch (Exception)
                        {
                            // ignored
                        }
                        break;
                }
                break;
        }
    }


    [JSInvokable]
    public async Task AddChildTagByNodeId(int parentId)
    {
        switch (string.IsNullOrEmpty(_currentUserId))
        {
            case true: return;
        }

        var dialog = await DialogService.ShowAsync<TagCreateChildDialog>("子タグの追加");
        var result = await dialog.Result;

        switch (result)
        {
            case { Canceled: false, Data: TagCreateChildDialog.Result data }:
                try
                {
                    var newTag = new Tag
                    {
                        Name = data.Name,
                        Content = data.Content,
                        ParentTagId = parentId,
                        OwnerId = _currentUserId,
                        CachedWeight = 0,
                        CreatedDate = DateTime.UtcNow,
                        UpdatedDate = DateTime.UtcNow
                    };

                    await using var context = await DbFactory.CreateDbContextAsync();
                    context.Tags.Add(newTag);
                    await context.SaveChangesAsync();

                    Snackbar.Add($"'{data.Name}' を追加しました。", Severity.Success);

                    await LoadDataAsync();
                    StateHasChanged();
                    switch (_isTreeInitialized)
                    {
                        case true:
                            var treeDataJson = GetSerializedTreeData();
                            try
                            {
                                await JSRuntime.InvokeVoidAsync("jqTreeInterop.loadData", "jqtree-container", treeDataJson);
                            }
                            catch (Exception)
                            {
                                // ignored
                            }
                            break;
                    }
                }
                catch (DbUpdateException ex) when (ex.InnerException?.Message.Contains("UNIQUE constraint failed") == true)
                {
                    Snackbar.Add("同じ名前のタグが既に存在します。", Severity.Error);
                }
                catch (Exception ex)
                {
                    Snackbar.Add($"エラーが発生しました: {ex.Message}", Severity.Error);
                }
                break;
        }
    }

    [JSInvokable]
    public async Task OnTreeMove(int movedNodeId, int targetNodeId, string position)
    {
        var movedItem = _tags.FirstOrDefault(t => t.Id == movedNodeId);
        var targetItem = _tags.FirstOrDefault(t => t.Id == targetNodeId);

        switch ((movedItem, targetItem))
        {
            case (null, _):
            case (_, null):
                return;
        }

        // 権限チェック: 自分のタグ以外は移動不可とする
        switch (!string.IsNullOrEmpty(movedItem.OwnerId) && movedItem.OwnerId != _currentUserId)
        {
            case true:
                Snackbar.Add("他人が作成したタグの構成を変更する権限がありません。", Severity.Error);
                switch (_isTreeInitialized)
                {
                    case false: return;
                }

                var treeDataJson = GetSerializedTreeData();
                try
                {
                    await JSRuntime.InvokeVoidAsync("jqTreeInterop.loadData", "jqtree-container", treeDataJson);
                }
                catch (Exception)
                {
                    // ignored
                }

                return;
        }

        // 自分自身の子孫へのドロップは無効（循環参照を防ぐ）
        // movedItem が targetItem の祖先（または自身）であるかを確認する
        switch (IsDescendantOrSelf(movedItem, targetItem))
        {
            case true:
                Snackbar.Add($"'{movedItem.Name}' を自身の配下 '{targetItem.Name}' に移動することはできません。", Severity.Warning);
                switch (_isTreeInitialized)
                {
                    case false: return;
                }

                var treeDataJson2 = GetSerializedTreeData();
                try
                {
                    await JSRuntime.InvokeVoidAsync("jqTreeInterop.loadData", "jqtree-container", treeDataJson2);
                }
                catch (Exception)
                {
                    // ignored
                }

                return;
        }

        movedItem.ParentTagId = position switch
        {
            "inside" => targetItem.Id,
            "before" or "after" => targetItem.ParentTagId,
            _ => movedItem.ParentTagId
        };

        try
        {
            await using var context = await DbFactory.CreateDbContextAsync();
            var tagToUpdate = await context.Tags.FindAsync(movedItem.Id);
            switch (tagToUpdate)
            {
                case not null:
                    tagToUpdate.ParentTagId = movedItem.ParentTagId;
                    tagToUpdate.UpdatedDate = DateTime.UtcNow;
                    await context.SaveChangesAsync();
                    Snackbar.Add("タグ構造を更新しました。", Severity.Success);
                    break;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"保存時にエラーが発生しました: {ex.Message}", Severity.Error);
        }

        StateHasChanged();

        // jqTreeのデータを更新
        switch (_isTreeInitialized)
        {
            case true:
                var treeDataJson3 = GetSerializedTreeData();
                try
                {
                    await JSRuntime.InvokeVoidAsync("jqTreeInterop.loadData", "jqtree-container", treeDataJson3);
                }
                catch (Exception)
                {
                    // ignored
                }
                break;
        }
    }

    private bool IsDescendantOrSelf(Tag parent, Tag target)
    {
        switch (parent.Id == target.Id)
        {
            case true: return true;
        }

        var children = _tags.Where(t => t.ParentTagId == parent.Id);
        return children.Any(child => IsDescendantOrSelf(child, target));
    }


    [JSInvokable]
    public void NavigateToTagDetail(int tagId)
    {
        NavigationManager.NavigateTo($"/TagDetail/{tagId}");
    }

    [JSInvokable]
    public void OnNodeSelected(int? nodeId)
    {
        var uri = NavigationManager.GetUriWithQueryParameter("tagId", nodeId);
        NavigationManager.NavigateTo(uri, false, true);
    }

    public async ValueTask DisposeAsync()
    {
        _dotNetRef?.Dispose();
        try
        {
            switch (_isTreeInitialized)
            {
                case true:
                    try
                    {
                        await JSRuntime.InvokeVoidAsync("jqTreeInterop.destroy", "jqtree-container");
                    }
                    catch (Exception)
                    {
                        // ignored
                    }
                    break;
            }
        }
        catch
        {
            // Ignore during teardown
        }
    }

}