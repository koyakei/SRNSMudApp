@page "/Tag/TagSearch"
@using System.Numerics.Tensors
@using SRNSMudApp.Services
@* 修正1: コンポーネントをインタラクティブ（動的）にする *@
@rendermode InteractiveServer
@* 修正2: 連続入力でのエラー（同時実行エラー）を防ぐため、Factory経由に変更 *@
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject ITagEmbeddingService TagEmbeddingService

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-10">
    <MudText Typo="Typo.h5" GutterBottom="true">タグ検索</MudText>

    @* MudAutocomplete は Enterキー不要で、文字を入力するたびに自動で SearchFunc が走ります *@
    <MudAutocomplete T="Tag"
                     Label="タグを検索"
                     @bind-Value="SelectedTag"
                     SearchFunc="@SearchTagsAsync"
                     ToStringFunc="@(tag => tag == null ? null : tag.Name)"
                     Placeholder="タグ名 または 内容を入力..."
                     ResetValueOnEmptyText="true"
                     Clearable="true">

        <ItemTemplate Context="tag">
            <div class="d-flex flex-column">
                <MudText Typo="Typo.body1">@tag.Name</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    ウェイト: @tag.CachedWeight | 内容: @tag.Content
                </MudText>
            </div>
        </ItemTemplate>

        <NoItemsTemplate>
            <MudText Align="Align.Center" Class="px-4 py-2">
                一致するタグが見つかりません
            </MudText>
        </NoItemsTemplate>
    </MudAutocomplete>

    @if (SelectedTag != null)
    {
        <MudAlert Severity="Severity.Info" Class="mt-4">
            選択されたタグ: 名前 = @SelectedTag.Name, ウェイト = @SelectedTag.CachedWeight
        </MudAlert>
    }
</MudContainer>

@code {
    private Tag? SelectedTag { get; set; }

    private async Task<IEnumerable<Tag>> SearchTagsAsync(string? value, CancellationToken token)
    {
        // 文字入力のたびに新しいDbContextを生成し、直前の処理との衝突（クラッシュ）を防ぐ
        await using var dbContext = await DbFactory.CreateDbContextAsync(token);

        var query = dbContext.Tags.AsQueryable();

        if (string.IsNullOrEmpty(value))
        {
            return await query.AsNoTracking().Take(50).ToListAsync(token);
        }

        try
        {
            var queryVector = await TagEmbeddingService.GenerateEmbeddingAsync(value);
            var queryArray = queryVector.ToArray();

            var textMatches = await query
                .Where(x => x.Name.Contains(value) || x.Content.Contains(value))
                .AsNoTracking()
                .ToListAsync(token);

            var vectorTags = await query.Where(x => x.Embedding != null).AsNoTracking().ToListAsync(token);

            var vectorMatches = vectorTags
                .OrderByDescending(x => TensorPrimitives.CosineSimilarity(x.Embedding, queryArray))
                .Take(50)
                .ToList();

            return
            [
                .. textMatches.Concat(vectorMatches)
                    .DistinctBy(x => x.Id)
                    .Take(50)
            ];
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Vector search failed: {ex.Message}");
            query = query.Where(x =>
                x.Name.Contains(value) ||
                x.Content.Contains(value)
            );
            return await query.AsNoTracking().Take(50).ToListAsync(token);
        }
    }

}