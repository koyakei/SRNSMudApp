@using System.Security.Claims
@using SRNSMudApp.Services

@switch (ShowHeader)
{
    case true:
        <div class="d-flex justify-space-between align-center mb-4">
            @switch (ShowCreateButton)
            {
                case true:
                    <MudButton Href="/Tag/AddTag" Variant="Variant.Filled" Color="Color.Primary">
                        Create New Tag
                    </MudButton>
                    break;
                case false:
                    <div></div>
                    break;
            }

            <MudAutocomplete T="string" @bind-Value="tagSearch" SearchFunc="@SearchTags"
                             Placeholder="Search tags..." Adornment="Adornment.Start"
                             AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium"
                             Class="mt-0 search-input"
                             ResetValueOnEmptyText="true" CoerceText="true" CoerceValue="true"
                             Clearable="true"/>
        </div>
        break;
    case false:
        break;
}

<MudTable Items="@Tags" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm" Loading="@(Tags == null)"
          LoadingProgressColor="Color.Info" Filter="FilterFunc">
    <HeaderContent>
        @switch (OnRemoveTag.HasDelegate)
        {
            case true:
                <MudTh></MudTh>
                break;
            case false:
                break;
        }
        <MudTh>Tag</MudTh>
        <MudTh>Attached Tags</MudTh>
        <MudTh>Content</MudTh>
    </HeaderContent>
    <RowTemplate>
        @switch (OnRemoveTag.HasDelegate)
        {
            case true:
                <MudTd DataLabel="Remove">
                    <MudIconButton Icon="@Icons.Material.Filled.LinkOff" Color="Color.Error" Size="Size.Small"
                                   OnClick="@(() => OnRemoveTag.InvokeAsync(context))" title="タグ付けを解除"/>
                </MudTd>
                break;
            case false:
                break;
        }
        <MudTd DataLabel="Tag">
            <BaseTagChip ChipId="@($"tag-table-chip-{context.Id}")"
                         TagName="@context.Name"
                         Weight="@(OverrideWeights != null && OverrideWeights.TryGetValue(context.Id, out var w) ? w : context.CachedWeight)"
                         OwnerName="@context.Owner?.UserName"
                         Variant="Variant.Outlined"
                         OnClick="@(() => NavigationManager.NavigateTo($"/TagDetail/{context.Id}"))">
                <ActionContent>
                    <div class="d-flex align-center action-container" @onclick:stopPropagation="true">
                        <MudIconButton Icon="@Icons.Material.Filled.AddCircleOutline" Size="Size.Small" Color="Color.Primary"
                                       OnClick="@(() => OnAddTagToTagClicked(context))" title="タグを追加"/>
                        <MudIconButton Icon="@Icons.Material.Filled.AccountTree" Size="Size.Small"
                                       OnClick="@(() => ToggleTree(context.Id))" title="タグツリーを表示"/>

                        @switch (!string.IsNullOrEmpty(_currentUserId) && TagTableViewModel.CanEditTag(context, _currentUserId))
                        {
                            case true:
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small"
                                               OnClick="@(() => EditTagAsync(context))" title="編集"/>
                                @switch (TagTableViewModel.CanDeleteTag(context, _currentUserId))
                                {
                                    case true:
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                                                       OnClick="@(() => DeleteTagAsync(context))" title="削除"/>
                                        break;
                                    case false:
                                        break;
                                }
                                break;
                            case false:
                                break;
                        }
                    </div>
                </ActionContent>
                <PopoverContent>
                    <MudOverlay Visible="@(_activeTreeTagId == context.Id)"
                                OnClick="@(() => _activeTreeTagId = null)"
                                AutoClose="true"
                                DarkBackground="false" />
                    <MudPopover Open="@(_activeTreeTagId == context.Id)"
                                AnchorOrigin="Origin.TopRight"
                                TransformOrigin="Origin.TopLeft"
                                OverflowBehavior="OverflowBehavior.FlipAlways"
                                Class="tree-popover" Paper="false">
                        <TagTreePopoverContent TargetTag="@context"
                                               AllTags="@_allTagsCache"
                                               EnableSwap="false"
                                               EnableExpand="true"
                                               EnableNavigation="true"/>
                    </MudPopover>
                </PopoverContent>
            </BaseTagChip>
        </MudTd>
        <MudTd DataLabel="Attached Tags">
            @{
                var attachedDisplay = TagTableViewModel.GetAttachedTagsDisplay(context, _expandedTagIds.Contains(context.Id));
            }
            <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" Class="align-items-center">
                @foreach (var tr in attachedDisplay.TagsToDisplay)
                {
                    <BaseTagChip TagName="@(tr.Tag?.Name ?? "不明")"
                                 Variant="Variant.Outlined"
                                 CloseIcon="@Icons.Material.Filled.RemoveCircleOutline"
                                 OnClose="@(_ => RemoveTagToTagRelationAsync(tr))"
                                 OnClick="@(() => NavigationManager.NavigateTo($"/TagDetail/{tr.Tag?.Id}"))"/>
                }
                @switch (attachedDisplay.HasManyTags)
                {
                    case true:
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Filled"
                                 OnClick="@(() => ToggleTagExpand(context.Id))"
                                 Class="tag-chip-more">
                            @attachedDisplay.ToggleLabel
                        </MudChip>
                        break;
                    case false:
                        break;
                }
            </MudStack>
        </MudTd>
        <MudTd DataLabel="Content">
            <div class="content-cell"
                 title="@context.Content">
                @context.Content
            </div>
        </MudTd>
    </RowTemplate>
    <PagerContent>
        <MudTablePager/>
    </PagerContent>
</MudTable>
