@using System.Security.Claims
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager
@inject IDialogService DialogService
@inject ISnackbar Snackbar

@switch (ShowHeader)
{
    case true:
        <div class="d-flex justify-space-between align-center mb-4">
            @switch (ShowCreateButton)
            {
                case true:
                    <MudButton Href="/Tag/AddTag" Variant="Variant.Filled" Color="Color.Primary">
                        Create New Tag
                    </MudButton>
                    break;
                case false:
                    <div></div>
                    break;
            }

            <MudAutocomplete T="string" @bind-Value="tagSearch" SearchFunc="@SearchTags"
                             Placeholder="Search tags..." Adornment="Adornment.Start"
                             AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium"
                             Class="mt-0 search-input"
                             ResetValueOnEmptyText="true" CoerceText="true" CoerceValue="true"
                             Clearable="true"/>
        </div>
        break;
    case false:
        break;
}

<MudTable Items="@Tags" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm" Loading="@(Tags == null)"
          LoadingProgressColor="Color.Info" Filter="FilterFunc">
    <HeaderContent>
        @switch (OnRemoveTag.HasDelegate)
        {
            case true:
                <MudTh></MudTh>
                break;
            case false:
                break;
        }
        <MudTh>Tag</MudTh>
        <MudTh>Attached Tags</MudTh>
        <MudTh>Content</MudTh>
    </HeaderContent>
    <RowTemplate>
        @switch (OnRemoveTag.HasDelegate)
        {
            case true:
                <MudTd DataLabel="Remove">
                    <MudIconButton Icon="@Icons.Material.Filled.LinkOff" Color="Color.Error" Size="Size.Small"
                                   OnClick="@(() => OnRemoveTag.InvokeAsync(context))" title="タグ付けを解除"/>
                </MudTd>
                break;
            case false:
                break;
        }
        <MudTd DataLabel="Tag">
            <BaseTagChip ChipId="@($"tag-table-chip-{context.Id}")"
                         TagName="@context.Name"
                         Weight="@(OverrideWeights != null && OverrideWeights.TryGetValue(context.Id, out var w) ? w : context.CachedWeight)"
                         OwnerName="@context.Owner?.UserName"
                         Variant="Variant.Outlined"
                         OnClick="@(() => NavigationManager.NavigateTo($"/TagDetail/{context.Id}"))">
                <ActionContent>
                    <div class="d-flex align-center action-container" @onclick:stopPropagation="true">
                        <MudIconButton Icon="@Icons.Material.Filled.AddCircleOutline" Size="Size.Small" Color="Color.Primary"
                                       OnClick="@(() => OnAddTagToTagClicked(context))" title="タグを追加"/>
                        <MudIconButton Icon="@Icons.Material.Filled.AccountTree" Size="Size.Small"
                                       OnClick="@(() => ToggleTree(context.Id))" title="タグツリーを表示"/>

                        @switch (!string.IsNullOrEmpty(_currentUserId) && context.OwnerId == _currentUserId)
                        {
                            case true:
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small"
                                               OnClick="@(() => EditTagAsync(context))" title="編集"/>
                                @switch (!context.IsSystem)
                                {
                                    case true:
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                                                       OnClick="@(() => DeleteTagAsync(context))" title="削除"/>
                                        break;
                                    case false:
                                        break;
                                }
                                break;
                            case false:
                                break;
                        }
                    </div>
                </ActionContent>
                <PopoverContent>
                    <MudPopover Open="@(_activeTreeTagId == context.Id)"
                                AnchorOrigin="Origin.TopRight"
                                TransformOrigin="Origin.TopLeft"
                                OverflowBehavior="OverflowBehavior.FlipAlways"
                                Class="tree-popover" Paper="false">
                        <TagTreePopoverContent TargetTag="@context"
                                               AllTags="@_allTagsCache"
                                               EnableSwap="false"
                                               EnableExpand="true"
                                               EnableNavigation="true"/>
                    </MudPopover>
                </PopoverContent>
            </BaseTagChip>
        </MudTd>
        <MudTd DataLabel="Attached Tags">
            @{
                var allTags = context.TargetTagRelations?
                    .Where(tr => tr.Tag != null && !tr.Tag.IsSystem)
                    .OrderByDescending(tr => tr.Weight)
                    .ToList() ?? [];
                var areTagsExpanded = _expandedTagIds.Contains(context.Id);
                var hasManyTags = allTags.Count >= 3;
                const int displayLimit = 2;
                var tagsToDisplay = (areTagsExpanded || !hasManyTags) switch
                {
                    true => allTags,
                    false => [.. allTags.Take(displayLimit)]
                };
                var hiddenCount = hasManyTags switch
                {
                    true => allTags.Count - displayLimit,
                    false => 0
                };
            }
            <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" Class="align-items-center">
                @foreach (var tr in tagsToDisplay)
                {
                    <BaseTagChip TagName="@(tr.Tag?.Name ?? "不明")"
                                 Variant="Variant.Outlined"
                                 CloseIcon="@Icons.Material.Filled.RemoveCircleOutline"
                                 OnClose="@(_ => RemoveTagToTagRelationAsync(tr))"
                                 OnClick="@(() => NavigationManager.NavigateTo($"/TagDetail/{tr.Tag?.Id}"))"/>
                }
                @switch (hasManyTags)
                {
                    case true:
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Filled"
                                 OnClick="@(() => ToggleTagExpand(context.Id))"
                                 Class="tag-chip-more">
                            @(areTagsExpanded switch { true => "閉じる", false => $"+{hiddenCount} more" })
                        </MudChip>
                        break;
                    case false:
                        break;
                }
            </MudStack>
        </MudTd>
        <MudTd DataLabel="Content">
            <div class="content-cell"
                 title="@context.Content">
                @context.Content
            </div>
        </MudTd>
    </RowTemplate>
    <PagerContent>
        <MudTablePager/>
    </PagerContent>
</MudTable>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    [Parameter] public IEnumerable<Tag>? Tags { get; set; }
    [Parameter] public IReadOnlyDictionary<int, int>? OverrideWeights { get; set; }
    [Parameter] public EventCallback OnDataChanged { get; set; }
    [Parameter] public EventCallback<Tag> OnRemoveTag { get; set; }
    [Parameter] public bool ShowHeader { get; set; } = true;
    [Parameter] public bool ShowCreateButton { get; set; } = true;

    private string _currentUserId = "";
    private string tagSearch = "";
    private List<Tag> _allTagsCache = [];

    protected override async Task OnInitializedAsync()
    {
        switch (AuthState)
        {
            case not null:
                var authState = await AuthState;
                _currentUserId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? "";
                break;
        }

        await using var context = await DbFactory.CreateDbContextAsync();
        _allTagsCache = await context.Tags.AsNoTracking().ToListAsync();
    }

    private bool FilterFunc(Tag tag)
    {
        return string.IsNullOrWhiteSpace(tagSearch) switch
        {
            true => true,
            false => tag.Name.Contains(tagSearch, StringComparison.OrdinalIgnoreCase) switch
            {
                true => true,
                false => (tag.Content?.Contains(tagSearch, StringComparison.OrdinalIgnoreCase) == true) switch
                {
                    true => true,
                    false => tag.Owner?.UserName?.Contains(tagSearch, StringComparison.OrdinalIgnoreCase) == true
                }
            }
        };
    }

    private async Task<IEnumerable<string>> SearchTags(string? value, CancellationToken token)
    {
        await Task.Yield();

        var sourceTags = Tags ?? [];

        return string.IsNullOrEmpty(value) switch
        {
            true => sourceTags.Select(t => t.Name).Distinct().Take(20),
            false => sourceTags
                .Where(t => t.Name.Contains(value, StringComparison.OrdinalIgnoreCase))
                .Select(t => t.Name)
                .Distinct()
                .Take(20)
        };
    }

    private readonly HashSet<int> _expandedTagIds = [];

    private void ToggleTagExpand(int tagId)
    {
        switch (_expandedTagIds.Remove(tagId))
        {
            case false:
                _expandedTagIds.Add(tagId);
                break;
        }
    }

    // ===== タグツリーポップオーバー用 =====
    private int? _activeTreeTagId;

    private void ToggleTree(int tagId)
    {
        _activeTreeTagId = (_activeTreeTagId == tagId) switch
        {
            true => null,
            false => tagId
        };
    }

    private async Task OnAddTagToTagClicked(Tag targetTag)
    {
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Large, FullWidth = true };
        var dialog = await DialogService.ShowAsync<TagAddDialog>("タグにタグを追加", options);
        var result = await dialog.Result;

        await (result switch
        {
            { Canceled: false, Data: Tag selectedTag } => AddTagToTagAsync(targetTag, selectedTag),
            _ => Task.CompletedTask
        });
    }

    private async Task AddTagToTagAsync(Tag targetTag, Tag selectedTag)
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        var alreadyExists = await context.TagRelationToTags
            .AnyAsync(tr => tr.TargetTagId == targetTag.Id && tr.TagId == selectedTag.Id);

        switch (alreadyExists)
        {
            case true:
                Snackbar.Add("このタグは既に追加されています。", Severity.Warning);
                break;
            case false:
                await ExecuteAddTagToTagAsync(context, targetTag, selectedTag);
                break;
        }
    }

    private async Task ExecuteAddTagToTagAsync(ApplicationDbContext context, Tag targetTag, Tag selectedTag)
    {
        var newRelation = new TagRelationToTag
        {
            TargetTagId = targetTag.Id,
            TagId = selectedTag.Id,
            Weight = 1,
            OwnerId = _currentUserId
        };

        context.Set<TagRelationToTag>().Add(newRelation);
        await context.SaveChangesAsync();

        var tagFromDb = await context.Tags.FindAsync(selectedTag.Id);
        switch (tagFromDb)
        {
            case not null:
                await UpdateTagWeightLedgerAsync(context, tagFromDb, newRelation);
                break;
            case null:
                break;
        }

        Snackbar.Add("タグを追加しました。", Severity.Success);
        await NotifyDataChangedAsync();
    }

    private async Task UpdateTagWeightLedgerAsync(ApplicationDbContext context, Tag tagFromDb, TagRelationToTag newRelation)
    {
        var prevWeight = tagFromDb.CachedWeight;
        tagFromDb.CachedWeight += 1;
        context.TagWeightLedgers!.Add(new TagWeightLedger
        {
            TagId = tagFromDb.Id,
            TagNameSnapshot = tagFromDb.Name,
            SourceType = "TagRelationToTagInsert",
            SourceId = newRelation.Id,
            PreviousWeight = prevWeight,
            NewWeight = tagFromDb.CachedWeight,
            Delta = 1,
            IsOwnerAction = true,
            Reason = "タグにタグを追加",
            OwnerId = _currentUserId
        });
        await context.SaveChangesAsync();
    }

    private async Task RemoveTagToTagRelationAsync(TagRelationToTag relation)
    {
        switch (relation.OwnerId != _currentUserId)
        {
            case true:
                Snackbar.Add("関連付けた本人ではないため、解除する権限がありません。", Severity.Error);
                break;
            case false:
                await ExecuteRemoveTagToTagRelationAsync(relation);
                break;
        }
    }

    private async Task ExecuteRemoveTagToTagRelationAsync(TagRelationToTag relation)
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        var entity = await context.TagRelationToTags.Include(tr => tr.Tag).FirstOrDefaultAsync(tr => tr.Id == relation.Id);
        
        switch (entity)
        {
            case not null:
                await RemoveEntityAndLedgerAsync(context, entity);
                break;
            case null:
                break;
        }
    }

    private async Task RemoveEntityAndLedgerAsync(ApplicationDbContext context, TagRelationToTag entity)
    {
        switch (entity.Tag)
        {
            case not null:
                var tag = entity.Tag;
                var prevWeight = tag.CachedWeight;
                tag.CachedWeight -= entity.Weight;
                context.TagWeightLedgers!.Add(new TagWeightLedger
                {
                    TagId = tag.Id,
                    TagNameSnapshot = tag.Name,
                    SourceType = "TagRelationToTagDelete",
                    SourceId = entity.Id,
                    PreviousWeight = prevWeight,
                    NewWeight = tag.CachedWeight,
                    Delta = -entity.Weight,
                    IsOwnerAction = true,
                    Reason = "タグの関連付け解除",
                    OwnerId = _currentUserId
                });
                break;
        }

        context.Remove(entity);
        await context.SaveChangesAsync();
        Snackbar.Add("タグの関連付けを解除しました。", Severity.Success);

        await NotifyDataChangedAsync();
    }

    private async Task EditTagAsync(Tag tag)
    {
        switch (tag.OwnerId != _currentUserId)
        {
            case true:
                Snackbar.Add("タグの作成者本人ではないため、編集する権限がありません。", Severity.Error);
                break;
            case false:
                await ShowTagEditDialogAsync(tag);
                break;
        }
    }

    private async Task ShowTagEditDialogAsync(Tag tag)
    {
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var parameters = new DialogParameters { ["Tag"] = tag };

        var dialog = await DialogService.ShowAsync<TagEditDialog>("タグの編集", parameters, options);
        var result = await dialog.Result;

        switch (result)
        {
            case { Canceled: false }:
                await ExecutePostEditTagAsync();
                break;
        }
    }

    private async Task ExecutePostEditTagAsync()
    {
        await NotifyDataChangedAsync();
        Snackbar.Add("タグを更新しました。", Severity.Success);
    }

    private async Task DeleteTagAsync(Tag tag)
    {
        switch (tag.OwnerId != _currentUserId)
        {
            case true:
                Snackbar.Add("タグの作成者本人ではないため、削除する権限がありません。", Severity.Error);
                break;
            case false:
                switch (tag.IsSystem)
                {
                    case true:
                        Snackbar.Add("システムタグは削除できません。", Severity.Error);
                        break;
                    case false:
                        await ExecuteDeleteTagAsync(tag);
                        break;
                }
                break;
        }
    }

    private async Task ExecuteDeleteTagAsync(Tag tag)
    {
        try
        {
            await using var context = await DbFactory.CreateDbContextAsync();
            var tagToDelete = await context.Tags.FindAsync(tag.Id);
            
            switch (tagToDelete)
            {
                case not null:
                    await PerformTagDeletionAsync(context, tagToDelete);
                    break;
                case null:
                    Snackbar.Add("対象のタグが既に削除されているか、見つかりません。", Severity.Warning);
                    break;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"エラーが発生しました: {ex.Message}", Severity.Error);
        }
    }

    private async Task PerformTagDeletionAsync(ApplicationDbContext context, Tag tagToDelete)
    {
        context.Tags.Remove(tagToDelete);
        await context.SaveChangesAsync();

        await NotifyDataChangedAsync();
        Snackbar.Add("タグを削除しました。", Severity.Success);
    }

    private async Task NotifyDataChangedAsync()
    {
        await (OnDataChanged.HasDelegate switch
        {
            true => OnDataChanged.InvokeAsync(),
            false => Task.CompletedTask
        });
    }

}