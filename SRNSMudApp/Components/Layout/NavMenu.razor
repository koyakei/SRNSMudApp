<MudNavMenu>
    <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">Home</MudNavLink>

    <MudNavLink Href="Tag/TagSearch" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.List">
        Tag Search
    </MudNavLink>
    <MudNavLink Href="User/UserSearch" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Search">
        User Search
    </MudNavLink>
    <MudNavLink Href="Item/ItemList" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.List">
        Item List
    </MudNavLink>
    <MudNavLink Href="Tag/TagList" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.List"> Tag List</MudNavLink>
    <MudNavLink Href="tag-tree" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.List"> Tag Tree</MudNavLink>
    <MudNavLink Href="tag-diagram" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Hub"> Tag Diagram
    </MudNavLink>
    <MudNavLink Href="RightAsset/Overview" Match="NavLinkMatch.Prefix"
                Icon="@Icons.Material.Filled.AccountBalanceWallet">
        Right Assets
    </MudNavLink>
    <AuthorizeView>
        <Authorized>
            <MudNavLink Href="notifications" Match="NavLinkMatch.Prefix">
                    <MudBadge Content="@ViewModel.UnreadNotificationCount" Color="Color.Error" Overlap="true"
                              Visible="@(ViewModel.UnreadNotificationCount > 0)" Class="mr-3"
                              data-testid="nav-notifications-badge">
                        <MudIcon Icon="@Icons.Material.Filled.Notifications" />
                    </MudBadge>
                    Notifications
                
            </MudNavLink>
            <MudNavLink Href="@($"User/UserDetail/{_currentUserId}")" Match="NavLinkMatch.Prefix"
                        Icon="@Icons.Material.Filled.AccountCircle">
                Profile
            </MudNavLink>
            <MudNavLink Href="Account/Manage" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Person">
                @context.User.Identity?.Name
            </MudNavLink>
            <form action="Account/Logout" method="post">
                <AntiforgeryToken />
                <input type="hidden" name="ReturnUrl" value="@ViewModel.CurrentUrl" />
                <button type="submit" class="mud-nav-link mud-ripple">
                    <MudIcon Icon="@Icons.Material.Filled.Logout" Color="Color.Info" Class="mr-3" />
                    Logout
                </button>
            </form>
            <AuthorizeView Roles="Admin" Context="adminContext">
                <MudNavLink Href="User/Management" Match="NavLinkMatch.Prefix"
                            Icon="@Icons.Material.Filled.ManageAccounts">
                    User Management
                </MudNavLink>
                <MudNavLink Href="Tag/AddTag" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.List">
                    Add Tag
                </MudNavLink>
                <MudNavLink Href="Admin/RequireConfirmedAccount" Match="NavLinkMatch.Prefix"
                            Icon="@Icons.Material.Filled.Settings">
                    User Confirmation Settings
                </MudNavLink>
                <MudNavLink Href="Admin/Invitations" Match="NavLinkMatch.Prefix"
                            Icon="@Icons.Material.Filled.MailOutline">
                    Invitation Management
                </MudNavLink>
                <MudNavLink Href="Admin/Reports" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Report">
                    通報管理
                </MudNavLink>
                <MudNavLink Href="Admin/TagManagement" Match="NavLinkMatch.Prefix"
                            Icon="@Icons.Material.Filled.AdminPanelSettings">
                    タグ管理
                </MudNavLink>
            </AuthorizeView>
            <MudNavLink Href="import-tag" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.FileUpload">
                Import Tags (CSV)
            </MudNavLink>
            <MudNavLink Href="import-tagging" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.DataObject">
                Import Tagging (JSON)
            </MudNavLink>
            <MudNavLink Href="Bounty/BountyBoard" Match="NavLinkMatch.Prefix"
                        Icon="@Icons.Material.Filled.AssignmentTurnedIn">
                Bounty Board
            </MudNavLink>
            <MudNavLink Href="Contract/ContractManagement" Match="NavLinkMatch.Prefix"
                        Icon="@Icons.Material.Filled.Mail">
                Inbox
            </MudNavLink>
            <MudNavLink Href="UserGroup/List" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Group">
                User Groups
            </MudNavLink>
            
            <MudNavLink Href="PublicOffer/PublicOfferBoard" Match="NavLinkMatch.Prefix"
                        Icon="@Icons.Material.Filled.Store">
                Public Offers
            </MudNavLink>
        </Authorized>
        <NotAuthorized>
            <MudNavLink Href="Account/Register" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Person">
                Register
            </MudNavLink>
            <MudNavLink Href="Account/Login" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Password">
                Login
            </MudNavLink>
            <MudNavLink Href="Account/RegisterConfirmation" Match="NavLinkMatch.Prefix"
                        Icon="@Icons.Material.Filled.BugReport">
                Confirm User (Debug)
            </MudNavLink>
        </NotAuthorized>
    </AuthorizeView>
    <MudNavGroup Title="WebAssembly (WASM)" Icon="@Icons.Material.Filled.Bolt" Expanded="true">
        <MudNavLink Href="Item/WasmList" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.List">
            Item List (WASM)
        </MudNavLink>
        <MudNavLink Href="Tag/WasmDiagram" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Hub">
            Tag Diagram (WASM)
        </MudNavLink>
        <MudNavLink Href="Tag/WasmTree" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.AccountTree">
            Tag Tree (WASM)
        </MudNavLink>
        <MudNavLink Href="Tag/WasmList" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Tag">
            Tag List (WASM)
        </MudNavLink>
        <MudNavLink Href="UserGroup/WasmList" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Group">
            User Groups (WASM)
        </MudNavLink>
        <MudNavLink Href="Notification/WasmList" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Notifications">
            Notifications (WASM)
        </MudNavLink>
        <MudNavLink Href="User/WasmSearch" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.PersonSearch">
            Users (WASM)
        </MudNavLink>
        <MudNavLink Href="Bounty/WasmBoard" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.AssignmentTurnedIn">
            Bounty Board (WASM)
        </MudNavLink>
        <MudNavLink Href="PublicOffer/WasmBoard" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Store">
            Public Offers (WASM)
        </MudNavLink>
        <MudNavLink Href="Contract/WasmManagement" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Mail">
            Contracts (WASM)
        </MudNavLink>
        <MudNavLink Href="RightAsset/WasmOverview" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.AccountBalanceWallet">
            Right Assets (WASM)
        </MudNavLink>
        <AuthorizeView Roles="Admin">
            <MudNavLink Href="User/WasmManagement" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.ManageAccounts">
                User Management (WASM)
            </MudNavLink>
            <MudNavLink Href="Admin/WasmReports" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Report">
                Reports (WASM)
            </MudNavLink>
            <MudNavLink Href="Admin/WasmInvitations" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.MailOutline">
                Invitations (WASM)
            </MudNavLink>
        </AuthorizeView>
    </MudNavGroup>
    @if (Env.IsDevelopment())
    {
        <MudNavLink Href="User/MakeMeAdmin" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.AdminPanelSettings">
            Make Me Admin
        </MudNavLink>
    }
</MudNavMenu>