@using SRNSMudApp.Models
@using SRNSMudApp.Services
@namespace SRNSMudApp.Components.Shared
@inject LinkPreviewService PreviewService

@if (_isLoading)
{
    <MudCard Outlined="true" Class="mt-2 rounded-lg">
        <MudCardContent Class="d-flex align-center pa-2">
            <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="mr-3"/>
            <MudText Typo="Typo.body2">リンク情報を取得中...</MudText>
        </MudCardContent>
    </MudCard>
}
else if (_previewData != null && _previewData.IsSuccess)
{
    <MudCard Outlined="true" Class="mt-2 mb-2 rounded-lg preview-card"
             @onclick="NavigateToUrl">
        <div class="d-flex flex-row">
            @if (!string.IsNullOrEmpty(_previewData.ImageUrl))
            {
                <div class="preview-img-container">
                    <MudImage Src="@_previewData.ImageUrl" Alt="Preview Image" ObjectFit="ObjectFit.Cover" Width="120"
                              Height="120"
                              Class="preview-img"/>
                </div>
            }
            <MudCardContent Class="pa-3 d-flex flex-column justify-center preview-content">
                <MudText Typo="Typo.subtitle2"
                         Class="preview-title">
                    @_previewData.Title
                </MudText>
                @* ===== Text Fragment (選択テキスト) または 通常の Description ===== *@
                @if (!string.IsNullOrEmpty(_selectedText))
                {
                    <div
                        class="preview-highlight">
                        <div class="d-flex align-center highlight-header">
                            <MudIcon Icon="@Icons.Material.Filled.FormatQuote" Size="Size.Small"
                                     Class="highlight-icon"/>
                            <MudText Typo="Typo.caption" Class="highlight-title">
                                選択テキスト
                            </MudText>
                        </div>
                        <MudText Typo="Typo.caption" Color="Color.Primary" Class="highlight-text">
                            @_selectedText
                        </MudText>
                    </div>
                }
                else if (!string.IsNullOrEmpty(_previewData.Description))
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="preview-description">
                        @_previewData.Description
                    </MudText>
                }
                <div class="d-flex align-center mt-2">
                    <MudIcon Icon="@Icons.Material.Filled.Language" Size="Size.Small" Color="Color.Secondary"
                             Class="mr-1 site-icon"/>
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="site-name">
                        @(!string.IsNullOrEmpty(_previewData.SiteName) ? _previewData.SiteName : new Uri(_previewData.Url).Host)
                    </MudText>
                </div>
            </MudCardContent>
        </div>
    </MudCard>
}

@code {
    [Parameter] [EditorRequired] public string Url { get; set; } = null!;

    [Inject] private IJSRuntime JS { get; set; } = null!;

    private LinkPreviewData? _previewData;
    private bool _isLoading = true;
    private string? _selectedText;

    protected override async Task OnParametersSetAsync()
    {
        if (string.IsNullOrWhiteSpace(Url)) return;

        _selectedText = ExtractTextFragment(Url);

        _isLoading = true;
        _previewData = null;

        _previewData = await PreviewService.GetPreviewAsync(Url);

        _isLoading = false;
        // StateHasChanged();
    }

    private async Task NavigateToUrl()
    {
        if (!string.IsNullOrEmpty(Url))
        {
            try
            {
                await JS.InvokeVoidAsync("open", Url, "_blank");
            }
            catch (Exception)
            {
            }
        }
    }

    /// <summary>
    ///     URL の #:~:text= フラグメント（Text Fragments）からブラウザの選択テキストを抽出する。
    ///     Brave/Chrome の「選択箇所へのリンクをコピー」で生成されるURLに対応。
    ///     仕様: https://wicg.github.io/scroll-to-text-fragment/
    /// </summary>
    private static string? ExtractTextFragment(string url)
    {
        const string marker = "#:~:text=";
        var markerIndex = url.IndexOf(marker, StringComparison.Ordinal);
        if (markerIndex < 0) return null;

        // マーカー以降の文字列を取得
        var raw = url[(markerIndex + marker.Length)..];

        // &text= で複数フラグメントを分割
        var parts = raw.Split(["&text="], StringSplitOptions.RemoveEmptyEntries);

        var results = new List<string>();
        foreach (var part in parts)
        {
            // URLデコード
            string decoded;
            try
            {
                decoded = Uri.UnescapeDataString(part);
            }
            catch
            {
                decoded = part;
            }

            // Text Fragment の構造: [prefix-,]start[,end][,-suffix]
            // prefix- は "-," の前、-suffix は ",-" の後
            var text = decoded;

            // -suffix を除去: 最後の ",-" 以降を削除
            var suffixSep = text.LastIndexOf(",-", StringComparison.Ordinal);
            if (suffixSep >= 0)
                text = text[..suffixSep];

            // prefix- を除去: 最初の "-," 以降を使用
            var prefixSep = text.IndexOf("-,", StringComparison.Ordinal);
            if (prefixSep >= 0)
                text = text[(prefixSep + 2)..];

            // start と end を "," で分割して "〜" で結合
            var segments = text.Split(',')
                .Select(s => s.Trim())
                .Where(s => !string.IsNullOrWhiteSpace(s))
                .ToArray();

            if (segments.Length == 0) continue;
            var joined = string.Join("〜", segments);
            results.Add(joined);
        }

        return results.Count > 0 ? string.Join(" | ", results) : null;
    }

}