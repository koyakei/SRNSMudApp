@inject IItemTagService ItemTagService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject NavigationManager NavigationManager
@using SRNSMudApp.Components.Contract
@using SRNSMudApp.Components.Item
@using SRNSMudApp.Components.Tag
@using SRNSMudApp.Services
@inject TaggingContractService TaggingContractService
@implements IAsyncDisposable
@inject IDbContextFactory<ApplicationDbContext> DbFactory

<MudCard id="@($"item-card-{Item.Id}")" @onclick="@(() => OnFocus.InvokeAsync(Item.Id))" Outlined="true"
         Class="rounded-xl scroll-observe-target" Style="@GetItemCardStyle()">
<MudCardContent Class="pa-4">
<div class="d-flex align-start">
    <VoteButtons Score="GetItemScore()"
                 IsUpvoted="IsItemUpvoted()"
                 IsDownvoted="IsItemDownvoted()"
                 OnUpvoteClicked="UpvoteItemAsync"
                 OnDownvoteClicked="DownvoteItemAsync"/>

    <div class="flex-1">
        @{
            var requestInfo = ItemCardViewModel.GetRequestInfo(Item);
        }
        @if (requestInfo.IsTaggingRequest)
        {
            var canCancel = !string.IsNullOrEmpty(CurrentUserId) && Item.OwnerId == CurrentUserId && requestInfo.Status == TradeStatus.Proposed;
            var canApprove = !string.IsNullOrEmpty(CurrentUserId) && Item.AsRequestOf?.TagOwnerUserId == CurrentUserId && requestInfo.Status == TradeStatus.Proposed;
            
            <RequestInfoAlert RequestInfo="requestInfo"
                              CanCancel="canCancel"
                              CanApprove="canApprove"
                              OnCancel="CancelTaggingRequestAsync"
                              OnApprove="ApproveTaggingRequestAsync" />
        }

        <div class="d-flex justify-space-between align-start">
            <div>
                @{
                    var content = Item.Content ?? "内容なし";
                    var showExpandBtn = _isOverflowing;
                }

                <div id="@($"item-content-{Item.Id}")"
                     class="@($"resource-content {(!_isExpanded ? "line-clamp-2" : "")}")">
                    <MudText Typo="Typo.subtitle1"
                             Class="font-inherit" Style="white-space: pre-wrap;">
                        @content
                    </MudText>
                </div>
                @{
                    var urls = ExtractUrls(content);
                }
                @if (urls.Any())
                {
                    <div class="d-flex flex-column gap-2 mb-2 mt-2">
                        @foreach (var url in urls.Take(3))
                        {
                            <SRNSMudApp.Components.Shared.UrlPreviewCard Url="@url"/>
                        }
                    </div>
                }
                @if (showExpandBtn)
                {
                    <MudLink OnClick="ToggleExpand" Color="Color.Primary"
                             Typo="Typo.body2" Underline="Underline.Hover" Class="cursor-pointer">
                        @(_isExpanded ? "閉じる" : "もっと見る")
                    </MudLink>
                }
                <MudText Typo="Typo.caption" Color="Color.Secondary"
                         Class="mb-2 mt-2 d-block">
                    投稿者:
                    @if (!string.IsNullOrEmpty(Item.OwnerId))
                    {
                        <span @onclick:stopPropagation="true">
                            <MudLink Href="@($"/User/UserDetail/{Item.OwnerId}")"
                                     Color="Color.Inherit"
                                     Underline="Underline.Hover">
                                @(Item.Owner?.UserName)
                            </MudLink>
                        </span>
                    }
                    else
                    {
                        @(Item.Owner?.UserName ?? "不明")
                    }
                    <span class="mx-1">|</span>
                    最終更新:
                    <span @onclick:stopPropagation="true">
                        <MudLink Href="@($"/ItemDetail/{Item.Id}")" Color="Color.Inherit"
                                 Underline="Underline.Hover">
                            @Item.UpdatedDate.ToLocalTime().ToString("g")
                        </MudLink>
                    </span>
                </MudText>
            </div>

            @* ログイン中のユーザーがオーナーの場合のみ操作ボタンを表示 *@
            @if (!string.IsNullOrEmpty(CurrentUserId) && Item.OwnerId == CurrentUserId)
            {
                <div class="d-flex">
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                   Color="Color.Primary" OnClick="EditItemAsync"
                                   title="このアイテムを編集"/>
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                   Color="Color.Error" OnClick="DeleteItemAsync"
                                   title="このアイテムを削除"/>
                </div>
            }
        </div>

        @{
            var allTags = Item.TagRelations?
                .Where(tr => tr.Tag != null && !tr.Tag.IsSystem)
                .OrderByDescending(tr => tr.Weight)
                .ToList() ?? [];

            // 削除されたタグが TimelineEvent に含まれている場合は、仮想的な TagRelation としてリストに追加して表示する
            if (HighlightEvents != null)
            {
                foreach (var ev in HighlightEvents.Where(e => e.EventType == "Delete"))
                {
                    if (ev.FollowedTag != null && allTags.All(t => t.TagId != ev.FollowedTagId))
                    {
                        allTags.Add(new TagRelation
                        {
                            TagId = ev.FollowedTagId,
                            Tag = ev.FollowedTag,
                            Weight = ev.PreviousWeight ?? 0,
                            OwnerId = ev.OwnerId // fake owner
                        });
                    }
                }
            }

            // タグが5つ以上あるか判定
            var hasManyTags = allTags.Count >= 5;
            // 折りたたみ時の表示数（4つ表示して、1つ以上を +X more にする）
            const int displayLimit = 4;

            var tagsToDisplay = _areTagsExpanded || !hasManyTags ? allTags : [.. allTags.Take(displayLimit)];
            var hiddenCount = hasManyTags ? allTags.Count - displayLimit : 0;
        }

        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" Class="align-items-center">
            @for (var i = 0; i < tagsToDisplay.Count; i++)
            {
                var tr = tagsToDisplay[i];
                <ItemTagChip TagRelation="tr"
                             Item="Item"
                             CurrentUserId="@CurrentUserId"
                             AllTags="AllTags"
                             AllTagRelationsToTags="AllTagRelationsToTags"
                             HighlightEvent="@(HighlightEvents?.FirstOrDefault(e => e.FollowedTagId == (tr.Tag?.Id ?? -1)))"
                             OnDataChanged="OnDataChanged"
                             ChipIndex="i"
                             ChipBackgrounds="_chipBackgrounds"
                             ChipTextColors="_chipTextColors"/>
            }
            @* 5つ以上の場合のみボタンを表示 *@
            @if (hasManyTags)
            {
                if (_areTagsExpanded)
                {
                    <MudChip T="string" Size="Size.Small"
                             OnClick="ToggleTagExpand"
                             Class="more-chip">
                        閉じる
                    </MudChip>
                }
                else
                {
                    <MudChip T="string" Size="Size.Small"
                             OnClick="@ToggleTagExpand"
                             Class="more-chip">
                        +@hiddenCount more
                    </MudChip>
                }
            }

            <!-- リクエスト中のタグ -->
            @foreach (var request in _taggingRequests)
            {
                // Executed または Canceled の場合は非表示
                if (request.Status != TradeStatus.Proposed) continue;

                var isAdd = request.RequestType == TaggingRequestType.Add;
                var hasTag = Item.TagRelations?.Any(tr => tr.TagId == request.RequestedTagId) ?? false;

                // すでに関連付けが存在する追加リクエスト、または関連付けが存在しない削除リクエストは非表示（放置されているリクエスト対策）
                if (isAdd && hasTag) continue;
                if (!isAdd && !hasTag) continue;

                var replyCount = request.Replies?.Count ?? 0;

                <MudBadge Content="@replyCount" Color="Color.Primary" Overlap="true"
                          Visible="@(replyCount > 0)">
                    <MudChip T="string"
                             Size="Size.Small"
                             Color="@(isAdd ? Color.Success : Color.Error)"
                             Variant="Variant.Outlined"
                             Icon="@(isAdd ? Icons.Material.Filled.Add : Icons.Material.Filled.Remove)">
                        <div class="d-flex align-center">
                            <a class="chip-link mr-1" style="color: inherit;"
                               @onclick="@(() => NavigationManager.NavigateTo($"/TagDetail/{request.RequestedTagId}"))"
                               @onclick:stopPropagation="true">
                                @request.RequestedTag?.Name
                            </a>
                            <MudIconButton Icon="@Icons.Material.Filled.ChatBubbleOutline"
                                           Size="Size.Small"
                                           Color="Color.Inherit"
                                           Class="pa-0"
                                           OnClick="@(async () => await OpenThreadDialogAsync(request))"/>
                        </div>
                    </MudChip>
                </MudBadge>
            }

            <MudIconButton Icon="@Icons.Material.Filled.AddCircleOutline"
                           Size="Size.Small"
                           Color="Color.Primary"
                           OnClick="OnAddTagClicked"
                           title="タグを追加"/>
        </MudStack>
        <div class="d-flex justify-end mt-2">
            <MudButton StartIcon="@Icons.Material.Filled.ChatBubbleOutline"
                       Size="Size.Small" Color="Color.Default" Variant="Variant.Text"
                       OnClick="ToggleRepliesAsync">
                リプライ
            </MudButton>
        </div>
    </div>
</div>

<MudCollapse Expanded="_isRepliesExpanded">
    <MudDivider Class="my-3"/>
    <MudText Typo="Typo.subtitle2" Class="mb-2">リプライスレッド</MudText>

    @if (_replies.Any())
    {
        <div class="d-flex flex-column gap-3 mb-4 pl-4" style="border-left: 2px solid #e0e0e0;">
            @foreach (var reply in _replies)
            {
                <ItemCard Item="reply"
                          CurrentUserId="@CurrentUserId"
                          CurrentUserGoodTagId="@CurrentUserGoodTagId"
                          CurrentUserBadTagId="@CurrentUserBadTagId"
                          OnDataChanged="LoadRepliesAsync"
                          AllTags="AllTags"
                          AllTagRelationsToTags="AllTagRelationsToTags"
                          HighlightEvents="HighlightEvents"
                          OnEnsureSystemTags="OnEnsureSystemTags"/>
            }
        </div>
    }

    <div class="d-flex align-end gap-2 mt-2">
        <MudTextField @bind-Value="_newReplyContent"
                      Label="リプライを入力..."
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Lines="2"
                      Immediate="true"
                      Class="flex-grow-1"/>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   OnClick="SubmitReplyAsync"
                   Disabled="@(string.IsNullOrWhiteSpace(_newReplyContent) || _isSubmittingReply)">
            @if (_isSubmittingReply)
            {
                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true"/>
                <span class="ms-2">送信中</span>
            }
            else
            {
                <span>送信</span>
            }
        </MudButton>
    </div>
</MudCollapse>
</MudCardContent>
</MudCard>

@code {
    [Parameter] [EditorRequired] public Item Item { get; set; } = null!;
    [Parameter] public EventCallback OnDataChanged { get; set; }
    [Parameter] public bool IsFocused { get; set; }
    [Parameter] public EventCallback<int> OnFocus { get; set; }
    [Parameter] public List<Tag> AllTags { get; set; } = [];
    [Parameter] public List<TagRelationToTag> AllTagRelationsToTags { get; set; } = [];
    [Parameter] public string CurrentUserId { get; set; } = "";
    [Parameter] public int? CurrentUserGoodTagId { get; set; }
    [Parameter] public int? CurrentUserBadTagId { get; set; }
    [Parameter] public EventCallback OnEnsureSystemTags { get; set; }
    [Parameter] public List<TimelineEvent>? HighlightEvents { get; set; }

    private readonly string[] _chipBackgrounds = ["#EEEDFE"];
    private readonly string[] _chipTextColors = ["#26215C"];

    private bool _isExpanded;
    private bool _isOverflowing;
    private bool _areTagsExpanded;

    private int _activePopoverTagId = -1;
    private string _activePopoverChipKey = "";

    private DotNetObjectReference<ItemCard>? _dotNetRef;
    private bool _needsOverflowCheck = true;

    private List<TaggingRequestEntity> _taggingRequests = [];

    private bool _isRepliesExpanded;
    private List<Item> _replies = [];
    private string _newReplyContent = "";
    private bool _isSubmittingReply;

    protected override async Task OnParametersSetAsync()
    {
        _taggingRequests = await ItemTagService.GetTaggingRequestsForItemAsync(Item.Id);
        if (_isRepliesExpanded)
        {
            await LoadRepliesAsync();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            try
            {
                await JS.InvokeVoidAsync("contentOverflowHelper.init", _dotNetRef);
            }
            catch (Exception)
            {
                // ignored
            }

            try
            {
                await JS.InvokeVoidAsync("contentOverflowHelper.initScrollObserver");
            }
            catch (Exception)
            {
                // ignored
            }
        }

        if (_needsOverflowCheck)
        {
            _needsOverflowCheck = false;
            await UpdateOverflowStateAsync();
            try
            {
                await JS.InvokeVoidAsync("contentOverflowHelper.observeElements", $"#item-card-{Item.Id}");
            }
            catch (Exception)
            {
                // ignored
            }
        }
    }

    [JSInvokable]
    public void OnWindowResized()
    {
        _needsOverflowCheck = true;
        InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public void OnElementFocusedByScroll(string elementId)
    {
        if (elementId == $"item-card-{Item.Id}")
        {
            OnFocus.InvokeAsync(Item.Id);
        }
    }

    private async Task UpdateOverflowStateAsync()
    {
        if (_isExpanded) return;

        try
        {
            var overflowIds = await JS.InvokeAsync<int[]>("contentOverflowHelper.checkOverflow", new[] { Item.Id });
            var isOverflowing = overflowIds.Contains(Item.Id);
            if (_isOverflowing != isOverflowing)
            {
                _isOverflowing = isOverflowing;
                StateHasChanged();
            }
        }
        catch (Exception)
        {
            // ignored
        }
    }

    private string GetItemCardStyle()
    {
        return ItemCardViewModel.GetItemCardStyle(IsFocused);
    }

    private void ToggleExpand()
    {
        _isExpanded = !_isExpanded;
        if (!_isExpanded)
        {
            _needsOverflowCheck = true; // Re-check when collapsing
        }
    }

    private void ToggleTagExpand()
    {
        _areTagsExpanded = !_areTagsExpanded;
    }

    private async Task CancelTaggingRequestAsync()
    {
        if (Item.AsRequestOf == null) return;
        try
        {
            await TaggingContractService.CancelContractAsync(Item.AsRequestOf.Id, CurrentUserId);
            Item.AsRequestOf.Status = TradeStatus.Canceled;
            Snackbar.Add("リクエストを取り下げました。", Severity.Success);
            if (OnDataChanged.HasDelegate) await OnDataChanged.InvokeAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"エラー: {ex.Message}", Severity.Error);
        }
    }

    private async Task ApproveTaggingRequestAsync()
    {
        if (Item.AsRequestOf == null) return;
        try
        {
            await TaggingContractService.AcceptContractAsync(Item.AsRequestOf.Id, CurrentUserId);
            Item.AsRequestOf.Status = TradeStatus.Executed;
            Snackbar.Add("リクエストを承認しました。", Severity.Success);
            if (OnDataChanged.HasDelegate) await OnDataChanged.InvokeAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"エラー: {ex.Message}", Severity.Error);
        }
    }

    private async Task OpenThreadDialogAsync(TaggingRequestEntity request)
    {
        var parameters = new DialogParameters<TaggingRequestThreadDialog>
        {
            { x => x.TaggingRequest, request }
        };

        var options = new DialogOptions
        {
            CloseButton = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true
        };

        var dialog = await DialogService.ShowAsync<TaggingRequestThreadDialog>($"Request: {request.RequestedTag?.Name}", parameters, options);
        await dialog.Result;
        StateHasChanged();
    }

    private async Task ToggleRepliesAsync()
    {
        _isRepliesExpanded = !_isRepliesExpanded;
        if (_isRepliesExpanded && !_replies.Any())
        {
            await LoadRepliesAsync();
        }
    }

    private async Task LoadRepliesAsync()
    {
        _replies = await ItemTagService.GetItemRepliesAsync(Item.Id);
    }

    private async Task SubmitReplyAsync()
    {
        if (string.IsNullOrWhiteSpace(_newReplyContent) || string.IsNullOrEmpty(CurrentUserId)) return;

        _isSubmittingReply = true;
        try
        {
            var addedReply = await ItemTagService.AddItemReplyAsync(Item.Id, _newReplyContent, CurrentUserId);
            if (addedReply != null)
            {
                _newReplyContent = "";
                await LoadRepliesAsync();
            }
        }
        finally
        {
            _isSubmittingReply = false;
        }
    }

    private static string GetShortOwnerName(string? name)
    {
        return ItemCardViewModel.GetShortOwnerName(name);
    }

    private static IReadOnlyList<string> ExtractUrls(string? text)
    {
        return ItemCardViewModel.ExtractUrls(text);
    }

    // --- Voting Logic ---
    private int GetItemScore()
    {
        return ItemCardViewModel.GetItemScore(Item.TagRelations);
    }

    private bool IsItemUpvoted()
    {
        return ItemCardViewModel.IsItemUpvoted(Item.TagRelations, CurrentUserId, CurrentUserGoodTagId);
    }

    private bool IsItemDownvoted()
    {
        return ItemCardViewModel.IsItemDownvoted(Item.TagRelations, CurrentUserId, CurrentUserGoodTagId);
    }

    private async Task UpvoteItemAsync()
    {
        await ToggleItemVoteAsync(true);
    }

    private async Task DownvoteItemAsync()
    {
        await ToggleItemVoteAsync(false);
    }

    private async Task ToggleItemVoteAsync(bool isUpvote)
    {
        if (string.IsNullOrEmpty(CurrentUserId))
        {
            Snackbar.Add("ログインが必要です。", Severity.Warning);
            return;
        }

        if (OnEnsureSystemTags.HasDelegate)
        {
            await OnEnsureSystemTags.InvokeAsync();
        }

        if (!CurrentUserGoodTagId.HasValue)
        {
            Snackbar.Add("システムタグの取得に失敗しました。", Severity.Error);
            return;
        }

        var targetWeight = isUpvote ? 1 : -1;
        var goodTagId = CurrentUserGoodTagId!.Value;

        await using var context = await DbFactory.CreateDbContextAsync();
        var relations = await context.TagRelations.Where(tr => tr.ItemId == Item.Id && tr.OwnerId == CurrentUserId).ToListAsync();

        var existingRelation = relations.FirstOrDefault(tr => tr.TagId == goodTagId);

        if (existingRelation != null)
        {
            var tag = await context.Tags.FindAsync(goodTagId);
            if (existingRelation.Weight == targetWeight)
            {
                // 同じウェイトならキャンセル（削除）
                var delta = -existingRelation.Weight;
                if (tag != null)
                {
                    var prevWeight = tag.CachedWeight;
                    tag.CachedWeight += delta;
                    context.TagWeightLedgers!.Add(new TagWeightLedger
                    {
                        TagId = tag.Id,
                        TagNameSnapshot = tag.Name,
                        SourceType = "TagRelationDelete",
                        SourceId = existingRelation.Id,
                        PreviousWeight = prevWeight,
                        NewWeight = tag.CachedWeight,
                        Delta = delta,
                        IsOwnerAction = true,
                        Reason = "Vote取り消し",
                        OwnerId = CurrentUserId
                    });
                }

                context.TimelineEvents!.Add(new TimelineEvent
                {
                    OwnerId = CurrentUserId,
                    TargetType = "Item",
                    TargetItemId = Item.Id,
                    FollowedTagId = goodTagId,
                    EventType = "Delete",
                    PreviousWeight = existingRelation.Weight
                });

                context.TagRelations.Remove(existingRelation);
                var localTarget = Item.TagRelations.FirstOrDefault(tr => tr.Id == existingRelation.Id);
                if (localTarget != null) Item.TagRelations.Remove(localTarget);
            }
            else
            {
                // 逆のウェイトなら更新
                var delta = targetWeight - existingRelation.Weight;
                existingRelation.Weight = targetWeight;
                existingRelation.UpdatedDate = DateTime.UtcNow;

                if (tag != null)
                {
                    var prevWeight = tag.CachedWeight;
                    tag.CachedWeight += delta;
                    context.TagWeightLedgers!.Add(new TagWeightLedger
                    {
                        TagId = tag.Id,
                        TagNameSnapshot = tag.Name,
                        SourceType = "TagRelationUpdate",
                        SourceId = existingRelation.Id,
                        PreviousWeight = prevWeight,
                        NewWeight = tag.CachedWeight,
                        Delta = delta,
                        IsOwnerAction = true,
                        Reason = "Vote変更",
                        OwnerId = CurrentUserId
                    });
                }

                context.TimelineEvents!.Add(new TimelineEvent
                {
                    OwnerId = CurrentUserId,
                    TargetType = "Item",
                    TargetItemId = Item.Id,
                    FollowedTagId = goodTagId,
                    EventType = "Update",
                    PreviousWeight = existingRelation.Weight - delta,
                    NewWeight = existingRelation.Weight
                });

                var localTarget = Item.TagRelations.FirstOrDefault(tr => tr.Id == existingRelation.Id);
                if (localTarget != null)
                {
                    localTarget.Weight = targetWeight;
                }
            }
        }
        else
        {
            var newRelation = new TagRelation
            {
                ItemId = Item.Id,
                TagId = goodTagId,
                OwnerId = CurrentUserId,
                Weight = targetWeight,
                CreatedDate = DateTime.UtcNow,
                UpdatedDate = DateTime.UtcNow
            };
            context.TagRelations.Add(newRelation);
            Item.TagRelations.Add(newRelation);
        }

        await context.SaveChangesAsync();

        if (OnDataChanged.HasDelegate)
        {
            await OnDataChanged.InvokeAsync();
        }
    }

    // --- Edit/Delete Logic ---
    private async Task EditItemAsync()
    {
        if (Item.OwnerId != CurrentUserId)
        {
            Snackbar.Add("投稿者本人ではないため、編集する権限がありません。", Severity.Error);
            return;
        }

        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var parameters = new DialogParameters { ["Item"] = Item };
        var dialog = await DialogService.ShowAsync<ItemEditDialog>("アイテムの編集", parameters, options);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            if (OnDataChanged.HasDelegate) await OnDataChanged.InvokeAsync();
            Snackbar.Add("アイテムを更新しました。", Severity.Success);
        }
    }

    private async Task DeleteItemAsync()
    {
        if (Item.OwnerId != CurrentUserId)
        {
            Snackbar.Add("投稿者本人ではないため、操作する権限がありません。", Severity.Error);
            return;
        }

        await using var context = await DbFactory.CreateDbContextAsync();
        context.Items.Remove(Item);
        await context.SaveChangesAsync();
        if (OnDataChanged.HasDelegate) await OnDataChanged.InvokeAsync();

        Snackbar.Add("アイテムを削除しました。", Severity.Success);
    }

    // --- Tag Operations ---
    private async Task OnAddTagClicked()
    {
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Large, FullWidth = true };
        var dialog = await DialogService.ShowAsync<TagAddDialog>("タグの追加", options);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled && result.Data is Tag selectedTag)
        {
            await AddTagToItemAsync(selectedTag);
        }
    }

    private async Task AddTagToItemAsync(Tag selectedTag)
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        var tagFromDb = await context.Tags.Include(t => t.Owner).FirstOrDefaultAsync(t => t.Id == selectedTag.Id);
        if (tagFromDb == null) return;

        if (tagFromDb.OwnerId != CurrentUserId)
        {
            var parameters = new DialogParameters<ProposeContractDialog>
            {
                { x => x.TargetItem, Item },
                { x => x.RequestedTag, tagFromDb },
                { x => x.WeightDelta, 1 } // Adding a tag is equivalent to +1 weight request
            };
            var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
            var dialog = await DialogService.ShowAsync<ProposeContractDialog>("コントラクトの提案", parameters, options);
            var result = await dialog.Result;
            if (result is not null && !result.Canceled)
            {
                // Reload requests
                _taggingRequests = await ItemTagService.GetTaggingRequestsForItemAsync(Item.Id);
                StateHasChanged();
                if (OnDataChanged.HasDelegate) await OnDataChanged.InvokeAsync();
            }

            return;
        }

        var alreadyExists = Item.TagRelations?.Any(tr => tr.TagId == selectedTag.Id) ?? false;
        if (alreadyExists)
        {
            Snackbar.Add("このタグは既に追加されています。", Severity.Warning);
            return;
        }

        var newRelation = new TagRelation
        {
            ItemId = Item.Id,
            TagId = selectedTag.Id,
            Weight = 1,
            OwnerId = CurrentUserId
        };

        context.Set<TagRelation>().Add(newRelation);
        context.TimelineEvents!.Add(new TimelineEvent
        {
            OwnerId = CurrentUserId,
            TargetType = "Item",
            TargetItemId = Item.Id,
            FollowedTagId = selectedTag.Id,
            EventType = "Insert",
            NewWeight = 1
        });

        await context.SaveChangesAsync();

        var prevWeight = tagFromDb.CachedWeight;
        tagFromDb.CachedWeight += 1;

        context.TagWeightLedgers!.Add(new TagWeightLedger
        {
            TagId = tagFromDb.Id,
            TagNameSnapshot = tagFromDb.Name,
            SourceType = "TagRelationInsert",
            SourceId = newRelation.Id,
            PreviousWeight = prevWeight,
            NewWeight = tagFromDb.CachedWeight,
            Delta = 1,
            IsOwnerAction = true,
            Reason = "タグの新規追加",
            OwnerId = CurrentUserId
        });

        await context.SaveChangesAsync();

        // ローカルに即時反映
        Item.TagRelations ??= new List<TagRelation>();
        newRelation.Tag = tagFromDb;
        Item.TagRelations.Add(newRelation);

        Snackbar.Add("タグを追加しました。", Severity.Success);
        if (OnDataChanged.HasDelegate) await OnDataChanged.InvokeAsync();
    }

    // The logic inside ItemCard has been moved to ItemTagChip.razor

    public async ValueTask DisposeAsync()
    {
        if (_dotNetRef != null)
        {
            try
            {
                await JS.InvokeVoidAsync("contentOverflowHelper.removeDotNetRef", _dotNetRef);
            }
            catch (Exception)
            {
                // ignored
            }

            _dotNetRef.Dispose();
        }
    }

