    private async Task AddTagToItemAsync(Tag selectedTag)
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        var tagFromDb = await context.Tags.Include(t => t.Owner).FirstOrDefaultAsync(t => t.Id == selectedTag.Id);
        if (tagFromDb == null) return;

        if (tagFromDb.OwnerId != CurrentUserId)
        {
            var parameters = new DialogParameters<ProposeContractDialog>
            {
                { x => x.TargetItem, Item },
                { x => x.RequestedTag, tagFromDb },
                { x => x.WeightDelta, 1 } // Adding a tag is equivalent to +1 weight request
            };
            var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
            var dialog = await DialogService.ShowAsync<ProposeContractDialog>("コントラクトの提案", parameters, options);
            var result = await dialog.Result;
            if (result is not null && !result.Canceled)
            {
                // Reload requests
                _taggingRequests = await ItemTagService.GetTaggingRequestsForItemAsync(Item.Id);
                StateHasChanged();
                if (OnDataChanged.HasDelegate) await OnDataChanged.InvokeAsync();
            }
            return;
        }

        var alreadyExists = Item.TagRelations?.Any(tr => tr.TagId == selectedTag.Id) ?? false;
        if (alreadyExists)
        {
            Snackbar.Add("このタグは既に追加されています。", Severity.Warning);
            return;
        }

        var newRelation = new TagRelation
        {
            ItemId = Item.Id,
            TagId = selectedTag.Id,
            Weight = 1,
            OwnerId = CurrentUserId
        };

        context.Set<TagRelation>().Add(newRelation);
        context.TimelineEvents!.Add(new TimelineEvent
        {
            OwnerId = CurrentUserId,
            TargetType = "Item",
            TargetItemId = Item.Id,
            FollowedTagId = selectedTag.Id,
            EventType = "Insert",
            NewWeight = 1
        });
        await context.SaveChangesAsync();

        // ローカルに即時反映
        if (Item.TagRelations == null)
        {
            Item.TagRelations = new List<TagRelation>();
        }
        newRelation.Tag = tagFromDb;
        Item.TagRelations.Add(newRelation);

        Snackbar.Add("タグを追加しました。", Severity.Success);
        if (OnDataChanged.HasDelegate) await OnDataChanged.InvokeAsync();
    }

    private async Task RemoveTagRelationAsync(TagRelation relation)
    {
        if (relation.OwnerId != CurrentUserId)
        {
            if (relation.Tag == null) return;
            var parameters = new DialogParameters<ProposeContractDialog>
            {
                { x => x.TargetItem, Item },
                { x => x.RequestedTag, relation.Tag },
                { x => x.WeightDelta, -relation.Weight }, // Suggest removing entirely
                { x => x.IsRemovalRequest, true }
            };
            var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
            var dialog = await DialogService.ShowAsync<ProposeContractDialog>("コントラクトの提案", parameters, options);
            var result = await dialog.Result;
            if (result is not null && !result.Canceled)
            {
                // Reload requests
                _taggingRequests = await ItemTagService.GetTaggingRequestsForItemAsync(Item.Id);
                StateHasChanged();
                if (OnDataChanged.HasDelegate) await OnDataChanged.InvokeAsync();
            }
            return;
        }

        await using var context = await DbFactory.CreateDbContextAsync();
        var entityToRemove = await context.TagRelations.FindAsync(relation.Id);
        if (entityToRemove != null)
        {
            context.TagRelations.Remove(entityToRemove);
        }
        context.TimelineEvents!.Add(new TimelineEvent
        {
            OwnerId = CurrentUserId,
            TargetType = "Item",
            TargetItemId = Item.Id,
            FollowedTagId = relation.TagId,
            EventType = "Delete",
            PreviousWeight = relation.Weight
        });
        await context.SaveChangesAsync();

        // 画面上に即時反映させるためローカルのコレクションからも削除する
        var localRelation = Item.TagRelations.FirstOrDefault(tr => tr.Id == relation.Id);
        if (localRelation != null)
        {
            Item.TagRelations.Remove(localRelation);
        }

        Snackbar.Add("タグの関連付けを解除しました。", Severity.Success);
        if (OnDataChanged.HasDelegate) await OnDataChanged.InvokeAsync();
    }

    private async Task UpdateTagRelationWeightAsync(TagRelation relation, int delta)
    {
        if (relation.OwnerId != CurrentUserId)
        {
            if (relation.Tag == null) return;
            var parameters = new DialogParameters<ProposeContractDialog>
            {
                { x => x.TargetItem, Item },
                { x => x.RequestedTag, relation.Tag },
                { x => x.WeightDelta, delta },
                { x => x.IsRemovalRequest, false }
            };
            var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
            var dialog = await DialogService.ShowAsync<ProposeContractDialog>("コントラクトの提案", parameters, options);
            var result = await dialog.Result;
            if (result is not null && !result.Canceled)
            {
                // Reload requests
                _taggingRequests = await ItemTagService.GetTaggingRequestsForItemAsync(Item.Id);
                StateHasChanged();
                if (OnDataChanged.HasDelegate) await OnDataChanged.InvokeAsync();
            }
            return;
        }

        await using var context = await DbFactory.CreateDbContextAsync();
        var entity = await context.TagRelations.FindAsync(relation.Id);
        if (entity != null)
        {
            entity.Weight += delta;
            entity.UpdatedDate = DateTime.UtcNow;

            var tag = await context.Tags.FindAsync(entity.TagId);
            if (tag != null)
            {
                var prevWeight = tag.CachedWeight;
                tag.CachedWeight += delta;
                context.TagWeightLedgers!.Add(new TagWeightLedger
                {
                    TagId = tag.Id,
                    TagNameSnapshot = tag.Name,
                    SourceType = "TagRelationUpdate",
                    SourceId = entity.Id,
                    PreviousWeight = prevWeight,
                    NewWeight = tag.CachedWeight,
                    Delta = delta,
                    IsOwnerAction = true,
                    Reason = "ユーザーによる直接ウェイト変更",
                    OwnerId = CurrentUserId
                });

                context.TimelineEvents!.Add(new TimelineEvent
                {
                    OwnerId = CurrentUserId,
                    TargetType = "Item",
                    TargetItemId = Item.Id,
                    FollowedTagId = entity.TagId,
                    EventType = "Update",
                    PreviousWeight = entity.Weight - delta,
                    NewWeight = entity.Weight
                });
            }

            await context.SaveChangesAsync();
            if (OnDataChanged.HasDelegate) await OnDataChanged.InvokeAsync();
        }
    }

    private async Task EditTagRelationWeightAsync(TagRelation relation)
    {
        if (relation.OwnerId != CurrentUserId)
        {
            Snackbar.Add("関連付けた本人ではないため、Weightを変更する権限がありません。", Severity.Error);
            return;
        }

        var parameters = new DialogParameters { ["Weight"] = relation.Weight };
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.ExtraSmall, FullWidth = true };
        var dialog = await DialogService.ShowAsync<WeightEditDialog>("Weightの一括変更", parameters, options);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled && result.Data is int newWeight)
        {
            if (newWeight == relation.Weight) return;

            await using var context = await DbFactory.CreateDbContextAsync();
            var entity = await context.TagRelations.FindAsync(relation.Id);
            if (entity != null)
            {
                var delta = newWeight - entity.Weight;
                entity.Weight = newWeight;
                entity.UpdatedDate = DateTime.UtcNow;

                var tag = await context.Tags.FindAsync(entity.TagId);
                if (tag != null)
                {
                    var prevWeight = tag.CachedWeight;
                    tag.CachedWeight += delta;
                    context.TagWeightLedgers!.Add(new TagWeightLedger
                    {
                        TagId = tag.Id,
                        TagNameSnapshot = tag.Name,
                        SourceType = "TagRelationUpdate",
                        SourceId = entity.Id,
                        PreviousWeight = prevWeight,
                        NewWeight = tag.CachedWeight,
                        Delta = delta,
                        IsOwnerAction = true,
                        Reason = "ユーザーによる直接ウェイト一括変更",
                        OwnerId = CurrentUserId
                    });
                }

                await context.SaveChangesAsync();
                if (OnDataChanged.HasDelegate) await OnDataChanged.InvokeAsync();
            }
        }
    }

    private async Task ChangeItemTagAsync(TagRelation oldRelation, int newTagId)
    {
        if (oldRelation.TagId == newTagId) return;

        if (oldRelation.OwnerId != CurrentUserId)
        {
            Snackbar.Add("関連付けた本人ではないため、変更する権限がありません。", Severity.Error);
            return;
        }

        await using var context = await DbFactory.CreateDbContextAsync();
        var alreadyExists = await context.TagRelations
            .AnyAsync(tr => tr.ItemId == Item.Id && tr.TagId == newTagId);

        if (alreadyExists)
        {
            Snackbar.Add("変更先のタグは既に追加されています。", Severity.Warning);
            return;
        }

        var entity = await context.TagRelations.FindAsync(oldRelation.Id);
        if (entity != null)
        {
            entity.TagId = newTagId;
            entity.UpdatedDate = DateTime.UtcNow;
            await context.SaveChangesAsync();

            Snackbar.Add("タグを変更しました。", Severity.Success);

            _activePopoverTagId = -1;
            _activePopoverChipKey = "";
            if (OnDataChanged.HasDelegate) await OnDataChanged.InvokeAsync();
        }
    }

