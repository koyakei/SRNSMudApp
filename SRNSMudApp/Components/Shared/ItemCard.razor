    private async Task ToggleItemVoteAsync(bool isUpvote)
    {
        if (string.IsNullOrEmpty(CurrentUserId))
        {
            Snackbar.Add("ログインが必要です。", Severity.Warning);
            return;
        }

        if (OnEnsureSystemTags.HasDelegate)
        {
            await OnEnsureSystemTags.InvokeAsync();
        }

        if (!CurrentUserGoodTagId.HasValue || !CurrentUserBadTagId.HasValue)
        {
            Snackbar.Add("システムタグの取得に失敗しました。", Severity.Error);
            return;
        }

        var targetTagId = isUpvote ? CurrentUserGoodTagId!.Value : CurrentUserBadTagId!.Value;
        var oppositeTagId = isUpvote ? CurrentUserBadTagId!.Value : CurrentUserGoodTagId!.Value;

        await using var context = await DbFactory.CreateDbContextAsync();
        var relations = await context.TagRelations.Where(tr => tr.ItemId == Item.Id && tr.OwnerId == CurrentUserId).ToListAsync();

        var targetRelation = relations.FirstOrDefault(tr => tr.TagId == targetTagId);
        var oppositeRelation = relations.FirstOrDefault(tr => tr.TagId == oppositeTagId);

        if (targetRelation != null)
        {
            context.TagRelations.Remove(targetRelation);
        }
        else
        {
            context.TagRelations.Add(new TagRelation
            {
                ItemId = Item.Id,
                TagId = targetTagId,
                OwnerId = CurrentUserId,
                Weight = 1
            });

            if (oppositeRelation != null)
            {
                context.TagRelations.Remove(oppositeRelation);
            }
        }

        await context.SaveChangesAsync();
        
        // ローカルにも反映（削除分のみ。追加はリロードを待つ）
        if (targetRelation != null)
        {
            var localTarget = Item.TagRelations.FirstOrDefault(tr => tr.Id == targetRelation.Id);
            if (localTarget != null) Item.TagRelations.Remove(localTarget);
        }
        else if (oppositeRelation != null)
        {
            var localOpposite = Item.TagRelations.FirstOrDefault(tr => tr.Id == oppositeRelation.Id);
            if (localOpposite != null) Item.TagRelations.Remove(localOpposite);
        }

        if (OnDataChanged.HasDelegate)
        {
            await OnDataChanged.InvokeAsync();
        }
    }

