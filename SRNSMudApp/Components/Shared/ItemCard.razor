@inject IItemTagService ItemTagService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject NavigationManager NavigationManager
@using SRNSMudApp.Services
@using SRNSMudApp.Components.Item
@using SRNSMudApp.Components.Tag
@using SRNSMudApp.Components.Contract
@implements IAsyncDisposable
@inject IDbContextFactory<ApplicationDbContext> DbFactory

<MudCard id="@($"item-card-{Item.Id}")" @onclick="@(() => OnFocus.InvokeAsync(Item.Id))" Outlined="true"
         Class="rounded-xl scroll-observe-target" Style="@GetItemCardStyle()">
    <MudCardContent Class="pa-4">
        <div class="d-flex align-start">
            <VoteButtons Score="GetItemScore()"
                         IsUpvoted="IsItemUpvoted()"
                         IsDownvoted="IsItemDownvoted()"
                         OnUpvoteClicked="UpvoteItemAsync"
                         OnDownvoteClicked="DownvoteItemAsync"/>

            <div class="flex-1">
                @{
                    var requestInfo = ItemCardViewModel.GetRequestInfo(Item);
                }
                @if (requestInfo.IsTaggingRequest)
                {
                    <MudAlert Severity="@(requestInfo.RequestType == TaggingRequestType.Add ? Severity.Success : (requestInfo.RequestType == TaggingRequestType.Remove ? Severity.Error : Severity.Warning))" 
                              Variant="Variant.Outlined" 
                              Dense="true" 
                              Class="mb-3 py-1 px-3"
                              Icon="@(requestInfo.RequestType == TaggingRequestType.Add ? Icons.Material.Filled.AddCircleOutline : (requestInfo.RequestType == TaggingRequestType.Remove ? Icons.Material.Outlined.Delete : Icons.Material.Outlined.RemoveCircleOutline))">
                        <div class="d-flex align-start flex-wrap" style="gap: 8px;">
                            <div class="d-flex align-center mt-1">
                                <MudText Typo="Typo.body2" Class="font-weight-bold">
                                    @(requestInfo.RequestType == TaggingRequestType.Add ? "タグ追加リクエスト" : (requestInfo.RequestType == TaggingRequestType.Remove ? "タグ削除リクエスト" : "ウェイト減少リクエスト"))
                                </MudText>
                            </div>
                            <span class="mt-1" style="color: var(--mud-palette-lines-default);">|</span>
                            
                            <div class="d-flex flex-column justify-center" style="flex: 1; min-width: 200px;">
                                @if (!string.IsNullOrWhiteSpace(requestInfo.TargetItemContent))
                                {
                                    <div class="d-flex align-start gap-1 mt-1" @onclick:stopPropagation="true">
                                        <div class="flex-1" style="min-width: 0;">
                                            <MudLink Href="@($"/ItemDetail/{requestInfo.TargetItemId}")" Color="Color.Default" Underline="Underline.Hover">
                                                <div class="@(!_isTargetExpanded ? "line-clamp-2" : "")" 
                                                     style="font-size: 0.85rem; padding: 4px 8px; background: rgba(0,0,0,0.03); border-radius: 4px; white-space: pre-wrap; word-break: break-word;">
                                                    @requestInfo.TargetItemContent
                                                </div>
                                            </MudLink>
                                        </div>
                                        <MudIconButton Icon="@(_isTargetExpanded ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)" 
                                                       Size="Size.Small" 
                                                       OnClick="ToggleTargetExpand" 
                                                       Class="mt-n1 flex-shrink-0"
                                                       title="展開/折りたたみ" />
                                    </div>
                                }
                                else 
                                {
                                    <div class="mt-1" @onclick:stopPropagation="true">
                                        <MudLink Href="@($"/ItemDetail/{requestInfo.TargetItemId}")" Color="Color.Default" Underline="Underline.Hover">
                                            <div style="font-size: 0.85rem; padding: 4px 8px; background: rgba(0,0,0,0.03); border-radius: 4px;">
                                                (内容なし)
                                            </div>
                                        </MudLink>
                                    </div>
                                }
                            </div>
                            
                            <span class="mt-1" style="color: var(--mud-palette-lines-default);">|</span>
                            <div class="d-flex align-center mt-1">
                                <MudText Typo="Typo.body2" Class="mr-1">タグ:</MudText>
                                <span @onclick:stopPropagation="true">
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" Class="ma-0 cursor-pointer" OnClick="@(() => NavigationManager.NavigateTo($"/TagDetail/{requestInfo.TargetTagId}"))">
                                        @requestInfo.TargetTagName
                                    </MudChip>
                                </span>
                            </div>
                        </div>
                    </MudAlert>
                }

                <div class="d-flex justify-space-between align-start">
                    <div>
                        @{
                            var content = Item.Content ?? "内容なし";
                            var showExpandBtn = _isOverflowing;
                        }

                        <div id="@($"item-content-{Item.Id}")"
                             class="@($"resource-content {(!_isExpanded ? "line-clamp-2" : "")}")">
                            <MudText Typo="Typo.subtitle1"
                                     Class="font-inherit" Style="white-space: pre-wrap;">
                                @content
                            </MudText>
                        </div>
                        @{
                            var urls = ExtractUrls(content);
                        }
                        @if (urls.Any())
                        {
                            <div class="d-flex flex-column gap-2 mb-2 mt-2">
                                @foreach (var url in urls.Take(3))
                                {
                                    <SRNSMudApp.Components.Shared.UrlPreviewCard Url="@url"/>
                                }
                            </div>
                        }
                        @if (showExpandBtn)
                        {
                            <MudLink OnClick="ToggleExpand" Color="Color.Primary"
                                     Typo="Typo.body2" Underline="Underline.Hover" Class="cursor-pointer">
                                @(_isExpanded ? "閉じる" : "もっと見る")
                            </MudLink>
                        }
                        <MudText Typo="Typo.caption" Color="Color.Secondary"
                                 Class="mb-2 mt-2 d-block">
                            投稿者:
                            @if (!string.IsNullOrEmpty(Item.OwnerId))
                            {
                                <span @onclick:stopPropagation="true">
                                    <MudLink Href="@($"/User/UserDetail/{Item.OwnerId}")"
                                             Color="Color.Inherit"
                                             Underline="Underline.Hover">
                                        @(Item.Owner?.UserName)
                                    </MudLink>
                                </span>
                            }
                            else
                            {
                                @(Item.Owner?.UserName ?? "不明")
                            }
                            <span class="mx-1">|</span>
                            最終更新:
                            <span @onclick:stopPropagation="true">
                                <MudLink Href="@($"/ItemDetail/{Item.Id}")" Color="Color.Inherit"
                                         Underline="Underline.Hover">
                                    @Item.UpdatedDate.ToLocalTime().ToString("g")
                                </MudLink>
                            </span>
                        </MudText>
                    </div>

                    @* ログイン中のユーザーがオーナーの場合のみ操作ボタンを表示 *@
                    @if (!string.IsNullOrEmpty(CurrentUserId) && Item.OwnerId == CurrentUserId)
                    {
                        <div class="d-flex">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                           Color="Color.Primary" OnClick="EditItemAsync"
                                           title="このアイテムを編集"/>
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                           Color="Color.Error" OnClick="DeleteItemAsync"
                                           title="このアイテムを削除"/>
                        </div>
                    }
                </div>

                @{
                    var allTags = Item.TagRelations?
                        .Where(tr => tr.Tag != null && !tr.Tag.IsSystem)
                        .OrderByDescending(tr => tr.Weight)
                        .ToList() ?? [];

                    // 削除されたタグが TimelineEvent に含まれている場合は、仮想的な TagRelation としてリストに追加して表示する
                    if (HighlightEvents != null)
                    {
                        foreach (var ev in HighlightEvents.Where(e => e.EventType == "Delete"))
                        {
                            if (ev.FollowedTag != null && allTags.All(t => t.TagId != ev.FollowedTagId))
                            {
                                allTags.Add(new TagRelation
                                {
                                    TagId = ev.FollowedTagId,
                                    Tag = ev.FollowedTag,
                                    Weight = ev.PreviousWeight ?? 0,
                                    OwnerId = ev.OwnerId, // fake owner
                                });
                            }
                        }
                    }

                    // タグが5つ以上あるか判定
                    var hasManyTags = allTags.Count >= 5;
                    // 折りたたみ時の表示数（4つ表示して、1つ以上を +X more にする）
                    const int displayLimit = 4;

                    var tagsToDisplay = _areTagsExpanded || !hasManyTags ? allTags : [.. allTags.Take(displayLimit)];
                    var hiddenCount = hasManyTags ? allTags.Count - displayLimit : 0;
                }

                <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" Class="align-items-center">
                    @for (var i = 0; i < tagsToDisplay.Count; i++)
                    {
                        var tr = tagsToDisplay[i];
                        var tagId = tr.Tag?.Id ?? -1;
                        var highlightEvent = HighlightEvents?.FirstOrDefault(e => e.FollowedTagId == tagId);

                        var isDeleted = highlightEvent?.EventType == "Delete";
                        var isInserted = highlightEvent?.EventType == "Insert";
                        var isUpdated = highlightEvent?.EventType == "Update";
                        var weightIncreased = highlightEvent != null && highlightEvent.NewWeight > (highlightEvent.PreviousWeight ?? 0);

                        var isMyTag = tr.OwnerId == CurrentUserId;
                        var bgColor = isDeleted ? "#E0E0E0" : (highlightEvent != null ? "#FFEB3B" : (isMyTag ? i < _chipBackgrounds.Length ? _chipBackgrounds[i] : _chipBackgrounds[0] : "#FFF9C4"));
                        var textColor = isDeleted ? "#9E9E9E" : (highlightEvent != null ? "#F57F17" : (isMyTag ? i < _chipTextColors.Length ? _chipTextColors[i] : _chipTextColors[0] : "#5C4B00"));

                        var chipId = $"tag-chip-{Item.Id}-{tagId}";
                        var isActive = _activePopoverTagId == tagId && _activePopoverChipKey == chipId;
                        var displayWeight = isUpdated || isInserted ? $"{highlightEvent?.PreviousWeight ?? 0} → {highlightEvent?.NewWeight}" : isDeleted ? $"{highlightEvent?.PreviousWeight}" : tr.Weight.ToString();
                        var addBtnColor = weightIncreased ? Color.Success : Color.Inherit;

                        <span id="@chipId"
                              class="position-relative d-inline-flex align-center">
                            <MudChip T="string" Size="Size.Small"
                                     Class="custom-chip"
                                     Style="@($"background: {bgColor}; color: {textColor}; font-weight: {(highlightEvent != null ? "bold" : "normal")}")"
                                     CloseIcon="@Icons.Material.Filled.RemoveCircleOutline"
                                     OnClose="@(_ => RemoveTagRelationAsync(tr))">
                                <div class="d-flex align-center">
                                    <MudIconButton Icon="@Icons.Material.Filled.LocalOffer"
                                                   Size="Size.Small" Color="Color.Inherit"
                                                   Class="chip-icon-btn mr-1"
                                                   OnClick="@(() => OnAddTagToTagClicked(tr.Tag))"/>
                                    <span class="d-flex align-center">
                                        <a class="chip-link mr-1"
                                           style="@(isDeleted ? "text-decoration: line-through;" : "")"
                                           @onclick="@(() => NavigationManager.NavigateTo($"/TagDetail/{tagId}"))"
                                           @onclick:stopPropagation="true">
                                            @(tr.Tag?.Name ?? "不明")
                                        </a>
                                        @if (!isDeleted)
                                        {
                                            <MudIconButton Icon="@Icons.Material.Filled.Remove" Size="Size.Small"
                                                           Color="Color.Inherit" Class="chip-icon-btn pa-0 mx-1"
                                                           OnClick="@(() => UpdateTagRelationWeightAsync(tr, -1))"
                                                           title="Weightを減らす"/>
                                        }
                                        <MudLink Color="Color.Inherit" Underline="Underline.Hover"
                                                 Class="mx-1 cursor-pointer font-weight-bold" OnClick="@(async () =>
                                                                                                       {
                                                                                                           if (!isDeleted) await EditTagRelationWeightAsync(tr);
                                                                                                       })">
                                            @if (isDeleted)
                                            {
                                                <MudIcon Icon="@Icons.Material.Outlined.Delete" Size="Size.Small"
                                                         Class="mr-1" Style="font-size: 1rem; vertical-align: middle;"/>
                                            }
                                            <span style="vertical-align: middle;">@displayWeight</span>
                                        </MudLink>
                                        @if (!isDeleted)
                                        {
                                            <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small"
                                                           Color="@addBtnColor" Class="chip-icon-btn pa-0 mx-1"
                                                           OnClick="@(() => UpdateTagRelationWeightAsync(tr, 1))"
                                                           title="Weightを増やす"/>
                                                           
                                            <MudIconButton Icon="@(isMyTag ? Icons.Material.Filled.Delete : Icons.Material.Outlined.Delete)" Size="Size.Small"
                                                           Color="Color.Inherit" Class="chip-icon-btn pa-0 mx-1"
                                                           OnClick="@(() => RemoveTagRelationAsync(tr))"
                                                           title="関連付けを削除"/>
                                        }
                                        <span class="ml-1">(@GetShortOwnerName(tr.Tag?.Owner?.UserName))</span>
                                    </span>
                                    <MudIconButton Icon="@Icons.Material.Filled.AccountTree"
                                                   Size="Size.Small" Color="Color.Inherit"
                                                   Class="chip-icon-btn ml-1"
                                                   OnClick="@(() => ToggleTagTreePopover(tagId, chipId))"/>
                                </div>
                            </MudChip>

                            @{
                                var addedTags = AllTagRelationsToTags
                                    .Where(ttr => ttr.TargetTagId == tagId && ttr.Tag != null && !ttr.Tag.IsSystem)
                                    .ToList();
                            }
                            @if (addedTags.Any())
                            {
                                <MudPopover Open="@isActive"
                                            AnchorOrigin="Origin.BottomCenter"
                                            TransformOrigin="Origin.TopCenter"
                                            OverflowBehavior="OverflowBehavior.FlipAlways"
                                            Paper="true"
                                            Class="added-tags-popover pa-2 mt-1 rounded-lg">
                                    <div class="d-flex flex-column gap-1">
                                        @foreach (var added in addedTags)
                                        {
                                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                                                     Color="Color.Primary"
                                                     Class="small-chip"
                                                     CloseIcon="@Icons.Material.Filled.RemoveCircleOutline"
                                                     OnClose="@(_ => RemoveTagToTagRelationAsync(added))">
                                                <div class="d-flex align-center">
                                                    <MudIcon
                                                        Icon="@Icons.Material.Filled.SubdirectoryArrowRight"
                                                        Size="Size.Small"
                                                        Class="mr-1 small-icon"/>
                                                    <a class="small-chip-link"
                                                       @onclick="@(() => NavigationManager.NavigateTo($"/TagDetail/{added.TagId}"))"
                                                       @onclick:stopPropagation="true">
                                                        @added.Tag?.Name
                                                    </a>
                                                </div>
                                            </MudChip>
                                        }
                                    </div>
                                </MudPopover>
                            }

                            @* タグツリーポップオーバー *@
                            <MudPopover Open="@(isActive && tr.Tag != null)"
                                        AnchorOrigin="Origin.TopCenter"
                                        TransformOrigin="Origin.BottomCenter"
                                        OverflowBehavior="OverflowBehavior.FlipAlways"
                                        Class="tree-popover" Paper="false">
                                <TagTreePopoverContent TargetTag="@tr.Tag"
                                                       AllTags="@AllTags"
                                                       EnableSwap="true"
                                                       EnableExpand="true"
                                                       EnableNavigation="true"
                                                       EnableAddChild="true"
                                                       OnAddChildTag="OnAddChildTagFromTree"
                                                       OnSwap="@(newTagId => ChangeItemTagAsync(tr, newTagId))"/>
                            </MudPopover>
                        </span>
                    }

                    @* 5つ以上の場合のみボタンを表示 *@
                    @if (hasManyTags)
                    {
                        if (_areTagsExpanded)
                        {
                            <MudChip T="string" Size="Size.Small"
                                     OnClick="ToggleTagExpand"
                                     Class="more-chip">
                                閉じる
                            </MudChip>
                        }
                        else
                        {
                            <MudChip T="string" Size="Size.Small"
                                     OnClick="@ToggleTagExpand"
                                     Class="more-chip">
                                +@hiddenCount more
                            </MudChip>
                        }
                    }
                    
                    <!-- リクエスト中のタグ -->
                    @foreach(var request in _taggingRequests)
                    {
                        // Executed または Canceled の場合は非表示
                        if (request.Status != TradeStatus.Proposed) continue;

                        var isAdd = request.RequestType == TaggingRequestType.Add;
                        var hasTag = Item.TagRelations?.Any(tr => tr.TagId == request.RequestedTagId) ?? false;

                        // すでに関連付けが存在する追加リクエスト、または関連付けが存在しない削除リクエストは非表示（放置されているリクエスト対策）
                        if (isAdd && hasTag) continue;
                        if (!isAdd && !hasTag) continue;

                        var replyCount = request.Replies?.Count ?? 0;
                        
                        <MudBadge Content="@replyCount" Color="Color.Primary" Overlap="true" Visible="@(replyCount > 0)">
                            <MudChip T="string" 
                                     Size="Size.Small"
                                     Color="@(isAdd ? Color.Success : Color.Error)"
                                     Variant="Variant.Outlined"
                                     Icon="@(isAdd ? Icons.Material.Filled.Add : Icons.Material.Filled.Remove)">
                                <div class="d-flex align-center">
                                    <a class="chip-link mr-1" style="color: inherit;"
                                       @onclick="@(() => NavigationManager.NavigateTo($"/TagDetail/{request.RequestedTagId}"))"
                                       @onclick:stopPropagation="true">
                                        @request.RequestedTag?.Name
                                    </a>
                                    <MudIconButton Icon="@Icons.Material.Filled.ChatBubbleOutline" 
                                                   Size="Size.Small" 
                                                   Color="Color.Inherit"
                                                   Class="pa-0" 
                                                   OnClick="@(async () => await OpenThreadDialogAsync(request))" />
                                </div>
                            </MudChip>
                        </MudBadge>
                    }

                    <MudIconButton Icon="@Icons.Material.Filled.AddCircleOutline"
                                   Size="Size.Small"
                                   Color="Color.Primary"
                                   OnClick="@(() => OnAddTagClicked())"
                                   title="タグを追加"/>
                </MudStack>
                <div class="d-flex justify-end mt-2">
                    <MudButton StartIcon="@Icons.Material.Filled.ChatBubbleOutline"
                               Size="Size.Small" Color="Color.Default" Variant="Variant.Text"
                               OnClick="ToggleRepliesAsync">
                        リプライ
                    </MudButton>
                </div>
            </div>
        </div>

        <MudCollapse Expanded="_isRepliesExpanded">
            <MudDivider Class="my-3" />
            <MudText Typo="Typo.subtitle2" Class="mb-2">リプライスレッド</MudText>
            
            @if (_replies.Any())
            {
                <div class="d-flex flex-column gap-3 mb-4 pl-4" style="border-left: 2px solid #e0e0e0;">
                    @foreach (var reply in _replies)
                    {
                        <ItemCard Item="reply" 
                                  CurrentUserId="@CurrentUserId" 
                                  CurrentUserGoodTagId="@CurrentUserGoodTagId"
                                  CurrentUserBadTagId="@CurrentUserBadTagId"
                                  OnDataChanged="LoadRepliesAsync"
                                  AllTags="AllTags"
                                  AllTagRelationsToTags="AllTagRelationsToTags" 
                                  HighlightEvents="HighlightEvents"
                                  OnEnsureSystemTags="OnEnsureSystemTags" />
                    }
                </div>
            }
            
            <div class="d-flex align-end gap-2 mt-2">
                <MudTextField @bind-Value="_newReplyContent"
                              Label="リプライを入力..."
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Lines="2"
                              Immediate="true"
                              Class="flex-grow-1" />
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           OnClick="SubmitReplyAsync"
                           Disabled="@(string.IsNullOrWhiteSpace(_newReplyContent) || _isSubmittingReply)">
                    @if (_isSubmittingReply)
                    {
                        <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                        <span class="ms-2">送信中</span>
                    }
                    else
                    {
                        <span>送信</span>
                    }
                </MudButton>
            </div>
        </MudCollapse>
    </MudCardContent>
</MudCard>

@code {
    [Parameter, EditorRequired] public Item Item { get; set; } = null!;
    [Parameter] public EventCallback OnDataChanged { get; set; }
    [Parameter] public bool IsFocused { get; set; }
    [Parameter] public EventCallback<int> OnFocus { get; set; }
    [Parameter] public List<Tag> AllTags { get; set; } = [];
    [Parameter] public List<TagRelationToTag> AllTagRelationsToTags { get; set; } = [];
    [Parameter] public string CurrentUserId { get; set; } = "";
    [Parameter] public int? CurrentUserGoodTagId { get; set; }
    [Parameter] public int? CurrentUserBadTagId { get; set; }
    [Parameter] public EventCallback OnEnsureSystemTags { get; set; }
    [Parameter] public List<TimelineEvent>? HighlightEvents { get; set; }

    private readonly string[] _chipBackgrounds = ["#EEEDFE"];
    private readonly string[] _chipTextColors = ["#26215C"];

    private bool _isExpanded;
    private bool _isOverflowing;
    private bool _areTagsExpanded;
    private bool _isTargetExpanded;

    private int _activePopoverTagId = -1;
    private string _activePopoverChipKey = "";

    private DotNetObjectReference<ItemCard>? _dotNetRef;
    private bool _needsOverflowCheck = true;
    
    private List<TaggingRequestEntity> _taggingRequests = new();

    private bool _isRepliesExpanded;
    private List<Item> _replies = new();
    private string _newReplyContent = "";
    private bool _isSubmittingReply;

    protected override async Task OnParametersSetAsync()
    {
        _taggingRequests = await ItemTagService.GetTaggingRequestsForItemAsync(Item.Id);
        if (_isRepliesExpanded)
        {
            await LoadRepliesAsync();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            try
            {
                await JS.InvokeVoidAsync("contentOverflowHelper.init", _dotNetRef);
            }
            catch (Exception)
            {
            }

            try
            {
                await JS.InvokeVoidAsync("contentOverflowHelper.initScrollObserver");
            }
            catch (Exception)
            {
            }
        }

        if (_needsOverflowCheck)
        {
            _needsOverflowCheck = false;
            await UpdateOverflowStateAsync();
            try
            {
                await JS.InvokeVoidAsync("contentOverflowHelper.observeElements", $"#item-card-{Item.Id}");
            }
            catch (Exception)
            {
            }
        }
    }

    [JSInvokable]
    public void OnWindowResized()
    {
        _needsOverflowCheck = true;
        InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public void OnElementFocusedByScroll(string elementId)
    {
        if (elementId == $"item-card-{Item.Id}")
        {
            OnFocus.InvokeAsync(Item.Id);
        }
    }

    private async Task UpdateOverflowStateAsync()
    {
        if (_isExpanded) return;

        try
        {
            var overflowIds = await JS.InvokeAsync<int[]>("contentOverflowHelper.checkOverflow", new[] { Item.Id });
            var isOverflowing = overflowIds.Contains(Item.Id);
            if (_isOverflowing != isOverflowing)
            {
                _isOverflowing = isOverflowing;
                StateHasChanged();
            }
        }
        catch (Exception)
        {
        }
    }

    private string GetItemCardStyle() => ItemCardViewModel.GetItemCardStyle(IsFocused);

    private void ToggleExpand()
    {
        _isExpanded = !_isExpanded;
        if (!_isExpanded)
        {
            _needsOverflowCheck = true; // Re-check when collapsing
        }
    }

    private void ToggleTagExpand()
    {
        _areTagsExpanded = !_areTagsExpanded;
    }

    private void ToggleTargetExpand()
    {
        _isTargetExpanded = !_isTargetExpanded;
    }

    private async Task ToggleTagTreePopover(int tagId, string chipKey)
    {
        if (_activePopoverTagId == tagId && _activePopoverChipKey == chipKey)
        {
            _activePopoverTagId = -1;
            _activePopoverChipKey = "";
        }
        else
        {
            _activePopoverTagId = tagId;
            _activePopoverChipKey = chipKey;
            StateHasChanged();
            await Task.Yield();
            try
            {
                await JS.InvokeVoidAsync("contentOverflowHelper.scrollToElement", ".tag-tree-popover-content .tag-tree-line.current");
            }
            catch (Exception)
            {
            }
        }
    }

    private async Task OpenThreadDialogAsync(TaggingRequestEntity request)
    {
        var parameters = new DialogParameters<TaggingRequestThreadDialog>
        {
            { x => x.TaggingRequest, request }
        };
        
        var options = new DialogOptions 
        { 
            CloseButton = true, 
            MaxWidth = MaxWidth.Small, 
            FullWidth = true 
        };
        
        var dialog = await DialogService.ShowAsync<TaggingRequestThreadDialog>($"Request: {request.RequestedTag?.Name}", parameters, options);
        await dialog.Result;
        StateHasChanged();
    }

    private async Task ToggleRepliesAsync()
    {
        _isRepliesExpanded = !_isRepliesExpanded;
        if (_isRepliesExpanded && !_replies.Any())
        {
            await LoadRepliesAsync();
        }
    }

    private async Task LoadRepliesAsync()
    {
