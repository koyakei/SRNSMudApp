@page "/Contract/ContractManagement"
@using System.Security.Claims
@using SRNSMudApp.Services
@using SRNSMudApp.Components.UI
@using SRNSMudApp.Models.Unions
@rendermode InteractiveServer

@attribute [Authorize]

@inject IContractDataProvider ContractData
@inject TaggingContractService ContractService
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <MudText Typo="Typo.h4" GutterBottom="true">コントラクト管理</MudText>

    @{
        var pageState = _pageState;
        switch (pageState)
        {
            case Loading:
                <MudProgressCircular Indeterminate="true"/>
                break;
            case Failed failed:
                <MudAlert Severity="Severity.Error">エラーが発生しました: @failed.Error.Message</MudAlert>
                break;
            case Loaded<ContractManagementData> loaded:
                <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" Class="mt-4">
                    <MudTabPanel Text="受信トレイ (Inbox)">
                        <div class="pa-4">
                            @switch (!loaded.Data.IncomingContracts.Any())
                            {
                                case true:
                                    <MudAlert Severity="Severity.Info">現在、受信したコントラクトの提案はありません。</MudAlert>
                                    break;
                                case false:
                                    <MudGrid>
                                        @foreach (var contract in loaded.Data.IncomingContracts)
                                        {
                                            <MudItem xs="12" sm="6" md="4">
                                                <MudCard Elevation="3">
                                                    <MudCardHeader>
                                                        <CardHeaderContent>
                                                            <MudText Typo="Typo.h6">@contract.RequestedTag.Name</MudText>
                                                            <MudText Typo="Typo.body2">対象アイテム: @contract.TargetItem.Content</MudText>
                                                        </CardHeaderContent>
                                                    </MudCardHeader>
                                                    <MudCardContent>
                                                        <MudChip T="string" Color="Color.Info" Size="Size.Small">
                                                            @(contract.Status == TradeStatus.Proposed ? "提案中" : 
                                                              contract.Status == TradeStatus.Executed ? "承認済み" : 
                                                              contract.Status == TradeStatus.Rejected ? "拒否" : 
                                                              contract.Status == TradeStatus.Canceled ? "キャンセル" : "その他")
                                                        </MudChip>
                                                        <ContractCardContent Contract="contract" />
                                                    </MudCardContent>
                                                    <MudCardActions>
                                                        <MudButton Color="Color.Success" Variant="Variant.Filled"
                                                                   OnClick="() => AcceptContract(contract)">
                                                            承認する
                                                        </MudButton>
                                                        <MudButton Color="Color.Error" Variant="Variant.Text" Class="ml-2"
                                                                   OnClick="() => RejectContract(contract)">
                                                            拒否する
                                                        </MudButton>
                                                    </MudCardActions>
                                                </MudCard>
                                            </MudItem>
                                        }
                                    </MudGrid>
                                    break;
                            }
                        </div>
                    </MudTabPanel>
                    
                    <MudTabPanel Text="送信済み (Outbox)">
                        <div class="pa-4">
                            @switch (!loaded.Data.OutgoingContracts.Any())
                            {
                                case true:
                                    <MudAlert Severity="Severity.Info">現在、送信したコントラクトの提案はありません。</MudAlert>
                                    break;
                                case false:
                                    <MudGrid>
                                        @foreach (var contract in loaded.Data.OutgoingContracts)
                                        {
                                            <MudItem xs="12" sm="6" md="4">
                                                <MudCard Elevation="3">
                                                    <MudCardHeader>
                                                        <CardHeaderContent>
                                                            <MudText Typo="Typo.h6">@contract.RequestedTag.Name</MudText>
                                                            <MudText Typo="Typo.body2">対象アイテム: @contract.TargetItem.Content</MudText>
                                                        </CardHeaderContent>
                                                    </MudCardHeader>
                                                    <MudCardContent>
                                                        <MudChip T="string" Color="Color.Info" Size="Size.Small">
                                                            @(contract.Status == TradeStatus.Proposed ? "提案中" : 
                                                              contract.Status == TradeStatus.Executed ? "承認済み" : 
                                                              contract.Status == TradeStatus.Rejected ? "拒否" : 
                                                              contract.Status == TradeStatus.Canceled ? "キャンセル" : "その他")
                                                        </MudChip>
                                                        <ContractCardContent Contract="contract" />
                                                    </MudCardContent>
                                                    <MudCardActions>
                                                        @switch (contract.Status == TradeStatus.Proposed)
                                                        {
                                                            case true:
                                                                <MudButton Color="Color.Error" Variant="Variant.Text"
                                                                           OnClick="() => CancelContract(contract)">
                                                                    取り下げる
                                                                </MudButton>
                                                                break;
                                                        }
                                                    </MudCardActions>
                                                </MudCard>
                                            </MudItem>
                                        }
                                    </MudGrid>
                                    break;
                            }
                        </div>
                    </MudTabPanel>
                </MudTabs>
                break;
        }
    }
</MudContainer>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    public record ContractManagementData(List<TaggingRequestEntity> IncomingContracts, List<TaggingRequestEntity> OutgoingContracts);

    private AsyncPageState<ContractManagementData> _pageState = new Loading();
    private string _currentUserId = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthState!;
        _currentUserId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? "";

        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        try
        {
            _pageState = new Loading();
            StateHasChanged();
            
            ContractManagementPageData page = await ContractData.GetContractsAsync(_currentUserId);

            _pageState = new Loaded<ContractManagementData>(new ContractManagementData(page.IncomingContracts, page.OutgoingContracts));
        }
        catch (Exception ex)
        {
            _pageState = new Failed(ex);
        }
    }

    private async Task AcceptContract(TaggingRequestEntity contract)
    {
        var result = await ContractService.AcceptContractAsync(contract.Id, _currentUserId);
        _ = result switch
        {
            Success<string> => HandleSuccess("コントラクトを承認しました。"),
            Failure f => HandleFailure(f.ErrorMessage)
        };
    }

    private async Task RejectContract(TaggingRequestEntity contract)
    {
        var result = await ContractService.CancelContractAsync(contract.Id, _currentUserId);
        _ = result switch
        {
            Success<string> => HandleSuccess("コントラクトを拒否しました。"),
            Failure f => HandleFailure(f.ErrorMessage)
        };
    }

    private async Task CancelContract(TaggingRequestEntity contract)
    {
        var result = await ContractService.CancelContractAsync(contract.Id, _currentUserId);
        _ = result switch
        {
            Success<string> => HandleSuccess("コントラクトを取り下げました。"),
            Failure f => HandleFailure(f.ErrorMessage)
        };
    }

    private bool HandleSuccess(string message)
    {
        Snackbar.Add(message, Severity.Success);
        _ = LoadDataAsync();
        return true;
    }

    private bool HandleFailure(string message)
    {
        Snackbar.Add($"エラーが発生しました: {message}", Severity.Error);
        return false;
    }

}