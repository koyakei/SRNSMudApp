@using SRNSMudApp.Data
@using System.Diagnostics

@RenderContent()

@code {
    [Parameter]
    [EditorRequired]
    public TaggingRequestEntity Contract { get; set; } = null!;

    private RenderFragment RenderContent() => builder =>
    {
        RenderFragment content = Contract.ContractType switch
        {
            "Mutual" => 
                (RenderFragment)(@<text>
                    <MudDivider Class="my-2"/>
                    <MudText Typo="Typo.subtitle2">提供されるアイテムとタグ</MudText>
                    <MudText Typo="Typo.body2">@Contract.OfferedTargetItem?.Content</MudText>
                    <MudText Typo="Typo.body2">@Contract.OfferedTag?.Name</MudText>
                </text>),
            "Gratis" when !string.IsNullOrEmpty(Contract.RequesterMessage) => 
                (RenderFragment)(@<text>
                    <MudDivider Class="my-2"/>
                    <MudText Typo="Typo.subtitle2">メッセージ</MudText>
                    <MudText Typo="Typo.body2">@Contract.RequesterMessage</MudText>
                </text>),
            "Gratis" => (RenderFragment)(@<text></text>),
            "Bounty" => 
                (RenderFragment)(@<text>
                    <MudDivider Class="my-2"/>
                    <MudText Typo="Typo.subtitle2">報酬</MudText>
                    <MudText Typo="Typo.body2">Bounty (AssetId: @Contract.OfferedRewardAssetId)</MudText>
                </text>),
            "Trigger" => 
                (RenderFragment)(@<text>
                    <MudDivider Class="my-2"/>
                    <MudText Typo="Typo.subtitle2">Public Offer Trigger</MudText>
                </text>),
            _ => throw new UnreachableException()
        };

        content(builder);
    };
}
