@using System.Security.Claims
@using SRNSMudApp.Services
@using SRNSMudApp.Models.Unions
@using SRNSMudApp.Services
@inject IContractDataProvider ContractData
@inject TaggingContractService ContractService
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.body1" GutterBottom="true">
            以下のアイテムにタグ付けを行って依頼を完了します。
        </MudText>
        <MudList T="string" ReadOnly="true">
            <MudListItem>
                <MudText Typo="Typo.subtitle2">対象アイテム</MudText>
                <MudText Typo="Typo.body2">@Bounty.TargetItem.Content</MudText>
            </MudListItem>
            <MudListItem>
                <MudText Typo="Typo.subtitle2">付与するタグ</MudText>
                <MudText Typo="Typo.body2">@Bounty.RequestedTag.Name</MudText>
            </MudListItem>
            @switch (_offeredRewardAsset)
            {
                case not null:
                    <MudListItem>
                        <MudText Typo="Typo.subtitle2">獲得できる報酬</MudText>
                        <MudText Typo="Typo.body2"
                                 Color="Color.Success">
                            @($"[ID: {_offeredRewardAsset.Id}] {_offeredRewardAsset.TargetTag?.Name} の権利")
                        </MudText>
                    </MudListItem>
                    break;
            }
        </MudList>

        @switch (_isLoading)
        {
            case true:
                <MudProgressCircular Indeterminate="true"/>
                break;
            case false:
                @switch (_canFulfillAsOwner)
                {
                    case true:
                        <MudAlert Severity="Severity.Info" Class="mt-4">
                            あなたはタグ「@Bounty.RequestedTag.Name」のオーナーです。アセットを消費せずに依頼を完了できます。
                        </MudAlert>
                        break;
                    case false:
                        @switch (_myValidAssets.Any())
                        {
                            case true:
                                <MudForm @ref="_form" @bind-IsValid="@_isValid">
                                    <MudSelect T="RightAsset" Label="消費するアセットを選択" @bind-Value="_selectedAsset" Required="true"
                                               RequiredError="消費するアセットを選択してください"
                                               ToStringFunc="@(a => a?.TargetTag?.Name != null ? $"[ID: {a.Id}] {a.TargetTag.Name} の権利" : "")"
                                               Class="mt-4">
                                        @foreach (var asset in _myValidAssets)
                                        {
                                            <MudSelectItem Value="@asset"/>
                                        }
                                    </MudSelect>
                                </MudForm>
                                break;
                            case false:
                                <MudAlert Severity="Severity.Error" Class="mt-4">
                                    この依頼を完了するために必要な「@Bounty.RequestedTag.Name」の権利（RightAsset）を所持していません。
                                </MudAlert>
                                break;
                        }
                        break;
                }
                break;
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">キャンセル</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit" Disabled="@(!CanSubmit())">
            承諾して完了
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    [Parameter] public TaggingRequestEntity Bounty { get; set; } = null!;

    private MudForm? _form;
    private bool _isValid = true;
    private bool _isLoading = true;

    private string _currentUserId = string.Empty;
    private bool _canFulfillAsOwner;
    private List<RightAsset> _myValidAssets = [];
    private RightAsset? _selectedAsset;
    private RightAsset? _offeredRewardAsset;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthState!;
        _currentUserId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? "";

        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _isLoading = true;
        if (Bounty.Payload is SRNSMudApp.Models.Unions.BountyPayload bp && bp.OfferedRewardAssetId != 0)
        {
            _offeredRewardAsset = await ContractData.GetRightAssetByIdAsync(bp.OfferedRewardAssetId);
        }

        _canFulfillAsOwner = Bounty.RequestedTag.OwnerId == _currentUserId;

        switch (!_canFulfillAsOwner)
        {
            case true:
                _myValidAssets = await ContractData.GetValidRightAssetsAsync(_currentUserId, Bounty.RequestedTagId);

                switch (_myValidAssets.Count == 1)
                {
                    case true:
                        _selectedAsset = _myValidAssets.First();
                        break;
                }
                break;
        }

        _isLoading = false;
    }

    private bool CanSubmit()
    {
        return _isLoading switch
        {
            true => false,
            false => _canFulfillAsOwner switch
            {
                true => true,
                false => _myValidAssets.Any() && _selectedAsset != null && _isValid
            }
        };
    }

    private async Task Submit()
    {
        switch (!CanSubmit())
        {
            case true: return;
        }

        switch (!_canFulfillAsOwner)
        {
            case true:
                await _form!.ValidateAsync();
                switch (!_isValid)
                {
                    case true: return;
                }
                break;
        }

        var result = await ContractService.AcceptContractAsync(Bounty.Id, _currentUserId, _canFulfillAsOwner ? null : _selectedAsset?.Id);

        _ = result switch
        {
            Success<string> => HandleSuccess(),
            Failure f => HandleFailure(f.ErrorMessage)
        };
    }

    private bool HandleSuccess()
    {
        Snackbar.Add("依頼を完了しました！", Severity.Success);
        MudDialog.Close(DialogResult.Ok(true));
        return true;
    }

    private bool HandleFailure(string message)
    {
        Snackbar.Add($"エラーが発生しました: {message}", Severity.Error);
        return false;
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }

}