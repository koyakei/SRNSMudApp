@page "/Bounty/BountyBoard"
@using System.Security.Claims
@rendermode InteractiveServer

@attribute [Authorize]

@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject IDialogLauncher DialogLauncher
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <MudText Typo="Typo.h4" GutterBottom="true">Bounty Board</MudText>
    <MudText Typo="Typo.body1" Class="mb-4">
        他のユーザーが「このアイテムにタグをつけてほしい！」と依頼しているリストです。条件を満たせば依頼を完了して報酬を受け取ることができます。
    </MudText>

    <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add"
               OnClick="OpenCreateDialog" Class="mb-6">
        タグ付けを依頼する
    </MudButton>

    @switch (_isLoading)
    {
        case true:
            <MudProgressCircular Indeterminate="true"/>
            break;
        case false:
            @switch (!_bounties.Any())
            {
                case true:
                    <MudAlert Severity="Severity.Info">現在、募集中のバウンティはありません。</MudAlert>
                    break;
                case false:
                    <MudGrid>
                        @foreach (var bounty in _bounties)
                        {
                            <MudItem xs="12" sm="6" md="4">
                                <MudCard Elevation="3">
                                    <MudCardHeader>
                                        <CardHeaderContent>
                                            <MudText Typo="Typo.h6">@bounty.RequestedTag.Name</MudText>
                                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                                依頼者: @bounty.RequesterUserId
                                            </MudText>
                                        </CardHeaderContent>
                                    </MudCardHeader>
                                    <MudCardContent>
                                        <MudText Typo="Typo.subtitle2">対象アイテム</MudText>
                                        <MudText Typo="Typo.body2" Class="mb-2">@bounty.TargetItem.Content</MudText>

                                        @{
                                            RightAsset? rewardAsset = (bounty.Payload is SRNSMudApp.Models.Unions.BountyPayload bp && bp.OfferedRewardAssetId != 0 && _rewardAssets.TryGetValue(bp.OfferedRewardAssetId, out var a)) ? a : null;
                                        }
                                        @switch (rewardAsset != null)
                                        {
                                            case true:
                                                <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Class="mt-2 py-1 px-2"
                                                          Style="font-size: 0.8rem;">
                                                    報酬: @rewardAsset!.TargetTag?.Name の権利
                                                </MudAlert>
                                                break;
                                            case false:
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">（無償のウィッシュリスト）</MudText>
                                                break;
                                        }
                                    </MudCardContent>
                                    <MudCardActions>
                                        @switch (bounty.RequesterUserId == _currentUserId)
                                        {
                                            case true:
                                                <MudButton Disabled="true" Variant="Variant.Text">自分の依頼</MudButton>
                                                break;
                                            case false:
                                                <MudButton Color="Color.Secondary" Variant="Variant.Filled"
                                                           OnClick="() => FulfillBounty(bounty)">
                                                    依頼を完了する
                                                </MudButton>
                                                break;
                                        }
                                    </MudCardActions>
                                </MudCard>
                            </MudItem>
                        }
                    </MudGrid>
                    break;
            }
            break;
    }
</MudContainer>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private bool _isLoading = true;
    private string _currentUserId = string.Empty;
    private List<TaggingRequestEntity> _bounties = [];
    private Dictionary<int, RightAsset> _rewardAssets = new();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthState!;
        _currentUserId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? "";

        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _isLoading = true;
        await using var dbContext = await DbFactory.CreateDbContextAsync();

        _bounties = await dbContext.TaggingRequestEntities
            .Where(b => b.ContractType == "Bounty")
            .Include(b => b.TargetItem)
            .Include(b => b.RequestedTag)
            .Where(b => b.Status == TradeStatus.Proposed)
            .OrderByDescending(b => b.CreatedDate)
            .AsNoTracking()
            .ToListAsync();

        var assetIds = _bounties
            .Select(b => b.Payload is SRNSMudApp.Models.Unions.BountyPayload bp ? bp.OfferedRewardAssetId : 0)
            .Where(id => id != 0)
            .Distinct()
            .ToList();

        var assets = await dbContext.RightAssets!
            .Include(a => a.TargetTag)
            .Where(a => assetIds.Contains(a.Id))
            .AsNoTracking()
            .ToListAsync();

        _rewardAssets = assets.ToDictionary(a => a.Id);

        _isLoading = false;
    }

    private async Task OpenCreateDialog()
    {
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogLauncher.ShowAsync<BountyCreateDialog>("タグ付けの依頼を作成", options);
        var result = await dialog.Result;

        switch (!result.Canceled)
        {
            case true:
                await LoadDataAsync();
                break;
        }
    }

    private async Task FulfillBounty(TaggingRequestEntity bounty)
    {
        var parameters = new DialogParameters<FulfillBountyDialog> { { x => x.Bounty, bounty } };
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogLauncher.ShowAsync<FulfillBountyDialog>("依頼を叶える", parameters, options);
        var result = await dialog.Result;

        switch (!result.Canceled)
        {
            case true:
                await LoadDataAsync();
                break;
        }
    }

}