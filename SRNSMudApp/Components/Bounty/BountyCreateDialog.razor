<MudDialog>
    <DialogContent>
        <MudForm @ref="_form" @bind-IsValid="@_isValid">
            @if (TargetItem is null)
            {
                <MudAutocomplete T="Item" Label="対象のアイテム" @bind-Value="ViewModel.TargetItem" SearchFunc="@SearchItems"
                                 ToStringFunc="@(i => i?.Content ?? "")" Required="true" RequiredError="アイテムを選択してください"
                                 ResetValueOnEmptyText="true" CoerceText="true" CoerceValue="true" MaxItems="10" />
            }
            else
            {
                <MudTextField T="string" Label="対象のアイテム" Value="@TargetItem.Content" ReadOnly="true" />
            }

            <MudAutocomplete T="Tag" Label="希望するタグ" @bind-Value="ViewModel.SelectedTag" SearchFunc="@SearchTags"
                             ToStringFunc="@(t => t?.Name ?? "")" Required="true" RequiredError="タグを選択してください"
                             ResetValueOnEmptyText="true" CoerceText="true" CoerceValue="true" MaxItems="10" />

            <MudSelect T="RightAsset" Label="報酬として提供するアセット（任意）" @bind-Value="ViewModel.SelectedRewardAsset" Clearable="true"
                       ToStringFunc="@(a => a?.TargetTag?.Name != null ? $"[ID: {a.Id}] {a.TargetTag.Name} の権利" : "")">
                @foreach (var asset in ViewModel.MyAssets)
                {
                    <MudSelectItem Value="@asset" />
                }
            </MudSelect>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">キャンセル</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit" Disabled="@(!_isValid || ViewModel.IsSubmitting)">
            @if (ViewModel.IsSubmitting)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" />
                <span>作成中...</span>
            }
            else
            {
                <span>依頼を作成</span>
            }
        </MudButton>
    </DialogActions>
</MudDialog>