@* リンクプレビューの表示専用子コンポーネント。
   プレビューデータの取得は LoadPreview デリゲート経由で親に委譲し、
   本コンポーネントはサービス注入なしでレンダリング可能。 *@
@using SRNSMudApp.Models
@namespace SRNSMudApp.Components.UI

@switch (_isLoading)
{
    case true:
        <MudCard Outlined="true" Class="mt-2 rounded-lg">
            <MudCardContent Class="d-flex align-center pa-2">
                <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="mr-3"/>
                <MudText Typo="Typo.body2">リンク情報を取得中...</MudText>
            </MudCardContent>
        </MudCard>
        break;
    case false when _previewData is { IsSuccess: true }:
        <MudCard Outlined="true" Class="mt-2 mb-2 rounded-lg preview-card"
                 @onclick="NavigateToUrl">
            <div class="d-flex flex-row">
                @switch (string.IsNullOrEmpty(_previewData.ImageUrl))
                {
                    case false:
                        <div class="preview-img-container">
                            <MudImage Src="@_previewData.ImageUrl" Alt="Preview Image" ObjectFit="ObjectFit.Cover" Width="120"
                                      Height="120"
                                      Class="preview-img"/>
                        </div>
                        break;
                }
                <MudCardContent Class="pa-3 d-flex flex-column justify-center preview-content">
                    <MudText Typo="Typo.subtitle2"
                             Class="preview-title">
                        @_previewData.Title
                    </MudText>
                    @switch (string.IsNullOrEmpty(_selectedText), string.IsNullOrEmpty(_previewData.Description))
                    {
                        case (false, _):
                            <div
                                class="preview-highlight">
                                <div class="d-flex align-center highlight-header">
                                    <MudIcon Icon="@Icons.Material.Filled.FormatQuote" Size="Size.Small"
                                             Class="highlight-icon"/>
                                    <MudText Typo="Typo.caption" Class="highlight-title">
                                        選択テキスト
                                    </MudText>
                                </div>
                                <MudText Typo="Typo.caption" Color="Color.Primary" Class="highlight-text">
                                    @_selectedText
                                </MudText>
                            </div>
                            break;
                        case (true, false):
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="preview-description">
                                @_previewData.Description
                            </MudText>
                            break;
                    }
                    <div class="d-flex align-center mt-2">
                        <MudIcon Icon="@Icons.Material.Filled.Language" Size="Size.Small" Color="Color.Secondary"
                                 Class="mr-1 site-icon"/>
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="site-name">
                            @(string.IsNullOrEmpty(_previewData.SiteName) switch { false => _previewData.SiteName, true => new Uri(_previewData.Url).Host })
                        </MudText>
                    </div>
                </MudCardContent>
            </div>
        </MudCard>
        break;
}

@code {
    [Parameter] [EditorRequired] public string Url { get; set; } = null!;

    /// <summary>プレビューデータ取得デリゲート（親から注入。null の場合は取得しない）。</summary>
    [Parameter] public Func<string, Task<LinkPreviewData?>>? LoadPreview { get; set; }

    [Inject] private IJSRuntime JS { get; set; } = null!;

    private LinkPreviewData? _previewData;
    private bool _isLoading = true;
    private string? _selectedText;

    protected override async Task OnParametersSetAsync()
    {
        switch (string.IsNullOrWhiteSpace(Url))
        {
            case true: return;
        }

        _selectedText = UrlPreviewCardViewModel.ExtractTextFragment(Url);

        switch (LoadPreview)
        {
            case null:
                _isLoading = false;
                return;
        }

        _isLoading = true;
        _previewData = null;

        _previewData = await LoadPreview(Url);

        _isLoading = false;
    }

    private async Task NavigateToUrl()
    {
        switch (string.IsNullOrEmpty(Url))
        {
            case false:
                try
                {
                    await JS.InvokeVoidAsync("open", Url, "_blank");
                }
                catch (Exception)
                {
                }
                break;
        }
    }

    private static string? ExtractTextFragment(string url)
    {
        const string marker = "#:~:text=";
        var markerIndex = url.IndexOf(marker, StringComparison.Ordinal);
        
        return markerIndex switch
        {
            < 0 => null,
            _ => ProcessTextFragment(url, markerIndex, marker)
        };
    }

    private static string? ProcessTextFragment(string url, int markerIndex, string marker)
    {
        var raw = url[(markerIndex + marker.Length)..];
        var parts = raw.Split(["&text="], StringSplitOptions.RemoveEmptyEntries);

        var results = new List<string>();
        foreach (var part in parts)
        {
            var text = TryDecode(part);

            var suffixSep = text.LastIndexOf(",-", StringComparison.Ordinal);
            text = suffixSep switch
            {
                >= 0 => text[..suffixSep],
                _ => text
            };

            var prefixSep = text.IndexOf("-,", StringComparison.Ordinal);
            text = prefixSep switch
            {
                >= 0 => text[(prefixSep + 2)..],
                _ => text
            };

            var segments = text.Split(',')
                .Select(s => s.Trim())
                .Where(s => !string.IsNullOrWhiteSpace(s))
                .ToArray();

            switch (segments.Length)
            {
                case > 0:
                    results.Add(string.Join("〜", segments));
                    break;
            }
        }

        return results.Count switch
        {
            > 0 => string.Join(" | ", results),
            _ => null
        };
    }

    private static string TryDecode(string part)
    {
        try
        {
            return Uri.UnescapeDataString(part);
        }
        catch
        {
            return part;
        }
    }
}