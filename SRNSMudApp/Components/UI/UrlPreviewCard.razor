@* リンクプレビューの表示専用子コンポーネント。
   プレビューデータの取得は LoadPreview デリゲート経由で親に委譲し、
   本コンポーネントはサービス注入なしでレンダリング可能。
   取得状態は AsyncPageState<LinkPreviewData> union で表現し、
   網羅的パターンマッチングにより描画を決定する (mainRules: if文撲滅)。 *@
@using SRNSMudApp.Models
@namespace SRNSMudApp.Components.UI

@switch (_state)
{
    case Loading:
        <MudCard Outlined="true" Class="mt-2 rounded-lg">
            <MudCardContent Class="d-flex align-center pa-2">
                <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="mr-3"/>
                <MudText Typo="Typo.body2">リンク情報を取得中...</MudText>
            </MudCardContent>
        </MudCard>
        break;
    case Loaded<LinkPreviewData> loaded when loaded.Data.IsSuccess:
        <MudCard Outlined="true" Class="mt-2 mb-2 rounded-lg preview-card"
                 @onclick="NavigateToUrl">
            <div class="d-flex flex-row">
                @switch (string.IsNullOrEmpty(loaded.Data.ImageUrl))
                {
                    case false:
                        <div class="preview-img-container">
                            <MudImage Src="@loaded.Data.ImageUrl" Alt="Preview Image" ObjectFit="ObjectFit.Cover" Width="120"
                                      Height="120"
                                      Class="preview-img"/>
                        </div>
                        break;
                }
                <MudCardContent Class="pa-3 d-flex flex-column justify-center preview-content">
                    <MudText Typo="Typo.subtitle2"
                             Class="preview-title">
                        @loaded.Data.Title
                    </MudText>
                    @switch (string.IsNullOrEmpty(_selectedText), string.IsNullOrEmpty(loaded.Data.Description))
                    {
                        case (false, _):
                            <div
                                class="preview-highlight">
                                <div class="d-flex align-center highlight-header">
                                    <MudIcon Icon="@Icons.Material.Filled.FormatQuote" Size="Size.Small"
                                             Class="highlight-icon"/>
                                    <MudText Typo="Typo.caption" Class="highlight-title">
                                        選択テキスト
                                    </MudText>
                                </div>
                                <MudText Typo="Typo.caption" Color="Color.Primary" Class="highlight-text">
                                    @_selectedText
                                </MudText>
                            </div>
                            break;
                        case (true, false):
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="preview-description">
                                @loaded.Data.Description
                            </MudText>
                            break;
                    }
                    <div class="d-flex align-center mt-2">
                        <MudIcon Icon="@Icons.Material.Filled.Language" Size="Size.Small" Color="Color.Secondary"
                                 Class="mr-1 site-icon"/>
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="site-name">
                            @(string.IsNullOrEmpty(loaded.Data.SiteName) switch { false => loaded.Data.SiteName, true => new Uri(loaded.Data.Url).Host })
                        </MudText>
                    </div>
                </MudCardContent>
            </div>
        </MudCard>
        break;
}

@code {
    [Parameter] [EditorRequired] public string Url { get; set; } = null!;

    /// <summary>プレビューデータ取得デリゲート（親から注入。null の場合は取得しない）。</summary>
    [Parameter] public Func<string, Task<LinkPreviewData?>>? LoadPreview { get; set; }

    [Inject] private IJSRuntime JS { get; set; } = null!;

    // 取得状態は bool フラグではなく union で表現する (mainRules: 再代入撲滅 / if文撲滅)
    private AsyncPageState<LinkPreviewData> _state = new Loading();
    private string? _selectedText;

    protected override async Task OnParametersSetAsync()
    {
        switch (string.IsNullOrWhiteSpace(Url))
        {
            case true: return;
        }

        _selectedText = UrlPreviewCardViewModel.ExtractTextFragment(Url);

        switch (LoadPreview)
        {
            case null:
                _state = new Empty("プレビュー取得デリゲート未設定");
                return;
        }

        _state = new Loading();
        LinkPreviewData? preview = await LoadPreview(Url);

        _state = preview is { IsSuccess: true }
            ? new Loaded<LinkPreviewData>(preview)
            : new Empty("プレビューを取得できませんでした");
    }

    private async Task NavigateToUrl()
    {
        switch (string.IsNullOrEmpty(Url))
        {
            case false:
                try
                {
                    await JS.InvokeVoidAsync("open", Url, "_blank");
                }
                catch (Exception)
                {
                    // ignored
                }
                break;
        }
    }
}
