@namespace SRNSMudApp.Components.UI

@* ItemCard のリプライスレッド表示を担う表示専用コンポーネント。
    サービス注入を持たず、データとコールバックのみで駆動するため
    bUnit で純粋レンダリングテストが可能。 *@
@{
    var replyCount = ItemCardViewModel.GetReplyCount(ReplyCount, Replies);
}
<div data-testid="@($"item-reply-thread-{ItemId}")">
    <div class="d-flex justify-end align-center gap-1 mt-2">
        <MudButton StartIcon="@Icons.Material.Filled.FormatQuote" Size="Size.Small" Color="Color.Default"
                   Variant="Variant.Text" OnClick="@(async () => await OnOpenQuoteDialog.InvokeAsync())"
                   data-testid="@($"quote-button-{ItemId}")">
            引用
        </MudButton>

        <MudButton StartIcon="@Icons.Material.Filled.FormatListBulleted" Size="Size.Small" Color="Color.Default"
                   Variant="Variant.Text" OnClick="@(async () => await OnShowQuotes.InvokeAsync())"
                   data-testid="@($"show-quotes-button-{ItemId}")">
            @if (QuoteCount > 0)
            {
                <span>引用の表示 (@QuoteCount)</span>
            }
            else
            {
                <span>引用の表示</span>
            }
        </MudButton>

        <MudButton StartIcon="@Icons.Material.Filled.ChatBubbleOutline" Size="Size.Small" Color="Color.Default"
                   Variant="Variant.Text" OnClick="@(async () => await OnToggleReplies.InvokeAsync())"
                   data-testid="@($"reply-toggle-button-{ItemId}")">
            <span>@ItemCardViewModel.FormatReplyButtonText(replyCount)</span>
        </MudButton>
    </div>

    <MudCollapse Expanded="IsExpanded">
        <MudDivider Class="my-3" />
        <MudText Typo="Typo.subtitle2" Class="mb-2">リプライスレッド</MudText>

        @if (Replies?.Any() == true)
        {
            <div class="d-flex flex-column gap-3 mb-4 pl-4" style="border-left: 2px solid #e0e0e0;">
                @foreach (Data.Item reply in Replies!)
                {
                    <div class="reply-thread-item" data-testid="@($"reply-thread-item-{reply.Id}")">
                        @if (reply.TagActionInfo is not null)
                        {
                            <div class="d-flex align-center flex-wrap gap-2 mb-1 tag-action-header" data-testid="@($"tag-action-header-{reply.Id}")">
                                <MudChip T="string" Color="Color.Primary" Size="Size.Small" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.LocalOffer">
                                    @reply.TagActionInfo.TagName
                                </MudChip>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    タグオーナー: @(reply.TagActionInfo.TagOwnerUserName ?? "システム")
                                </MudText>
                                <MudText Typo="Typo.caption" Color="@(reply.TagActionInfo.Weight > 0 ? Color.Success : reply.TagActionInfo.Weight < 0 ? Color.Error : Color.Default)">
                                    付与ウェイト: @(reply.TagActionInfo.Weight > 0 ? $"+{reply.TagActionInfo.Weight}" : reply.TagActionInfo.Weight.ToString())
                                </MudText>
                            </div>
                        }
                        @{
                            // リプライの描画はコンテナ (ItemCard) がテンプレートとして提供する
                            var template = ReplyTemplate;
                            if (template != null)
                            {
                                @template(reply)
                            }
                        }
                    </div>
                }
            </div>
        }

        @if (TargetCandidates?.Any() == true)
        {
            <div class="d-flex flex-wrap align-center gap-2 mt-2 px-1"
                 data-testid="@($"reply-target-candidates-container-{ItemId}")">
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mr-1">返信先:</MudText>
                @foreach (var candidate in TargetCandidates)
                {
                    var isChecked = SelectedTargetUserIds?.Contains(candidate.Id) ?? false;
                    <div data-testid="@($"reply-target-checkbox-{ItemId}-{candidate.UserName}")"
                         class="d-inline-flex align-center">
                        <MudCheckBox T="bool" Value="@isChecked"
                                     ValueChanged="@(async (bool val) => await HandleTargetToggled(candidate.Id, val))" Dense="true"
                                     Size="Size.Small" Color="Color.Primary">
                            <MudText Typo="Typo.caption">@candidate.UserName</MudText>
                        </MudCheckBox>
                    </div>
                }
            </div>
        }

        @if (ParentIsPrivate)
        {
            <div class="d-flex align-center gap-2 mt-2 px-1" data-testid="@($"reply-private-toggle-{ItemId}")">
                <MudSwitch T="bool" Value="@IsPrivateReply"
                           ValueChanged="@(async (bool val) => await HandlePrivateReplyToggled(val))"
                           Color="Color.Primary"
                           Size="Size.Small"
                           data-testid="@($"reply-private-switch-{ItemId}")">
                    <MudText Typo="Typo.caption">
                        @(IsPrivateReply
                            ? (!string.IsNullOrWhiteSpace(ParentUserGroupName)
                                ? $"プライベートモード ({ParentUserGroupName} のみ)"
                                : (ParentUserGroupId.HasValue ? "プライベートモード (グループ限定)" : "プライベートモード (フォロワー限定)"))
                            : "公開で投稿")
                    </MudText>
                </MudSwitch>
            </div>
        }

        <div class="d-flex align-end gap-2 mt-2" data-testid="@($"reply-input-form-{ItemId}")">
            <MudTextField Value="@NewReplyContent"
                          ValueChanged="@(async (string value) => await HandleNewReplyContentChanged(value))" Label="リプライを入力..."
                          Variant="Variant.Outlined" Margin="Margin.Dense" Lines="2" Immediate="true" Class="flex-grow-1"
                          data-testid="@($"reply-input-{ItemId}")" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       OnClick="@(async () => await OnSubmitReply.InvokeAsync())"
                       Disabled="@(string.IsNullOrWhiteSpace(NewReplyContent) || IsSubmittingReply)"
                       data-testid="@($"reply-submit-button-{ItemId}")">
                @if (IsSubmittingReply)
                {
                    <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                    <span class="ms-2">送信中</span>
                }
                else
                {
                    <span>送信</span>
                }
            </MudButton>
        </div>
    </MudCollapse>
</div>
