@using SRNSMudApp.Components.Tag
@using SRNSMudApp.Models

<MudCard id="@($"item-card-{Item.Id}")" @onclick="@(() => OnFocus.InvokeAsync(Item.Id))" Outlined="true"
         Class="rounded-xl scroll-observe-target" Style="@GetItemCardStyle()">
<MudCardContent Class="pa-4">
<div class="d-flex align-start">
    <VoteButtons Score="GetItemScore()"
                 IsUpvoted="IsItemUpvoted()"
                 IsDownvoted="IsItemDownvoted()"
                 OnUpvoteClicked="UpvoteItemAsync"
                 OnDownvoteClicked="DownvoteItemAsync"/>

    <div class="flex-1">
        @{
            var requestInfo = ItemCardViewModel.GetRequestInfo(Item);
        }
        @switch (requestInfo.IsTaggingRequest)
        {
            case true:
                var canCancel = !string.IsNullOrEmpty(CurrentUserId) && Item.OwnerId == CurrentUserId && requestInfo.Status == TradeStatus.Proposed;
                var canApprove = !string.IsNullOrEmpty(CurrentUserId) && Item.AsRequestOf?.TagOwnerUserId == CurrentUserId && requestInfo.Status == TradeStatus.Proposed;

                <RequestInfoAlert RequestInfo="requestInfo"
                                  CanCancel="canCancel"
                                  CanApprove="canApprove"
                                  OnCancel="CancelTaggingRequestAsync"
                                  OnApprove="ApproveTaggingRequestAsync" />
                break;
            case false:
                break;
        }

        <div class="d-flex justify-space-between align-start">
            <div>
                @* 本文・URL プレビュー・メタ情報は表示専用子コンポーネントへ委譲 *@
                <ItemCardContent ItemId="Item.Id"
                                 LoadPreview="PreviewService.GetPreviewAsync"
                                 Content="@Item.Content"
                                 OwnerId="@Item.OwnerId"
                                 OwnerUserName="@(Item.Owner?.UserName)"
                                 UpdatedDate="Item.UpdatedDate"/>
            </div>

            @switch (((IOwnable)Item).IsOwnedBy(CurrentUserId))
            {
                case true:
                    <div class="d-flex">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                       Color="Color.Primary" OnClick="EditItemAsync"
                                       title="このアイテムを編集"/>
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                       Color="Color.Error" OnClick="DeleteItemAsync"
                                       title="このアイテムを削除"/>
                    </div>
                    break;
                case false:
                    break;
            }
        </div>

        <ItemTagChipList Item="Item"
                         CurrentUserId="@CurrentUserId"
                         AllTags="AllTags"
                         AllTagRelationsToTags="AllTagRelationsToTags"
                         HighlightEvents="HighlightEvents"
                         TaggingRequests="_taggingRequests"
                         OnDataChanged="OnDataChanged"
                         OnAddTagClicked="OnAddTagClicked"/>

        <ReactionBar ItemId="@Item.Id"
                     ShinjiScore="@GetReactionScore("真実")"
                     ZenScore="@GetReactionScore("善")"
                     BiScore="@GetReactionScore("美")"
                     IsShinjiUpvoted="@IsItemReactionUpvoted("真実")"
                     IsShinjiDownvoted="@IsItemReactionDownvoted("真実")"
                     IsZenUpvoted="@IsItemReactionUpvoted("善")"
                     IsZenDownvoted="@IsItemReactionDownvoted("善")"
                     IsBiUpvoted="@IsItemReactionUpvoted("美")"
                     IsBiDownvoted="@IsItemReactionDownvoted("美")"
                     OnReactionVoteClicked="VoteReactionAsync"/>

        @* リプライスレッド (表示専用子コンポーネント。リプライの描画はテンプレートで委譲) *@
        <ItemReplyThread IsExpanded="_isRepliesExpanded"
                         Replies="_replies"
                         ReplyTemplate="ReplyTemplate"
                         NewReplyContent="@_newReplyContent"
                         NewReplyContentChanged="@(value => { _newReplyContent = value; return Task.CompletedTask; })"
                         IsSubmittingReply="_isSubmittingReply"
                         OnToggleReplies="ToggleRepliesAsync"
                         OnSubmitReply="SubmitReplyAsync"/>
    </div>
</div>
</MudCardContent>
</MudCard>
