@using SRNSMudApp.Components.Tag
@using SRNSMudApp.Models

<MudCard id="@($"item-card-{Item.Id}")" @onclick="HandleCardClickAsync" Outlined="true"
         Class="rounded-xl scroll-observe-target" Style="@GetItemCardStyle()">
    <MudCardContent Class="pa-4">
        <div class="d-flex align-start">
            <div @onclick:stopPropagation="true">
                <VoteButtons Score="GetItemScore()" IsUpvoted="IsItemUpvoted()" IsDownvoted="IsItemDownvoted()"
                             OnUpvoteClicked="UpvoteItemAsync" OnDownvoteClicked="DownvoteItemAsync" />
            </div>

            <div class="flex-1">
                @{
                    var requestInfo = ItemCardViewModel.GetRequestInfo(Item);
                }
                @if (requestInfo.IsTaggingRequest)
                {
                    var canCancel = !string.IsNullOrEmpty(CurrentUserId) && Item.OwnerId == CurrentUserId &&
                    requestInfo.Status == TradeStatus.Proposed;
                    var canApprove = !string.IsNullOrEmpty(CurrentUserId) && Item.AsRequestOf?.TagOwnerUserId ==
                    CurrentUserId && requestInfo.Status == TradeStatus.Proposed;

                    <div @onclick:stopPropagation="true">
                        <RequestInfoAlert RequestInfo="requestInfo" CanCancel="canCancel" CanApprove="canApprove"
                                          OnCancel="CancelTaggingRequestAsync" OnApprove="ApproveTaggingRequestAsync" />
                    </div>
                }

                <div class="d-flex justify-space-between align-start">
                    <div class="flex-grow-1">
                        @* 本文・URL プレビュー・メタ情報は表示専用子コンポーネントへ委譲 *@
                        <ItemCardContent ItemId="Item.Id" LoadPreview="@(url => PreviewService.GetPreviewAsync(url, CurrentUserId, IsAdmin))"
                                         Content="@Item.Content" OwnerId="@Item.OwnerId" OwnerUserName="@(Item.Owner?.UserName)"
                                         UpdatedDate="Item.UpdatedDate" IsPrivate="Item.IsPrivate" IsAdminHidden="Item.IsAdminHidden"
                                         TargetUserGroupId="Item.TargetUserGroupId"
                                         TargetUserGroupName="@(Item.TargetUserGroup?.Name)" EnableNavigation="EnableNavigation" />

                        @* 引用元アイテムプレビュー *@
                        @if (Item.QuotedItemId.HasValue)
                        {
                            <div @onclick:stopPropagation="true">
                                <QuotedItemPreview QuotedItemId="Item.QuotedItemId.Value" QuotedItem="Item.QuotedItem"
                                                   LoadPreview="@(url => PreviewService.GetPreviewAsync(url, CurrentUserId, IsAdmin))" />
                            </div>
                        }
                    </div>

                    <div class="d-flex align-center" @onclick:stopPropagation="true">
                        @if (((IOwnable)Item).IsOwnedBy(CurrentUserId))
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.VerticalSplit" Size="Size.Small"
                                           Color="Color.Secondary" OnClick="SplitSelectionAsync" title="選択テキストを別アイテムに分割"
                                           data-testid="@($"direct-split-button-{Item.Id}")" />
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary"
                                           OnClick="EditItemAsync" title="このアイテムを編集" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                           OnClick="DeleteItemAsync" title="このアイテムを削除" />
                        }
                        else
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.VerticalSplit" Size="Size.Small"
                                           Color="Color.Secondary" OnClick="RequestSplitSelectionAsync"
                                           title="選択テキストを別アイテムに分割するリクエストを送信" data-testid="@($"request-split-button-{Item.Id}")" />
                            <MudIconButton Icon="@Icons.Material.Outlined.Report" Size="Size.Small" Color="Color.Default"
                                           OnClick="ReportItemAsync" title="このアイテムを通報" />
                            @if (_isAdmin)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.DeleteForever" Size="Size.Small" Color="Color.Error"
                                               OnClick="AdminForceDeleteItemAsync" title="【管理者】強制削除"
                                               data-testid="@($"admin-delete-button-{Item.Id}")" />
                            }
                        }
                        @if (_isAdmin)
                        {
                            <MudIconButton
                            Icon="@(Item.IsAdminHidden ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff)"
                            Size="Size.Small" Color="@(Item.IsAdminHidden ? Color.Warning : Color.Default)"
                            OnClick="AdminToggleHideItemAsync"
                            title="@(Item.IsAdminHidden ? "【管理者】非公開を解除して公開" : "【管理者】強制非公開化")"
                            data-testid="@($"admin-hide-button-{Item.Id}")" />
                        }
                        @if (!string.IsNullOrEmpty(CurrentUserId))
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.VolumeOff" Size="Size.Small" Color="Color.Default"
                                           OnClick="ToggleConversationOptOutAsync" title="この会話（リプライツリー）から抜ける/戻る" />
                        }
                        <MudIconButton Icon="@Icons.Material.Filled.Hub" Size="Size.Small" Color="Color.Default"
                                       OnClick="OpenTagDiagram" title="タグダイアグラムを見る" />
                    </div>
                </div>

                @if (_pendingSplitRequests is { Count: > 0 })
                {
                    <div class="mt-2" @onclick:stopPropagation="true">
                        @foreach (var req in _pendingSplitRequests)
                        {
                            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="mb-2 py-1 px-3"
                                      NoIcon="true" data-testid="@($"pending-split-alert-{req.Id}")">
                                <div class="d-flex align-center justify-space-between flex-wrap" style="gap: 8px;">
                                    <div class="d-flex align-center">
                                        <MudIcon Icon="@Icons.Material.Filled.VerticalSplit" Size="Size.Small"
                                                 Color="Color.Info" Class="mr-2" />
                                        <MudText Typo="Typo.body2">
                                            <b>@(req.RequesterUser?.UserName ?? "ユーザー")</b> さんからの分割リクエスト:
                                            <span class="font-italic ml-1">「@(req.SelectedText.Length > 20 ?
                                                                                                                                                                                                                        $"{req.SelectedText[..20]}..." : req.SelectedText)」</span>
                                            @if (req.RequesterQuoteItemId.HasValue)
                                            {
                                                <MudLink Href="@($"/ItemDetail/{req.RequesterQuoteItemId.Value}")" Typo="Typo.caption" Color="Color.Info" Class="ml-2"
                                                         data-testid="@($"quote-item-link-{req.Id}")">
                                                    (引用投稿: #@req.RequesterQuoteItemId.Value)
                                                </MudLink>
                                            }
                                        </MudText>
                                        </div>
                                        <div class="d-flex align-center">
                                            @if (((IOwnable)Item).IsOwnedBy(CurrentUserId))
                                            {
                                                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Success"
                                                           OnClick="@(() => ApproveSplitRequestAsync(req))" Class="mr-1 py-0 px-2"
                                                           StartIcon="@Icons.Material.Filled.Check"
                                                           data-testid="@($"approve-split-request-{req.Id}")">承認</MudButton>
                                                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error"
                                                           OnClick="@(() => RejectSplitRequestAsync(req))" Class="py-0 px-2"
                                                           StartIcon="@Icons.Material.Filled.Close"
                                                           data-testid="@($"reject-split-request-{req.Id}")">却下</MudButton>
                                            }
                                            else if (req.RequesterUserId == CurrentUserId)
                                            {
                                                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error"
                                                           OnClick="@(() => CancelSplitRequestAsync(req))" Class="py-0 px-2"
                                                           StartIcon="@Icons.Material.Filled.Cancel"
                                                           data-testid="@($"cancel-split-request-{req.Id}")">取り下げ</MudButton>
                                            }
                                        </div>
                                    </div>
                                </MudAlert>
                            }
                        </div>
                    }

                    <div @onclick:stopPropagation="true">
                        <ItemTagChipList Item="Item" CurrentUserId="@CurrentUserId" AllTags="AllTags"
                                         AllTagRelationsToTags="AllTagRelationsToTags" HighlightEvents="HighlightEvents"
                                         TaggingRequests="_taggingRequests" OnDataChanged="OnDataChanged"
                                         OnAddTagClicked="OnAddTagClicked" />
                    </div>

                    <div @onclick:stopPropagation="true">
                        <ReactionBar ItemId="@Item.Id" ShinjiScore="@GetReactionScore(ReactionTagNames.Shinji)"
                                     ZenScore="@GetReactionScore(ReactionTagNames.Zen)"
                                     BiScore="@GetReactionScore(ReactionTagNames.Bi)"
                                     IsShinjiUpvoted="@IsItemReactionUpvoted(ReactionTagNames.Shinji)"
                                     IsShinjiDownvoted="@IsItemReactionDownvoted(ReactionTagNames.Shinji)"
                                     IsZenUpvoted="@IsItemReactionUpvoted(ReactionTagNames.Zen)"
                                     IsZenDownvoted="@IsItemReactionDownvoted(ReactionTagNames.Zen)"
                                     IsBiUpvoted="@IsItemReactionUpvoted(ReactionTagNames.Bi)"
                                     IsBiDownvoted="@IsItemReactionDownvoted(ReactionTagNames.Bi)"
                                     OnReactionVoteClicked="VoteReactionAsync" />
                    </div>

                    @* リプライスレッド (表示専用子コンポーネント。リプライの描画はテンプレートで委譲) *@
                    <div @onclick:stopPropagation="true">
                        <ItemReplyThread ItemId="Item.Id" IsExpanded="_isRepliesExpanded" Replies="_replies"
                                         ReplyCount="_replyCount" ReplyTemplate="ReplyTemplate" NewReplyContent="@_newReplyContent"
                                         NewReplyContentChanged="HandleNewReplyContentChanged" IsSubmittingReply="_isSubmittingReply"
                                         TargetCandidates="@GetReplyTargetCandidates()" SelectedTargetUserIds="_selectedTargetUserIds"
                                         OnTargetToggled="HandleTargetUserToggled" QuoteCount="_quoteCount"
                                         OnOpenQuoteDialog="OpenQuoteDialogAsync" OnShowQuotes="OpenShowQuotesDialogAsync"
                                         OnToggleReplies="ToggleRepliesAsync" OnSubmitReply="SubmitReplyAsync"
                                         ParentIsPrivate="@Item.IsPrivate" ParentUserGroupId="@Item.TargetUserGroupId"
                                         ParentUserGroupName="@Item.TargetUserGroup?.Name"
                                         IsPrivateReply="@_isReplyPrivate" OnPrivateReplyChanged="HandlePrivateReplyChanged" />
                    </div>
                </div>
            </div>
        </MudCardContent>
    </MudCard>
