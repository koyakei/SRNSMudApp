@* アイテム本文の表示専用子コンポーネント。
   本文の展開/折りたたみ・URL プレビュー・投稿者/最終更新メタ情報を担い、
   オーバーフロー検知の JS インターオープンをここに集約する。 *@
@using SRNSMudApp.Models
@inject IJSRuntime JS
@inject NavigationManager NavigationManager
@implements IAsyncDisposable

<div>
    <div id="@($"item-content-{ItemId}")" class="@($"resource-content {(!_isExpanded ? "line-clamp-2" : "")}")">
        @foreach (var segment in _segments)
        {
            @switch (segment.IsUrl)
            {
                case true:
                    <span @onclick:stopPropagation="true">
                        <UrlPreviewCard Url="@segment.Text" LoadPreview="@LoadPreview" />
                    </span>
                    break;
                case false:
                    <MudText Typo="Typo.subtitle1" Class="font-inherit d-inline" Style="white-space: pre-wrap;">@segment.Text
                    </MudText>
                    break;
            }
        }
    </div>

    @switch (_isOverflowing)
    {
        case true:
            <span @onclick:stopPropagation="true">
                <MudLink OnClick="ToggleExpand" Color="Color.Primary" Typo="Typo.body2" Underline="Underline.Hover"
                         Class="cursor-pointer">
                    @(_isExpanded switch { true => "閉じる", false => "もっと見る" })
                </MudLink>
            </span>
            break;
    }

    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2 mt-2 d-block">
        投稿者:
        @switch (string.IsNullOrEmpty(OwnerId))
        {
            case false:
                <span @onclick:stopPropagation="true">
                    <MudLink Href="@($"/User/UserDetail/{OwnerId}")" Color="Color.Inherit" Underline="Underline.Hover">
                        @OwnerUserName
                    </MudLink>
                </span>
                break;
            case true:
                @(OwnerUserName ?? "不明")
                break;
        }
        <span class="mx-1">|</span>
        @switch (EnableNavigation)
        {
            case true:
                <span @onclick:stopPropagation="true">
                    <MudLink Href="@($"/ItemDetail/{ItemId}")" OnClick="NavigateToDetail" Color="Color.Inherit" Underline="Underline.Hover">
                        最終更新: @UpdatedDate.ToLocalTime().ToString("g")
                    </MudLink>
                </span>
                break;
            case false:
                <span>最終更新: @UpdatedDate.ToLocalTime().ToString("g")</span>
                break;
        }
        @if (IsPrivate)
        {
            <span class="mx-1">|</span>
            @if (string.IsNullOrEmpty(TargetUserGroupName))
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Warning" Icon="@Icons.Material.Filled.Lock"
                         Variant="Variant.Outlined" Class="ml-1">フォロワー限定</MudChip>
            }
            else
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Info" Icon="@Icons.Material.Filled.Group"
                         Variant="Variant.Outlined" Class="ml-1">グループ: @TargetUserGroupName</MudChip>
            }
        }
    </MudText>
</div>

@code {
    [Parameter] public int ItemId { get; set; }
    [Parameter] public string? Content { get; set; }
    [Parameter] public string? OwnerId { get; set; }
    [Parameter] public string? OwnerUserName { get; set; }
    [Parameter] public DateTime UpdatedDate { get; set; }
    [Parameter] public bool IsPrivate { get; set; }
    [Parameter] public string? TargetUserGroupName { get; set; }
    [Parameter] public bool EnableNavigation { get; set; } = true;

    /// <summary>リンクプレビュー取得デリゲート（UrlPreviewCard へ委譲）。</summary>
    [Parameter] public Func<string, Task<LinkPreviewData?>>? LoadPreview { get; set; }

    private string DisplayContent => string.IsNullOrWhiteSpace(Content) ? "内容なし" : Content;

    private bool _isExpanded;
    private bool _isOverflowing;

    private IReadOnlyList<ContentSegment> _segments = [];

    private DotNetObjectReference<ItemCardContent>? _dotNetRef;
    private bool _needsOverflowCheck = true;

    protected override void OnParametersSet()
    {
        _segments = ItemCardViewModel.GetContentSegments(DisplayContent);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await (firstRender switch
        {
            true => InitializeOverflowHelperAsync(),
            false => Task.CompletedTask
        });

        await (_needsOverflowCheck switch
        {
            true => CheckOverflowNowAsync(),
            false => Task.CompletedTask
        });
    }

    /// <summary>オーバーフロー監視 (resize 通知) のための DotNetObjectReference を登録する。</summary>
    private async Task InitializeOverflowHelperAsync()
    {
        _dotNetRef = DotNetObjectReference.Create(this);
        try
        {
            await JS.InvokeVoidAsync("contentOverflowHelper.init", _dotNetRef);
        }
        catch (Exception)
        {
            // ignored
        }
    }

    private async Task CheckOverflowNowAsync()
    {
        _needsOverflowCheck = false;
        await UpdateOverflowStateAsync();
        try
        {
            await JS.InvokeVoidAsync("contentOverflowHelper.observeElements", $"#item-card-{ItemId}");
        }
        catch (Exception)
        {
            // ignored
        }
    }

    /// <summary>resize 時にオーバーフロー状態を再計算するためのコールバック。</summary>
    [JSInvokable]
    public void OnWindowResized()
    {
        _needsOverflowCheck = true;
        InvokeAsync(StateHasChanged);
    }

    private async Task UpdateOverflowStateAsync()
    {
        switch (_isExpanded)
        {
            case true:
                return;
        }

        try
        {
            var overflowIds = await JS.InvokeAsync<int[]>("contentOverflowHelper.checkOverflow", new[] { ItemId });
            var isOverflowing = overflowIds.Contains(ItemId);
            switch (_isOverflowing != isOverflowing)
            {
                case true:
                    _isOverflowing = isOverflowing;
                    StateHasChanged();
                    break;
            }
        }
        catch (Exception)
        {
            // ignored
        }
    }

    private void ToggleExpand()
    {
        _isExpanded = !_isExpanded;
        switch (!_isExpanded)
        {
            case true:
                _needsOverflowCheck = true; // 折りたたみ時に再チェック
                break;
        }
    }

    private void NavigateToDetail()
    {
        NavigationManager.NavigateTo($"/ItemDetail/{ItemId}");
    }

    public async ValueTask DisposeAsync()
    {
        switch (_dotNetRef)
        {
            case not null:
                try
                {
                    await JS.InvokeVoidAsync("contentOverflowHelper.removeDotNetRef", _dotNetRef);
                }
                catch (Exception)
                {
                    // ignored
                }
                _dotNetRef.Dispose();
                break;
        }
    }
}
