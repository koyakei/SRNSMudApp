@namespace SRNSMudApp.Components.UI

<MudDialog>
    <TitleContent>
        <div class="d-flex align-center">
            <MudIcon Icon="@Icons.Material.Filled.Comment" Class="mr-2" Color="Color.Primary" />
            <MudText Typo="Typo.h6">タグ履歴にコメントを追加</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="Comment"
                      Label="コメント"
                      Placeholder="タグ履歴に対するコメントを入力してください"
                      Variant="Variant.Outlined"
                      Lines="3"
                      Immediate="true"
                      Required="true"
                      data-testid="ledger-comment-input" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Text" data-testid="ledger-comment-cancel-btn">キャンセル</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit"
                   Disabled="@string.IsNullOrWhiteSpace(Comment)" data-testid="ledger-comment-submit-btn">
            送信
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public string Comment { get; set; } = "";

    private void Submit()
    {
        if (!string.IsNullOrWhiteSpace(Comment))
        {
            MudDialog.Close(DialogResult.Ok(Comment));
        }
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }
}

