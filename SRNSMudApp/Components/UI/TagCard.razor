@* タグカード。
    表示ロジックは TagCardViewModel、DB アクセスは ITagCardDataProvider に分離済み。
    チップ 1 個分 (+タグツリーポップオーバー) は表示専用子コンポーネント TagCardChip へ委譲し、
    ダイアログ起動・DB 操作はカード側に集約する。 *@
@using SRNSMudApp.Components.Tag
<MudCard id="@($"tag-card-{Tag.Id}")" @onclick="HandleCardClickAsync" Outlined="true"
         Class="rounded-xl scroll-observe-target" Style="@GetTagCardStyle()">
    <MudCardContent Class="pa-4">
        <div class="d-flex align-start">
            <VoteButtons Score="TagCardViewModel.GetTagScore(Tag)"
                         IsUpvoted="TagCardViewModel.IsTagUpvoted(Tag, CurrentUserGoodTagId, CurrentUserId)"
                         IsDownvoted="TagCardViewModel.IsTagDownvoted(Tag, CurrentUserBadTagId, CurrentUserId)"
                         OnUpvoteClicked="UpvoteTagAsync" OnDownvoteClicked="DownvoteTagAsync" />

            <div class="flex-1">
                <div class="d-flex justify-space-between align-start">
                    <div>
                        <div class="resource-name d-flex align-center gap-2">
                            <MudLink Href="@($"/TagDetail/{Tag.Id}")" Typo="Typo.subtitle1" Class="resource-link">
                                <MudIcon Icon="@Icons.Material.Filled.LocalOffer" Size="Size.Small" Class="mr-1" />
                                @Tag.Name
                            </MudLink>
                            @if (PrivacyBadgeStrategyResolver.Resolve(Tag.IsPrivate, Tag.TargetUserGroup?.Name, Tag.IsAdminHidden, Tag.TargetUserGroupId) is { } badge)
                            {
                                @if (!string.IsNullOrEmpty(badge.Href))
                                {
                                    <span @onclick:stopPropagation="true">
                                        <MudChip T="string" Color="@badge.Color" Icon="@badge.Icon" Size="Size.Small" Variant="Variant.Filled" Href="@badge.Href">
                                            @badge.Text
                                        </MudChip>
                                    </span>
                                }
                                else
                                {
                                    <MudChip T="string" Color="@badge.Color" Icon="@badge.Icon" Size="Size.Small" Variant="Variant.Filled">
                                        @badge.Text
                                    </MudChip>
                                }
                            }
                        </div>
                        @if (!string.IsNullOrEmpty(Tag.Content))
                        {
                            <MudText Typo="Typo.body2" Class="mb-2">@Tag.Content</MudText>
                        }
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2 d-block">
                            作成者:
                            @if (!string.IsNullOrEmpty(Tag.OwnerId))
                            {
                                <span @onclick:stopPropagation="true">
                                    <MudLink Href="@($"/User/UserDetail/{Tag.OwnerId}")" Color="Color.Inherit"
                                             Underline="Underline.Hover">
                                        @(Tag.Owner?.UserName)
                                    </MudLink>
                                </span>
                            }
                            else
                            {
                                @(Tag.Owner?.UserName ?? "不明")
                            }
                        </MudText>
                    </div>
                    <div @onclick:stopPropagation="true">
                        <MudIconButton Icon="@Icons.Material.Outlined.Report" Size="Size.Small" Color="Color.Default"
                                       OnClick="ReportTagAsync" title="このタグを通報" />
                    </div>
                </div>

                @{
                    TagCardDisplayList display =
                        TagCardViewModel.BuildDisplayList(Tag, HighlightEvents, _areTagsExpanded);
                    IReadOnlyList<TagRelationToTag> tagsToDisplay = display.TagsToDisplay;
                }

                <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" Class="align-items-center">
                    @for (var i = 0; i < tagsToDisplay.Count; i++)
                    {
                        var tr = tagsToDisplay[i];
                        var tagId = tr.Tag?.Id ?? -1;
                        var highlightEvent = HighlightEvents?.FirstOrDefault(e => e.FollowedTagId == tagId);
                        var isMyTag = tr.OwnerId == CurrentUserId;

                        TagCardChipDisplayInfo chip =
                            TagCardViewModel.GetChipDisplayInfo(tr, highlightEvent, isMyTag, i);
                        var chipId = $"tag-tagchip-{Tag.Id}-{tagId}";
                        var isActive = _activePopoverTagId == tagId && _activePopoverChipKey == chipId;

                        <TagCardChip Relation="tr" Display="chip" HighlightEvent="highlightEvent" ChipId="@chipId"
                                     IsActive="@isActive" AllTags="@AllTags"
                                     OnRemoveRelation="@(() => RemoveTagToTagRelationAsync(tr))"
                                     OnAddTagToTag="@(() => OnAddTagToTagClicked(tr.Tag))"
                                     OnNavigate="@(() => NavigationManager.NavigateTo($"/TagDetail/{tagId}"))"
                                     OnDecreaseWeight="@(() => UpdateTagToTagWeightAsync(tr, -1))"
                                     OnIncreaseWeight="@(() => UpdateTagToTagWeightAsync(tr, 1))"
                                     OnEditWeight="@(() => EditTagToTagWeightAsync(tr))"
                                     OnToggleTree="@(() => ToggleTagTreePopover(tagId, chipId))" OnCloseTree="ClosePopover"
                                     OnSwapTag="@(newTagId => ChangeTagTagAsync(tr, newTagId))"
                                     OnAddChildTag="OnAddChildTagFromTree" />
                    }

                    @if (display.HasManyTags)
                    {
                        @if (_areTagsExpanded)
                        {
                            <MudChip T="string" Size="Size.Small" OnClick="@ToggleTagTagExpand" Class="more-chip">
                                閉じる
                            </MudChip>
                        }
                        else
                        {
                            <MudChip T="string" Size="Size.Small" OnClick="@ToggleTagTagExpand" Class="more-chip">
                                +@display.HiddenCount more
                            </MudChip>
                        }
                    }

                    <MudIconButton Icon="@Icons.Material.Filled.AddCircleOutline" Size="Size.Small"
                                   Color="Color.Primary" OnClick="@(() => OnAddTagToTagClicked(Tag))" title="タグを追加" />
                </MudStack>
            </div>
        </div>
    </MudCardContent>
</MudCard>
