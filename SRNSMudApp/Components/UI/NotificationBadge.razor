@using System.Security.Claims
@using SRNSMudApp.Services
@implements IDisposable
@inject INotificationService NotificationService
@inject NavigationManager NavigationManager

@switch (_userId)
{
    case not null:
        <MudBadge Content="_unreadCount" Color="Color.Error" Overlap="true" Visible="@(_unreadCount > 0)"
                  data-testid="appbar-notifications-badge">
            <MudIconButton Icon="@Icons.Material.Filled.Notifications" Color="Color.Inherit" Href="notifications"
                           aria-label="notifications" />
        </MudBadge>
        break;
}

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthenticationStateTask { get; set; } = default!;

    private string? _userId;
    private int _unreadCount;
    private string? _lastBasePath;

    protected override async Task OnInitializedAsync()
    {
        var initialUri = new Uri(NavigationManager.Uri, UriKind.RelativeOrAbsolute);
        _lastBasePath = initialUri.IsAbsoluteUri ? initialUri.AbsolutePath : NavigationManager.Uri.Split('?')[0];

        NavigationManager.LocationChanged += OnLocationChanged;
        NotificationService.NotificationsChanged += OnNotificationsChanged;
        await RefreshUnreadCountAsync();
    }

    private async void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        var uri = new Uri(e.Location, UriKind.RelativeOrAbsolute);
        var absolutePath = uri.IsAbsoluteUri ? uri.AbsolutePath : e.Location.Split('?')[0];

        if (string.Equals(_lastBasePath, absolutePath, StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        _lastBasePath = absolutePath;
        await RefreshUnreadCountAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async void OnNotificationsChanged(object? sender, EventArgs e)
    {
        await RefreshUnreadCountAsync();
        await InvokeAsync(StateHasChanged);
    }

    private bool IsNotificationsPage()
    {
        var relative = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        return relative.Trim('/').Equals("notifications", StringComparison.OrdinalIgnoreCase);
    }

    private async Task RefreshUnreadCountAsync()
    {
        var authState = await AuthenticationStateTask;
        var user = authState.User;
        switch (user.Identity?.IsAuthenticated)
        {
            case true:
                _userId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;
                switch (_userId)
                {
                    case not null:
                        if (IsNotificationsPage())
                        {
                            _unreadCount = 0;
                        }
                        else
                        {
                            _unreadCount = await NotificationService.GetUnreadCountAsync(_userId);
                        }
                        break;
                }
                break;
            default:
                _userId = null;
                _unreadCount = 0;
                break;
        }
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
        NotificationService.NotificationsChanged -= OnNotificationsChanged;
    }
}
