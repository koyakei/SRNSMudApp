@using SRNSMudApp.Services
@using SRNSMudApp.Components.Item
@using System.Security.Claims
@implements IAsyncDisposable

@* ===== タグリスト ===== *@
@switch (Tags.Any())
{
    case true:
        <MudStack Spacing="3">
            @foreach (var tag in Tags)
            {
                <SRNSMudApp.Components.UI.TagCard Tag="@tag"
                                                      AllTags="@_allTags"
                                                      CurrentUserId="@_currentUserId"
                                                      CurrentUserGoodTagId="@_currentUserGoodTagId"
                                                      CurrentUserBadTagId="@_currentUserBadTagId"
                                                      OnEnsureSystemTags="EnsureSystemTagsExistAsync"
                                                      OnDataChanged="NotifyChangedAsync"
                                                      IsFocused="@(_focusTagId == tag.Id)"
                                                      OnFocus="SetFocusTag"/>
            }
        </MudStack>
        break;
}

@* ===== アイテムリスト ===== *@
@switch (Items.Any())
{
    case true:
        <MudStack Spacing="3" Class="@(Tags.Any() ? "mt-4" : "")">
            @foreach (var item in Items)
            {
                <SRNSMudApp.Components.UI.ItemCard Item="@item"
                                                       AllTags="@_allTags"
                                                       AllTagRelationsToTags="@_allTagRelationsToTags"
                                                       CurrentUserId="@_currentUserId"
                                                       CurrentUserGoodTagId="@_currentUserGoodTagId"
                                                       CurrentUserBadTagId="@_currentUserBadTagId"
                                                       CurrentUserShinjiTagId="@_currentUserShinjiTagId"
                                                       CurrentUserZenTagId="@_currentUserZenTagId"
                                                       CurrentUserBiTagId="@_currentUserBiTagId"
                                                       OnEnsureSystemTags="EnsureSystemTagsExistAsync"
                                                       OnDataChanged="NotifyChangedAsync"
                                                       IsFocused="@(_focusItemId == item.Id)"
                                                       OnFocus="SetFocusItem"/>
            }
        </MudStack>
        break;
}
