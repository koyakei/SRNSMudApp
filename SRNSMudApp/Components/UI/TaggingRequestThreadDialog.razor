@using System.Security.Claims
@using SRNSMudApp.Services
@inject IItemTagService ItemTagService
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject TaggingContractService TaggingContractService
@inject ITaggingService TaggingService
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudDialog>
    <DialogContent>
        <div class="d-flex flex-column pa-2" style="max-height: 50vh; overflow-y: auto;">

            @switch (CanApprove(TaggingRequest))
            {
                case true:
                    <div class="d-flex justify-end mb-2">
                        <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Success"
                                   OnClick="ApproveRequestAsync" Class="mr-2">
                            承認
                        </MudButton>
                        <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Error"
                                   StartIcon="@Icons.Material.Filled.ThumbDown" OnClick="RejectRequestAsync">
                            却下
                        </MudButton>
                    </div>
                    break;
            }

            <!-- 親リクエスト (スレッドの開始点) -->
            @switch (TaggingRequest.RequestItem)
            {
                case not null:
                    <div class="mb-4">
                        <ItemCard Item="TaggingRequest.RequestItem"
                                  CurrentUserId="@_currentUserId"
                                  AllTags="_allTags"
                                  AllTagRelationsToTags="_allTagRelationsToTags"/>
                    </div>
                    break;
                case null:
                    <div class="d-flex mb-1">
                        <MudAvatar Size="Size.Medium" Class="mr-3" Color="Color.Primary">
                            @(TaggingRequest.Owner?.UserName?.FirstOrDefault().ToString() ?? "?")
                        </MudAvatar>
                        <div class="flex-grow-1">
                            <div class="d-flex align-baseline">
                                <MudText Typo="Typo.subtitle2" Class="mr-2">
                                    <b>@TaggingRequest.Owner?.UserName</b>
                                </MudText>
                                <MudText Typo="Typo.caption" Style="color: var(--mud-palette-text-secondary);">
                                    @TaggingRequest.CreatedDate.ToLocalTime().ToString("g")
                                </MudText>
                            </div>
                            <MudText Typo="Typo.body1" Class="mt-1">
                                @switch (TaggingRequest.RequestType)
                                {
                                    case TaggingRequestType.Add:
                                        <span>このアイテムに <b>@TaggingRequest.RequestedTag?.Name</b> を追加するリクエストをしました。</span>
                                        break;
                                    default:
                                        <span>このアイテムから <b>@TaggingRequest.RequestedTag?.Name</b> を削除するリクエストをしました。</span>
                                        break;
                                }
                            </MudText>
                        </div>
                    </div>
                    break;
            }

            <!-- リプライツリー -->
            <div class="ml-5 pl-5" style="border-left: 2px solid var(--mud-palette-lines-default);">
                @switch (Replies)
                {
                    case { Count: > 0 }:
                        @foreach (var reply in Replies)
                        {
                            <div class="mb-4 mt-3 position-relative">
                                <div class="position-absolute" style="left: -30px; top: 10px; z-index: 1;">
                                    <MudAvatar Size="Size.Small"
                                               Style="border: 3px solid var(--mud-palette-background);"
                                               Color="Color.Secondary">
                                        @(reply.Owner?.UserName?.FirstOrDefault().ToString() ?? "?")
                                    </MudAvatar>
                                </div>
                                <div class="flex-grow-1">
                                    <ItemCard Item="reply"
                                              CurrentUserId="@_currentUserId"
                                              AllTags="_allTags"
                                              AllTagRelationsToTags="_allTagRelationsToTags"/>
                                </div>
                            </div>
                        }
                        break;
                }
            </div>

        </div>
    </DialogContent>

    <DialogActions>
        <!-- 新規リプライ投稿フィールド -->
        <div class="d-flex w-100 px-4 pb-2 align-center">
            <MudTextField @bind-Value="_newReplyMessage"
                          Placeholder="返信を投稿..."
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Class="mr-2"
                          Immediate="true"
                          Lines="1"
                          MaxLines="3"/>
            <MudIconButton Icon="@Icons.Material.Filled.Send"
                           Color="Color.Primary"
                           AriaLabel="Send"
                           OnClick="SubmitReplyAsync"
                           Disabled="@(string.IsNullOrWhiteSpace(_newReplyMessage) || _isSubmitting)"/>
        </div>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] public IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public TaggingRequestEntity TaggingRequest { get; set; } = null!;

    private List<Item> Replies { get; set; } = new();
    private string _newReplyMessage = string.Empty;
    private bool _isSubmitting;
    private string? _currentUserId;
    private List<Tag> _allTags = new();
    private List<TagRelationToTag> _allTagRelationsToTags = new();

    [CascadingParameter] private Task<AuthenticationState> AuthenticationStateTask { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        // パラメータとして渡されたリクエストの既存リプライをセット
        Replies = TaggingRequest.Replies?.OrderBy(r => r.CreatedDate).ToList() ?? new List<Item>();

        var authState = await AuthenticationStateTask;
        var user = authState.User;
        switch (user.Identity?.IsAuthenticated)
        {
            case true:
                _currentUserId = user.FindFirst(c => c.Type == ClaimTypes.NameIdentifier)?.Value;
                break;
        }

        await using var context = await DbFactory.CreateDbContextAsync();
        _allTags = await context.Tags.Include(t => t.Owner).ToListAsync();
        _allTagRelationsToTags = await context.TagRelationToTags.Include(trt => trt.Tag).ToListAsync();
    }

    private async Task SubmitReplyAsync()
    {
        switch (string.IsNullOrWhiteSpace(_newReplyMessage) || string.IsNullOrEmpty(_currentUserId))
        {
            case true: return;
        }

        _isSubmitting = true;

        try
        {
            var newReply = await ItemTagService.AddReplyToRequestAsync(TaggingRequest.Id, _currentUserId, _newReplyMessage);

            switch (newReply)
            {
                case not null:
                    Replies.Add(newReply);
                    _newReplyMessage = string.Empty;

                    switch (TaggingRequest.Replies.Contains(newReply))
                    {
                        case false:
                            TaggingRequest.Replies.Add(newReply);
                            break;
                    }
                    break;
            }
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private bool CanApprove(TaggingRequestEntity request)
    {
        return request.Status switch
        {
            TradeStatus.Proposed => request.ContractType switch
            {
                "Trigger" => request.RequesterUserId == _currentUserId,
                "Bounty" => true,
                _ => request.TagOwnerUserId == _currentUserId
            },
            _ => false
        };
    }

    private async Task ApproveRequestAsync()
    {
        switch (_currentUserId)
        {
            case null: return;
        }

        try
        {
            await TaggingContractService.AcceptContractAsync(TaggingRequest.Id, _currentUserId);
            Snackbar.Add("リクエストを承認しました。", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"承認に失敗しました: {ex.Message}", Severity.Error);
        }
    }

    private async Task RejectRequestAsync()
    {
        switch (_currentUserId)
        {
            case null: return;
        }

        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<RejectRequestDialog>("リクエストを却下", options);
        var result = await dialog.Result;

        switch (result)
        {
            case { Canceled: false }:
                try
                {
                    var comment = result.Data as string;
                    await TaggingService.RejectRequestAsync(TaggingRequest.Id, _currentUserId, comment);
                    Snackbar.Add("リクエストを却下しました。", Severity.Success);
                    MudDialog.Close(DialogResult.Ok(true));
                }
                catch (Exception ex)
                {
                    Snackbar.Add($"却下に失敗しました: {ex.Message}", Severity.Error);
                }
                break;
        }
    }

}