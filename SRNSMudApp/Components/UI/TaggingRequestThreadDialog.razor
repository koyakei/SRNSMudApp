@using System.Security.Claims
@using SRNSMudApp.Data
@using SRNSMudApp.Services

<MudDialog>
    <DialogContent>
        <div class="d-flex flex-column pa-2" style="max-height: 50vh; overflow-y: auto;">

            @if (ViewModel.CanApprove)
            {
                <div class="d-flex justify-end mb-2">
                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Success"
                               OnClick="ApproveRequestAsync" Class="mr-2" Disabled="@ViewModel.IsSubmitting">
                        承認
                    </MudButton>
                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Error"
                               StartIcon="@Icons.Material.Filled.ThumbDown" OnClick="RejectRequestAsync" Disabled="@ViewModel.IsSubmitting">
                        却下
                    </MudButton>
                </div>
            }

            <!-- 親リクエスト (スレッドの開始点) -->
            @if (TaggingRequest.RequestItem is not null)
            {
                <div class="mb-4">
                    <ItemCard Item="TaggingRequest.RequestItem" CurrentUserId="@ViewModel.CurrentUserId" AllTags="ViewModel.AllTags"
                              AllTagRelationsToTags="ViewModel.AllTagRelationsToTags" />
                </div>
            }
            else
            {
                <div class="d-flex mb-1">
                    <MudAvatar Size="Size.Medium" Class="mr-3" Color="Color.Primary">
                        @(TaggingRequest.Owner?.UserName?.FirstOrDefault().ToString() ?? "?")
                    </MudAvatar>
                    <div class="flex-grow-1">
                        <div class="d-flex align-baseline">
                            <MudText Typo="Typo.subtitle2" Class="mr-2">
                                <b>@TaggingRequest.Owner?.UserName</b>
                            </MudText>
                            <MudText Typo="Typo.caption" Style="color: var(--mud-palette-text-secondary);">
                                @TaggingRequest.CreatedDate.ToLocalTime().ToString("g")
                            </MudText>
                        </div>
                        <MudText Typo="Typo.body1" Class="mt-1">
                            @if (TaggingRequest.RequestType == TaggingRequestType.Add)
                            {
                                <span>このアイテムに <b>@TaggingRequest.RequestedTag?.Name</b> を追加するリクエストをしました。</span>
                            }
                            else
                            {
                                <span>このアイテムから <b>@TaggingRequest.RequestedTag?.Name</b> を削除するリクエストをしました。</span>
                            }
                        </MudText>
                    </div>
                </div>
            }

            <!-- リプライツリー -->
            <div class="ml-5 pl-5" style="border-left: 2px solid var(--mud-palette-lines-default);">
                @if (ViewModel.Replies.Count > 0)
                {
                    @foreach (var reply in ViewModel.Replies)
                    {
                        <div class="mb-4 mt-3 position-relative">
                            <div class="position-absolute" style="left: -30px; top: 10px; z-index: 1;">
                                <MudAvatar Size="Size.Small" Style="border: 3px solid var(--mud-palette-background);"
                                           Color="Color.Secondary">
                                    @(reply.Owner?.UserName?.FirstOrDefault().ToString() ?? "?")
                                </MudAvatar>
                            </div>
                            <div class="flex-grow-1">
                                <ItemCard Item="reply" CurrentUserId="@ViewModel.CurrentUserId" AllTags="ViewModel.AllTags"
                                          AllTagRelationsToTags="ViewModel.AllTagRelationsToTags" />
                            </div>
                        </div>
                    }
                }
            </div>

        </div>
    </DialogContent>

    <DialogActions>
        <!-- 新規リプライ投稿フィールド -->
        <div class="d-flex w-100 px-4 pb-2 align-center">
            <MudTextField @bind-Value="ViewModel.NewReplyMessage" Placeholder="返信を投稿..." Variant="Variant.Outlined"
                          Margin="Margin.Dense" Class="mr-2" Immediate="true" Lines="1" MaxLines="3" />
            <MudIconButton Icon="@Icons.Material.Filled.Send" Color="Color.Primary" AriaLabel="Send"
                           OnClick="SubmitReplyAsync" Disabled="@(!ViewModel.CanSubmitReply)" />
        </div>
    </DialogActions>
</MudDialog>
