@page "/User/MakeMeAdmin"
@attribute [Authorize]
@rendermode InteractiveServer
@inject IWebHostEnvironment Env

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-10">
    <MudText Typo="Typo.h5" GutterBottom="true">デバッグ: Admin権限の取得</MudText>

    @switch (Env.IsDevelopment())
    {
        case false:
            <MudAlert Severity="Severity.Error">このページは開発環境でのみ利用可能です。</MudAlert>
            break;
        case true:
            <MudText Class="mb-4">
                開発用機能です。現在のログインユーザーに「Admin」ロールを付与し、セッション（Cookie）を即時更新します。
            </MudText>
            <form action="Account/MakeMeAdmin" method="post">
                <AntiforgeryToken/>
                <input type="hidden" name="returnUrl" value="Tag/AddTag"/>
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">
                    自分をAdminにして AddTag を開く
                </MudButton>
            </form>
            break;
    }
</MudContainer>
