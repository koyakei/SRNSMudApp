@using System.Security.Claims
@using SRNSMudApp.Services
@inject IContractDataProvider ContractData
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form" @bind-IsValid="@_isValid">
            <MudText Typo="Typo.body1" Class="mb-4">
                以下のオファーを実行してタグを受け取ります。
            </MudText>

            <MudAlert Severity="Severity.Info" Class="mb-4">
                提供されるタグ: @Offer.OfferedTag.Name<br/>
                要求されるアセット量: @(Offer.RequiredAssetAmount > 0 ? Offer.RequiredAssetAmount.ToString() : "無償")
            </MudAlert>

            <MudAutocomplete T="Item" Label="タグを付与する対象のアイテム" @bind-Value="_selectedItem"
                             SearchFunc="@SearchItems" ToStringFunc="@(i => i?.Content ?? "")"
                             Required="true" RequiredError="アイテムを選択してください"
                             ResetValueOnEmptyText="true" CoerceText="true" CoerceValue="true"/>

            @switch (Offer.RequiredAssetAmount > 0)
            {
                case true:
                    <MudSelect T="RightAsset" Label="消費するアセット（必須）" @bind-Value="_selectedAsset" Clearable="true"
                               Required="true" RequiredError="要求量以上のアセットを選択してください"
                               ToStringFunc="@(a => a?.TargetTag?.Name != null ? $"[ID: {a.Id}] {a.TargetTag.Name} の権利 (量: {a.Amount})" : "")">
                        @foreach (var asset in _validAssets)
                        {
                            <MudSelectItem Value="@asset"/>
                        }
                    </MudSelect>
                    @switch (!_validAssets.Any())
                    {
                        case true:
                            <MudText Color="Color.Error" Typo="Typo.caption">条件を満たすアセットを所有していません。</MudText>
                            break;
                    }
                    break;
            }
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">キャンセル</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit"
                   Disabled="@(!_isValid || (Offer.RequiredAssetAmount > 0 && !_validAssets.Any()))">
            実行する
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    [Parameter] public PublicTradeOffer Offer { get; set; } = null!;

    private MudForm? _form;
    private bool _isValid;
    private string _currentUserId = string.Empty;

    private Item? _selectedItem;
    private RightAsset? _selectedAsset;
    private List<RightAsset> _validAssets = [];

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthState!;
        _currentUserId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? "";

        switch (Offer.RequiredAssetAmount > 0)
        {
            case true:
                await LoadMyAssetsAsync();
                break;
        }
    }

    private async Task LoadMyAssetsAsync()
    {
        // Asset must match the OfferedTagId
        // ("ユーザーが提供する RightAsset の TargetTagId は、OfferedTagId と一致しているか判定に使用します")
        _validAssets = await ContractData.GetValidRightAssetsAsync(
            _currentUserId, Offer.OfferedTagId, Offer.RequiredAssetAmount);
    }

    private async Task<IEnumerable<Item>> SearchItems(string? value, CancellationToken token)
    {
        return await ContractData.SearchItemsAsync(value, token);
    }

    private async Task Submit()
    {
        await _form!.ValidateAsync();
        switch (!_isValid || _selectedItem == null)
        {
            case true: return;
        }
        switch (Offer.RequiredAssetAmount > 0 && _selectedAsset == null)
        {
            case true: return;
        }

        var triggerContract = new TaggingRequestEntity
        {
            ContractType = "Trigger",
            OwnerId = _currentUserId,
            RequesterUserId = _currentUserId,
            TagOwnerUserId = Offer.OwnerId,
            TargetItemId = _selectedItem.Id,
            RequestedTagId = Offer.OfferedTagId,
            Status = TradeStatus.Proposed,
            Payload = new SRNSMudApp.Models.Unions.PublicOfferPayload(Offer.Id),
            ConsumedRightAssetId = _selectedAsset?.Id
        };

        await ContractData.CreateTriggerContractAsync(triggerContract);

        MudDialog.Close(DialogResult.Ok(triggerContract.Id));
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }

}