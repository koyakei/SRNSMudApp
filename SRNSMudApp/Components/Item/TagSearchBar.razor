@using SRNSMudApp.Models
@* タグ検索バー。選択済みフィルタチップとオートコンプリートを持つ表示専用子コンポーネント。
   状態・ロジックはすべて TagSearchViewModel に委譲し、テスト容易性を確保。 *@
<MudPaper Class="pa-3 mb-4 rounded-xl search-container" Outlined="true">
    @switch (ViewModel.SelectedFilters.Any())
    {
        case true:
            <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" Class="mb-2 align-center">
                @foreach (var filter in ViewModel.SelectedFilters)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled"
                             OnClose="@(_ => ViewModel.RemoveFilterAsync(filter))">
                        @filter.DisplayText
                    </MudChip>
                }
                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Default"
                           OnClick="@(() => ViewModel.ClearFiltersAsync())" StartIcon="@Icons.Material.Filled.Clear" Class="clear-btn">
                    すべてクリア
                </MudButton>
            </MudStack>
            break;
    }

    @* 検索テキスト入力 (TagSuggestion オブジェクトによるオートコンプリート) *@
    <MudAutocomplete @ref="_autocomplete"
                     T="TagSuggestion"
                     @bind-Text="_searchText"
                     SearchFunc="@ViewModel.SearchSuggestionsAsync"
                     ToStringFunc="@(s => s?.DisplayText)"
                     ValueChanged="OnSuggestionSelected"
                     Placeholder="タグ名で検索..."
                     Variant="Variant.Outlined"
                     Margin="Margin.Dense"
                     Adornment="Adornment.Start"
                     AdornmentIcon="@Icons.Material.Filled.Search"
                     OnAdornmentClick="OnAdornmentClick"
                     DebounceInterval="300"
                     Clearable="true"
                     ResetValueOnEmptyText="true"
                     MaxItems="10" />
</MudPaper>

@code {
    [Parameter] public TagSearchViewModel ViewModel { get; set; } = null!;

    private MudAutocomplete<TagSuggestion>? _autocomplete;
    private string _searchText = "";

    private async Task OnSuggestionSelected(TagSuggestion? suggestion)
    {
        if (suggestion == null)
        {
            return;
        }

        _ = await ViewModel.AddFilterFromSuggestionAsync(suggestion);
        _searchText = "";
        if (_autocomplete != null)
        {
            await _autocomplete.ClearAsync();
        }
    }

    private async Task OnAdornmentClick()
    {
        if (!string.IsNullOrWhiteSpace(_searchText))
        {
            _ = await ViewModel.AddFilterFromTextAsync(_searchText);
            _searchText = "";
            if (_autocomplete != null)
            {
                await _autocomplete.ClearAsync();
            }
        }
    }
}
