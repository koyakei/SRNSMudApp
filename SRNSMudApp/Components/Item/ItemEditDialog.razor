@namespace SRNSMudApp.Components.Item
@using SRNSMudApp.Components.UI
@using SRNSMudApp.Models

<MudDialog>
    <DialogContent>
        <div class="add-item-editor-container" onclick="document.getElementById('edit-item-textarea')?.focus()">
            <div id="edit-item-textarea" class="add-item-editor" contenteditable="true" role="textbox"
                 aria-multiline="true" data-placeholder="内容を編集..."></div>

            <textarea id="edit-item-textarea-hidden" name="_editContent" class="add-item-hidden-textarea"
                      value="@ViewModel.EditContent"
                      @oninput="@((ChangeEventArgs e) => { ViewModel.EditContent = e.Value?.ToString() ?? string.Empty; })"></textarea>
        </div>
        <div class="d-flex justify-space-between align-center px-1 mt-1">
            <MudText Typo="Typo.caption" Color="@(ViewModel.IsOverCharacterLimit ? Color.Error : Color.Default)">
                @($"{ViewModel.CharacterCount} / {ItemEditViewModel.MaxContentLength}")
            </MudText>
        </div>

        @* 抽出したURLのプレビューを表示 *@
        @if (ViewModel.ExternalUrls.Count > 0)
        {
            <MudStack Spacing="2" Class="mt-2">
                @foreach (var url in ViewModel.ExternalUrls.Take(3))
                {
                    <SRNSMudApp.Components.UI.UrlPreviewCard Url="@url" LoadPreview="@ViewModel.GetPreviewAsync" />
                }
            </MudStack>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@Cancel">キャンセル</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="@SaveAsync" Disabled="@ViewModel.IsSubmitting">保存</MudButton>
    </DialogActions>
</MudDialog>