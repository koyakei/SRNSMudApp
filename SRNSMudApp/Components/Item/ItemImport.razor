@using System.Security.Claims
@rendermode InteractiveServer

@using SRNSMudApp.Services
@inject IAdminDataProvider AdminData
@inject ISnackbar Snackbar

<MudPaper Outlined="true" Class="pa-4 rounded-xl mb-4">
    <MudStack>
        <MudText Typo="Typo.h6">CSVからインポート</MudText>
        <MudText Typo="Typo.body2">フォーマット: 1列目にアイテムのContent、2列目以降にタグ名を指定します。</MudText>
        <InputFile id="csv-upload" OnChange="@OnCsvUpload" hidden accept=".csv"/>
        <MudButton HtmlTag="label"
                   Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.UploadFile"
                   for="csv-upload"
                   Disabled="@_isUploading">
            @switch (_isUploading)
            {
                case true:
                    <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true"/>
                    <MudText Class="ms-2">処理中...</MudText>
                    break;
                case false:
                    <MudText>CSVファイルを選択</MudText>
                    break;
            }
        </MudButton>
    </MudStack>
</MudPaper>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    [Parameter] public EventCallback OnImportCompleted { get; set; }

    private string _currentUserId = null!;
    private bool _isUploading;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthState!;
        _currentUserId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? string.Empty;
    }

    private async Task OnCsvUpload(InputFileChangeEventArgs e)
    {
        switch (string.IsNullOrEmpty(_currentUserId))
        {
            case true:
                Snackbar.Add("ログインが必要です。", Severity.Error);
                return;
        }

        _isUploading = true;

        try
        {
            var file = e.File;
            switch (file.Size > 5 * 1024 * 1024) // 5MB limit
            {
                case true:
                    Snackbar.Add("ファイルサイズが大きすぎます。5MB以下のファイルを選択してください。", Severity.Error);
                    return;
            }

            await ProcessCsvFile(file);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"エラーが発生しました: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isUploading = false;
        }
    }

    private async Task ProcessCsvFile(IBrowserFile file)
    {
        List<string[]> linesToProcess = [];
        using (var reader = new StreamReader(file.OpenReadStream()))
        {
            while (await reader.ReadLineAsync() is { } line)
            {
                switch (string.IsNullOrWhiteSpace(line))
                {
                    case true: continue;
                }
                var values = line.Split(',').Select(v => v.Trim()).ToArray();
                switch (values.Length > 0 && !string.IsNullOrWhiteSpace(values[0]))
                {
                    case true:
                        linesToProcess.Add(values);
                        break;
                }
            }
        }

        switch (!linesToProcess.Any())
        {
            case true:
                Snackbar.Add("処理するデータがありませんでした。", Severity.Info);
                return;
        }

        try
        {
            int importedItemCount =
                await AdminData.ImportItemsWithTagsAsync(_currentUserId, linesToProcess);

            Snackbar.Add($"{importedItemCount}件のアイテムをインポートしました。", Severity.Success);
            await OnImportCompleted.InvokeAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"インポート中にエラーが発生しました: {ex.Message}", Severity.Error);
        }
    }

}