@page "/ItemDetail/{ItemId:int}"
@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
@using SRNSMudApp.Data
@using SRNSMudApp.Services
@rendermode InteractiveServer
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject TaggingContractService TaggingContractService

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-5">
    @if (_item == null)
    {
        <MudText>読み込み中...</MudText>
    }
    else
    {
        <div class="d-flex align-center mb-4">
            <MudIconButton Icon="@Icons.Material.Filled.ArrowBack"
                           OnClick="@(() => NavigationManager.NavigateTo("Item/ItemList"))" Class="mr-2"/>
            <MudText Typo="Typo.h5">アイテム詳細</MudText>
        </div>

        <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-6">
            <MudTabPanel Text="詳細 (Details)">
                <SRNSMudApp.Components.Shared.ResourceList Items="new List<Item> { _item }" OnDataChanged="LoadDataAsync"/>

                <MudText Typo="Typo.h5" Class="mt-8 mb-4">付けられたタグ</MudText>
                <SRNSMudApp.Components.Tag.TagTable Tags="@(_item.TagRelations.Select(tr => tr.Tag).Where(t => t != null))"
                                                    OnDataChanged="LoadDataAsync" ShowCreateButton="false"
                                                    OnRemoveTag="RemoveItemTagAsync"/>
            </MudTabPanel>
            
            <MudTabPanel Text="関連リクエスト (Related Requests)">
                @if (_requests == null)
                {
                    <MudText>読み込み中...</MudText>
                }
                else if (!_requests.Any())
                {
                    <MudText Typo="Typo.body1" Color="Color.Default">関連するリクエストはありません。</MudText>
                }
                else
                {
                    <SRNSMudApp.Components.Tag.TaggingRequestList Requests="@_requests" OnRequestChanged="LoadDataAsync" />
                }
            </MudTabPanel>
        </MudTabs>
    }
</MudContainer>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    [Parameter] public int ItemId { get; set; }

    private Item? _item;
    private List<TaggingRequestEntity>? _requests;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_item != null && _item.Id != ItemId)
        {
            await LoadDataAsync();
        }
    }

    private async Task LoadDataAsync()
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        _item = await context.Items
            .Include(i => i.Owner)
            .Include(i => i.TagRelations)
            .ThenInclude(tr => tr.Tag)
            .ThenInclude(t => t.Owner)
            .Include(i => i.TagRelations)
            .ThenInclude(tr => tr.Tag)
            .ThenInclude(t => t.TargetTagRelations)
            .ThenInclude(ttr => ttr.Tag)
            .ThenInclude(t => t.Owner)
            .Include(i => i.AsRequestOf)
            .ThenInclude(r => r.TargetItem)
            .Include(i => i.AsRequestOf)
            .ThenInclude(r => r.RequestedTag)
            .AsNoTracking()
            .FirstOrDefaultAsync(i => i.Id == ItemId);

        _requests = await TaggingContractService.GetRequestsByItemIdAsync(ItemId);
    }

    private async Task RemoveItemTagAsync(Tag tag)
    {
        if (_item == null) return;

        await using var context = await DbFactory.CreateDbContextAsync();
        var relation = await context.TagRelations.FirstOrDefaultAsync(tr => tr.ItemId == _item.Id && tr.TagId == tag.Id);
        if (relation != null)
        {
            var authState = await AuthState!;
            var currentUserId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;

            if (relation.OwnerId != currentUserId)
            {
                Snackbar.Add("関連付けた本人ではないため、解除する権限がありません。", Severity.Error);
                return;
            }

            context.Remove(relation);
            await context.SaveChangesAsync();
            Snackbar.Add("タグの関連付けを解除しました。", Severity.Success);

            await LoadDataAsync();
        }
    }

}