@page "/ItemDetail/{ItemId:int}"
@using System.Security.Claims
@using SRNSMudApp.Components.Shared
@using SRNSMudApp.Services
@rendermode InteractiveServer
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject TaggingContractService TaggingContractService
@inject ITaggingService TaggingService
@inject IDialogService DialogService

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-5">
    @if (_item == null)
    {
        <MudText>読み込み中...</MudText>
    }
    else
    {
        <div class="d-flex align-center mb-4">
            <MudIconButton Icon="@Icons.Material.Filled.ArrowBack"
                           OnClick="@(() => NavigationManager.NavigateTo("Item/ItemList"))" Class="mr-2"/>
            <MudText Typo="Typo.h5">アイテム詳細</MudText>
        </div>

        <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-6"
                 ActivePanelIndex="_activeTabIndex" ActivePanelIndexChanged="OnTabChanged">
            <MudTabPanel Text="詳細 (Details)">
                <SRNSMudApp.Components.Shared.ResourceList Items="new List<Item> { _item }"
                                                           OnDataChanged="LoadDataAsync"/>

                @if (_item.TagRelations != null)
                {
                    <SRNSMudApp.Components.Tag.ItemTagTable
                        TagRelations="@_item.TagRelations"
                        Item="@_item"
                        CurrentUserId="@_currentUserId"
                        AllTags="@_allTags"
                        AllTagRelationsToTags="@_allTagRelationsToTags"
                        OnDataChanged="LoadDataAsync"/>
                }
            </MudTabPanel>

            <MudTabPanel Text="関連リクエスト (Related Requests)">
                @if (_requests == null)
                {
                    <MudText>読み込み中...</MudText>
                }
                else if (!_requests.Any())
                {
                    <MudText Typo="Typo.body1" Color="Color.Default">関連するリクエストはありません。</MudText>
                }
                else
                {
                    <SRNSMudApp.Components.Tag.TaggingRequestList Requests="@_requests" OnRequestChanged="LoadDataAsync"
                                                                  SelectedRequest="_selectedRequest"
                                                                  SelectedRequestChanged="OnSelectedRequestChanged">
                        <RejectButtonTemplate Context="request">
                            <MudButton Color="Color.Error" Variant="Variant.Filled" Size="Size.Small"
                                       OnClick="@(() => OpenRejectDialogAsync(request))">
                                リジェクト
                            </MudButton>
                        </RejectButtonTemplate>
                    </SRNSMudApp.Components.Tag.TaggingRequestList>
                }
            </MudTabPanel>

            <MudTabPanel Text="タグ履歴">
                @if (_ledgers == null)
                {
                    <div class="d-flex justify-center my-4">
                        <MudProgressCircular Color="Color.Default" Indeterminate="true"/>
                    </div>
                }
                else if (!_ledgers.Any())
                {
                    <MudText Typo="Typo.body1" Color="Color.Default">履歴はありません</MudText>
                }
                else
                {
                    <MudList T="TagWeightLedger">
                        @foreach (var ledger in _ledgers)
                        {
                            <MudListItem>
                                <div class="d-flex align-center">
                                    <MudChip T="string" Color="Color.Primary" Size="Size.Small" Class="mr-2">
                                        @(ledger.TagRelation?.Tag?.Name ?? ledger.TagNameSnapshot)
                                    </MudChip>
                                    <MudText Typo="Typo.body2"
                                             Color="@(ledger.Delta > 0 ? Color.Success : ledger.Delta < 0 ? Color.Error : Color.Default)"
                                             Class="mr-2">
                                        @(ledger.Delta > 0 ? $"+{ledger.Delta}" : ledger.Delta.ToString())
                                    </MudText>
                                    <MudText Typo="Typo.body2" Class="mr-2">
                                        @ledger.Owner?.UserName
                                    </MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="ml-auto">
                                        @ledger.CreatedDate.ToLocalTime().ToString("g")
                                    </MudText>
                                </div>
                            </MudListItem>
                        }
                    </MudList>
                }
            </MudTabPanel>
        </MudTabs>
    }
</MudContainer>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    [Parameter] public int ItemId { get; set; }

    private Item? _item;
    private List<TaggingRequestEntity>? _requests;
    private List<TagWeightLedger>? _ledgers;
    private string _currentUserId = "";
    private List<Tag> _allTags = [];
    private List<TagRelationToTag> _allTagRelationsToTags = [];

    [SupplyParameterFromQuery(Name = "tab")]
    public string? ActiveTabQuery { get; set; }

    [SupplyParameterFromQuery(Name = "requestId")]
    public int? SelectedRequestIdQuery { get; set; }

    private int _activeTabIndex;
    private TaggingRequestEntity? _selectedRequest;

    protected override async Task OnInitializedAsync()
    {
        if (ActiveTabQuery == "requests")
        {
            _activeTabIndex = 1;
        }
        else if (ActiveTabQuery == "history")
        {
            _activeTabIndex = 2;
        }

        await LoadDataAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_item != null && _item.Id != ItemId)
        {
            await LoadDataAsync();
        }
    }


    private async Task LoadDataAsync()
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        _item = await context.Items
            .Include(i => i.Owner)
            .Include(i => i.TagRelations)
            .ThenInclude(tr => tr.Tag)
            .ThenInclude(t => t.Owner)
            .Include(i => i.TagRelations)
            .ThenInclude(tr => tr.Tag)
            .ThenInclude(t => t.TargetTagRelations)
            .ThenInclude(ttr => ttr.Tag)
            .ThenInclude(t => t.Owner)
            .Include(i => i.AsRequestOf)
            .ThenInclude(r => r.TargetItem)
            .Include(i => i.AsRequestOf)
            .ThenInclude(r => r.RequestedTag)
            .AsNoTracking()
            .FirstOrDefaultAsync(i => i.Id == ItemId);

        _requests = await TaggingContractService.GetRequestsByItemIdAsync(ItemId);

        _ledgers = await context.TagWeightLedgers
            .Include(l => l.Owner)
            .Include(l => l.TagRelation)
            .ThenInclude(tr => tr.Tag)
            .Where(l => l.TagRelation != null && l.TagRelation.ItemId == ItemId)
            .OrderByDescending(l => l.CreatedDate)
            .AsNoTracking()
            .ToListAsync();

        if (SelectedRequestIdQuery.HasValue && _requests != null)
        {
            _selectedRequest = _requests.FirstOrDefault(r => r.Id == SelectedRequestIdQuery.Value);
        }

        if (AuthState != null)
        {
            var authState = await AuthState;
            _currentUserId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? "";
        }

        _allTags = await context.Tags.AsNoTracking().ToListAsync();
        _allTagRelationsToTags = await context.TagRelationToTags.Include(ttr => ttr.Tag).AsNoTracking().ToListAsync();
    }

    private void OnSelectedRequestChanged(TaggingRequestEntity? request)
    {
        _selectedRequest = request;
        SelectedRequestIdQuery = request?.Id;
        UpdateUrlQuery();
    }


    // Removed RemoveItemTagAsync as it's now handled inside ItemTagChip

    private async Task OpenRejectDialogAsync(TaggingRequestEntity request)
    {
        var authState = await AuthState!;
        var currentUserId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;

        if (currentUserId == null) return;

        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<RejectRequestDialog>("リクエストを却下", options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            try
            {
                var comment = result.Data as string;
                await TaggingService.RejectRequestAsync(request.Id, currentUserId, comment);
                Snackbar.Add("リクエストを却下しました。", Severity.Success);

                if (_requests != null)
                {
                    _requests.Remove(request);
                    StateHasChanged();
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add($"却下に失敗しました: {ex.Message}", Severity.Error);
            }
        }
    }

    private void OnTabChanged(int index)
    {
        _activeTabIndex = index;
        ActiveTabQuery = index switch
        {
            1 => "requests",
            2 => "history",
            _ => "details"
        };
        UpdateUrlQuery();
    }

    private void UpdateUrlQuery()
    {
        var uri = NavigationManager.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            { "tab", ActiveTabQuery },
            { "requestId", SelectedRequestIdQuery }
        });
        NavigationManager.NavigateTo(uri, replace: false);
    }

}