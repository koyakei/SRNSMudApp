@page "/Item/ItemList"
@using System.Numerics.Tensors
@using System.Text.Encodings.Web
@using System.Text.Json
@using System.Text.RegularExpressions
@using System.Text.Unicode
@using Microsoft.AspNetCore.WebUtilities
@using SRNSMudApp.Services
@using SRNSMudApp.Models
@rendermode InteractiveServer
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject ITagEmbeddingService TagEmbeddingService
@inject IJSRuntime JS
@inject NavigationManager NavigationManager
@inject LinkPreviewService LinkPreviewService

<MudContainer MaxWidth="MaxWidth.False" Class="mt-5">
    <MudTabs Elevation="1" Rounded="true" ApplyEffectsToContainer="true" panelClass="pa-4" Class="mb-4">
        <MudTabPanel Text="アイテムの追加">
            <AddItem InitialTags="@(_selectedFilters.Select(f => f.Tag))" OnItemAdded="LoadDataAsync"/>
        </MudTabPanel>
        <AuthorizeView>
            <Authorized>
                <MudTabPanel Text="アイテムのインポート (CSV)">
                    <ItemImport OnImportCompleted="LoadDataAsync"/>
                </MudTabPanel>
            </Authorized>
        </AuthorizeView>
    </MudTabs>

    @* ===== タグ検索セクション ===== *@
    <MudPaper Class="pa-3 mb-4 rounded-xl search-container" Outlined="true">
        @* 選択済みタグチップ *@
        @switch (_selectedFilters.Any())
        {
            case true:
            <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" Class="mb-2 align-center">
                @foreach (var filter in _selectedFilters)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled"
                             OnClose="@(_ => RemoveTagFilter(filter))">
                        @filter.DisplayText
                    </MudChip>
                }
                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Default"
                           OnClick="@ClearAllTagFilters" StartIcon="@Icons.Material.Filled.Clear"
                           Class="clear-btn">
                    すべてクリア
                </MudButton>
            </MudStack>
            break;
        }

        @* 検索テキスト入力 (2段階オートコンプリート) *@
        <MudAutocomplete @ref="_autocomplete"
                         T="string"
                         Value="@_tagSearchText"
                         ValueChanged="OnAutocompleteValueChanged"
                         SearchFunc="@SearchTagsAndUsersAsync"
                         Placeholder="タグ名 または タグ名 @@ユーザー名 で検索..."
                         Variant="Variant.Outlined"
                         Margin="Margin.Dense"
                         Adornment="Adornment.Start"
                         AdornmentIcon="@Icons.Material.Filled.Search"
                         OnAdornmentClick="ExecuteSearch"
                         OnKeyDown="OnSearchKeyDown"
                         DebounceInterval="300"
                         Clearable="true"
                         ResetValueOnEmptyText="true"
                         MaxItems="10"/>
    </MudPaper>

    @* ===== フィルタ結果件数 ===== *@
    @switch (_selectedFilters.Any())
    {
        case true:
        <MudText Typo="Typo.body2" Class="mb-2" Color="Color.Secondary">
            @(_items.Count()) 件のアイテム、@(_foundTags.Count()) 件のタグが見つかりました
        </MudText>
        break;
    }

    <div class="d-flex flex-column gap-2 mb-4">
        <div class="d-flex justify-space-between align-end flex-wrap gap-2">
            <MudAutocomplete T="Tag"
                             Label="ソート対象タグを追加"
                             Value="null"
                             ValueChanged="OnSortTargetTagAdded"
                             SearchFunc="@SearchSortTagsAsync"
                             ToStringFunc="@(t => t == null ? "" : t.Name)"
                             Clearable="false"
                             ResetValueOnEmptyText="true"
                             Variant="Variant.Outlined"
                             Margin="Margin.Dense"
                             Style="min-width: 250px;"/>

            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Download"
                       OnClick="@ExportToJsonAsync">
                JSONエクスポート
            </MudButton>
        </div>

        @switch (_sortConditions.Any())
        {
            case true:
            <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="2" Class="align-center">
                <MudText Typo="Typo.body2" Color="Color.Secondary">ソート優先度 (左から):</MudText>
                @foreach (var condition in _sortConditions)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined"
                             OnClose="@(_ => RemoveSortCondition(condition))">
                        <span class="d-flex align-center">
                            @condition.Tag.Name
                            <MudIconButton
                                Icon="@(condition.Order == SortOrder.Desc ? Icons.Material.Filled.ArrowDownward : Icons.Material.Filled.ArrowUpward)"
                                Size="Size.Small" Color="Color.Inherit" Class="ml-1 pa-0"
                                OnClick="@(() => ToggleSortOrder(condition))"
                                title="@(condition.Order == SortOrder.Desc ? "降順 (クリックで昇順に変更)" : "昇順 (クリックで降順に変更)")"/>
                        </span>
                    </MudChip>
                }
            </MudStack>
            break;
        }
    </div>

    <SRNSMudApp.Components.UI.ResourceList Tags="_foundTags" Items="_items" OnDataChanged="LoadDataAsync"/>
</MudContainer>


@code {
    private IEnumerable<Item> _items = [];
    private IEnumerable<Tag> _foundTags = [];

    // ===== タグ検索フィルタ用ステート =====
    public class TagFilter
    {
        public Tag Tag { get; set; } = null!;
        public string? UserName { get; set; }
        public string DisplayText => string.IsNullOrWhiteSpace(UserName) ? Tag.Name : $"{Tag.Name} ({UserName})";
    }

    private readonly List<TagFilter> _selectedFilters = [];
    private string _tagSearchText = "";
    private MudAutocomplete<string>? _autocomplete;

    // ===== ソート用ステート =====
    public enum SortOrder
    {
        Desc,
        Asc
    }

    public class SortCondition
    {
        public Tag Tag { get; set; } = null!;
        public SortOrder Order { get; set; } = SortOrder.Desc;
    }

    private readonly List<SortCondition> _sortConditions = [];

    protected override async Task OnInitializedAsync()
    {
        var uri = new Uri(NavigationManager.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);

        await using var context = await DbFactory.CreateDbContextAsync();

        switch (query.TryGetValue("tags", out var tagsValues))
        {
            case true:
                foreach (var val in tagsValues)
                {
                    switch (string.IsNullOrWhiteSpace(val))
                    {
                        case true: continue;
                    }
                    var parts = val.Split(':');
                    int tagId;
                    switch (int.TryParse(parts[0], out tagId))
                    {
                        case true:
                            var tag = await context.Tags.FindAsync(tagId);
                            switch (tag)
                            {
                                case not null:
                                    _selectedFilters.Add(new TagFilter { Tag = tag, UserName = parts.Length > 1 ? parts[1] : null });
                                    break;
                            }
                            break;
                    }
                }
                break;
        }

        switch (query.TryGetValue("sort", out var sortStr))
        {
            case true:
                var parts = sortStr.ToString().Split(',', StringSplitOptions.RemoveEmptyEntries);
                foreach (var part in parts)
                {
                    var kvp = part.Split(':');
                    int tagId = 0;
                    switch (kvp.Length == 2 && int.TryParse(kvp[0], out tagId))
                    {
                        case true:
                            var order = kvp[1] == "asc" ? SortOrder.Asc : SortOrder.Desc;
                            var tag = await context.Tags.FindAsync(tagId);
                            switch (tag)
                            {
                                case not null:
                                    _sortConditions.Add(new SortCondition { Tag = tag, Order = order });
                                    break;
                            }
                            break;
                    }
                }
                break;
        }

        await LoadDataAsync();
    }

    // ===== タグ検索メソッド =====

    private async Task<IEnumerable<string>> SearchTagsAndUsersAsync(string? value, CancellationToken token)
    {
        switch (string.IsNullOrWhiteSpace(value))
        {
            case true: return Array.Empty<string>();
        }

        await using var context = await DbFactory.CreateDbContextAsync(token);

        switch (value.Contains(" @"))
        {
            case false:
                var searchText = value;
                try
                {
                    var queryVector = await TagEmbeddingService.GenerateEmbeddingAsync(searchText);
                    var queryArray = queryVector.ToArray();

                    var textMatches = await context.Tags
                        .Where(t => t.Name.Contains(searchText) || t.Content.Contains(searchText))
                        .AsNoTracking()
                        .ToListAsync(token);

                    var vectorTags = await context.Tags
                        .Where(t => t.Embedding != null)
                        .AsNoTracking()
                        .ToListAsync(token);

                    var vectorMatches = vectorTags
                        .Where(t => t.Embedding.Length == queryArray.Length)
                        .OrderByDescending(t => TensorPrimitives.CosineSimilarity(t.Embedding, queryArray))
                        .Take(10)
                        .ToList();

                    return textMatches.Concat(vectorMatches)
                        .Select(t => t.Name + " @") // 末尾に " @" を付与
                        .Distinct()
                        .Take(10);
                }
                catch
                {
                    var textMatches = await context.Tags
                        .Where(t => t.Name.Contains(searchText) || t.Content.Contains(searchText))
                        .AsNoTracking()
                        .Select(t => t.Name + " @")
                        .Distinct()
                        .Take(10)
                        .ToListAsync(token);
                    return textMatches;
                }
            case true:
                var parts = value.Split(" @", 2);
                var tagName = parts[0];
                var userSearch = parts[1];

                var usersQuery = context.TagRelations
                    .AsNoTracking()
                    .Where(tr => tr.Tag.Name == tagName)
                    .Select(tr => tr.Owner.UserName)
                    .Where(u => u != null);

                usersQuery = string.IsNullOrWhiteSpace(userSearch) switch
                {
                    false => usersQuery.Where(u => u!.Contains(userSearch)),
                    true => usersQuery
                };

                var users = await usersQuery.Distinct().Take(10).ToListAsync(token);

                return (!users.Any() && string.IsNullOrWhiteSpace(userSearch)) switch
                {
                    true => new[] { tagName + " @" },
                    false => users.Select(u => tagName + " @" + u)
                };
        }
    }

    private async Task OnAutocompleteValueChanged(string? value)
    {
        _tagSearchText = value ?? string.Empty;
        var query = TagSearchQuery.Parse(_tagSearchText);

        switch (query)
        {
            case EmptySearch:
                return;
            case IncompleteSearch:
                // タグ名だけ選択された状態。検索は実行せず、次の入力を待つ
                // ドロップダウンを再表示してユーザー名をサジェストさせる
                switch (_autocomplete)
                {
                    case not null:
                        _ = Task.Run(async () =>
                        {
                            await Task.Delay(100); // 選択時にメニューが閉じるのを待機
                            await InvokeAsync(async () =>
                            {
                                await _autocomplete.FocusAsync();
                                await _autocomplete.ToggleMenuAsync();
                                StateHasChanged();
                            });
                        });
                        break;
                }
                break;
            case TagWithUserSearch tagWithUserSearch:
                await ExecuteSearch(tagWithUserSearch.TagName, tagWithUserSearch.UserName);
                break;
            case TagNameSearch:
                // 文字列の変更だけでは、エンターキーなどの確定イベントがない限りタグ単体検索は自動実行しない
                break;
        }
    }

    private async Task OnSearchKeyDown(KeyboardEventArgs e)
    {
        switch (e.Key == "Enter")
        {
            case true:
                await ExecuteSearch();
                break;
        }
    }

    private async Task ExecuteSearch()
    {
        var query = TagSearchQuery.Parse(_tagSearchText);
        switch (query)
        {
            case EmptySearch:
                break;
            case IncompleteSearch incompleteSearch:
                await ExecuteSearch(incompleteSearch.TagName, null);
                break;
            case TagNameSearch tagNameSearch:
                await ExecuteSearch(tagNameSearch.TagName, null);
                break;
            case TagWithUserSearch tagWithUserSearch:
                await ExecuteSearch(tagWithUserSearch.TagName, tagWithUserSearch.UserName);
                break;
        }
    }

    private async Task ExecuteSearch(string tagName, string? userName)
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        var tag = await context.Tags.FirstOrDefaultAsync(t => t.Name == tagName);

        switch (tag)
        {
            case not null:
                switch (!_selectedFilters.Any(f => f.Tag.Id == tag.Id && f.UserName == userName))
                {
                    case true:
                        _selectedFilters.Add(new TagFilter { Tag = tag, UserName = userName });
                        break;
                }
                break;
        }

        _tagSearchText = "";
        UpdateUrlQuery();
        await LoadDataAsync();
    }

    private void UpdateUrlQuery()
    {
        var filterStrings = _selectedFilters.Select(f => string.IsNullOrWhiteSpace(f.UserName) ? f.Tag.Id.ToString() : $"{f.Tag.Id}:{f.UserName}").ToArray();
        var sortParam = string.Join(",", _sortConditions.Select(c => $"{c.Tag.Id}:{(c.Order == SortOrder.Desc ? "desc" : "asc")}"));

        var parameters = new Dictionary<string, object?>
        {
            { "tags", filterStrings.Any() ? filterStrings : null },
            { "sort", string.IsNullOrEmpty(sortParam) ? null : sortParam }
        };
        var newUri = NavigationManager.GetUriWithQueryParameters(parameters);
        NavigationManager.NavigateTo(newUri, replace: true);
    }

    private async Task RemoveTagFilter(TagFilter filter)
    {
        _selectedFilters.Remove(filter);
        _sortConditions.RemoveAll(c => c.Tag.Id == filter.Tag.Id);
        UpdateUrlQuery();
        await LoadDataAsync();
    }

    private async Task ClearAllTagFilters()
    {
        _selectedFilters.Clear();
        _sortConditions.Clear();
        UpdateUrlQuery();
        await LoadDataAsync();
    }

    // ===== 既存メソッド =====

    private async Task LoadDataAsync()
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        var query = context.Items
            .AsNoTracking()
            .Include(i => i.Owner)
            .Include(i => i.TagRelations)
            .ThenInclude(tr => tr.Tag)
            .ThenInclude(t => t.Owner)
            .Include(i => i.AsRequestOf)
            .ThenInclude(r => r.TargetItem)
            .Include(i => i.AsRequestOf)
            .ThenInclude(r => r.RequestedTag)
            .AsQueryable();

        var tagQuery = context.Tags
            .AsNoTracking()
            .Include(t => t.Owner)
            .Include(t => t.TargetTagRelations)
            .ThenInclude(tr => tr.Tag)
            .ThenInclude(t => t.Owner)
            .AsQueryable();

        // タグフィルタ適用（AND 検索: 選択した全タグ/ユーザーの条件を満たす Item/Tag のみ）
        switch (_selectedFilters.Any())
        {
            case true:
                foreach (var filter in _selectedFilters)
                {
                    switch (string.IsNullOrWhiteSpace(filter.UserName))
                    {
                        case true:
                            query = query.Where(i => i.TagRelations.Any(tr => tr.TagId == filter.Tag.Id));
                            tagQuery = tagQuery.Where(t => t.TargetTagRelations.Any(tr => tr.TagId == filter.Tag.Id));
                            break;
                        case false:
                            query = query.Where(i => i.TagRelations.Any(tr => tr.TagId == filter.Tag.Id && tr.Owner.UserName == filter.UserName));
                            tagQuery = tagQuery.Where(t => t.TargetTagRelations.Any(tr => tr.TagId == filter.Tag.Id && tr.Owner.UserName == filter.UserName));
                            break;
                    }
                }

                tagQuery = ApplySortToTagQuery(tagQuery);
                _foundTags = await tagQuery.ToListAsync();
                break;
            case false:
                _foundTags = new List<Tag>();
                break;
        }

        query = ApplySortToItemQuery(query);
        _items = await query.ToListAsync();

        StateHasChanged();
    }

    private IQueryable<Item> ApplySortToItemQuery(IQueryable<Item> query)
    {
        switch (!_sortConditions.Any())
        {
            case true:
                return query.OrderByDescending(i => i.UpdatedDate);
        }

        IOrderedQueryable<Item>? orderedQuery = null;

        foreach (var condition in _sortConditions)
        {
            var targetId = condition.Tag.Id;
            switch (orderedQuery)
            {
                case null:
                    orderedQuery = condition.Order == SortOrder.Desc
                        ? query.OrderByDescending(i => i.TagRelations.Where(tr => tr.TagId == targetId).Sum(tr => (int?)tr.Weight) ?? 0)
                        : query.OrderBy(i => i.TagRelations.Where(tr => tr.TagId == targetId).Sum(tr => (int?)tr.Weight) ?? 0);
                    break;
                case not null:
                    orderedQuery = condition.Order == SortOrder.Desc
                        ? orderedQuery.ThenByDescending(i => i.TagRelations.Where(tr => tr.TagId == targetId).Sum(tr => (int?)tr.Weight) ?? 0)
                        : orderedQuery.ThenBy(i => i.TagRelations.Where(tr => tr.TagId == targetId).Sum(tr => (int?)tr.Weight) ?? 0);
                    break;
            }
        }

        return orderedQuery ?? query.OrderByDescending(i => i.UpdatedDate);
    }

    private IQueryable<Tag> ApplySortToTagQuery(IQueryable<Tag> query)
    {
        switch (!_sortConditions.Any())
        {
            case true:
                return query.OrderByDescending(t => t.UpdatedDate);
        }

        IOrderedQueryable<Tag>? orderedQuery = null;

        foreach (var condition in _sortConditions)
        {
            var targetId = condition.Tag.Id;
            switch (orderedQuery)
            {
                case null:
                    orderedQuery = condition.Order == SortOrder.Desc
                        ? query.OrderByDescending(t => t.TargetTagRelations.Where(tr => tr.TagId == targetId).Sum(tr => (int?)tr.Weight) ?? 0)
                        : query.OrderBy(t => t.TargetTagRelations.Where(tr => tr.TagId == targetId).Sum(tr => (int?)tr.Weight) ?? 0);
                    break;
                case not null:
                    orderedQuery = condition.Order == SortOrder.Desc
                        ? orderedQuery.ThenByDescending(t => t.TargetTagRelations.Where(tr => tr.TagId == targetId).Sum(tr => (int?)tr.Weight) ?? 0)
                        : orderedQuery.ThenBy(t => t.TargetTagRelations.Where(tr => tr.TagId == targetId).Sum(tr => (int?)tr.Weight) ?? 0);
                    break;
            }
        }

        return orderedQuery ?? query.OrderByDescending(t => t.UpdatedDate);
    }

    private async Task OnSortTargetTagAdded(Tag? tag)
    {
        switch (tag != null && _sortConditions.All(c => c.Tag.Id != tag.Id))
        {
            case true:
                _sortConditions.Add(new SortCondition { Tag = tag, Order = SortOrder.Desc });
                UpdateUrlQuery();
                await LoadDataAsync();
                break;
        }
    }

    private async Task ToggleSortOrder(SortCondition condition)
    {
        condition.Order = condition.Order == SortOrder.Desc ? SortOrder.Asc : SortOrder.Desc;
        UpdateUrlQuery();
        await LoadDataAsync();
    }

    private async Task RemoveSortCondition(SortCondition condition)
    {
        _sortConditions.Remove(condition);
        UpdateUrlQuery();
        await LoadDataAsync();
    }

    private Task<IEnumerable<Tag>> SearchSortTagsAsync(string? value, CancellationToken token)
    {
        switch (string.IsNullOrWhiteSpace(value))
        {
            case true:
                return Task.FromResult<IEnumerable<Tag>>(_selectedFilters.Select(f => f.Tag));
        }

        var matches = _selectedFilters.Select(f => f.Tag).Where(t => t.Name.Contains(value, StringComparison.OrdinalIgnoreCase));
        return Task.FromResult(matches);
    }

    private async Task ExportToJsonAsync()
    {
        await using var context = await DbFactory.CreateDbContextAsync();

        var itemIds = _items.Select(i => i.Id).ToList();

        var allTags = await context.Tags.ToDictionaryAsync(t => t.Id);

        var itemTags = await context.TagRelations
            .Where(tr => itemIds.Contains(tr.ItemId))
            .ToListAsync();

        var relatedTagIds = itemTags.Select(t => t.TagId).Distinct().ToList();

        var tagToTags = await context.TagRelationToTags
            .Where(trt => relatedTagIds.Contains(trt.TargetTagId))
            .ToListAsync();

        var exportList = new List<ExportItemDto>();

        foreach (var item in _items)
        {
            var exportItem = new ExportItemDto { Content = item.Content };
            var relations = itemTags.Where(tr => tr.ItemId == item.Id).ToList();

            foreach (var rel in relations)
            {
                switch (allTags.TryGetValue(rel.TagId, out var tag))
                {
                    case false: continue;
                }

                var exportTag = new ExportTagDto
                {
                    Name = tag.Name,
                    Content = tag.Content
                };

                var currentTag = tag;
                while (currentTag.ParentTagId != null && allTags.TryGetValue(currentTag.ParentTagId.Value, out var parentTag))
                {
                    exportTag.ParentTags.Add(new ExportTagSimpleDto
                    {
                        Name = parentTag.Name,
                        Content = parentTag.Content
                    });
                    currentTag = parentTag;
                }

                var attachedRelations = tagToTags.Where(trt => trt.TargetTagId == tag.Id).ToList();
                foreach (var attachedRel in attachedRelations)
                {
                    switch (allTags.TryGetValue(attachedRel.TagId, out var attachedTag))
                    {
                        case true:
                            exportTag.RelatedTags.Add(new ExportTagSimpleDto
                            {
                                Name = attachedTag.Name,
                                Content = attachedTag.Content
                            });
                            break;
                    }
                }

                exportItem.Tags.Add(exportTag);
            }

            var urls = ExtractUrls(item.Content);
            foreach (var url in urls.Take(3))
            {
                var preview = await LinkPreviewService.GetPreviewAsync(url);
                switch (preview)
                {
                    case { IsSuccess: true }:
                        exportItem.LinkPreviews.Add(new ExportLinkPreviewDto
                        {
                            Url = preview.Url,
                            Title = preview.Title,
                            Description = preview.Description,
                            ImageUrl = preview.ImageUrl,
                            SiteName = preview.SiteName
                        });
                        break;
                }
            }

            exportList.Add(exportItem);
        }

        var json = JsonSerializer.Serialize(exportList, new JsonSerializerOptions
        {
            WriteIndented = true,
            Encoder = JavaScriptEncoder.Create(UnicodeRanges.All)
        });

        try
        {
            await JS.InvokeVoidAsync("window.downloadFileFromText", "search_results.json", json);
        }
        catch (Exception)
        {
        }
    }

    public class ExportItemDto
    {
        public string Content { get; set; } = string.Empty;
        public List<ExportTagDto> Tags { get; set; } = [];
        public List<ExportLinkPreviewDto> LinkPreviews { get; set; } = [];
    }

    public class ExportTagDto
    {
        public string Name { get; set; } = string.Empty;
        public string Content { get; set; } = string.Empty;
        public List<ExportTagSimpleDto> ParentTags { get; set; } = [];
        public List<ExportTagSimpleDto> RelatedTags { get; set; } = [];
    }

    public class ExportTagSimpleDto
    {
        public string Name { get; set; } = string.Empty;
        public string Content { get; set; } = string.Empty;
    }

    public class ExportLinkPreviewDto
    {
        public string Url { get; set; } = string.Empty;
        public string Title { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public string ImageUrl { get; set; } = string.Empty;
        public string SiteName { get; set; } = string.Empty;
    }

    private static readonly Regex UrlRegex = new(@"https?:\/\/(www\.)?[-a-zA-Z0-9@:%._\+~#=]{1,256}\.[a-zA-Z0-9()]{1,6}\b([-a-zA-Z0-9()@:%_\+.~#?&//=]*)");

    private static List<string> ExtractUrls(string? text)
    {
        switch (string.IsNullOrWhiteSpace(text))
        {
            case true: return [];
        }
        List<string> results = [];
        var matches = UrlRegex.Matches(text);
        foreach (Match match in matches)
        {
            switch (!results.Contains(match.Value))
            {
                case true:
                    results.Add(match.Value);
                    break;
            }
        }

        return results;
    }

}