@namespace SRNSMudApp.Components.Item
@rendermode InteractiveServer
@using SRNSMudApp.Components.UI
@using SRNSMudApp.Models
@using SRNSMudApp.Services

<MudStack Class="w-100 pb-2">
    @if (NewItem == null)
    {
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
        <MudText>読み込み中...</MudText>
    }
    else
    {
        <EditForm id="@FormId" Model="@NewItem" OnValidSubmit="HandleValidSubmit" OnInvalidSubmit="HandleInvalidSubmit"
                  FormName="AddItem" class="w-100">
            <DataAnnotationsValidator />

            <MudStack Row="@(!HideSubmitButton)" Wrap="Wrap.Wrap" Spacing="4" AlignItems="AlignItems.Start">
                <MudStack Class="flex-grow-1" Style="min-width: 0; max-width: 100%;">
                    @{
                        var allUrls = ItemCardViewModel.ExtractUrls(NewItem.Content);
                        var externalUrls = allUrls.Where(u => !u.StartsWith("/")).ToList();
                    }
                    <div class="add-item-editor-container" onclick="document.getElementById('@TextareaId')?.focus()">
                        @* リンクプレビュー（pill）をインライン表示可能な contenteditable エディタ *@
                        <div id="@TextareaId" class="add-item-editor" contenteditable="true" role="textbox"
                             aria-multiline="true" data-placeholder="新しいアイテムのコンテンツを入力..."></div>

                        @* bUnit テストおよびフォーム同期用の textarea（テスト・バリデーション互換性を維持） *@
                        <textarea id="@(TextareaId + "-hidden")" name="_newItem.Content" class="add-item-hidden-textarea"
                                  value="@NewItem.Content"
                                  @oninput="@(async (ChangeEventArgs e) => await HandleContentChanged(e.Value?.ToString() ?? string.Empty))"
                                  @onkeydown="@HandleKeyDown"></textarea>
                    </div>
                    <div class="d-flex justify-space-between align-center px-1 mt-1">
                        <ValidationMessage For="@(() => NewItem.Content)" />
                        <MudText Typo="Typo.caption"
                                 Color="@(NewItem.Content?.Length > 1000 ? Color.Error : Color.Default)">
                            @($"{NewItem?.Content?.Length ?? 0} / 1000")
                        </MudText>
                    </div>

                    <MudStack Row="true" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Spacing="4" Class="mt-1 flex-wrap">
                        <MudSwitch @bind-Value="IsPrivate" Color="Color.Primary" Label="プライベートモード" Size="Size.Small" />
                        <MudSwitch @bind-Value="IsLinkConversionEnabled" Color="Color.Info" Label="テキスト→内部リンク変換"
                                   Size="Size.Small" data-testid="link-conversion-toggle" />

                        @if (IsPrivate)
                        {
                            <MudSelect T="int?" @bind-Value="SelectedGroupId" Label="公開範囲" Dense="true" Margin="Margin.Dense"
                                       Variant="Variant.Outlined" Style="max-width: 100%; min-width: 200px;">
                                <MudSelectItem T="int?" Value="@((int?)null)">フォロワーのみ（デフォルト）</MudSelectItem>
                                @foreach (var group in UserGroups ?? [])
                                {
                                    <MudSelectItem T="int?" Value="@((int?)group.Id)">@group.Name</MudSelectItem>
                                }
                            </MudSelect>
                        }
                    </MudStack>

                    @if (TargetCandidates.Count > 0)
                    {
                        <MudExpansionPanels Class="mt-2" Elevation="0" Outlined="true">
                            <MudExpansionPanel Text="@($"通知先 ({SelectedTargetUserIds.Count})")" Dense="true">
                                <div class="d-flex flex-wrap align-center gap-2 px-1">
                                    @foreach (var candidate in TargetCandidates)
                                    {
                                        var isChecked = SelectedTargetUserIds.Contains(candidate.Id);
                                        <div class="d-inline-flex align-center">
                                            <MudCheckBox T="bool" Value="@isChecked"
                                                         ValueChanged="@((bool val) => HandleTargetToggled(candidate.Id, val))" Dense="true"
                                                         Size="Size.Small" Color="Color.Primary">
                                                <MudText Typo="Typo.caption">@candidate.UserName</MudText>
                                            </MudCheckBox>
                                        </div>
                                    }
                                </div>
                            </MudExpansionPanel>
                        </MudExpansionPanels>
                    }

                    @* コンテンツに基づく関連タグ提案パネル *@
                    <TagSuggestionPanel Suggestions="@SuggestedTags" IsLoading="@IsLoadingSuggestions"
                                        ExcludedTagIds="@(InitialTags?.Select(t => t.Id).ToList() ?? [])"
                                        InitialStrongThreshold="@UserStrongThreshold" InitialCandidateThreshold="@UserCandidateThreshold"
                                        OnConfirmedTagIdsChanged="HandleConfirmedSuggestedTagIdsChanged"
                                        OnThresholdsChanged="HandleThresholdsChanged" />

                    @* テキスト→内部リンク変換候補パネル *@
                    @if (IsLinkConversionEnabled)
                    {
                        <LinkConversionPanel AutoReplaceCandidates="@LinkAutoReplaceCandidates"
                                             ManualCandidates="@LinkManualCandidates" IsLoading="@IsLoadingLinkCandidates"
                                             AutoReplaceThreshold="@LinkConversionThreshold"
                                             OnThresholdChanged="HandleLinkConversionThresholdChanged" />
                    }

                    @* 外部URLのプレビューカードのみ別セクションに表示 *@
                    @if (externalUrls.Count > 0)
                    {
                        <MudStack Spacing="2" Class="mt-2 w-100" Style="max-width: 100%; min-width: 0;">
                            @foreach (var url in externalUrls.Take(3))
                            {
                                <SRNSMudApp.Components.UI.UrlPreviewCard Url="@url" LoadPreview="@ViewModel.GetPreviewAsync" />
                            }
                        </MudStack>
                    }
                </MudStack>

                @if (!HideSubmitButton)
                {
                    <MudStack AlignItems="AlignItems.Center" Class="mt-2" Style="min-width: 90px;">
                        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary"
                                   Size="Size.Large" Class="w-100" Disabled="@ViewModel.IsSubmitting">
                            保存
                        </MudButton>
                    </MudStack>
                }
            </MudStack>
        </EditForm>
    }
</MudStack>