@using System.Security.Claims
@using Microsoft.AspNetCore.Identity
@rendermode InteractiveServer

@namespace SRNSMudApp.Components.Item

@using SRNSMudApp.Components.UI
@using SRNSMudApp.Services
@inject IItemCardDataProvider ItemCardData
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject UserManager<ApplicationUser> UserManager

<MudStack Class="w-100 pb-2">
    @switch (_newItem)
    {
        case null:
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
            <MudText>読み込み中...</MudText>
            break;
        case not null:
            <EditForm Model="@_newItem" OnValidSubmit="HandleValidSubmit" OnInvalidSubmit="HandleInvalidSubmit"
                      FormName="AddItem" class="w-100">
                <DataAnnotationsValidator />

                <MudStack Row="true" Spacing="4" AlignItems="AlignItems.Start">
                    <MudStack Class="flex-grow-1" Style="min-width: 0;">
                        <MudTextField @bind-Value="_newItem.Content" For="@(() => _newItem.Content)" name="_newItem.Content"
                                      Placeholder="新しいアイテムのコンテンツを入力..." Variant="Variant.Outlined" Lines="3" MaxLength="1000"
                                      Counter="1000" Required="true" RequiredError="コンテンツは必須です。" Immediate="true" />

                        @* 抽出したURLのプレビューを表示 *@
                        @{
                            var urls = ItemCardViewModel.ExtractUrls(_newItem.Content);
                        }
                        @switch (urls.Any())
                        {
                            case true:
                                <MudStack Spacing="2" Class="mt-2">
                                    @foreach (var url in urls.Take(3)) // 最大3件程度に制限
                                    {
                                        <SRNSMudApp.Components.UI.UrlPreviewCard Url="@url" />
                                    }
                                </MudStack>
                                break;
                        }
                    </MudStack>

                    <MudStack AlignItems="AlignItems.Center" Class="mt-2" Style="min-width: 90px;">
                        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary"
                                   Size="Size.Large" Class="w-100">
                            保存
                        </MudButton>
                    </MudStack>
                </MudStack>
            </EditForm>
            break;
    }
</MudStack>

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthenticationStateTask { get; set; } = null!;

    [Parameter] public IEnumerable<Data.Tag> InitialTags { get; set; } = [];

    [Parameter] public EventCallback OnItemAdded { get; set; }

    [SupplyParameterFromForm] private Data.Item? _newItem { get; set; }

    protected override async Task OnInitializedAsync()
    {
        // 2. フォーム送信時（POST）の再読み込みで、入力済みデータを上書きしないようにガードする
        switch (_newItem)
        {
            case null:
                var authState = await AuthenticationStateTask;
                var user = authState.User;

                var userId = string.Empty;

                switch (user.Identity is not null && user.Identity.IsAuthenticated)
                {
                    case true:
                        userId = user.FindFirst(c => c.Type == ClaimTypes.NameIdentifier)?.Value ?? string.Empty;
                        break;
                }

                _newItem = new Data.Item
                {
                    Content = string.Empty,
                    OwnerId = userId
                };
                break;
        }
    }

    private async Task HandleValidSubmit()
    {
        if (string.IsNullOrWhiteSpace(_newItem!.Content))
        {
            return;
        }

        try
        {
            await ItemCardData.CreateItemAsync(
                _newItem, InitialTags?.Select(t => t.Id).ToList());

            _newItem = new Data.Item { Content = string.Empty, OwnerId = _newItem.OwnerId };

            Snackbar.Add("アイテムが正常に保存されました。", Severity.Success);

            if (OnItemAdded.HasDelegate)
            {
                await OnItemAdded.InvokeAsync();
            }
            else
            {
                NavigationManager.NavigateTo(NavigationManager.Uri, true);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"エラー: {ex.Message}", Severity.Error);
        }
    }

    private void HandleInvalidSubmit(EditContext context)
    {
        Snackbar.Add("入力内容を確認してください。", Severity.Warning);
    }
}