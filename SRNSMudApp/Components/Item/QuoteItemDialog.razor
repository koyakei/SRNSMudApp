@using SRNSMudApp.Components.UI

<MudDialog>
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.FormatQuote" Color="Color.Primary" />
            <MudText Typo="Typo.h6">引用して投稿</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3">
            @* 新規引用投稿の本文入力 *@
            <MudTextField T="string" @bind-Value="ViewModel.Content" Label="コメントを追加..." Placeholder="このアイテムについて何か書く..."
                          Variant="Variant.Outlined" Lines="4" MaxLines="8" MaxLength="1000" Counter="1000" Immediate="true"
                          AutoFocus="true" Required="true" RequiredError="本文を入力してください。" data-testid="quote-item-content-input" />

            @* 抽出したURLのプレビュー *@
            @if (ViewModel.ExtractedUrls.Count > 0)
            {
                <MudStack Spacing="2">
                    @foreach (var url in ViewModel.ExtractedUrls.Take(3))
                    {
                        <UrlPreviewCard Url="@url" LoadPreview="@ViewModel.GetPreviewAsync" />
                    }
                </MudStack>
            }

            @* 引用元のアイテムプレビュー *@
            <div class="mt-1">
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-1 d-block">引用元:</MudText>
                <QuotedItemPreview QuotedItemId="QuotedItem.Id" QuotedItem="QuotedItem"
                                   LoadPreview="@ViewModel.GetPreviewAsync" />
            </div>
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">キャンセル</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAsync" Disabled="@(!ViewModel.CanSubmit)"
                   data-testid="quote-item-submit-button">
            @if (ViewModel.IsSubmitting)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" />
                <span>投稿中...</span>
            }
            else
            {
                <span>引用して投稿</span>
            }
        </MudButton>
    </DialogActions>
</MudDialog>