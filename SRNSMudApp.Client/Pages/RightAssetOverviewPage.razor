@page "/RightAsset/WasmOverview"
@page "/RightAsset/WasmOverview/{TagId:int}"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@using SRNSMudApp.Client.Models
@using SRNSMudApp.Client.Models.Api
@using SRNSMudApp.Client.Services
@inject IItemListApiClient ApiClient
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar

<PageTitle>RightAsset 状況一覧 (WASM) - SRNS</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-6 mb-10">
    <div class="d-flex align-center mb-4">
        <MudIcon Icon="@Icons.Material.Filled.AccountBalanceWallet" Size="Size.Large" Color="Color.Primary" Class="mr-3" />
        <div>
            <MudText Typo="Typo.h5" Class="font-weight-bold">RightAsset 保有状況 (WASM)</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                タグを指定して、誰がどれだけの RightAsset を保有しているかを確認できます。
            </MudText>
        </div>
    </div>

    <!-- 検索バー -->
    <MudPaper Class="pa-4 mb-6" Elevation="2">
        <MudAutocomplete T="TagSuggestion"
                         Label="タグを検索してRightAsset状況を表示"
                         Placeholder="タグ名を入力..."
                         Value="@_selectedTag"
                         ValueChanged="OnTagSelectedAsync"
                         SearchFunc="SearchTagsAsync"
                         ToStringFunc="@(t => t?.TagName ?? string.Empty)"
                         Clearable="true"
                         ResetValueOnEmptyText="true"
                         CoerceText="false"
                         AdornmentIcon="@Icons.Material.Filled.Search"
                         AdornmentColor="Color.Primary" />
    </MudPaper>

    @if (_isLoading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-6" />
    }
    else if (_overview != null)
    {
        <!-- タグ概要ヘッダーカード -->
        <MudCard Class="mb-6" Elevation="2">
            <MudCardContent>
                <div class="d-flex justify-space-between align-start flex-wrap gap-4">
                    <div>
                        <div class="d-flex align-center gap-2">
                            <MudIcon Icon="@Icons.Material.Filled.LocalOffer" Color="Color.Primary" />
                            <MudText Typo="Typo.h5" Class="font-weight-bold">@_overview.TagName</MudText>
                            <MudChip T="string" Color="Color.Secondary" Size="Size.Small" Variant="Variant.Outlined">
                                Weight: @_overview.TagWeight
                            </MudChip>
                            @if (_overview.IsSystem)
                            {
                                <MudChip T="string" Color="Color.Info" Size="Size.Small" Variant="Variant.Filled">
                                    システムタグ
                                </MudChip>
                            }
                        </div>
                        @if (!string.IsNullOrWhiteSpace(_overview.TagContent))
                        {
                            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-2">
                                @_overview.TagContent
                            </MudText>
                        }
                    </div>
                    <div class="d-flex gap-2">
                        <MudButton Variant="Variant.Outlined" Color="Color.Secondary"
                                   StartIcon="@Icons.Material.Filled.ShoppingCart"
                                   OnClick="@TogglePurchasePanelAsync"
                                   data-testid="overview-purchase-jpyc-button">
                            @(_showPurchasePanel ? "購入を閉じる" : "JPYCで購入")
                        </MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.OpenInNew"
                                   Href="@($"/Tag/WasmDetail/{_overview.TagId}")">
                            タグ詳細を見る
                        </MudButton>
                    </div>
                </div>
            </MudCardContent>
        </MudCard>

        @if (_showPurchasePanel)
        {
            <MudCard Class="mb-6 pa-4" Elevation="2" data-testid="purchase-jpyc-panel">
                <div class="d-flex align-center gap-2 mb-3">
                    <MudIcon Icon="@Icons.Material.Filled.ShoppingCart" Color="Color.Primary" />
                    <MudText Typo="Typo.h6" Class="font-weight-bold">
                        「@_overview.TagName」の操作権限を JPYC で購入
                    </MudText>
                </div>

                <MudAlert Severity="Severity.Info" Dense="true" Class="mb-4">
                    日本円連動ステーブルコイン <strong>JPYC</strong> (1 JPYC = 1円) を送金して、このタグの操作権限（RightAsset）を購入できます。<br />
                    システムがあなた専用の受取ウォレット宛ての送金トランザクション完了を確認した上で、RightAsset を付与します。
                </MudAlert>

                <MudGrid Class="mb-3">
                    <MudItem xs="12" sm="6">
                        <MudNumericField T="int" Label="購入数量 (Amount)" @bind-Value="_purchaseAmount" Min="1"
                                         Variant="Variant.Outlined" data-testid="purchase-amount-field" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudNumericField T="int" Label="1権限あたりの価格 (JPYC)" @bind-Value="_purchaseUnitPrice" Min="1"
                                         HelperText="1 JPYC = 1円相当 (任意に調整可能)"
                                         Variant="Variant.Outlined" data-testid="unit-price-field" />
                    </MudItem>
                </MudGrid>

                <MudPaper Class="pa-3 mb-4 d-flex justify-space-between align-center" Elevation="0" Outlined="true"
                          Style="background-color: var(--mud-palette-background-grey);">
                    <div>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">合計支払金額</MudText>
                        <MudText Typo="Typo.h6" Color="Color.Primary" Class="font-weight-bold">
                            @((_purchaseAmount * _purchaseUnitPrice).ToString("N0")) JPYC
                        </MudText>
                    </div>
                    <MudChip T="string" Color="Color.Success" Variant="Variant.Filled" Size="Size.Small">
                        ¥@((_purchaseAmount * _purchaseUnitPrice).ToString("N0")) 相当
                    </MudChip>
                </MudPaper>

                @if (_networks.Count > 0)
                {
                    <MudSelect T="string" Label="支払いネットワーク" Value="_selectedNetworkName" ValueChanged="OnNetworkChangedAsync"
                               Variant="Variant.Outlined" Class="mb-3" data-testid="network-select">
                        @foreach (var net in _networks)
                        {
                            <MudSelectItem Value="@net.Name">
                                @net.DisplayName @(net.IsRecommended ? " [推奨]" : "")
                            </MudSelectItem>
                        }
                    </MudSelect>
                }

                @if (CurrentNetwork != null)
                {
                    <MudCard Outlined="true" Class="mb-3 pa-3">
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="font-weight-bold d-block mb-1">
                            あなた専用の受取ウォレットアドレス (Deposit Address)
                        </MudText>
                        <div class="d-flex align-center gap-1 mb-2">
                            @if (_isLoadingWallet)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-2" />
                                <MudText Typo="Typo.caption" Color="Color.Secondary">受取アドレスを取得中...</MudText>
                            }
                            else
                            {
                                <MudText Typo="Typo.body2" Style="word-break: break-all; font-family: monospace; font-weight: bold; color: var(--mud-palette-primary);"
                                         data-testid="deposit-address-text">
                                    @_depositAddress
                                </MudText>
                            }
                        </div>
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mb-2">
                            ※ あなたのアカウント専用のアドレスです。MetaMask等から上記アドレス宛てに <strong>@((_purchaseAmount * _purchaseUnitPrice).ToString("N0")) JPYC</strong> を送金してください。
                        </MudText>

                        <MudDivider Class="my-2" />

                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="font-weight-bold d-block mb-1">
                            JPYC コントラクトアドレス (@CurrentNetwork.DisplayName)
                        </MudText>
                        <div class="d-flex align-center gap-1 mb-2">
                            <MudText Typo="Typo.body2" Style="word-break: break-all; font-family: monospace;">
                                @CurrentNetwork.ContractAddress
                            </MudText>
                        </div>

                        <div class="d-flex gap-2 mt-2 flex-wrap">
                            @if (CurrentNetwork.IsTestnet && !string.IsNullOrWhiteSpace(CurrentNetwork.FaucetUrl))
                            {
                                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Small"
                                           StartIcon="@Icons.Material.Filled.WaterDrop" Href="@CurrentNetwork.FaucetUrl" Target="_blank"
                                           data-testid="faucet-link-button">
                                    テスト用 JPYC を取得 (Faucet)
                                </MudButton>
                            }
                            <MudButton Variant="Variant.Text" Color="Color.Default" Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.HelpOutline"
                                       Href="https://faq.jpyc.co.jp/s/article/developer-documentation" Target="_blank">
                                JPYC 開発者ドキュメント
                            </MudButton>
                        </div>
                    </MudCard>
                }

                <div class="d-flex align-center justify-space-between mb-1">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">送金トランザクション確認</MudText>
                    @if (CurrentNetwork?.IsTestnet == true)
                    {
                        <MudLink Typo="Typo.caption" Underline="Underline.Hover" OnClick="@SimulatePaymentAsync"
                                 data-testid="simulate-payment-link">
                            テスト送金をシミュレートしてTxHashを取得
                        </MudLink>
                    }
                </div>
                <MudTextField T="string" Label="トランザクションハッシュ (TxHash)" @bind-Value="_txHash" Placeholder="0x..."
                              Variant="Variant.Outlined" Class="mb-3"
                              HelperText="送金完了後に発行されたトランザクションハッシュを入力してください。システムが送金完了を検証します。"
                              data-testid="txhash-field" />

                <div class="d-flex justify-end gap-2">
                    <MudButton OnClick="@(() => _showPurchasePanel = false)">キャンセル</MudButton>
                    <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="@SubmitPurchaseAsync"
                               Disabled="@(!CanSubmitPurchase)" data-testid="confirm-purchase-button">
                        @if (_isPurchasing)
                        {
                            <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                            <span class="ms-2">トランザクション確認中...</span>
                        }
                        else
                        {
                            <span>送金を確認してRightAssetを受け取る</span>
                        }
                    </MudButton>
                </div>
            </MudCard>
        }

        <!-- メトリクスカード群 -->
        <MudGrid Class="mb-6">
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Class="pa-4 d-flex align-center justify-space-between" Elevation="1">
                    <div>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">総有効保有量</MudText>
                        <MudText Typo="Typo.h5" Class="font-weight-bold" Color="Color.Primary">
                            @_overview.TotalActiveAmount
                        </MudText>
                    </div>
                    <MudAvatar Color="Color.Primary" Variant="Variant.Outlined">
                        <MudIcon Icon="@Icons.Material.Filled.Token" />
                    </MudAvatar>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Class="pa-4 d-flex align-center justify-space-between" Elevation="1">
                    <div>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">有効保有者数</MudText>
                        <MudText Typo="Typo.h5" Class="font-weight-bold">
                            @_overview.TotalHoldersCount 人
                        </MudText>
                    </div>
                    <MudAvatar Color="Color.Success" Variant="Variant.Outlined">
                        <MudIcon Icon="@Icons.Material.Filled.People" />
                    </MudAvatar>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Class="pa-4 d-flex align-center justify-space-between" Elevation="1">
                    <div>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">有効アセット件数</MudText>
                        <MudText Typo="Typo.h5" Class="font-weight-bold">
                            @_overview.TotalActiveAssetsCount 件
                        </MudText>
                    </div>
                    <MudAvatar Color="Color.Info" Variant="Variant.Outlined">
                        <MudIcon Icon="@Icons.Material.Filled.ReceiptLong" />
                    </MudAvatar>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Class="pa-4 d-flex align-center justify-space-between" Elevation="1">
                    <div>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">燃焼済み量 (Burned)</MudText>
                        <MudText Typo="Typo.h5" Class="font-weight-bold" Color="Color.Dark">
                            @_overview.TotalBurnedAmount
                        </MudText>
                    </div>
                    <MudAvatar Color="Color.Default" Variant="Variant.Outlined">
                        <MudIcon Icon="@Icons.Material.Filled.LocalFireDepartment" />
                    </MudAvatar>
                </MudPaper>
            </MudItem>
        </MudGrid>

        <!-- メインタブ: 保有者一覧 / アセット明細 -->
        <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true">
            <MudTabPanel Text="保有者別サマリー" Icon="@Icons.Material.Filled.People">
                <div class="pa-4">
                <MudTable Items="@_overview.Holders" Dense="true" Hover="true" Striped="true" Breakpoint="Breakpoint.Sm"
                          Loading="@_isLoading" LoadingProgressColor="Color.Info" data-testid="right-asset-holders-table">
                    <HeaderContent>
                        <MudTh>保有ユーザー</MudTh>
                        <MudTh Style="text-align: right;">有効保有量</MudTh>
                        <MudTh Style="width: 25%;">保有シェア</MudTh>
                        <MudTh Style="text-align: right;">有効アセット件数</MudTh>
                        <MudTh Style="text-align: right;">燃焼済 (消費量)</MudTh>
                        <MudTh>最終更新日時</MudTh>
                        <MudTh Style="text-align: center;">操作</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="保有ユーザー">
                            <div class="d-flex align-center gap-2">
                                <MudAvatar Size="Size.Small" Color="Color.Secondary">
                                    @((context.UserName ?? context.UserId)[..1].ToUpperInvariant())
                                </MudAvatar>
                                <div>
                                    <MudLink Href="@($"/User/WasmDetail/{context.UserId}")" Underline="Underline.Hover">
                                        <strong>@(context.UserName ?? context.UserId)</strong>
                                    </MudLink>
                                    @if (!string.IsNullOrEmpty(context.UserName))
                                    {
                                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block">
                                            ID: @context.UserId
                                        </MudText>
                                    }
                                </div>
                            </div>
                        </MudTd>
                        <MudTd DataLabel="有効保有量" Style="text-align: right;">
                            <MudChip T="string" Color="Color.Primary" Size="Size.Small" Variant="Variant.Filled">
                                @context.TotalAmount
                            </MudChip>
                        </MudTd>
                        <MudTd DataLabel="保有シェア">
                            @{
                                double share = _overview.TotalActiveAmount > 0
                                    ? ((double)context.TotalAmount / _overview.TotalActiveAmount) * 100.0
                                    : 0;
                            }
                            <div class="d-flex align-center gap-2">
                                <MudProgressLinear Color="Color.Primary" Value="@share" Rounded="true" Class="flex-grow-1" />
                                <MudText Typo="Typo.caption" Style="min-width: 45px; text-align: right;">
                                    @share.ToString("F1")%
                                </MudText>
                            </div>
                        </MudTd>
                        <MudTd DataLabel="有効アセット件数" Style="text-align: right;">
                            @context.ActiveAssetCount 件
                        </MudTd>
                        <MudTd DataLabel="燃焼済 (消費量)" Style="text-align: right;">
                            @if (context.BurnedAmount > 0)
                            {
                                <MudText Typo="Typo.body2" Color="Color.Secondary">
                                    @context.BurnedAmount (@context.BurnedAssetCount 件)
                                </MudText>
                            }
                            else
                            {
                                <MudText Typo="Typo.body2" Color="Color.Secondary">-</MudText>
                            }
                        </MudTd>
                        <MudTd DataLabel="最終更新日時">
                            @(context.LastUpdated?.ToLocalTime().ToString("yyyy/MM/dd HH:mm") ?? "-")
                        </MudTd>
                        <MudTd DataLabel="操作" Style="text-align: center;">
                            <MudIconButton Icon="@Icons.Material.Filled.Person" Size="Size.Small" Color="Color.Primary"
                                           Href="@($"/User/WasmDetail/{context.UserId}")" aria-label="ユーザー詳細へ" />
                        </MudTd>
                    </RowTemplate>
                    <NoRecordsContent>
                        <MudAlert Severity="Severity.Normal" Class="my-4">
                            このタグを保有しているユーザーはいません。
                        </MudAlert>
                    </NoRecordsContent>
                </MudTable>
                </div>
            </MudTabPanel>

            <MudTabPanel Text="個別 RightAsset 明細" Icon="@Icons.Material.Filled.ListAlt">
                <div class="pa-4">
                <MudTable Items="@_overview.Assets" Dense="true" Hover="true" Striped="true" Breakpoint="Breakpoint.Sm"
                          data-testid="right-asset-items-table">
                    <HeaderContent>
                        <MudTh>ID</MudTh>
                        <MudTh>所有者</MudTh>
                        <MudTh Style="text-align: right;">数量 (Amount)</MudTh>
                        <MudTh>状態</MudTh>
                        <MudTh>作成日時</MudTh>
                        <MudTh>更新日時</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="ID">#@context.Id</MudTd>
                        <MudTd DataLabel="所有者">
                            <MudLink Href="@($"/User/WasmDetail/{context.OwnerId}")" Underline="Underline.Hover">
                                @(context.OwnerName ?? context.OwnerId)
                            </MudLink>
                        </MudTd>
                        <MudTd DataLabel="数量" Style="text-align: right;">
                            <strong>@context.Amount</strong>
                        </MudTd>
                        <MudTd DataLabel="状態">
                            @if (context.IsBurned)
                            {
                                <MudChip T="string" Color="Color.Default" Size="Size.Small" Variant="Variant.Outlined">
                                    @context.StatusSummary
                                </MudChip>
                            }
                            else if (context.Amount > 0)
                            {
                                <MudChip T="string" Color="Color.Success" Size="Size.Small" Variant="Variant.Filled">
                                    有効
                                </MudChip>
                            }
                            else
                            {
                                <MudChip T="string" Color="Color.Warning" Size="Size.Small" Variant="Variant.Outlined">
                                    残高0
                                </MudChip>
                            }
                        </MudTd>
                        <MudTd DataLabel="作成日時">
                            @context.CreatedDate.ToLocalTime().ToString("yyyy/MM/dd HH:mm")
                        </MudTd>
                        <MudTd DataLabel="更新日時">
                            @context.UpdatedDate.ToLocalTime().ToString("yyyy/MM/dd HH:mm")
                        </MudTd>
                    </RowTemplate>
                    <NoRecordsContent>
                        <MudAlert Severity="Severity.Normal" Class="my-4">
                            RightAsset のレコードが存在しません。
                        </MudAlert>
                    </NoRecordsContent>
                </MudTable>
                </div>
            </MudTabPanel>
        </MudTabs>
    }
    else
    {
        <!-- 未選択時の案内と代表タグ -->
        <MudAlert Severity="Severity.Info" Class="mb-6" Icon="@Icons.Material.Filled.Info">
            上の検索バーからタグを入力して検索・選択すると、そのタグの RightAsset 保有状況が表示されます。
        </MudAlert>

        @if (_topTags.Count > 0)
        {
            <MudPaper Class="pa-4" Elevation="1">
                <div class="d-flex align-center mb-3">
                    <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Color="Color.Primary" Class="mr-2" />
                    <MudText Typo="Typo.subtitle1" Class="font-weight-bold">RightAsset 発行実績のあるタグ</MudText>
                </div>
                <div class="d-flex flex-wrap gap-2">
                    @foreach (var tagSummary in _topTags)
                    {
                        <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined"
                                 Icon="@Icons.Material.Filled.LocalOffer"
                                 OnClick="@(() => LoadOverviewAsync(tagSummary.TagId))">
                            @tagSummary.TagName (@tagSummary.TotalAmount 持分 / @tagSummary.HolderCount 人)
                        </MudChip>
                    }
                </div>
            </MudPaper>
        }
    }
</MudContainer>

@code {
    [Parameter]
    public int? TagId { get; set; }

    private bool _isLoading;
    private TagSuggestion? _selectedTag;
    private RightAssetOverviewResponse? _overview;
    private IReadOnlyList<TagRightAssetSummaryDto> _topTags = [];

    // JPYC 購入パネル用状態
    private bool _showPurchasePanel;
    private int _purchaseAmount = 1;
    private int _purchaseUnitPrice = 100;
    private string _selectedNetworkName = "polygon-amoy";
    private string _depositAddress = string.Empty;
    private string _txHash = string.Empty;
    private bool _isLoadingWallet;
    private bool _isPurchasing;
    private IReadOnlyList<JpycNetworkDto> _networks = [];

    private JpycNetworkDto? CurrentNetwork =>
        _networks.FirstOrDefault(n => n.Name == _selectedNetworkName)
        ?? _networks.FirstOrDefault();

    private bool CanSubmitPurchase =>
        !_isPurchasing && _purchaseAmount > 0 && _purchaseUnitPrice > 0 && !string.IsNullOrWhiteSpace(_txHash);

    protected override async Task OnInitializedAsync()
    {
        if (TagId.HasValue && TagId.Value > 0)
        {
            await LoadOverviewAsync(TagId.Value);
        }
        else
        {
            await LoadTopTagsAsync();
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (TagId.HasValue && TagId.Value > 0 && (_overview == null || _overview.TagId != TagId.Value))
        {
            await LoadOverviewAsync(TagId.Value);
        }
    }

    private async Task LoadTopTagsAsync()
    {
        try
        {
            _topTags = await ApiClient.GetTopTagsWithRightAssetsAsync(10);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"代表タグの読み込みに失敗しました: {ex.Message}", Severity.Warning);
        }
    }

    private async Task<IEnumerable<TagSuggestion>> SearchTagsAsync(string value, CancellationToken cancellationToken)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return [];
        }

        try
        {
            return await ApiClient.SearchTagsAsync(value, cancellationToken);
        }
        catch
        {
            return [];
        }
    }

    private async Task OnTagSelectedAsync(TagSuggestion? tag)
    {
        _selectedTag = tag;
        _showPurchasePanel = false;
        if (tag?.TagId is int tagId)
        {
            await LoadOverviewAsync(tagId);
        }
        else
        {
            _overview = null;
            await LoadTopTagsAsync();
        }
    }

    private async Task LoadOverviewAsync(int tagId)
    {
        _isLoading = true;
        try
        {
            _overview = await ApiClient.GetRightAssetOverviewAsync(tagId);
            if (_overview != null)
            {
                _selectedTag = new TagSuggestion(_overview.TagId, _overview.TagName, null);
            }
            else
            {
                Snackbar.Add("タグの RightAsset 情報が見つかりませんでした。", Severity.Info);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"保有状況の取得に失敗しました: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task TogglePurchasePanelAsync()
    {
        _showPurchasePanel = !_showPurchasePanel;
        if (_showPurchasePanel)
        {
            if (_networks.Count == 0)
            {
                await LoadNetworksAsync();
            }
            else
            {
                await LoadWalletAsync();
            }
        }
    }

    private async Task LoadNetworksAsync()
    {
        try
        {
            _networks = await ApiClient.GetJpycNetworksAsync();
            if (_networks.Count > 0)
            {
                var recommended = _networks.FirstOrDefault(n => n.IsRecommended);
                _selectedNetworkName = recommended?.Name ?? _networks[0].Name;
            }
            await LoadWalletAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"ネットワーク情報の取得に失敗しました: {ex.Message}", Severity.Warning);
        }
    }

    private async Task OnNetworkChangedAsync(string networkName)
    {
        _selectedNetworkName = networkName;
        await LoadWalletAsync();
    }

    private async Task LoadWalletAsync()
    {
        if (string.IsNullOrEmpty(_selectedNetworkName))
        {
            return;
        }

        _isLoadingWallet = true;
        try
        {
            var wallet = await ApiClient.GetUserDepositWalletAsync(_selectedNetworkName);
            _depositAddress = wallet?.DepositAddress ?? string.Empty;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"受取ウォレットアドレスの取得に失敗しました: {ex.Message}", Severity.Warning);
        }
        finally
        {
            _isLoadingWallet = false;
        }
    }

    private async Task SimulatePaymentAsync()
    {
        try
        {
            int total = _purchaseAmount * _purchaseUnitPrice;
            string? txHash = await ApiClient.SimulateDepositAsync(new SimulateDepositRequest(_selectedNetworkName, total));
            if (!string.IsNullOrEmpty(txHash))
            {
                _txHash = txHash;
                Snackbar.Add("テスト送金をシミュレートしました。TxHashが自動入力されました。", Severity.Info);
            }
            else
            {
                Snackbar.Add("送金シミュレーションに失敗しました。ログイン状態をご確認ください。", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"送金シミュレーションエラー: {ex.Message}", Severity.Error);
        }
    }

    private async Task SubmitPurchaseAsync()
    {
        if (_overview == null)
        {
            return;
        }

        _isPurchasing = true;
        try
        {
            var request = new PurchaseRightAssetRequest(
                RequestedTagId: _overview.TagId,
                Amount: _purchaseAmount,
                UnitPriceJpyc: _purchaseUnitPrice,
                NetworkName: _selectedNetworkName,
                TransactionHash: _txHash
            );

            var result = await ApiClient.PurchaseRightAssetAsync(request);
            if (result != null)
            {
                Snackbar.Add($"「{result.TagName}」の RightAsset を {result.Amount} 権限購入しました！", Severity.Success);
                _showPurchasePanel = false;
                _txHash = string.Empty;
                await LoadOverviewAsync(_overview.TagId);
            }
            else
            {
                Snackbar.Add("RightAsset の購入に失敗しました。送金確認またはログイン状態をご確認ください。", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"購入エラー: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isPurchasing = false;
        }
    }
}
