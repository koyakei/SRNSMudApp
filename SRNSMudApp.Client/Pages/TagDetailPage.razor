@page "/Tag/WasmDetail/{TagId:int}"
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using MudBlazor
@using SRNSMudApp.Client.Models.Api
@using SRNSMudApp.Client.Services
@implements IDisposable

<PageTitle>@(Tag != null ? $"{Tag.Name} - タグ詳細 (WASM)" : "タグ詳細 (WASM)") - SRNS</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-5 mb-10">
    <div class="d-flex align-center gap-2 mb-4 flex-wrap">
        <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Color="Color.Default"
                       OnClick="@(() => NavigationManager.NavigateTo("Item/WasmList"))" title="一覧に戻る" />
        <MudText Typo="Typo.h5" Class="font-weight-bold">タグ詳細 (WASM)</MudText>
        <MudSpacer />
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.AccountTree"
                   OnClick="@(() => NavigationManager.NavigateTo("Tag/WasmTree"))">
            タグツリー
        </MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.Hub"
                   OnClick="@(() => NavigationManager.NavigateTo("Tag/WasmDiagram"))">
            ダイアグラム
        </MudButton>
    </div>

    @if (IsLoading)
    {
        <div class="d-flex justify-center pa-8">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
        </div>
    }
    else if (Tag == null)
    {
        <MudAlert Severity="Severity.Warning">タグが見つかりませんでした。</MudAlert>
    }
    else
    {
        @if (Tag.IsLocked)
        {
            <MudAlert Severity="Severity.Error" Class="mb-4 rounded-lg" Dense="true" Elevation="1">
                このタグはロックされています。新規作成・編集・削除は制限されています（管理者のみ操作可能）。
            </MudAlert>
        }

        <MudCard Outlined="true" Class="rounded-xl mb-4">
            <MudCardContent Class="pa-5">
                @if (_isEditing)
                {
                    <div class="d-flex flex-column gap-3" data-testid="tag-edit-form">
                        <MudText Typo="Typo.h6" Class="font-weight-bold">タグ情報の編集</MudText>
                        <MudTextField @bind-Value="_editName" Label="タグ名 *" Variant="Variant.Outlined" Required="true"
                                      data-testid="edit-tag-name-input" />
                        <MudTextField @bind-Value="_editContent" Label="説明・定義" Variant="Variant.Outlined" Lines="3"
                                      data-testid="edit-tag-content-input" />
                        <MudSwitch T="bool" @bind-Value="_editIsPrivate" Label="非公開タグ" Color="Color.Warning"
                                   data-testid="edit-tag-private-switch" />
                        <div class="d-flex justify-end gap-2 mt-2">
                            <MudButton Variant="Variant.Outlined" Color="Color.Default" OnClick="CancelEdit"
                                       data-testid="cancel-edit-btn">
                                キャンセル
                            </MudButton>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveEditAsync"
                                       Disabled="_isSaving" data-testid="save-edit-btn">
                                @if (_isSaving)
                                {
                                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="ms-n1" />
                                    <span class="ms-2">保存中...</span>
                                }
                                else
                                {
                                    <span>保存</span>
                                }
                            </MudButton>
                        </div>
                    </div>
                }
                else if (_isProposing)
                {
                    <div class="d-flex flex-column gap-3" data-testid="tag-proposal-form">
                        <MudText Typo="Typo.h6" Class="font-weight-bold">
                            @(_proposalType == "name" ? "タグ名の変更を提案" : "説明文の変更を提案")
                        </MudText>
                        @if (_proposalType == "name")
                        {
                            <MudTextField @bind-Value="_proposedName" Label="新しいタグ名 *" Variant="Variant.Outlined" Required="true"
                                          data-testid="proposal-name-input" />
                        }
                        else
                        {
                            <MudTextField @bind-Value="_proposedContent" Label="新しい説明文 *" Variant="Variant.Outlined" Lines="3" Required="true"
                                          data-testid="proposal-content-input" />
                        }
                        <MudTextField @bind-Value="_proposalReason" Label="提案理由や補足（任意）" Variant="Variant.Outlined" Lines="2"
                                      data-testid="proposal-reason-input" />
                        <div class="d-flex justify-end gap-2 mt-2">
                            <MudButton Variant="Variant.Outlined" Color="Color.Default" OnClick="@(() => _isProposing = false)"
                                       data-testid="cancel-proposal-btn">
                                キャンセル
                            </MudButton>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SubmitProposalAsync"
                                       Disabled="_isSubmittingProposal" data-testid="submit-proposal-btn">
                                @if (_isSubmittingProposal)
                                {
                                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="ms-n1" />
                                    <span class="ms-2">送信中...</span>
                                }
                                else
                                {
                                    <span>提案を送信</span>
                                }
                            </MudButton>
                        </div>
                    </div>
                }
                else
                {
                    <div class="d-flex align-start justify-space-between flex-wrap gap-3">
                        <div class="d-flex align-start gap-3">
                            @* 投票スコア *@
                            <div class="d-flex flex-column align-center vote-container">
                                <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward" Size="Size.Small" Color="Color.Default" Class="pa-1"
                                               OnClick="@(() => VoteTagAsync(true))" title="Upvote" data-testid="tag-upvote-btn" />
                                <MudText Typo="Typo.body2" Class="vote-score font-weight-bold">@Tag.Score</MudText>
                                <MudIconButton Icon="@Icons.Material.Filled.ArrowDownward" Size="Size.Small" Color="Color.Default" Class="pa-1"
                                               OnClick="@(() => VoteTagAsync(false))" title="Downvote" data-testid="tag-downvote-btn" />
                            </div>

                            <div>
                                <div class="d-flex align-center gap-2 flex-wrap">
                                    <MudIcon Icon="@Icons.Material.Filled.LocalOffer" Color="Color.Primary" />
                                    <MudText Typo="Typo.h5" Class="font-weight-bold">@Tag.Name</MudText>
                                    @if (Tag.IsPrivate)
                                    {
                                        <MudChip T="string" Color="Color.Warning" Size="Size.Small" Variant="Variant.Filled">非公開</MudChip>
                                    }
                                    @if (!string.IsNullOrEmpty(Tag.TargetUserGroupName))
                                    {
                                        <MudChip T="string" Color="Color.Info" Size="Size.Small" Variant="Variant.Filled">@Tag.TargetUserGroupName</MudChip>
                                    }
                                    @if (Tag.IsLocked)
                                    {
                                        <MudChip T="string" Color="Color.Error" Size="Size.Small" Variant="Variant.Filled">
                                            <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Small" Class="mr-1" />ロック中
                                        </MudChip>
                                    }
                                    @if (Tag.AutoAcceptIncomingTaggingRequests)
                                    {
                                        <MudChip T="string" Color="Color.Success" Size="Size.Small" Variant="Variant.Outlined">自動承認</MudChip>
                                    }
                                </div>

                                @if (!string.IsNullOrEmpty(Tag.Content))
                                {
                                    <MudText Typo="Typo.body1" Class="mt-2" Style="white-space: pre-wrap;">@Tag.Content</MudText>
                                }

                                <div class="d-flex align-center gap-3 mt-2">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        作成者:
                                        @if (!string.IsNullOrEmpty(Tag.OwnerUserId))
                                        {
                                            <MudLink Href="@($"/User/WasmDetail/{Tag.OwnerUserId}")" Color="Color.Inherit" Underline="Underline.Hover">
                                                @(Tag.OwnerUserName ?? "不明")
                                            </MudLink>
                                        }
                                        else
                                        {
                                            @(Tag.OwnerUserName ?? "不明")
                                        }
                                    </MudText>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex align-center gap-2 flex-wrap">
                            @if (_isAdmin)
                            {
                                <MudButton Variant="Variant.Outlined"
                                           Color="@(Tag.IsLocked ? Color.Success : Color.Error)"
                                           Size="Size.Small"
                                           StartIcon="@(Tag.IsLocked ? Icons.Material.Filled.LockOpen : Icons.Material.Filled.Lock)"
                                           OnClick="ToggleLockAsync"
                                           data-testid="toggle-tag-lock-btn">
                                    @(Tag.IsLocked ? "ロック解除" : "ロック")
                                </MudButton>
                            }

                            @if (CanEditOrDelete && (!Tag.IsLocked || _isAdmin))
                            {
                                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                                           StartIcon="@Icons.Material.Filled.Edit"
                                           OnClick="StartEdit"
                                           data-testid="start-edit-btn">
                                    編集
                                </MudButton>
                                <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small"
                                           StartIcon="@Icons.Material.Filled.Delete"
                                           OnClick="StartDelete"
                                           data-testid="delete-tag-btn">
                                    削除
                                </MudButton>
                            }
                            else if (!string.IsNullOrEmpty(_currentUserId) && !Tag.IsLocked)
                            {
                                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Small"
                                           StartIcon="@Icons.Material.Filled.DriveFileRenameOutline"
                                           OnClick="@(() => StartProposal("name"))"
                                           data-testid="propose-name-btn">
                                    名前を提案
                                </MudButton>
                                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Small"
                                           StartIcon="@Icons.Material.Filled.EditNote"
                                           OnClick="@(() => StartProposal("content"))"
                                           data-testid="propose-content-btn">
                                    説明を提案
                                </MudButton>
                            }

                            @if (!string.IsNullOrEmpty(_currentUserId))
                            {
                                <MudButton Variant="@(Tag.IsFollowing ? Variant.Outlined : Variant.Filled)"
                                           Color="@(Tag.IsFollowing ? Color.Default : Color.Primary)"
                                           Size="Size.Small"
                                           StartIcon="@(Tag.IsFollowing ? Icons.Material.Filled.FavoriteBorder : Icons.Material.Filled.Favorite)"
                                           OnClick="ToggleFollowAsync" Disabled="IsTogglingFollow"
                                           data-testid="toggle-follow-btn">
                                    @(Tag.IsFollowing ? "フォロー解除" : "フォロー")
                                </MudButton>
                            }
                        </div>
                    </div>
                }

                @if (_showDeleteConfirm)
                {
                    <MudAlert Severity="Severity.Error" Class="mt-4 rounded-lg" data-testid="delete-confirm-box">
                        <div class="d-flex align-center justify-space-between flex-wrap gap-2">
                            <MudText Typo="Typo.body2">
                                タグ「@Tag.Name」を削除してもよろしいですか？この操作は取り消せません。
                            </MudText>
                            <div class="d-flex gap-2">
                                <MudButton Variant="Variant.Text" Color="Color.Default" Size="Size.Small"
                                           OnClick="@(() => _showDeleteConfirm = false)" data-testid="cancel-delete-btn">
                                    キャンセル
                                </MudButton>
                                <MudButton Variant="Variant.Filled" Color="Color.Error" Size="Size.Small"
                                           OnClick="ConfirmDeleteAsync" Disabled="_isDeleting"
                                           data-testid="confirm-delete-btn">
                                    @if (_isDeleting)
                                    {
                                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="ms-n1" />
                                        <span class="ms-1">削除中...</span>
                                    }
                                    else
                                    {
                                        <span>削除実行</span>
                                    }
                                </MudButton>
                            </div>
                        </div>
                    </MudAlert>
                }
            </MudCardContent>
        </MudCard>

        <MudTabs Elevation="1" Rounded="true" ApplyEffectsToContainer="true" panelClass="pa-4" KeepPanelsAlive="true">
            <MudTabPanel Text="@($"関連アイテム ({Tag.RelatedItems.Count})")" Icon="@Icons.Material.Filled.Article">
                @if (Tag.RelatedItems.Count == 0)
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="pa-4 text-center">
                        このタグに関連付けられたアイテムはありません。
                    </MudText>
                }
                else
                {
                    <MudStack Spacing="3">
                        @foreach (var item in Tag.RelatedItems)
                        {
                            <MudPaper Elevation="0" Outlined="true" Class="pa-3 rounded-lg">
                                <div class="d-flex justify-space-between align-center mb-1">
                                    <MudLink Href="@($"/Item/WasmDetail/{item.Id}")" Color="Color.Primary" Typo="Typo.subtitle2" Class="font-weight-bold">
                                        #@item.Id - @(item.OwnerUserName ?? "匿名")
                                    </MudLink>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        @item.UpdatedDate.ToLocalTime().ToString("g")
                                    </MudText>
                                </div>
                                <MudText Typo="Typo.body2" Class="mb-2" Style="white-space: pre-wrap;">@item.Content</MudText>
                                <div class="d-flex align-center justify-space-between">
                                    <div class="d-flex gap-1 flex-wrap">
                                        @foreach (var tr in item.TagRelations)
                                        {
                                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default">
                                                @tr.TagName (+@tr.Weight)
                                            </MudChip>
                                        }
                                    </div>
                                    <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                                               Href="@($"/Item/WasmDetail/{item.Id}")" EndIcon="@Icons.Material.Filled.ArrowForward">
                                        詳細を見る
                                    </MudButton>
                                </div>
                            </MudPaper>
                        }
                    </MudStack>
                }
            </MudTabPanel>

            <MudTabPanel Text="@($"関連タグ ({Tag.RelatedTags.Count})")" Icon="@Icons.Material.Filled.Tag">
                @if (Tag.RelatedTags.Count == 0)
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="pa-4 text-center">
                        関連するタグはありません。
                    </MudText>
                }
                else
                {
                    <MudGrid Spacing="2">
                        @foreach (var relTag in Tag.RelatedTags)
                        {
                            <MudItem xs="12" sm="6" md="4">
                                <MudPaper Elevation="0" Outlined="true" Class="pa-3 rounded-lg">
                                    <div class="d-flex align-center justify-space-between mb-1">
                                        <MudLink Href="@($"/Tag/WasmDetail/{relTag.Id}")" Color="Color.Primary" Typo="Typo.subtitle2" Class="font-weight-bold">
                                            <MudIcon Icon="@Icons.Material.Filled.LocalOffer" Size="Size.Small" Class="mr-1" />
                                            @relTag.Name
                                        </MudLink>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">スコア: @relTag.Score</MudText>
                                    </div>
                                    @if (!string.IsNullOrEmpty(relTag.Content))
                                    {
                                        <MudText Typo="Typo.caption" Class="d-block text-truncate mb-1">@relTag.Content</MudText>
                                    }
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">作成者: @(relTag.OwnerUserName ?? "不明")</MudText>
                                </MudPaper>
                            </MudItem>
                        }
                    </MudGrid>
                }
            </MudTabPanel>

            <MudTabPanel Text="@($"タグ付け提案 ({Tag.PendingRequests.Count})")" Icon="@Icons.Material.Filled.PendingActions">
                @if (Tag.PendingRequests.Count == 0)
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="pa-4 text-center">
                        保留中のタグ付け提案はありません。
                    </MudText>
                }
                else
                {
                    <MudStack Spacing="2">
                        @foreach (var req in Tag.PendingRequests)
                        {
                            <MudPaper Elevation="0" Outlined="true" Class="pa-3 rounded-lg">
                                <div class="d-flex align-center justify-space-between flex-wrap gap-2">
                                    <div>
                                        <MudText Typo="Typo.subtitle2" Class="font-weight-bold">
                                            アイテム #@req.TargetItemId へのタグ付け提案 (@req.RequestedTagName)
                                        </MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                                            提案者: @(req.RequesterUserName ?? req.RequesterUserId) | 提案ウェイト: @req.ProposedWeight
                                        </MudText>
                                    </div>
                                    @if (CanEditOrDelete)
                                    {
                                        <div class="d-flex gap-2">
                                            <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small"
                                                       OnClick="@(() => ApproveRequestAsync(req.Id))">承認</MudButton>
                                            <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small"
                                                       OnClick="@(() => RejectRequestAsync(req.Id))">却下</MudButton>
                                        </div>
                                    }
                                </div>
                            </MudPaper>
                        }
                    </MudStack>
                }
            </MudTabPanel>

            <MudTabPanel Text="@($"変更提案 ({TotalPendingProposals})")" Icon="@Icons.Material.Filled.Feedback"
                         data-testid="proposals-tab">
                @if (_pendingProposals == null || TotalPendingProposals == 0)
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="pa-4 text-center">
                        保留中の変更提案はありません。
                    </MudText>
                }
                else
                {
                    <MudStack Spacing="3">
                        @if (_pendingProposals.NameProposals.Count > 0)
                        {
                            <MudText Typo="Typo.subtitle2" Class="font-weight-bold">タグ名変更の提案</MudText>
                            @foreach (var prop in _pendingProposals.NameProposals)
                            {
                                <MudPaper Elevation="0" Outlined="true" Class="pa-3 rounded-lg" data-testid="@($"name-proposal-{prop.Id}")">
                                    <div class="d-flex align-center justify-space-between flex-wrap gap-2">
                                        <div>
                                            <MudText Typo="Typo.body1" Class="font-weight-bold">
                                                新名称案: 「@prop.ProposedName」
                                            </MudText>
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                提案者: @(prop.RequesterUserName ?? prop.RequesterUserId) | @prop.CreatedDate.ToLocalTime().ToString("g")
                                            </MudText>
                                            @if (!string.IsNullOrWhiteSpace(prop.Reason))
                                            {
                                                <MudText Typo="Typo.body2" Class="mt-1">理由: @prop.Reason</MudText>
                                            }
                                        </div>
                                        <div class="d-flex gap-2">
                                            @if (CanEditOrDelete)
                                            {
                                                <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small"
                                                           OnClick="@(() => ApproveNameProposalAsync(prop.Id))"
                                                           data-testid="@($"approve-name-prop-{prop.Id}")">承認</MudButton>
                                                <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small"
                                                           OnClick="@(() => RejectNameProposalAsync(prop.Id))"
                                                           data-testid="@($"reject-name-prop-{prop.Id}")">却下</MudButton>
                                            }
                                            else if (prop.RequesterUserId == _currentUserId)
                                            {
                                                <MudButton Variant="Variant.Outlined" Color="Color.Default" Size="Size.Small"
                                                           OnClick="@(() => CancelNameProposalAsync(prop.Id))"
                                                           data-testid="@($"cancel-name-prop-{prop.Id}")">取り下げ</MudButton>
                                            }
                                        </div>
                                    </div>
                                </MudPaper>
                            }
                        }

                        @if (_pendingProposals.ContentProposals.Count > 0)
                        {
                            <MudText Typo="Typo.subtitle2" Class="font-weight-bold mt-2">説明文変更の提案</MudText>
                            @foreach (var prop in _pendingProposals.ContentProposals)
                            {
                                <MudPaper Elevation="0" Outlined="true" Class="pa-3 rounded-lg" data-testid="@($"content-proposal-{prop.Id}")">
                                    <div class="d-flex align-center justify-space-between flex-wrap gap-2">
                                        <div>
                                            <MudText Typo="Typo.body2" Class="font-weight-bold" Style="white-space: pre-wrap;">
                                                新説明案: @prop.ProposedContent
                                            </MudText>
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                提案者: @(prop.RequesterUserName ?? prop.RequesterUserId) | @prop.CreatedDate.ToLocalTime().ToString("g")
                                            </MudText>
                                            @if (!string.IsNullOrWhiteSpace(prop.Reason))
                                            {
                                                <MudText Typo="Typo.body2" Class="mt-1">理由: @prop.Reason</MudText>
                                            }
                                        </div>
                                        <div class="d-flex gap-2">
                                            @if (CanEditOrDelete)
                                            {
                                                <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small"
                                                           OnClick="@(() => ApproveContentProposalAsync(prop.Id))"
                                                           data-testid="@($"approve-content-prop-{prop.Id}")">承認</MudButton>
                                                <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small"
                                                           OnClick="@(() => RejectContentProposalAsync(prop.Id))"
                                                           data-testid="@($"reject-content-prop-{prop.Id}")">却下</MudButton>
                                            }
                                            else if (prop.RequesterUserId == _currentUserId)
                                            {
                                                <MudButton Variant="Variant.Outlined" Color="Color.Default" Size="Size.Small"
                                                           OnClick="@(() => CancelContentProposalAsync(prop.Id))"
                                                           data-testid="@($"cancel-content-prop-{prop.Id}")">取り下げ</MudButton>
                                            }
                                        </div>
                                    </div>
                                </MudPaper>
                            }
                        }
                    </MudStack>
                }
            </MudTabPanel>
        </MudTabs>
    }
</MudContainer>

@code {
    private readonly CancellationTokenSource _cts = new();

    [Parameter]
    public int TagId { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    [Inject]
    public required IItemListApiClient ApiClient { get; set; }

    [Inject]
    public required ISnackbar Snackbar { get; set; }

    [Inject]
    public required NavigationManager NavigationManager { get; set; }

    public TagDetailDto? Tag { get; private set; }

    public bool IsLoading { get; private set; } = true;

    public bool IsTogglingFollow { get; private set; }

    private string? _currentUserId;
    private bool _isAdmin;
    private bool CanEditOrDelete => _isAdmin || (!string.IsNullOrEmpty(_currentUserId) && _currentUserId == Tag?.OwnerUserId);

    private bool _isEditing;
    private bool _isSaving;
    private string _editName = string.Empty;
    private string? _editContent;
    private bool _editIsPrivate;

    private bool _showDeleteConfirm;
    private bool _isDeleting;

    private TagPendingProposalsDto? _pendingProposals;
    private int TotalPendingProposals => (_pendingProposals?.NameProposals.Count ?? 0) + (_pendingProposals?.ContentProposals.Count ?? 0);

    private bool _isProposing;
    private string _proposalType = "name";
    private string _proposedName = string.Empty;
    private string _proposedContent = string.Empty;
    private string? _proposalReason;
    private bool _isSubmittingProposal;

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask != null)
        {
            var authState = await AuthStateTask;
            _currentUserId = authState.User?.FindFirst(ClaimTypes.NameIdentifier)?.Value;
            _isAdmin = authState.User?.IsInRole("Admin") ?? false;
        }

        await LoadTagAsync();
    }

    [System.Diagnostics.CodeAnalysis.SuppressMessage("Design", "CA1031:Do not catch general exception types", Justification = "UI 表示向けにエラーメッセージへ集約するため")]
    private async Task LoadTagAsync()
    {
        IsLoading = true;
        try
        {
            Tag = await ApiClient.GetTagDetailAsync(TagId, _cts.Token);
            _pendingProposals = await ApiClient.GetPendingProposalsForTagAsync(TagId, _cts.Token);
        }
        catch (OperationCanceledException)
        {
            // キャンセル時は無視
        }
        catch (Exception ex)
        {
            Snackbar.Add($"タグ情報の取得に失敗しました: {ex.Message}", Severity.Error);
        }
        finally
        {
            IsLoading = false;
        }
    }

