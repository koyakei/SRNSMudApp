    [System.Diagnostics.CodeAnalysis.SuppressMessage("Design", "CA1031:Do not catch general exception types", Justification = "UI 表示向けにエラーメッセージへ集約するため")]
    private async Task ToggleFollowAsync()
    {
        if (Tag == null || IsTogglingFollow)
        {
            return;
        }

        IsTogglingFollow = true;
        try
        {
            bool isFollowing = await ApiClient.ToggleTagFollowAsync(TagId, _cts.Token);
            Tag = Tag with { IsFollowing = isFollowing };
            Snackbar.Add(isFollowing ? ClientMessages.TagFollowSuccess : ClientMessages.TagUnfollowSuccess, Severity.Success);
        }
        catch (OperationCanceledException)
        {
            // キャンセル時は通知しない
        }
        catch (Exception ex)
        {
            Logger?.LogError(ex, "タグフォロー切替 (TagId: {TagId}) 中にエラーが発生しました。", TagId);
            Snackbar.Add(ClientMessages.FormatTagFollowFailed(ex.Message), Severity.Error);
        }
        finally
        {
            IsTogglingFollow = false;
        }
    }

