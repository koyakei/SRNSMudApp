    private void StartProposal(string type)
    {
        _proposalType = type;
        _proposedName = Tag?.Name ?? string.Empty;
        _proposedContent = Tag?.Content ?? string.Empty;
        _proposalReason = string.Empty;
        _isProposing = true;
    }

    [System.Diagnostics.CodeAnalysis.SuppressMessage("Design", "CA1031:Do not catch general exception types", Justification = "UI 表示向けにエラーメッセージへ集約するため")]
    private async Task SubmitProposalAsync()
    {
        _isSubmittingProposal = true;
        try
        {
            if (_proposalType == "name")
            {
                if (string.IsNullOrWhiteSpace(_proposedName))
                {
                    Snackbar.Add("提案するタグ名を入力してください。", Severity.Warning);
                    return;
                }

                var req = new ProposeTagNameRequest(TagId, _proposedName.Trim(), _proposalReason?.Trim());
                var res = await ApiClient.ProposeTagNameAsync(req, _cts.Token);
                if (res != null)
                {
                    Snackbar.Add("タグ名変更の提案を送信しました。", Severity.Success);
                    _isProposing = false;
                    await LoadTagAsync();
                }
                else
                {
                    Snackbar.Add("提案の送信に失敗しました。", Severity.Error);
                }
            }
            else
            {
                if (string.IsNullOrWhiteSpace(_proposedContent))
                {
                    Snackbar.Add("提案する説明文を入力してください。", Severity.Warning);
                    return;
                }

                var req = new ProposeTagContentRequest(TagId, _proposedContent.Trim(), _proposalReason?.Trim());
                var res = await ApiClient.ProposeTagContentAsync(req, _cts.Token);
                if (res != null)
                {
                    Snackbar.Add("説明文変更の提案を送信しました。", Severity.Success);
                    _isProposing = false;
                    await LoadTagAsync();
                }
                else
                {
                    Snackbar.Add("提案の送信に失敗しました。", Severity.Error);
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"提案送信エラー: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSubmittingProposal = false;
        }
    }

