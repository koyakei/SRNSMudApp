@page "/Tag/WasmTree"
@using SRNSMudApp.Client.Components

@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))

<PageTitle>Tag Tree (WASM)</PageTitle>

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-5">
    <div class="d-flex align-center justify-space-between mb-4">
        <div>
            <MudText Typo="Typo.h5">タグツリー階層 (WebAssembly)</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                ブラウザ側 WebAssembly (WASM) から API (/api/tag/tree) を直接呼び出して動作します。
            </MudText>
        </div>
        <div class="d-flex align-center gap-2">
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" Href="/Item/WasmList"
                       StartIcon="@Icons.Material.Filled.List">
                アイテム一覧 (WASM)
            </MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" Href="/Tag/WasmDiagram"
                       StartIcon="@Icons.Material.Filled.Hub">
                ダイアグラム (WASM)
            </MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Small" Href="/tag-tree"
                       StartIcon="@Icons.Material.Filled.ArrowBack">
                サーバー版 TagTree へ戻る
            </MudButton>
        </div>
    </div>

    <TagTreeView />
</MudContainer>

