@using MudBlazor
@using SRNSMudApp.Client.Models.Api

@if (Items.Count == 0)
{
    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="pa-4 text-center">
        このタグに関連付けられたアイテムはありません。
    </MudText>
}
else
{
    <MudStack Spacing="3">
        @foreach (var item in Items)
        {
            <MudPaper Elevation="0" Outlined="true" Class="pa-3 rounded-lg">
                <div class="d-flex justify-space-between align-center mb-1">
                    <MudLink Href="@($"/Item/WasmDetail/{item.Id}")" Color="Color.Primary" Typo="Typo.subtitle2" Class="font-weight-bold">
                        #@item.Id - @(item.OwnerUserName ?? "匿名")
                    </MudLink>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        @item.UpdatedDate.ToLocalTime().ToString("g")
                    </MudText>
                </div>
                <MudText Typo="Typo.body2" Class="mb-2" Style="white-space: pre-wrap;">@item.Content</MudText>
                <div class="d-flex align-center justify-space-between">
                    <div class="d-flex gap-1 flex-wrap">
                        @foreach (var tr in item.TagRelations)
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default">
                                @tr.TagName (+@tr.Weight)
                            </MudChip>
                        }
                    </div>
                    <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                               Href="@($"/Item/WasmDetail/{item.Id}")" EndIcon="@Icons.Material.Filled.ArrowForward">
                        詳細を見る
                    </MudButton>
                </div>
            </MudPaper>
        }
    </MudStack>
}

@code {
    /// <summary>
    /// 関連アイテム一覧。
    /// </summary>
    [Parameter]
    public IReadOnlyList<ItemDto> Items { get; set; } = [];
}

