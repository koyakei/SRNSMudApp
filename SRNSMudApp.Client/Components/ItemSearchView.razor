@using MudBlazor
@using SRNSMudApp.Client.Models
@using SRNSMudApp.Client.Models.Api

<MudPaper Class="pa-3 mb-4 rounded-xl search-container" Outlined="true">
    @if (_selectedFilters.Count > 0)
    {
        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" Class="mb-2 align-center">
            @foreach (var filter in _selectedFilters)
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled"
                         OnClose="@(_ => RemoveFilterAsync(filter))">
                    @filter.DisplayText
                </MudChip>
            }
            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Default"
                       OnClick="ClearFiltersAsync" StartIcon="@Icons.Material.Filled.Clear">
                すべてクリア
            </MudButton>
        </MudStack>
    }

    <MudAutocomplete @ref="_autocomplete" T="TagSuggestion" @bind-Text="_searchText"
                     SearchFunc="SearchSuggestionsAsync" ToStringFunc="@(s => s?.DisplayText)"
                     ValueChanged="OnSuggestionSelected" Placeholder="タグ名で検索 (WASM)..." Variant="Variant.Outlined"
                     Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                     OnAdornmentClick="OnAdornmentClick" DebounceInterval="300" Clearable="true"
                     ResetValueOnEmptyText="true" MaxItems="10" />
</MudPaper>

@if (!string.IsNullOrEmpty(_errorMessage))
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@_errorMessage</MudAlert>
}

@if (_isLoading)
{
    <div class="d-flex justify-center pa-4">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
    </div>
}
else
{
    @if (_selectedFilters.Count > 0)
    {
        <MudText Typo="Typo.body2" Class="mb-3" Color="Color.Secondary">
            @(_totalCount) 件のアイテム、@(_tags?.Count ?? 0) 件のタグが見つかりました
        </MudText>
    }

    @if (_items is { Count: > 0 })
    {
        <MudStack Spacing="3">
            @foreach (var item in _items)
            {
                <MudCard Outlined="true" Class="rounded-xl">
                    <MudCardContent Class="pa-4">
                        <MudText Typo="Typo.body1" Style="white-space: pre-wrap;">@item.Content</MudText>

                        @if (item.TagRelations is { Count: > 0 })
                        {
                            <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" Class="mt-2">
                                @foreach (var rel in item.TagRelations)
                                {
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Info">
                                        #@rel.TagName
                                        @if (rel.Weight.HasValue && rel.Weight.Value != 0)
                                        {
                                            <span> (@rel.Weight)</span>
                                        }
                                    </MudChip>
                                }
                            </MudStack>
                        }

                        <MudStack Row="true" Justify="Justify.SpaceBetween" Class="mt-3 align-center">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                投稿者: @(item.OwnerUserName ?? "匿名")
                            </MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                @item.UpdatedDate.LocalDateTime.ToString("yyyy/MM/dd HH:mm")
                            </MudText>
                        </MudStack>
                    </MudCardContent>
                </MudCard>
            }
        </MudStack>
    }
    else
    {
        <MudAlert Severity="Severity.Info" Class="mt-2">条件に一致するアイテムが見つかりませんでした。</MudAlert>
    }
}
